<?xml version="1.0" encoding="utf-8"?>
<!-- Self-contained single file like the toolbox; published to firewall\publish\win-x64 at the repository's root (like the engine). -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Startup: no compression (compressed, every assembly is unpacked into the process's private memory at each start: ~0.25 s
         and ~65 MB more) and ReadyToRun (precompiled code, little JIT at startup: ~0.2 s less). The .exe goes to ~240 MB. -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>none</DebugType>
    <PublishDir>..\..\..\firewall\publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
