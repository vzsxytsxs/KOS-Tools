<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:v="clr-namespace:KosToolbox.Views">

    <!-- ===== Palette (monochrome, no blue) ===== -->
    <Color x:Key="BgColor">#000000</Color>
    <Color x:Key="CardColor">#0D0D0D</Color>
    <Color x:Key="ControlColor">#141414</Color>
    <Color x:Key="HoverColor">#1F1F1F</Color>
    <Color x:Key="PressedColor">#262626</Color>
    <Color x:Key="BorderColor">#292929</Color>
    <Color x:Key="BorderStrongColor">#3A3A3A</Color>
    <Color x:Key="TextColor">#F5F5F5</Color>
    <Color x:Key="TextSecondaryColor">#A0A0A0</Color>

    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="ControlBrush" Color="{StaticResource ControlColor}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}" />
    <SolidColorBrush x:Key="PressedBrush" Color="{StaticResource PressedColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="OnLightBrush" Color="#000000" />
    <!-- Muted functional colors, only for errors and warnings. -->
    <SolidColorBrush x:Key="ErrorBrush" Color="#F28B82" />
    <SolidColorBrush x:Key="WarningBrush" Color="#E6C27A" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#5A5A5A" />

    <!-- No built-in WPF popup animations, which follow the Windows visual effects: the toolbox animates (Motion). -->
    <PopupAnimation x:Key="{x:Static SystemParameters.ToolTipPopupAnimationKey}">None</PopupAnimation>
    <PopupAnimation x:Key="{x:Static SystemParameters.MenuPopupAnimationKey}">None</PopupAnimation>
    <PopupAnimation x:Key="{x:Static SystemParameters.ComboBoxPopupAnimationKey}">None</PopupAnimation>

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <!-- Segoe Fluent Icons on Windows 11; MDL2 as fallback (same codes). -->
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- ===== Text ===== -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Secondary" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>
    <Style x:Key="Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ===== Visible focus ===== -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-2" RadiusX="6" RadiusY="6" Stroke="{StaticResource TextBrush}" StrokeThickness="1.5" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Cards ===== -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- Small status badge (Custom, Unknown, Restart pending...). -->
    <Style x:Key="Pill" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="8,1" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ===== Buttons ===== -->
    <Style TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
        <Setter Property="Background" Value="{StaticResource ControlBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,5" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid SnapsToDevicePixels="True">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" />
                        <Border Margin="{TemplateBinding BorderThickness}" CornerRadius="4" Background="{StaticResource HoverBrush}" Opacity="0"
                                v:Motion.ShowWhen="{TemplateBinding IsMouseOver}" />
                        <Border Margin="{TemplateBinding BorderThickness}" CornerRadius="4" Background="{StaticResource PressedBrush}" Opacity="0"
                                v:Motion.ShowWhen="{TemplateBinding IsPressed}" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{StaticResource OnLightBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border Background="{StaticResource TextBrush}" CornerRadius="5" />
                        <Border Background="#DADADA" CornerRadius="5" Opacity="0" v:Motion.ShowWhen="{TemplateBinding IsMouseOver}" />
                        <Border Background="#BDBDBD" CornerRadius="5" Opacity="0" v:Motion.ShowWhen="{TemplateBinding IsPressed}" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <!-- Subtle link (underlined text), without the default blue color. -->
    <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock x:Name="t" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" TextDecorations="Underline" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="t" Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Segmented On/Off control ===== -->
    <!-- Items: OptionItem (Key, Label, IsSelected). The command that receives the Key goes in the ItemsControl Tag. -->
    <Style x:Key="SegmentButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="MinWidth" Value="84" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border CornerRadius="4" Background="{StaticResource HoverBrush}" Opacity="0" v:Motion.ShowWhen="{TemplateBinding IsMouseOver}" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Border CornerRadius="4" Background="{StaticResource TextBrush}" Opacity="0" Padding="{TemplateBinding Padding}"
                                v:Motion.ShowWhen="{Binding IsSelected}">
                            <TextBlock Text="{Binding Label}" Foreground="{StaticResource OnLightBrush}" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Segmented" TargetType="ItemsControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ItemsControl">
                    <Border Background="{StaticResource ControlBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="2">
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Button Style="{StaticResource SegmentButton}" Content="{Binding Label}"
                            AutomationProperties.Name="{Binding Label}"
                            Command="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding Key}" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Text box (search) ===== -->
    <Style TargetType="TextBox">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="{StaticResource ControlBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource SelectionBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                        <Grid>
                            <TextBlock x:Name="ph" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="{TemplateBinding Padding}" Padding="3,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" />
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="ph" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource TextBrush}" />
                            <!-- When focused, the placeholder text disappears so the caret doesn't sit on top of it. -->
                            <Setter TargetName="ph" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Read-only, selectable text (dialogs). -->
    <Style x:Key="ReadOnlyText" TargetType="TextBox">
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="SelectionBrush" Value="{StaticResource SelectionBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer x:Name="PART_ContentHost" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== ComboBox (value lists) ===== -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Grid Background="Transparent">
                        <Border x:Name="b" Background="Transparent" CornerRadius="4" />
                        <Border CornerRadius="4" Background="{StaticResource HoverBrush}" Opacity="0" v:Motion.ShowWhen="{TemplateBinding IsHighlighted}" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="b" Property="Background" Value="{StaticResource PressedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="MinWidth" Value="190" />
        <Setter Property="MaxDropDownHeight" Value="320" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Grid>
                                        <Border Background="{StaticResource ControlBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" />
                                        <Border Margin="1" CornerRadius="4" Background="{StaticResource HoverBrush}" Opacity="0" v:Motion.ShowWhen="{TemplateBinding IsMouseOver}" />
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="10" HorizontalAlignment="Right" Margin="0,0,10,0"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                    </Grid>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <!-- Without ContentTemplateSelector/StringFormat, a DisplayMemberPath would show the item's class name. -->
                        <ContentPresenter IsHitTestVisible="False" Margin="10,0,30,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                          Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                        <!-- No item matches the current value: the Tag explains why (Partial, Not configured, Unknown...). -->
                        <TextBlock x:Name="ph" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" IsHitTestVisible="False"
                                   Margin="10,0,30,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource TextSecondaryBrush}" FontStyle="Italic" Visibility="Collapsed" />
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="None"
                               IsOpen="{TemplateBinding IsDropDownOpen}" v:Motion.PopOnOpen="True">
                            <Border Background="{StaticResource ControlBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                                    CornerRadius="5" Padding="2" Margin="0,4,0,0" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <ScrollViewer>
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="SelectedItem" Value="{x:Null}">
                            <Setter TargetName="ph" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Thin scroll bar ===== -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="t" CornerRadius="3" Background="{StaticResource BorderStrongBrush}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="t" Property="Background" Value="#5A5A5A" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ScrollPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="2,2">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand" />
                        </Track.DecreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb Style="{StaticResource ScrollThumb}" />
                        </Track.Thumb>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand" />
                        </Track.IncreaseRepeatButton>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" Margin="2,2">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageLeftCommand" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageRightCommand" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Tooltips ===== -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{StaticResource ControlBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                            CornerRadius="5" Padding="8,5" MaxWidth="440">
                        <ContentPresenter>
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap" />
                                </Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Context menu (⋯) ===== -->
    <Style TargetType="ContextMenu">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{StaticResource ControlBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="6" Padding="4">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid Background="Transparent" MinWidth="220">
                        <Border CornerRadius="4" Background="{StaticResource HoverBrush}" Opacity="0" v:Motion.ShowWhen="{TemplateBinding IsHighlighted}" />
                        <ContentPresenter Margin="10,7" ContentSource="Header" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Expandable groups ===== -->
    <Style x:Key="GroupExpander" TargetType="Expander">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <DockPanel>
                        <ToggleButton DockPanel.Dock="Top" FocusVisualStyle="{StaticResource FocusVisual}" Cursor="Hand"
                                      Content="{TemplateBinding Header}" AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}"
                                      IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border Background="Transparent" Padding="2,6,2,8">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="chev" Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="10" Margin="0,0,8,0"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                            <ContentPresenter>
                                                <ContentPresenter.Resources>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}" />
                                                </ContentPresenter.Resources>
                                            </ContentPresenter>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <!-- When collapsed, the down arrow rotates to point right. -->
                                        <Trigger Property="IsChecked" Value="False">
                                            <Setter TargetName="chev" Property="v:Motion.Angle" Value="-90" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Visibility="Collapsed" Opacity="0" v:Motion.RevealWhen="{TemplateBinding IsExpanded}" />
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Side navigation ===== -->
    <!-- A page in the sidebar: 16 px icon and its name; the name hides and becomes a tooltip when the sidebar is collapsed (MainViewModel.NavCollapsed). -->
    <Style x:Key="NavList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Cycle" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ItemsPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="ToolTip" Value="{Binding Title}" />
                    <Setter Property="ToolTipService.IsEnabled" Value="{Binding DataContext.NavCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <!-- Margin on the item (not in the template): the Tab focus rectangle fits tightly around the row. -->
                    <Setter Property="Margin" Value="8,0,8,1" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Grid Height="30" Background="Transparent">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Grid.ColumnSpan="2" CornerRadius="6" Background="{StaticResource ControlBrush}" Opacity="0" v:Motion.ShowWhen="{TemplateBinding IsMouseOver}" />
                                    <Border Grid.ColumnSpan="2" CornerRadius="6" Background="{StaticResource HoverBrush}" Opacity="0" v:Motion.ShowWhen="{TemplateBinding IsSelected}" />
                                    <Border Width="3" CornerRadius="3,0,0,3" HorizontalAlignment="Left"
                                            Background="{StaticResource TextBrush}" Opacity="0" v:Motion.ShowWhen="{TemplateBinding IsSelected}" />
                                    <TextBlock x:Name="glyph" Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="16"
                                               HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Visibility="Collapsed" />
                                    <Path x:Name="drawn" Data="{Binding IconPath}" Stretch="Uniform" Width="16" Height="16" StrokeThickness="1.4"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="{StaticResource TextSecondaryBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock x:Name="label" Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" Margin="0,0,10,0"
                                               TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextSecondaryBrush}" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <!-- No drawn icon (most pages): use the font glyph. -->
                                    <DataTrigger Binding="{Binding IconPath}" Value="{x:Null}">
                                        <Setter TargetName="glyph" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="drawn" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DataContext.NavCollapsed, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter TargetName="label" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="glyph" Property="Foreground" Value="{StaticResource TextBrush}" />
                                        <Setter TargetName="drawn" Property="Stroke" Value="{StaticResource TextBrush}" />
                                        <Setter TargetName="label" Property="Foreground" Value="{StaticResource TextBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="glyph" Property="Foreground" Value="{StaticResource TextBrush}" />
                                        <Setter TargetName="drawn" Property="Stroke" Value="{StaticResource TextBrush}" />
                                        <Setter TargetName="label" Property="Foreground" Value="{StaticResource TextBrush}" />
                                        <Setter TargetName="label" Property="FontWeight" Value="SemiBold" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A KOS app's master switch in its header (AppWindow): a pill with a track, a knob and the page's MasterText; on = the switches' blue. -->
    <Style x:Key="MasterSwitch" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Height="34">
                        <Border x:Name="Frame" CornerRadius="17" Background="{StaticResource ControlBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" />
                        <Border CornerRadius="17" Margin="1" Background="{StaticResource HoverBrush}" Opacity="0" v:Motion.ShowWhen="{TemplateBinding IsMouseOver}" />
                        <StackPanel Orientation="Horizontal" Margin="9,0,14,0">
                            <Grid Width="36" Height="20" VerticalAlignment="Center">
                                <Border x:Name="Track" CornerRadius="10" Background="{StaticResource ControlBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" />
                                <Ellipse x:Name="Knob" Width="12" Height="12" Margin="4,0" HorizontalAlignment="Left" Fill="{StaticResource TextSecondaryBrush}" />
                            </Grid>
                            <TextBlock x:Name="Label" Text="{Binding Current.MasterText}" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Current.MasterOn}" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                            <Setter TargetName="Track" Property="Background" Value="#1E9BE0" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="#1E9BE0" />
                            <Setter TargetName="Knob" Property="Fill" Value="#FFFFFF" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Label" Property="Foreground" Value="{StaticResource TextBrush}" />
                            <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The sidebar's Collapse button: the same row as a page, with a chevron. -->
    <Style x:Key="NavButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="8,0" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Height="30" Background="Transparent">
                        <Border CornerRadius="6" Background="{StaticResource ControlBrush}" Opacity="0" v:Motion.ShowWhen="{TemplateBinding IsMouseOver}" />
                        <ContentPresenter />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource TextBrush}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Top tabs ===== -->
    <Style x:Key="TabList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ItemsPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <StackPanel Margin="0,0,22,0" Background="Transparent">
                                    <TextBlock x:Name="t" Text="{Binding Title}" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,6" />
                                    <Border Height="2" CornerRadius="1" Background="{StaticResource TextBrush}" Opacity="0" v:Motion.ShowWhen="{TemplateBinding IsSelected}" />
                                </StackPanel>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="t" Property="Foreground" Value="{StaticResource TextBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="t" Property="Foreground" Value="{StaticResource TextBrush}" />
                                        <Setter TargetName="t" Property="FontWeight" Value="SemiBold" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Check box ===== -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <!-- A Grid, not a horizontal StackPanel: a label with a wrapping TextBlock can wrap. -->
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid Width="18" Height="18" VerticalAlignment="Center">
                            <Border x:Name="box" CornerRadius="4" BorderThickness="1" BorderBrush="{StaticResource BorderStrongBrush}" Background="{StaticResource ControlBrush}" />
                            <Border CornerRadius="4" Background="{StaticResource TextBrush}" Opacity="0"
                                    v:Motion.ShowWhen="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="12" Foreground="{StaticResource OnLightBrush}" HorizontalAlignment="Center" />
                            </Border>
                            <!-- Partly: only code sets it (a state read back), a click never lands here. -->
                            <TextBlock x:Name="partly" Style="{StaticResource Icon}" Text="&#xE738;" FontSize="12" HorizontalAlignment="Center" Visibility="Collapsed" />
                        </Grid>
                        <ContentPresenter x:Name="label" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="label" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="partly" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource TextSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Progress (determinate only: shows real progress only) ===== -->
    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="3" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="{StaticResource BorderBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" CornerRadius="1.5" Background="{TemplateBinding Background}" />
                        <Border x:Name="PART_Indicator" CornerRadius="1.5" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Data lists (Startup, Services): virtualized, own scrolling ===== -->
    <Style x:Key="DataList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="True" />
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
        <!-- Without this, filtering the list moves the selection to the first visible row. -->
        <Setter Property="IsSynchronizedWithCurrentItem" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                    <Setter Property="Padding" Value="10,6" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Grid Background="Transparent">
                                    <Border CornerRadius="4" Background="{StaticResource HoverBrush}" Opacity="0" v:Motion.ShowWhen="{TemplateBinding IsMouseOver}" />
                                    <Border x:Name="sel" CornerRadius="4" Background="{StaticResource PressedBrush}" BorderBrush="{StaticResource BorderStrongBrush}"
                                            BorderThickness="1" Opacity="0" v:Motion.ShowWhen="{TemplateBinding IsSelected}" />
                                    <ContentPresenter Margin="{TemplateBinding Padding}" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="sel" Property="BorderBrush" Value="{StaticResource TextSecondaryBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <BooleanToVisibilityConverter x:Key="BoolToVis" />
</ResourceDictionary>
