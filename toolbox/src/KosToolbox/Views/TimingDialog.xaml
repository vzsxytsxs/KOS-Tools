<Window x:Class="KosToolbox.Views.TimingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:t="clr-namespace:KosToolbox.Core.Text;assembly=KosToolbox.Core"
        Title="{Binding Title}" Width="680" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" UseLayoutRounding="True"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13">
    <Window.Resources>
        <!-- Dark radio button (which value stays fixed). -->
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Grid Width="18" Height="18">
                                <Ellipse Stroke="{StaticResource BorderStrongBrush}" StrokeThickness="1.5" Fill="{StaticResource ControlBrush}" />
                                <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{StaticResource TextBrush}" Visibility="Collapsed" />
                            </Grid>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Dot" Property="Visibility" Value="Visible" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Unit" TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
        <Style x:Key="Field" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="Height" Value="30" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="Section" TargetType="Border">
            <Setter Property="Background" Value="#111111" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,8,12,10" />
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>
    </Window.Resources>

    <StackPanel x:Name="Root" Margin="24,20,24,20">
        <TextBlock Style="{StaticResource CardTitle}" FontSize="18" Text="{Binding Title}" Margin="0,0,0,12" />
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="Timing:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Modes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Mode}" AutomationProperties.Name="Timing" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0">
                <Button Content="Copy" Command="{Binding CopyCommand}" ToolTip="Copy this timing" />
                <Button Content="Paste" Command="{Binding PasteCommand}" Margin="6,0,0,0" ToolTip="Paste the copied timing" />
                <Button Content="Reset" Command="{Binding ResetCommand}" Margin="6,0,0,0" ToolTip="Back to the values this window opened with" />
            </StackPanel>
        </Grid>

        <Border Style="{StaticResource Section}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" /><ColumnDefinition Width="*" /><ColumnDefinition Width="52" /><ColumnDefinition Width="*" /><ColumnDefinition Width="44" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Text="Parameters" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,2" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="Horizontal" HorizontalAlignment="Center" Style="{StaticResource Secondary}" />
                <TextBlock Grid.Row="1" Grid.Column="3" Text="Vertical" HorizontalAlignment="Center" Style="{StaticResource Secondary}" />

                <TextBlock Grid.Row="2" Text="Active:" VerticalAlignment="Center" />
                <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource Field}" Text="{Binding HActive, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Horizontal active" />
                <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Unit}" Text="pixels" />
                <TextBox Grid.Row="2" Grid.Column="3" Style="{StaticResource Field}" Text="{Binding VActive, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Vertical active" />
                <TextBlock Grid.Row="2" Grid.Column="4" Style="{StaticResource Unit}" Text="lines" />

                <TextBlock Grid.Row="3" Text="Front porch:" VerticalAlignment="Center" />
                <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource Field}" Text="{Binding HFront, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsManual}" AutomationProperties.Name="Horizontal front porch" />
                <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource Unit}" Text="pixels" />
                <TextBox Grid.Row="3" Grid.Column="3" Style="{StaticResource Field}" Text="{Binding VFront, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsManual}" AutomationProperties.Name="Vertical front porch" />
                <TextBlock Grid.Row="3" Grid.Column="4" Style="{StaticResource Unit}" Text="lines" />

                <TextBlock Grid.Row="4" Text="Sync width:" VerticalAlignment="Center" />
                <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource Field}" Text="{Binding HSync, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsManual}" AutomationProperties.Name="Horizontal sync width" />
                <TextBlock Grid.Row="4" Grid.Column="2" Style="{StaticResource Unit}" Text="pixels" />
                <TextBox Grid.Row="4" Grid.Column="3" Style="{StaticResource Field}" Text="{Binding VSync, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsManual}" AutomationProperties.Name="Vertical sync width" />
                <TextBlock Grid.Row="4" Grid.Column="4" Style="{StaticResource Unit}" Text="lines" />

                <RadioButton Grid.Row="5" GroupName="Anchor" Content="Back porch:" IsChecked="{Binding AnchorBack}" IsEnabled="{Binding IsManual}" />
                <TextBox Grid.Row="5" Grid.Column="1" Style="{StaticResource Field}" Text="{Binding HBack, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanBack}" AutomationProperties.Name="Horizontal back porch" />
                <TextBlock Grid.Row="5" Grid.Column="2" Style="{StaticResource Unit}" Text="pixels" />
                <TextBox Grid.Row="5" Grid.Column="3" Style="{StaticResource Field}" Text="{Binding VBack, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanBack}" AutomationProperties.Name="Vertical back porch" />
                <TextBlock Grid.Row="5" Grid.Column="4" Style="{StaticResource Unit}" Text="lines" />

                <RadioButton Grid.Row="6" GroupName="Anchor" Content="Blanking:" IsChecked="{Binding AnchorBlank}" IsEnabled="{Binding IsManual}" />
                <TextBox Grid.Row="6" Grid.Column="1" Style="{StaticResource Field}" Text="{Binding HBlank, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanBlank}" AutomationProperties.Name="Horizontal blanking" />
                <TextBlock Grid.Row="6" Grid.Column="2" Style="{StaticResource Unit}" Text="pixels" />
                <TextBox Grid.Row="6" Grid.Column="3" Style="{StaticResource Field}" Text="{Binding VBlank, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanBlank}" AutomationProperties.Name="Vertical blanking" />
                <TextBlock Grid.Row="6" Grid.Column="4" Style="{StaticResource Unit}" Text="lines" />

                <RadioButton Grid.Row="7" GroupName="Anchor" Content="Total:" IsChecked="{Binding AnchorTotal}" IsEnabled="{Binding IsManual}" />
                <TextBox Grid.Row="7" Grid.Column="1" Style="{StaticResource Field}" Text="{Binding HTotal, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanTotal}" AutomationProperties.Name="Horizontal total" />
                <TextBlock Grid.Row="7" Grid.Column="2" Style="{StaticResource Unit}" Text="pixels" />
                <TextBox Grid.Row="7" Grid.Column="3" Style="{StaticResource Field}" Text="{Binding VTotal, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanTotal}" AutomationProperties.Name="Vertical total" />
                <TextBlock Grid.Row="7" Grid.Column="4" Style="{StaticResource Unit}" Text="lines" />

                <TextBlock Grid.Row="8" Text="Sync polarity:" VerticalAlignment="Center" />
                <ComboBox Grid.Row="8" Grid.Column="1" Margin="0,3" ItemsSource="{Binding Polarities}" SelectedItem="{Binding HPolarity}" IsEnabled="{Binding IsManual}" AutomationProperties.Name="Horizontal sync polarity" />
                <ComboBox Grid.Row="8" Grid.Column="3" Margin="0,3" ItemsSource="{Binding Polarities}" SelectedItem="{Binding VPolarity}" IsEnabled="{Binding IsManual}" AutomationProperties.Name="Vertical sync polarity" />
            </Grid>
        </Border>

        <Border Style="{StaticResource Section}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" /><ColumnDefinition Width="*" /><ColumnDefinition Width="44" /><ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Text="Frequency" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,2" />

                <RadioButton Grid.Row="1" GroupName="Frequency" Content="Refresh rate:" IsChecked="{Binding FreqRefresh}" IsEnabled="{Binding IsManual}" />
                <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource Field}" Text="{Binding RefreshText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanRefresh}" AutomationProperties.Name="Refresh rate" />
                <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Unit}" Text="Hz" />
                <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding ActualRefresh}" VerticalAlignment="Center" Margin="8,0,0,0" />

                <RadioButton Grid.Row="2" GroupName="Frequency" Content="Horizontal:" IsChecked="{Binding FreqHorizontal}" IsEnabled="{Binding IsManual}" />
                <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource Field}" Text="{Binding HorizontalText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanHorizontal}" AutomationProperties.Name="Horizontal frequency" />
                <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Unit}" Text="kHz" />
                <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding ActualHorizontal}" VerticalAlignment="Center" Margin="8,0,0,0" />

                <RadioButton Grid.Row="3" GroupName="Frequency" Content="Pixel clock:" IsChecked="{Binding FreqClock}" IsEnabled="{Binding IsManual}" />
                <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource Field}" Text="{Binding ClockText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanClock}" AutomationProperties.Name="Pixel clock" />
                <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource Unit}" Text="MHz" />
                <StackPanel Grid.Row="3" Grid.Column="3" Orientation="Horizontal" Margin="8,0,0,0">
                    <CheckBox Content="Interlaced" IsChecked="{Binding Interlaced}" VerticalAlignment="Center" />
                    <CheckBox Content="Preferred" IsChecked="{Binding Preferred}" Margin="18,0,0,0" VerticalAlignment="Center"
                              ToolTip="Make this the display's preferred (native) resolution" />
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Text="{Binding Summary}" Margin="0,10,0,0" />
        <TextBlock Text="{Binding Error}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                   Visibility="{Binding Error, Converter={StaticResource NotEmptyToVis}}" />

        <Grid Margin="0,22,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="10" /><ColumnDefinition /></Grid.ColumnDefinitions>
            <Button x:Name="Ok" Style="{StaticResource PrimaryButton}" Content="{Binding OkText}" IsEnabled="{Binding IsValid}" IsDefault="True" Click="OnOk" />
            <Button Grid.Column="2" Content="{x:Static t:Txt.Cancel}" IsCancel="True" />
        </Grid>
    </StackPanel>
</Window>
