<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:KosToolbox.ViewModels"
                    xmlns:t="clr-namespace:KosToolbox.Core.Text;assembly=KosToolbox.Core">

    <!-- ===================== BIOS (AMI SCEWIN) ===================== -->
    <!-- One setting: name and help on the left, the value on the right (list, number or read-only). The bar on the left marks a pending change. -->
    <DataTemplate DataType="{x:Type vm:BiosSettingRow}">
        <Grid MinHeight="40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="38" />
            </Grid.ColumnDefinitions>
            <Border CornerRadius="1.5" Background="{StaticResource TextBrush}" Margin="0,2"
                    Visibility="{Binding IsPending, Converter={StaticResource BoolToVis}}" />
            <StackPanel Grid.Column="1" Margin="10,0,16,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                <TextBlock Style="{StaticResource Secondary}" FontSize="12" Text="{Binding Help}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                           ToolTip="{Binding Help}" Visibility="{Binding Help, Converter={StaticResource NotEmptyToVis}}" />
            </StackPanel>
            <!-- ★ KOS recommended value: click to use it; dimmed when it is already in effect. -->
            <Button Grid.Column="2" Style="{StaticResource NicRecommended}" Content="{Binding RecommendedLabel}" Command="{Binding UseRecommendedCommand}"
                    ToolTip="{Binding RecommendedTip}" Visibility="{Binding HasRecommended, Converter={StaticResource BoolToVis}}" />
            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice, Mode=TwoWay}" ItemTemplate="{StaticResource OptionText}"
                          Tag="{x:Static t:Txt.BiosNotSet}" AutomationProperties.Name="{Binding Name}"
                          Visibility="{Binding IsChoice, Converter={StaticResource BoolToVis}}" />
                <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding NumberHint}" AutomationProperties.Name="{Binding Name}"
                         Visibility="{Binding IsNumber, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding ReadOnlyText}" TextTrimming="CharacterEllipsis" ToolTip="{x:Static t:Txt.BiosReadOnlyHint}"
                           Foreground="{StaticResource TextSecondaryBrush}" Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVis}}" />
                <TextBlock Style="{StaticResource Secondary}" FontSize="11.5" Text="{Binding Note}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Note}" Visibility="{Binding Note, Converter={StaticResource NotEmptyToVis}}" />
                <TextBlock Text="{Binding Error}" Foreground="{StaticResource ErrorBrush}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
            <Button Grid.Column="4" Style="{StaticResource IconButton}" Content="&#xE7A7;" Width="30" Height="28" FontSize="12" HorizontalAlignment="Right"
                    VerticalAlignment="Center" Command="{Binding DiscardCommand}" ToolTip="{x:Static t:Txt.BiosDiscardSetting}"
                    AutomationProperties.Name="{x:Static t:Txt.BiosDiscardSetting}" Visibility="{Binding CanDiscard, Converter={StaticResource BoolToVis}}" />
        </Grid>
    </DataTemplate>

    <!-- Difference between a backup and the last read (as on the Services page). -->
    <DataTemplate DataType="{x:Type vm:BiosDiffRow}">
        <Grid ToolTip="{Binding Reason}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="1.4*" />
                <ColumnDefinition Width="1.3*" />
                <ColumnDefinition Width="1.3*" />
            </Grid.ColumnDefinitions>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Restorable}" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding Restorable}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}" />
            <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" Margin="0,0,10,0" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="{Binding InBackup}" TextTrimming="CharacterEllipsis" ToolTip="{Binding InBackup}"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
            <TextBlock Grid.Column="3" Text="{Binding Current}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Current}"
                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="BiosBackupItem">
        <StackPanel Margin="0,2">
            <TextBlock Text="{Binding CapturedAt, StringFormat=g}" FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource Secondary}" FontSize="12" Text="{Binding ChangedText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ChangedText}"
                       Margin="0,2,0,0" Visibility="{Binding ChangedText, Converter={StaticResource NotEmptyToVis}}" />
            <TextBlock Style="{StaticResource Secondary}" FontSize="12">
                <Run Text="{Binding Count, Mode=OneWay, StringFormat={x:Static t:Txt.BiosSettingsCountFormat}}" /><Run Text="{Binding Computer, Mode=OneWay, StringFormat=' · {0}'}" />
            </TextBlock>
            <TextBlock Style="{StaticResource Secondary}" FontSize="12" Text="{x:Static t:Txt.BiosNotBooted}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap"
                       Visibility="{Binding NotBooted, Converter={StaticResource BoolToVis}}" />
            <TextBlock Style="{StaticResource Secondary}" FontSize="12" Text="{Binding Problem}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap"
                       Visibility="{Binding Problem, Converter={StaticResource NotEmptyToVis}}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:BiosPageViewModel}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ItemsControl ItemsSource="{Binding Tabs}" Focusable="False" Margin="0,0,0,10">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource GpuTabButton}" Command="{Binding DataContext.SelectTabCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding Key}" AutomationProperties.Name="{Binding Label}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Settings: the last read (nvram.txt), with edits pending until Apply. -->
            <Grid Grid.Row="1" Visibility="{Binding IsSettingsTab, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource CardTitle}" Text="nvram.txt" />
                            <TextBlock Style="{StaticResource Secondary}" Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,3,0,0" />
                            <TextBlock Style="{StaticResource Secondary}" Text="{Binding RecommendedText}" TextWrapping="Wrap" Margin="0,3,0,0"
                                       Visibility="{Binding RecommendedText, Converter={StaticResource NotEmptyToVis}}" />
                            <TextBlock Style="{StaticResource Secondary}" Text="{Binding Problem}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Visibility="{Binding Problem, Converter={StaticResource NotEmptyToVis}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="{x:Static t:Txt.BiosOpenTools}" Margin="0,0,8,0" Command="{Binding OpenToolsCommand}"
                                    Visibility="{Binding HasScewin, Converter={StaticResource InverseBoolToVis}}" />
                            <Button Content="{x:Static t:Txt.BiosRecommended}" Margin="0,0,8,0" Command="{Binding RecommendedCommand}" ToolTip="{x:Static t:Txt.BiosRecommendedTooltip}" />
                            <Button Style="{StaticResource PrimaryButton}" Content="{x:Static t:Txt.BiosRead}" Command="{Binding ReadCommand}" ToolTip="{x:Static t:Txt.BiosReadTooltip}" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE838;" Margin="6,0,0,0" Command="{Binding OpenFolderCommand}"
                                    ToolTip="{Binding Folder}" AutomationProperties.Name="{x:Static t:Txt.OpenFolder}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <DockPanel Grid.Row="1" Margin="0,10,0,8" LastChildFill="False">
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource PageSearch}" VerticalAlignment="Center" />
                    <CheckBox Content="{x:Static t:Txt.BiosOnlyNotDefault}" IsChecked="{Binding OnlyNotDefault}" Margin="16,0,0,0" VerticalAlignment="Center" />
                    <CheckBox Content="{x:Static t:Txt.BiosOnlyPending}" IsChecked="{Binding OnlyPending}" Margin="16,0,0,0" VerticalAlignment="Center" />
                    <CheckBox Content="{x:Static t:Txt.BiosOnlyNotRecommended}" IsChecked="{Binding OnlyNotRecommended}" Margin="16,0,0,0" VerticalAlignment="Center" />
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Secondary}" Text="{Binding CountText}" VerticalAlignment="Center" />
                </DockPanel>

                <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                    <Grid>
                        <!-- No container recycling: a reused drop-down could carry its value from one row to another. -->
                        <ListBox Style="{StaticResource DataList}" ItemsSource="{Binding View}" VirtualizingPanel.VirtualizationMode="Standard"
                                 AutomationProperties.Name="{x:Static t:Txt.PageBios}" />
                        <TextBlock Style="{StaticResource Secondary}" Text="{Binding EmptyText}" Margin="10,12,10,0" TextWrapping="Wrap"
                                   Visibility="{Binding EmptyText, Converter={StaticResource NotEmptyToVis}}" />
                    </Grid>
                </Border>

                <!-- Nothing is written before Apply. -->
                <Border Grid.Row="3" Style="{StaticResource Card}" BorderBrush="{StaticResource BorderStrongBrush}" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{Binding PendingText}" Visibility="{Binding HasPending, Converter={StaticResource BoolToVis}}" Margin="0,0,0,3" />
                            <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.BiosApplyNote}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Status}" Margin="0,6,0,0" Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}" />
                            <ProgressBar IsIndeterminate="{Binding HasStatus}" Margin="0,6,0,0" Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="{x:Static t:Txt.Discard}" MinWidth="92" Command="{Binding DiscardCommand}" />
                            <Button Style="{StaticResource PrimaryButton}" Content="{x:Static t:Txt.Apply}" MinWidth="92" Margin="8,0,0,0" Command="{Binding ApplyCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Backups: the state read before each write, compared with the last read. -->
            <Grid Grid.Row="1" Visibility="{Binding IsBackupsTab, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.ColumnSpan="2" Style="{StaticResource Secondary}" Text="{x:Static t:Txt.BiosBackupsNote}" TextWrapping="Wrap" Margin="0,0,0,10" />

                <DockPanel Grid.Row="1" Margin="0,0,14,0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="{x:Static t:Txt.OpenFolder}" Command="{Binding OpenBackupsCommand}" ToolTip="{Binding BackupFolder}" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Secondary}" Text="{x:Static t:Txt.BiosNoBackups}" TextWrapping="Wrap" Margin="2,0,0,8"
                               Visibility="{Binding NoBackups, Converter={StaticResource BoolToVis}}" />
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Background="{StaticResource CardBrush}">
                        <ListBox Style="{StaticResource DataList}" ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup, Mode=TwoWay}"
                                 ItemTemplate="{StaticResource BiosBackupItem}" Padding="4" AutomationProperties.Name="{x:Static t:Txt.BiosTabBackups}" />
                    </Border>
                </DockPanel>

                <Grid Grid.Row="1" Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel LastChildFill="False" Margin="0,0,0,8">
                        <Grid Width="220" VerticalAlignment="Center">
                            <TextBox Text="{Binding DiffFilter, UpdateSourceTrigger=PropertyChanged, Delay=150}" Tag="{x:Static t:Txt.BiosFilter}"
                                     Padding="30,0,8,0" AutomationProperties.Name="{x:Static t:Txt.BiosFilter}" />
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE71C;" FontSize="12" Margin="10,0,0,0" HorizontalAlignment="Left"
                                       Foreground="{StaticResource TextSecondaryBrush}" IsHitTestVisible="False" />
                        </Grid>
                        <Button Content="{x:Static t:Txt.CheckAll}" Margin="8,0,0,0" Command="{Binding CheckAllCommand}" />
                        <Button Content="{x:Static t:Txt.UncheckAll}" Margin="8,0,0,0" Command="{Binding UncheckAllCommand}" />
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Secondary}" Text="{Binding DiffStats}" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Grid.Row="1" Style="{StaticResource Secondary}" Text="{Binding CompareError}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap"
                               Margin="2,0,0,8" Visibility="{Binding CompareError, Converter={StaticResource NotEmptyToVis}}" />
                    <Grid Grid.Row="2" Margin="10,2,20,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="1.4*" />
                            <ColumnDefinition Width="1.3*" />
                            <ColumnDefinition Width="1.3*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource SectionTitle}" FontSize="12" Text="{x:Static t:Txt.Restore}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource SectionTitle}" FontSize="12" Text="{x:Static t:Txt.ColSetting}" />
                        <TextBlock Grid.Column="2" Style="{StaticResource SectionTitle}" FontSize="12" Text="{x:Static t:Txt.ColInBackup}" />
                        <TextBlock Grid.Column="3" Style="{StaticResource SectionTitle}" FontSize="12" Text="{x:Static t:Txt.ColCurrent}" />
                    </Grid>
                    <Border Grid.Row="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                        <Grid>
                            <ListBox Style="{StaticResource DataList}" ItemsSource="{Binding DiffView}" AutomationProperties.Name="{x:Static t:Txt.Differences}" />
                            <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.NoDifferences}" Margin="10,12,0,0"
                                       Visibility="{Binding NoDifferences, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource Card}" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.BiosRestoreNote}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Status}" Margin="0,6,0,0" Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}" />
                            <ProgressBar IsIndeterminate="{Binding HasStatus}" Margin="0,6,0,0" Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="{x:Static t:Txt.BiosRestoreChecked}" VerticalAlignment="Center"
                                Command="{Binding RestoreCommand}" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
