<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:KosToolbox.ViewModels"
                    xmlns:v="clr-namespace:KosToolbox.Views"
                    xmlns:t="clr-namespace:KosToolbox.Core.Text;assembly=KosToolbox.Core">

    <!-- Page search box (placeholder in the Tag, magnifier icon and clear button). -->
    <DataTemplate x:Key="PageSearch">
        <Grid Width="240">
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}" Tag="{x:Static t:Txt.FilterPlaceholder}"
                     Padding="30,0,30,0" AutomationProperties.Name="{x:Static t:Txt.FilterPlaceholder}" />
            <TextBlock Style="{StaticResource Icon}" Text="&#xE71C;" FontSize="12" Margin="10,0,0,0" HorizontalAlignment="Left"
                       Foreground="{StaticResource TextSecondaryBrush}" IsHitTestVisible="False" />
            <Button Style="{StaticResource IconButton}" Content="&#xE711;" Width="28" Height="28" FontSize="10" HorizontalAlignment="Right" Margin="0,0,2,0"
                    Command="{Binding ClearSearchCommand}" ToolTip="{x:Static t:Txt.ClearSearch}" AutomationProperties.Name="{x:Static t:Txt.ClearSearch}"
                    Visibility="{Binding SearchText, Converter={StaticResource NotEmptyToVis}}" />
        </Grid>
    </DataTemplate>

    <!-- Page result/error message: shown as a notification (toast) at the bottom of the window, not in the middle of the page. -->
    <Style x:Key="PageMessage" TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
        <Setter Property="v:ToastOnMessage.Message" Value="{Binding Message}" />
        <Setter Property="Visibility" Value="Collapsed" />
    </Style>

    <!-- Label and selectable value (detail panels). -->
    <DataTemplate x:Key="DetailRow">
        <Grid Margin="0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="DetailLabel" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Key}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,18,0" />
            <TextBox Grid.Column="1" Style="{StaticResource ReadOnlyText}" Text="{Binding Value, Mode=OneWay}" FontSize="12.5" />
        </Grid>
    </DataTemplate>

    <!-- ===================== Startup ===================== -->
    <DataTemplate DataType="{x:Type vm:StartupRowViewModel}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="1.4*" />
                <ColumnDefinition Width="0.9*" />
                <ColumnDefinition Width="1.4*" />
                <ColumnDefinition Width="1.3*" />
                <ColumnDefinition Width="2.4*" />
                <ColumnDefinition Width="40" />
            </Grid.ColumnDefinitions>
            <!-- Remove the entry (with backup); disabled with the reason in the tooltip when it can't be done. -->
            <Button Grid.Column="6" Style="{StaticResource IconButton}" Content="&#xE74D;" FontSize="13" Width="30" Height="28" HorizontalAlignment="Right"
                    CommandParameter="{Binding}" Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                    ToolTip="{Binding RemoveTip}" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Remove" />
            <DockPanel Margin="0,0,10,0">
                <Image DockPanel.Dock="Left" Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="12" Margin="6,0,0,0"
                           Foreground="{StaticResource WarningBrush}" ToolTip="{x:Static t:Txt.CriticalTooltip}"
                           Visibility="{Binding IsCritical, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Grid.Column="1" Text="{Binding Source}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextSecondaryBrush}"
                       Margin="0,0,10,0" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="{Binding Status}" Margin="0,0,10,0" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsUnknown}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Grid.Column="3" Text="{Binding StartupType}" TextTrimming="CharacterEllipsis" ToolTip="{Binding StartupType}"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
            <TextBlock Grid.Column="4" Text="{Binding Signer}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Signer}"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
            <TextBlock Grid.Column="5" Text="{Binding Command}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Command}"
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
        </Grid>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:StartupPageViewModel}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel LastChildFill="False">
                <ItemsControl Style="{StaticResource Segmented}" ItemsSource="{Binding Modes}" Tag="{Binding SelectModeCommand}" VerticalAlignment="Center"
                              AutomationProperties.Name="{x:Static t:Txt.Mode}" />
                <ComboBox ItemsSource="{Binding Filters}" ItemTemplate="{StaticResource OptionText}" SelectedItem="{Binding SelectedFilter, Mode=TwoWay}"
                          Margin="10,0,0,0" MinWidth="200" VerticalAlignment="Center" AutomationProperties.Name="{x:Static t:Txt.SourceFilter}" />
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource PageSearch}" Margin="10,0,0,0" VerticalAlignment="Center" />
                <CheckBox Content="{x:Static t:Txt.HideMicrosoft}" IsChecked="{Binding HideMicrosoft}" ToolTip="{x:Static t:Txt.HideMicrosoftTip}" Margin="14,0,0,0" VerticalAlignment="Center" />
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Secondary}" Text="{Binding CountText}" VerticalAlignment="Center" />
            </DockPanel>

            <StackPanel Grid.Row="1" Margin="0,10,0,6">
                <TextBlock Style="{StaticResource Secondary}" Text="{Binding ModeDetail}" />
                <TextBlock Style="{StaticResource Secondary}" Text="{Binding Coverage}" FontSize="12" Margin="0,3,0,0" />
                <ItemsControl ItemsSource="{Binding Problems}" Focusable="False" Margin="0,3,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource Secondary}" Text="{Binding}" Foreground="{StaticResource WarningBrush}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Margin="0,6,0,0" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                    <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" />
                    <TextBlock Style="{StaticResource Secondary}" Text="{Binding ProgressText}" FontSize="12" Margin="0,4,0,0" />
                </StackPanel>
                <TextBlock Style="{StaticResource PageMessage}" Margin="0,4,0,0" />
            </StackPanel>

            <!-- Column headers (same proportions as the rows; 10 px padding and 10 px for the scroll bar). -->
            <Grid Grid.Row="2" Margin="10,4,20,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="0.9*" />
                    <ColumnDefinition Width="1.4*" />
                    <ColumnDefinition Width="1.3*" />
                    <ColumnDefinition Width="2.4*" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource SectionTitle}" FontSize="12" Text="{x:Static t:Txt.ColName}" Margin="24,0,0,0" />
                <TextBlock Grid.Column="1" Style="{StaticResource SectionTitle}" FontSize="12" Text="{x:Static t:Txt.ColSource}" />
                <TextBlock Grid.Column="2" Style="{StaticResource SectionTitle}" FontSize="12" Text="{x:Static t:Txt.ColStatus}" />
                <TextBlock Grid.Column="3" Style="{StaticResource SectionTitle}" FontSize="12" Text="{x:Static t:Txt.ColStartupType}" />
                <TextBlock Grid.Column="4" Style="{StaticResource SectionTitle}" FontSize="12" Text="{x:Static t:Txt.ColSigner}" />
                <TextBlock Grid.Column="5" Style="{StaticResource SectionTitle}" FontSize="12" Text="{x:Static t:Txt.ColCommand}" />
            </Grid>

            <Border Grid.Row="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <ListBox Style="{StaticResource DataList}" ItemsSource="{Binding View}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                         SelectionMode="Single" AutomationProperties.Name="{x:Static t:Txt.PageStartup}">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource SectionTitle}" Margin="4,12,0,4">
                                        <Run Text="{Binding Name, Mode=OneWay}" /><Run Text="{Binding ItemCount, Mode=OneWay, StringFormat=' ({0})'}" />
                                    </TextBlock>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                </ListBox>
            </Border>

            <!-- Details of the selected entry: how the state was read and what the change does. -->
            <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,10,0,0" MaxHeight="260"
                    Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}" v:Motion.Transition="{Binding Selected}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Content="{x:Static t:Txt.Enable}" MinWidth="92" Command="{Binding EnableCommand}" />
                            <Button Content="{x:Static t:Txt.Disable}" MinWidth="92" Margin="8,0,0,0" Command="{Binding DisableCommand}" />
                            <Button Content="Remove" MinWidth="92" Margin="8,0,0,0" Command="{Binding RemoveCommand}" ToolTip="{Binding Selected.RemoveTip}" ToolTipService.ShowOnDisabled="True" />
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{Binding Selected.Icon}" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Selected.Name}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Secondary}" Text="{Binding SelectedWarning}" Foreground="{StaticResource WarningBrush}" Margin="0,6,0,0"
                                       Visibility="{Binding SelectedWarning, Converter={StaticResource NotEmptyToVis}}" />
                            <TextBlock Style="{StaticResource Secondary}" Text="{Binding SelectedReadOnly}" Margin="0,6,0,0"
                                       Visibility="{Binding SelectedReadOnly, Converter={StaticResource NotEmptyToVis}}" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding CanDelaySelected, Converter={StaticResource BoolToVis}}"
                                        ToolTip="A later start turns the Run entry off and creates a scheduled task of this account that starts the same command after the delay. An entry for all users then starts only for this account.">
                                <TextBlock Style="{StaticResource Secondary}" Text="Starts" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <ItemsControl Style="{StaticResource Segmented}" ItemsSource="{Binding DelayChoices}" Tag="{Binding SelectDelayCommand}" VerticalAlignment="Center"
                                              AutomationProperties.Name="Starts" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                        <ItemsControl ItemsSource="{Binding SelectedDetails}" ItemTemplate="{StaticResource DetailRow}" Grid.IsSharedSizeScope="True" Focusable="False" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DataTemplate>

    <!-- ===================== Power ===================== -->
    <DataTemplate x:Key="PlanText">
        <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:PowerSettingViewModel}">
        <Border Style="{StaticResource Card}" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                    <WrapPanel>
                        <TextBlock Style="{StaticResource CardTitle}" FontSize="13.5" Text="{Binding Name}" ToolTip="{Binding Technical}" Margin="0,0,10,0" />
                        <Border Style="{StaticResource Pill}" Visibility="{Binding IsModifiedHere, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{x:Static t:Txt.Modified}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        </Border>
                        <Border Style="{StaticResource Pill}" ToolTip="{x:Static t:Txt.PowerHiddenTooltip}" Visibility="{Binding IsHidden, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{x:Static t:Txt.PowerHiddenPill}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        </Border>
                        <Border Style="{StaticResource Pill}" ToolTip="{x:Static t:Txt.PowerDefaultTooltip}" Visibility="{Binding IsDefaultHere, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{x:Static t:Txt.PowerDefaultPill}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                        </Border>
                        <Border Style="{StaticResource Pill}" BorderBrush="{StaticResource WarningBrush}" Visibility="{Binding Differs, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{x:Static t:Txt.PowerDiffersPill}" FontSize="11" Foreground="{StaticResource WarningBrush}" />
                        </Border>
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Secondary}" Text="{Binding Description}" Margin="0,3,0,0"
                               Visibility="{Binding HasDescription, Converter={StaticResource BoolToVis}}" />
                    <!-- Comparison: value of the same setting in the other plans, read-only. -->
                    <ItemsControl ItemsSource="{Binding Comparison}" Focusable="False" Margin="0,6,0,0"
                                  Visibility="{Binding Others, Converter={StaticResource NotEmptyToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" FontSize="12" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Differs}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" MinWidth="260">
                    <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice, Mode=TwoWay}" Tag="{Binding ChoicePlaceholder}"
                              MinWidth="260" AutomationProperties.Name="{Binding Name}"
                              Visibility="{Binding IsChoice, Converter={StaticResource BoolToVis}}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <StackPanel Visibility="{Binding IsRange, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Width="130" AutomationProperties.Name="{Binding Name}" />
                            <TextBlock Style="{StaticResource Secondary}" Text="{Binding Units}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Secondary}" Text="{Binding RangeHint}" FontSize="11.5" Margin="0,4,0,0" />
                        <TextBlock Style="{StaticResource Secondary}" Text="{Binding Error}" Foreground="{StaticResource ErrorBrush}" FontSize="12" Margin="0,4,0,0"
                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding IsReadOnly, Converter={StaticResource BoolToVis}}" MaxWidth="320">
                        <TextBlock Text="{Binding ReadOnlyText}" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource Secondary}" Text="{Binding ReadOnlyReason}" FontSize="11.5" Margin="0,3,0,0"
                                   Visibility="{Binding ReadOnlyReason, Converter={StaticResource NotEmptyToVis}}" />
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE712;" Margin="6,0,0,0" VerticalAlignment="Center" v:MenuButton.OpenOnClick="True"
                        ToolTip="{x:Static t:Txt.PowerSettingMenu}" AutomationProperties.Name="{x:Static t:Txt.PowerSettingMenu}">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{x:Static t:Txt.PowerCustomValue}" Command="{Binding CustomValueCommand}" />
                            <MenuItem Header="{x:Static t:Txt.PowerDiscardSetting}" Command="{Binding DiscardCommand}" />
                            <MenuItem Header="{x:Static t:Txt.PowerRemoveValue}" Command="{Binding RemoveValueCommand}" />
                            <MenuItem Header="{Binding HiddenMenuText}" Command="{Binding ToggleHiddenCommand}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:PowerGroupViewModel}">
        <Expander Style="{StaticResource GroupExpander}" Header="{Binding Name}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
            <ItemsControl ItemsSource="{Binding Visible}" Focusable="False" />
        </Expander>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:PowerPageViewModel}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Edited plan (separate from the active plan) and activation. -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource CardTitle}" Text="{x:Static t:Txt.PowerPlan}" />
                        <TextBlock Style="{StaticResource Secondary}" Text="{Binding PlanDescription}" TextWrapping="Wrap" Margin="0,3,0,0"
                                   Visibility="{Binding PlanDescription, Converter={StaticResource NotEmptyToVis}}" />
                        <TextBlock Style="{StaticResource Secondary}" Text="{Binding PlanStatus}" Margin="0,3,0,0" />
                        <TextBlock Style="{StaticResource Secondary}" Text="{Binding LoadError}" Foreground="{StaticResource ErrorBrush}" Margin="0,4,0,0"
                                   Visibility="{Binding HasLoadError, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <ComboBox ItemsSource="{Binding Plans}" ItemTemplate="{StaticResource PlanText}" SelectedItem="{Binding SelectedPlan, Mode=TwoWay}"
                                  MinWidth="300" MaxWidth="420" AutomationProperties.Name="{x:Static t:Txt.PowerPlan}" />
                        <Button Style="{StaticResource PrimaryButton}" Content="{x:Static t:Txt.Activate}" Margin="8,0,0,0" Command="{Binding ActivateCommand}" />
                    </StackPanel>

                    <!-- Manage plans: each operation is verified by reading Windows back. -->
                    <DockPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0" LastChildFill="False"
                               AutomationProperties.Name="{x:Static t:Txt.PlanManagement}">
                        <Button DockPanel.Dock="Right" Content="{x:Static t:Txt.PlanRestoreDefaults}" Command="{Binding RestoreDefaultsCommand}" ToolTip="{x:Static t:Txt.PlanRestoreDefaultsTooltip}" />
                        <Button Content="{x:Static t:Txt.PlanSaveCopy}" Command="{Binding SaveCopyCommand}" />
                        <Button Content="{x:Static t:Txt.PlanRename}" Margin="8,0,0,0" Command="{Binding RenameCommand}" />
                        <Button Content="{x:Static t:Txt.PlanDelete}" Margin="8,0,0,0" Command="{Binding DeletePlanCommand}" />
                        <Button Content="{x:Static t:Txt.PlanImport}" Margin="8,0,0,0" Command="{Binding ImportCommand}" />
                        <Button Content="{x:Static t:Txt.PlanExport}" Margin="8,0,0,0" Command="{Binding ExportCommand}" />
                    </DockPanel>
                </Grid>
            </Border>

            <DockPanel Grid.Row="1" Margin="0,8,0,10" LastChildFill="False">
                <ItemsControl Style="{StaticResource Segmented}" ItemsSource="{Binding Modes}" Tag="{Binding SelectModeCommand}" VerticalAlignment="Center"
                              AutomationProperties.Name="{x:Static t:Txt.PowerSource}" />
                <CheckBox Content="{x:Static t:Txt.ShowAdvancedSettings}" IsChecked="{Binding ShowAdvanced}" Margin="16,0,0,0" VerticalAlignment="Center" />
                <CheckBox Content="{x:Static t:Txt.PowerCompare}" IsChecked="{Binding Compare}" Margin="16,0,0,0" VerticalAlignment="Center" />
                <CheckBox Content="{x:Static t:Txt.PowerOnlyDifferent}" IsChecked="{Binding OnlyDifferent}" IsEnabled="{Binding Compare}" Margin="16,0,0,0" VerticalAlignment="Center" />
                <ContentPresenter DockPanel.Dock="Right" Content="{Binding}" ContentTemplate="{StaticResource PageSearch}" VerticalAlignment="Center" />
            </DockPanel>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <StackPanel Margin="0,0,10,0">
                    <ItemsControl ItemsSource="{Binding Profiles}" Focusable="False" />
                    <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.PowerEditorNote}" Margin="2,0,0,10" />
                    <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.PowerNoMatches}" Margin="2,0,0,10"
                               Visibility="{Binding NoMatches, Converter={StaticResource BoolToVis}}" />
                    <ItemsControl ItemsSource="{Binding Groups}" Focusable="False" />
                </StackPanel>
            </ScrollViewer>

            <!-- Pending edits: nothing is written before Apply. -->
            <Border Grid.Row="3" Style="{StaticResource Card}" BorderBrush="{StaticResource BorderStrongBrush}" Margin="0,10,0,0">
                <Border.Visibility>
                    <MultiBinding Converter="{StaticResource AnyVisible}">
                        <Binding Path="HasPending" />
                        <Binding Path="Message" />
                    </MultiBinding>
                </Border.Visibility>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="{Binding PendingText}" Visibility="{Binding HasPending, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Style="{StaticResource PageMessage}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                Visibility="{Binding HasPending, Converter={StaticResource BoolToVis}}">
                        <Button Content="{x:Static t:Txt.Discard}" MinWidth="92" Command="{Binding DiscardCommand}" />
                        <Button Style="{StaticResource PrimaryButton}" Content="{x:Static t:Txt.Apply}" MinWidth="92" Margin="8,0,0,0" Command="{Binding ApplyCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </DataTemplate>

    <!-- ===================== Services ===================== -->
    <!-- Text filter of the Services page (FilterText property). -->
    <DataTemplate x:Key="PageSearchFilter">
        <Grid Width="220">
            <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Delay=150}" Tag="{x:Static t:Txt.FilterServices}"
                     Padding="30,0,8,0" AutomationProperties.Name="{x:Static t:Txt.FilterServices}" />
            <TextBlock Style="{StaticResource Icon}" Text="&#xE71C;" FontSize="12" Margin="10,0,0,0" HorizontalAlignment="Left"
                       Foreground="{StaticResource TextSecondaryBrush}" IsHitTestVisible="False" />
        </Grid>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ServiceDiffRow}">
        <Grid ToolTip="{Binding Reason}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="1.3*" />
                <ColumnDefinition Width="1.6*" />
                <ColumnDefinition Width="1.6*" />
            </Grid.ColumnDefinitions>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Restorable}" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding Restorable}" VerticalAlignment="Center"
                      AutomationProperties.Name="{Binding Name}" />
            <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="{Binding InSnapshot}" TextTrimming="CharacterEllipsis" ToolTip="{Binding InSnapshot}"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
            <TextBlock Grid.Column="3" Text="{Binding Current}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Current}"
                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="SnapshotItem">
        <StackPanel Margin="0,2">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
            <TextBlock Style="{StaticResource Secondary}" FontSize="12" Margin="0,2,0,0">
                <Run Text="{Binding LastWrite, Mode=OneWay, StringFormat=g}" /><Run Text="{Binding Computer, Mode=OneWay, StringFormat=' · {0}'}" />
            </TextBlock>
            <TextBlock Style="{StaticResource Secondary}" FontSize="12">
                <Run Text="{Binding ServiceCount, Mode=OneWay, StringFormat={x:Static t:Txt.ServicesCountFormat}}" />
            </TextBlock>
            <TextBlock Style="{StaticResource Secondary}" FontSize="12" Text="{x:Static t:Txt.FullExport}"
                       Visibility="{Binding HasFullExport, Converter={StaticResource BoolToVis}}" />
            <TextBlock Style="{StaticResource Secondary}" FontSize="12" Text="{Binding Problem}" Foreground="{StaticResource WarningBrush}"
                       Visibility="{Binding Problem, Converter={StaticResource NotEmptyToVis}}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ServicesPageViewModel}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ItemsControl Style="{StaticResource Segmented}" ItemsSource="{Binding Tabs}" Tag="{Binding SelectTabCommand}" HorizontalAlignment="Left"
                          Margin="0,0,0,10" AutomationProperties.Name="{x:Static t:Txt.Tabs}" />

            <!-- Options: services KOS leaves as a choice (catalog page "services") -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                          Visibility="{Binding ShowOptions, Converter={StaticResource BoolToVis}}" v:Motion.Transition="{Binding ShowOptions}">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.ServiceOptionsExplanation}" TextWrapping="Wrap" Margin="2,0,0,10" />
                    <ItemsControl ItemsSource="{Binding Options}" Focusable="False" />
                </StackPanel>
            </ScrollViewer>

            <!-- Snapshots -->
            <Grid Grid.Row="1" Visibility="{Binding ShowSnapshots, Converter={StaticResource BoolToVis}}" v:Motion.Transition="{Binding ShowSnapshots}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.ColumnSpan="2" Margin="0,0,0,10">
                <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.SnapshotsExplanation}" />
                <Border Style="{StaticResource Card}" Margin="0,10,0,0" Visibility="{Binding HasLegacy, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Secondary}" Text="{Binding LegacyText}" VerticalAlignment="Center" Margin="0,0,16,0" />
                        <Button Grid.Column="1" Content="{x:Static t:Txt.MoveLegacy}" Command="{Binding OrganizeCommand}" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- Saved snapshots -->
            <DockPanel Grid.Row="1" Margin="0,0,14,0">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <Button Style="{StaticResource PrimaryButton}" Content="{x:Static t:Txt.CreateSnapshot}" Command="{Binding NewSnapshotCommand}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE838;" Margin="6,0,0,0" Command="{Binding OpenFolderCommand}"
                            ToolTip="{Binding Folder}" AutomationProperties.Name="{x:Static t:Txt.OpenFolder}" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource Secondary}" Text="{x:Static t:Txt.NoSnapshots}" Margin="2,0,0,0"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Background="{StaticResource CardBrush}">
                    <ListBox Style="{StaticResource DataList}" ItemsSource="{Binding Snapshots}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                             ItemTemplate="{StaticResource SnapshotItem}" Padding="4" AutomationProperties.Name="{x:Static t:Txt.SavedSnapshots}" />
                </Border>
            </DockPanel>

            <!-- Differences between the snapshot and the current state -->
            <Grid Grid.Row="1" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel LastChildFill="False" Margin="0,0,0,8">
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource PageSearchFilter}" VerticalAlignment="Center" />
                    <Button Content="{x:Static t:Txt.CheckAll}" Margin="8,0,0,0" Command="{Binding CheckAllCommand}" />
                    <Button Content="{x:Static t:Txt.UncheckAll}" Margin="8,0,0,0" Command="{Binding UncheckAllCommand}" />
                    <Button Content="{x:Static t:Txt.ExportCsv}" Margin="8,0,0,0" Command="{Binding ExportCommand}" />
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Secondary}" Text="{Binding Stats}" VerticalAlignment="Center" />
                </DockPanel>
                <Grid Grid.Row="1" Margin="10,2,20,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="1.3*" />
                        <ColumnDefinition Width="1.6*" />
                        <ColumnDefinition Width="1.6*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource SectionTitle}" FontSize="12" Text="{x:Static t:Txt.Restore}" />
                    <TextBlock Grid.Column="1" Style="{StaticResource SectionTitle}" FontSize="12" Text="{x:Static t:Txt.ColService}" />
                    <TextBlock Grid.Column="2" Style="{StaticResource SectionTitle}" FontSize="12" Text="{x:Static t:Txt.ColInSnapshot}" />
                    <TextBlock Grid.Column="3" Style="{StaticResource SectionTitle}" FontSize="12" Text="{x:Static t:Txt.ColCurrent}" />
                </Grid>
                <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                    <Grid>
                        <ListBox Style="{StaticResource DataList}" ItemsSource="{Binding View}" AutomationProperties.Name="{x:Static t:Txt.Differences}" />
                        <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.NoDifferences}" Margin="10,12,0,0"
                                   Visibility="{Binding NoDifferences, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Style="{StaticResource Secondary}" Text="{Binding LoadError}" Foreground="{StaticResource ErrorBrush}" Margin="10,12,0,0"
                                   Visibility="{Binding HasLoadError, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource Card}" Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.RestoreNote}" />
                        <ProgressBar Value="{Binding Progress, Mode=OneWay}" Maximum="100" Margin="0,8,0,0"
                                     Visibility="{Binding HasProgress, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Style="{StaticResource PageMessage}" Margin="0,6,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="{x:Static t:Txt.RestoreChecked}" VerticalAlignment="Center"
                            Command="{Binding RestoreCommand}" />
                </Grid>
            </Border>
            </Grid>
        </Grid>
    </DataTemplate>

    <!-- ===================== Tools ===================== -->
    <DataTemplate DataType="{x:Type vm:ToolProgramViewModel}">
        <Border Style="{StaticResource Card}" Width="340" Margin="0,0,8,8" Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Source="{Binding Icon}" Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Style="{StaticResource CardTitle}" FontSize="13.5" Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                               ToolTip="{Binding Path}" />
                    <TextBlock Style="{StaticResource Secondary}" FontSize="12" Text="{Binding Description}" MaxHeight="34" TextTrimming="CharacterEllipsis"
                               Margin="0,2,0,0" Visibility="{Binding Description, Converter={StaticResource NotEmptyToVis}}" />
                    <TextBlock Style="{StaticResource Secondary}" FontSize="12" Text="{Binding Problem}" Foreground="{StaticResource WarningBrush}" Margin="0,2,0,0"
                               Visibility="{Binding HasProblem, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <Button Grid.Column="2" Content="{x:Static t:Txt.Open}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}"
                        Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ToolsPageViewModel}">
        <StackPanel>
            <ItemsControl Style="{StaticResource Segmented}" ItemsSource="{Binding Tabs}" Tag="{Binding SelectTabCommand}" HorizontalAlignment="Left"
                          Margin="0,0,0,12" AutomationProperties.Name="{x:Static t:Txt.Tabs}" />

            <StackPanel Visibility="{Binding ShowPrograms, Converter={StaticResource BoolToVis}}" v:Motion.Transition="{Binding ShowPrograms}">
                <DockPanel LastChildFill="False" Margin="0,0,0,8">
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource PageSearch}" VerticalAlignment="Center" />
                    <Button Content="{x:Static t:Txt.Refresh}" Margin="8,0,0,0" Command="{Binding RescanCommand}" />
                    <Button Content="{x:Static t:Txt.OpenFolder}" Margin="8,0,0,0" Command="{Binding OpenFolderCommand}" />
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Secondary}" Text="{Binding CountText}" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Style="{StaticResource Secondary}" Text="{Binding Folder, StringFormat={x:Static t:Txt.ToolsFolderFormat}}" Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource Secondary}" Margin="0,0,0,4" TextWrapping="Wrap">
                    <Run Text="More tools to download, such as CapFrameX, NVIDIA FrameView and MSI Afterburner, are in" />
                    <Hyperlink Command="{Binding OpenSetupCommand}" Foreground="{StaticResource TextBrush}">Install › Tools</Hyperlink><Run Text="." />
                </TextBlock>
                <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.ToolsElevatedNote}" Foreground="{StaticResource WarningBrush}" Margin="0,0,0,4"
                           Visibility="{Binding ShowElevatedNote, Converter={StaticResource BoolToVis}}" />
                <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.ReadingToolsFolder}" Margin="0,6,0,0"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
                <TextBlock Style="{StaticResource Secondary}" Text="{Binding Error}" Foreground="{StaticResource ErrorBrush}" Margin="0,6,0,0"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                <TextBlock Style="{StaticResource Secondary}" Text="{Binding EmptyText}" Margin="0,6,0,0"
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
                <ItemsControl ItemsSource="{Binding Programs}" Focusable="False" Margin="0,8,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Maintenance}" Focusable="False" v:Motion.Transition="{Binding ShowMaintenance}"
                          Visibility="{Binding ShowMaintenance, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
    </DataTemplate>

    <!-- ===================== Devices ===================== -->
    <!-- Label above an editor field. -->
    <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <DataTemplate DataType="{x:Type vm:IrqRowViewModel}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*" />
                <ColumnDefinition Width="0.9*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="0.5*" />
                <ColumnDefinition Width="0.5*" />
                <ColumnDefinition Width="0.7*" />
                <ColumnDefinition Width="1.5*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Device.InstanceId}" Margin="0,0,10,0" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding Class}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="{Binding Support}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
            <TextBlock Grid.Column="3" Text="{Binding Msi}" Margin="0,0,10,0" VerticalAlignment="Center" />
            <TextBlock Grid.Column="4" Text="{Binding Limit}" Margin="0,0,10,0" VerticalAlignment="Center" />
            <TextBlock Grid.Column="5" Text="{Binding Priority}" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" VerticalAlignment="Center" />
            <TextBlock Grid.Column="6" Text="{Binding Policy}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Policy}" Margin="0,0,10,0" VerticalAlignment="Center" />
            <TextBlock Grid.Column="7" Text="{Binding InEffect}" TextTrimming="CharacterEllipsis" ToolTip="{Binding InEffect}" VerticalAlignment="Center" />
        </Grid>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:GhostRowViewModel}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="2.4*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="3*" />
            </Grid.ColumnDefinitions>
            <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}" />
            <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" Margin="0,0,10,0" VerticalAlignment="Center" />
            <TextBlock Grid.Column="2" Text="{Binding LastSeen}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
            <TextBlock Grid.Column="3" Text="{Binding InstanceId}" TextTrimming="CharacterEllipsis" ToolTip="{Binding InstanceId}"
                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
        </Grid>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:DevicesPageViewModel}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <DockPanel LastChildFill="False" Margin="0,0,0,10">
                <ItemsControl Style="{StaticResource Segmented}" ItemsSource="{Binding Tabs}" Tag="{Binding SelectTabCommand}" VerticalAlignment="Center" Margin="0,0,10,0"
                              AutomationProperties.Name="{x:Static t:Txt.Tabs}" Visibility="{Binding HasTabs, Converter={StaticResource BoolToVis}}" />
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource PageSearch}" VerticalAlignment="Center" />
                <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.Reading}" Margin="10,0,0,0" VerticalAlignment="Center"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
            </DockPanel>

            <!-- Interrupts of the connected PCI devices -->
            <Grid Grid.Row="1" Visibility="{Binding ShowIrq, Converter={StaticResource BoolToVis}}" v:Motion.Transition="{Binding ShowIrq}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,6">
                    <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.IrqNote}" />
                    <DockPanel LastChildFill="False" Margin="0,8,0,0">
                        <CheckBox Content="{x:Static t:Txt.MsiOnlyFilter}" IsChecked="{Binding MsiOnly}" VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right" Content="{x:Static t:Txt.EnableMsiAll}" ToolTip="{x:Static t:Txt.EnableMsiAllTooltip}" Command="{Binding EnableMsiAllCommand}" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Secondary}" Text="{Binding LoadError}" Foreground="{StaticResource ErrorBrush}" Margin="0,6,0,0"
                               Visibility="{Binding LoadError, Converter={StaticResource NotEmptyToVis}}" />
                    <TextBlock Style="{StaticResource PageMessage}" Margin="0,6,0,0" />
                </StackPanel>

                <!-- Advice (read only) and the suggested layout -->
                <Grid Grid.Row="1" Margin="0,4,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource CardTitle}" Text="{x:Static t:Txt.AdviceTitle}" Margin="0,0,0,6" />
                            <ScrollViewer MaxHeight="112" VerticalAlignment="Top" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Advice}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Style="{StaticResource Secondary}" Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" Margin="0,0,0,4" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,6">
                                <TextBlock Style="{StaticResource CardTitle}" Text="{x:Static t:Txt.LayoutTitle}" VerticalAlignment="Center" />
                                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="{x:Static t:Txt.ApplyLayout}" ToolTip="{x:Static t:Txt.LayoutNote}"
                                        Command="{Binding ApplyLayoutCommand}" />
                            </DockPanel>
                            <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Secondary}" Text="{x:Static t:Txt.LayoutShortNote}" ToolTip="{x:Static t:Txt.LayoutNote}"
                                       TextTrimming="CharacterEllipsis" FontSize="11.5" Margin="0,6,0,0" />
                            <ScrollViewer MaxHeight="112" VerticalAlignment="Top" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding LayoutRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}" Margin="0,0,0,2" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="2" Margin="10,4,20,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.2*" />
                        <ColumnDefinition Width="0.9*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="0.5*" />
                        <ColumnDefinition Width="0.5*" />
                        <ColumnDefinition Width="0.7*" />
                        <ColumnDefinition Width="1.5*" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource SectionTitle}" FontSize="12" Text="{x:Static t:Txt.ColDevice}" />
                    <TextBlock Grid.Column="1" Style="{StaticResource SectionTitle}" FontSize="12" Text="{x:Static t:Txt.ColClass}" />
                    <TextBlock Grid.Column="2" Style="{StaticResource SectionTitle}" FontSize="12" Text="{x:Static t:Txt.ColSupport}" />
                    <TextBlock Grid.Column="3" Style="{StaticResource SectionTitle}" FontSize="12" Text="{x:Static t:Txt.ColMsi}" />
                    <TextBlock Grid.Column="4" Style="{StaticResource SectionTitle}" FontSize="12" Text="{x:Static t:Txt.ColLimit}" />
                    <TextBlock Grid.Column="5" Style="{StaticResource SectionTitle}" FontSize="12" Text="{x:Static t:Txt.ColPriority}" />
                    <TextBlock Grid.Column="6" Style="{StaticResource SectionTitle}" FontSize="12" Text="{x:Static t:Txt.ColPolicy}" />
                    <TextBlock Grid.Column="7" Style="{StaticResource SectionTitle}" FontSize="12" Text="{x:Static t:Txt.ColInEffect}" />
                </Grid>
                <Border Grid.Row="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                    <ListBox Style="{StaticResource DataList}" ItemsSource="{Binding IrqView}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                             SelectionMode="Single" AutomationProperties.Name="{x:Static t:Txt.TabInterrupts}" />
                </Border>

                <!-- Editor for the selected device: nothing is written before Apply. -->
                <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,10,0,0"
                        Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}" v:Motion.Transition="{Binding Selected}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{x:Static t:Txt.RestartDevice}" ToolTip="{x:Static t:Txt.RestartDeviceTooltip}" Command="{Binding RestartDeviceCommand}"
                                    VerticalAlignment="Top" Margin="10,0,0,0" />
                            <TextBlock Style="{StaticResource CardTitle}" Text="{Binding SelectedName}" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBox Style="{StaticResource ReadOnlyText}" Text="{Binding SelectedDetail, Mode=OneWay}" FontSize="12" Margin="0,4,0,10" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="10" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static t:Txt.LabelMsi}" />
                                <ComboBox ItemsSource="{Binding MsiOptions}" ItemTemplate="{StaticResource OptionText}" SelectedItem="{Binding EditMsi, Mode=TwoWay}"
                                          AutomationProperties.Name="{x:Static t:Txt.LabelMsi}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static t:Txt.LabelLimit}" />
                                <TextBox Text="{Binding EditLimit, UpdateSourceTrigger=PropertyChanged}" Tag="{x:Static t:Txt.LimitHint}"
                                         AutomationProperties.Name="{x:Static t:Txt.LabelLimit}" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static t:Txt.LabelPriority}" />
                                <ComboBox ItemsSource="{Binding PriorityOptions}" ItemTemplate="{StaticResource OptionText}" SelectedItem="{Binding EditPriority, Mode=TwoWay}"
                                          AutomationProperties.Name="{x:Static t:Txt.LabelPriority}" />
                            </StackPanel>
                            <StackPanel Grid.Row="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static t:Txt.LabelPolicy}" />
                                <ComboBox ItemsSource="{Binding PolicyOptions}" ItemTemplate="{StaticResource OptionText}" SelectedItem="{Binding EditPolicy, Mode=TwoWay}"
                                          AutomationProperties.Name="{x:Static t:Txt.LabelPolicy}" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{x:Static t:Txt.LabelCpus}" />
                                <TextBox Text="{Binding EditCpus, UpdateSourceTrigger=PropertyChanged}" Tag="{x:Static t:Txt.CpusHint}"
                                         IsEnabled="{Binding CpusEnabled}" AutomationProperties.Name="{x:Static t:Txt.LabelCpus}" />
                                <TextBlock Style="{StaticResource Secondary}" Text="{Binding CpuInfo}" FontSize="11.5" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                <Button Content="{x:Static t:Txt.RestoreOriginal}" ToolTip="{x:Static t:Txt.RestoreOriginalTooltip}" Command="{Binding RestoreCommand}" />
                                <Button Style="{StaticResource PrimaryButton}" Content="{x:Static t:Txt.Apply}" MinWidth="92" Margin="8,0,0,0" Command="{Binding ApplyCommand}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Ghost devices -->
            <Grid Grid.Row="1" Visibility="{Binding ShowGhosts, Converter={StaticResource BoolToVis}}" v:Motion.Transition="{Binding ShowGhosts}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,8">
                    <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.GhostNote}" />
                    <TextBlock Style="{StaticResource Secondary}" Text="{Binding LoadError}" Foreground="{StaticResource ErrorBrush}" Margin="0,6,0,0"
                               Visibility="{Binding LoadError, Converter={StaticResource NotEmptyToVis}}" />
                    <TextBlock Style="{StaticResource PageMessage}" Margin="0,6,0,0" />
                </StackPanel>
                <DockPanel Grid.Row="1" LastChildFill="False" Margin="0,0,0,8">
                    <Button Content="{x:Static t:Txt.CheckAll}" Command="{Binding CheckAllCommand}" />
                    <Button Content="{x:Static t:Txt.UncheckAll}" Margin="8,0,0,0" Command="{Binding UncheckAllCommand}" />
                    <Button Style="{StaticResource PrimaryButton}" Content="{x:Static t:Txt.RemoveChecked}" Margin="8,0,0,0" Command="{Binding RemoveCommand}" />
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Secondary}" Text="{Binding GhostCount}" VerticalAlignment="Center" />
                </DockPanel>
                <Grid Grid.Row="2" Margin="10,4,20,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="2.4*" />
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Style="{StaticResource SectionTitle}" FontSize="12" Text="{x:Static t:Txt.ColDevice}" />
                    <TextBlock Grid.Column="2" Style="{StaticResource SectionTitle}" FontSize="12" Text="{x:Static t:Txt.ColLastSeen}" />
                    <TextBlock Grid.Column="3" Style="{StaticResource SectionTitle}" FontSize="12" Text="{x:Static t:Txt.ColInstanceId}" />
                </Grid>
                <Border Grid.Row="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                    <ListBox Style="{StaticResource DataList}" ItemsSource="{Binding GhostView}" SelectionMode="Single"
                             AutomationProperties.Name="{x:Static t:Txt.TabGhostDevices}">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource SectionTitle}" Margin="4,12,0,4">
                                            <Run Text="{Binding Name, Mode=OneWay}" /><Run Text="{Binding ItemCount, Mode=OneWay, StringFormat=' ({0})'}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                    </ListBox>
                </Border>
            </Grid>
        </Grid>
    </DataTemplate>

    <!-- ===================== Latency ===================== -->
    <Style x:Key="LatencyCell" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="LatencyHead" TargetType="TextBlock" BasedOn="{StaticResource SectionTitle}">
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Column titles of the driver and processor tables; the first title is the content. The driver table's last column (LatencyHeaderDrivers)
         says which processors a driver ran on; the processor table keeps the column empty so both line up. -->
    <DataTemplate x:Key="LatencyHeaderDrivers">
        <Grid Margin="10,4,20,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*" />
                <ColumnDefinition Width="0.9*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="0.9*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1.7*" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource LatencyHead}" Text="{Binding}" />
            <TextBlock Grid.Column="1" Style="{StaticResource LatencyHead}" Text="{x:Static t:Txt.ColIsrs}" />
            <TextBlock Grid.Column="2" Style="{StaticResource LatencyHead}" Text="{x:Static t:Txt.ColIsrMax}" />
            <TextBlock Grid.Column="3" Style="{StaticResource LatencyHead}" Text="{x:Static t:Txt.ColIsrTotal}" />
            <TextBlock Grid.Column="4" Style="{StaticResource LatencyHead}" Text="{x:Static t:Txt.ColDpcs}" />
            <TextBlock Grid.Column="5" Style="{StaticResource LatencyHead}" Text="{x:Static t:Txt.ColDpcMax}" />
            <TextBlock Grid.Column="6" Style="{StaticResource LatencyHead}" Text="{x:Static t:Txt.ColDpcTotal}" />
            <TextBlock Grid.Column="7" Style="{StaticResource LatencyHead}" Text="{x:Static t:Txt.ColRunsOn}" />
        </Grid>
    </DataTemplate>
    <DataTemplate x:Key="LatencyHeader">
        <Grid Margin="10,4,20,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*" />
                <ColumnDefinition Width="0.9*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="0.9*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1.7*" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource LatencyHead}" Text="{Binding}" />
            <TextBlock Grid.Column="1" Style="{StaticResource LatencyHead}" Text="{x:Static t:Txt.ColIsrs}" />
            <TextBlock Grid.Column="2" Style="{StaticResource LatencyHead}" Text="{x:Static t:Txt.ColIsrMax}" />
            <TextBlock Grid.Column="3" Style="{StaticResource LatencyHead}" Text="{x:Static t:Txt.ColIsrTotal}" />
            <TextBlock Grid.Column="4" Style="{StaticResource LatencyHead}" Text="{x:Static t:Txt.ColDpcs}" />
            <TextBlock Grid.Column="5" Style="{StaticResource LatencyHead}" Text="{x:Static t:Txt.ColDpcMax}" />
            <TextBlock Grid.Column="6" Style="{StaticResource LatencyHead}" Text="{x:Static t:Txt.ColDpcTotal}" />
        </Grid>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:LatencyRowViewModel}">
        <Grid Margin="10,3,20,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*" />
                <ColumnDefinition Width="0.9*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="0.9*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1.7*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource LatencyCell}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSlow}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Grid.Column="1" Style="{StaticResource LatencyCell}" Text="{Binding Isrs}" Foreground="{StaticResource TextSecondaryBrush}" />
            <TextBlock Grid.Column="2" Style="{StaticResource LatencyCell}" Text="{Binding IsrMax}" />
            <TextBlock Grid.Column="3" Style="{StaticResource LatencyCell}" Text="{Binding IsrTotal}" Foreground="{StaticResource TextSecondaryBrush}" />
            <TextBlock Grid.Column="4" Style="{StaticResource LatencyCell}" Text="{Binding Dpcs}" Foreground="{StaticResource TextSecondaryBrush}" />
            <TextBlock Grid.Column="5" Style="{StaticResource LatencyCell}" Text="{Binding DpcMax}" />
            <TextBlock Grid.Column="6" Style="{StaticResource LatencyCell}" Text="{Binding DpcTotal}" Foreground="{StaticResource TextSecondaryBrush}" />
            <TextBlock Grid.Column="7" Style="{StaticResource LatencyCell}" Text="{Binding RunsOn}" ToolTip="{Binding RunsOnTip}" />
        </Grid>
    </DataTemplate>

    <!-- One summary figure: title (with its explanation as tooltip), value and detail. -->
    <Style x:Key="LatencyStat" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <!-- ===================== What's slow (rows are StabilityRow) ===================== -->
    <DataTemplate DataType="{x:Type vm:SlowPageViewModel}">
        <StackPanel>
            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.SlowSampling}" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
                    <ItemsControl ItemsSource="{Binding Verdict}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><TextBlock Style="{StaticResource CardTitle}" Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,4" /></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static t:Txt.SlowNow}" Margin="2,4,0,4" />
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.SlowHungNone}" Margin="10,6,0,2" Visibility="{Binding NoHung, Converter={StaticResource BoolToVis}}" />
                    <ItemsControl ItemsSource="{Binding Hung}" Focusable="False" />
                    <ItemsControl ItemsSource="{Binding Disks}" Focusable="False" />
                    <TextBlock Style="{StaticResource Secondary}" Text="{Binding DisksNote}" TextWrapping="Wrap" Margin="10,2,20,2" Visibility="{Binding DisksNote, Converter={StaticResource NotEmptyToVis}}" />
                    <TextBlock Text="{Binding Memory}" TextWrapping="Wrap" Margin="10,4,20,2" Visibility="{Binding Memory, Converter={StaticResource NotEmptyToVis}}" />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static t:Txt.SlowRecentHangs}" Margin="2,4,0,4" />
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Style="{StaticResource Secondary}" Text="{Binding HangsNote}" TextWrapping="Wrap" Margin="10,6,20,0" Visibility="{Binding HangsNote, Converter={StaticResource NotEmptyToVis}}" />
                    <ItemsControl ItemsSource="{Binding Hangs}" Focusable="False" />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static t:Txt.SlowSinceBoot}" Margin="2,4,0,4" />
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{Binding Boot}" TextWrapping="Wrap" Margin="10,6,20,4" />
                    <ItemsControl ItemsSource="{Binding Startup}" Focusable="False" />
                    <TextBlock Style="{StaticResource Secondary}" Text="{Binding StartupNote}" TextWrapping="Wrap" Margin="10,6,20,0" />
                    <TextBlock Style="{StaticResource Secondary}" Text="{Binding BootLogNote}" TextWrapping="Wrap" Margin="10,4,20,0" Visibility="{Binding BootLogNote, Converter={StaticResource NotEmptyToVis}}" />
                    <ContentControl Content="{Binding Diagnostics}" Focusable="False" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.SlowMore}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <Button Grid.Column="1" Content="{x:Static t:Txt.SlowOpenLatency}" Command="{Binding OpenLatencyCommand}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button Grid.Column="2" Content="{x:Static t:Txt.SlowOpenStability}" Command="{Binding OpenStabilityCommand}" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </StackPanel>
    </DataTemplate>

    <!-- ===================== Stability ===================== -->
    <DataTemplate DataType="{x:Type vm:StabilityRow}">
        <Grid Margin="10,4,20,4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.3*" /><ColumnDefinition Width="2.4*" /><ColumnDefinition Width="5.6*" /></Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource LatencyCell}" Text="{Binding Time}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Top" />
            <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" VerticalAlignment="Top">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Severe}" Value="True"><Setter Property="Foreground" Value="{StaticResource WarningBrush}" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Grid.Column="2" Text="{Binding Detail}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" />
        </Grid>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:WindowsUpdatePageViewModel}">
        <StackPanel>
            <Border Style="{StaticResource Card}" Margin="0,0,0,10" Visibility="{Binding NeedsAdmin, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Secondary}" Text="Searching and installing updates turns Windows Update's services on for a moment, which needs administrator." VerticalAlignment="Center" Margin="0,0,16,0" TextWrapping="Wrap" />
                    <Button Grid.Column="1" Content="{x:Static t:Txt.RestartAsAdmin}" VerticalAlignment="Center" Command="{Binding RestartAsAdminCommand}" />
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Style="{StaticResource Secondary}" TextWrapping="Wrap"
                               Text="Windows Update stays as set in Windows › System › Windows Update. Each button here lets it run for that one operation (its services on manual and the policies that block it removed), then puts every value back and stops the services again. Nothing installs unless you check it." />
                    <WrapPanel Margin="0,12,0,0">
                        <Button Style="{StaticResource PrimaryButton}" Content="Search for updates" Command="{Binding SearchCommand}" Margin="0,0,8,6" />
                        <Button Content="Install selected" Command="{Binding InstallCommand}" Margin="0,0,8,6" />
                        <Button Content="Hide selected" Command="{Binding HideCommand}" ToolTip="Windows Update stops offering them (a mandatory update can't be hidden)" Margin="0,0,8,6" />
                        <Button Content="Show selected again" Command="{Binding ShowCommand}" Margin="0,0,8,6" />
                    </WrapPanel>
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="{Binding Status, Converter={StaticResource NotEmptyToVis}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsError}" Value="True"><Setter Property="Foreground" Value="{StaticResource ErrorBrush}" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ProgressBar IsIndeterminate="True" Height="4" Margin="0,8,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,0,10" Visibility="{Binding SuggestKosState, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Secondary}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0"
                               Text="Updates can put back services, tasks and settings the KOS changed. After restarting, check KOS state and put back what you want." />
                    <Button Grid.Column="1" Content="Open KOS state" VerticalAlignment="Center" Command="{Binding OpenKosStateCommand}" />
                </Grid>
            </Border>
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Visibility="{Binding HasRows, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="10,6,20,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" Margin="0,0,10,0" AutomationProperties.Name="{Binding Title}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource Secondary}" FontSize="12" Text="{Binding Detail}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:StabilityPageViewModel}">
        <StackPanel>
            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Summary}" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.StabilityNote}" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static t:Txt.StabilityEvents}" Margin="2,4,0,4" />
            <Grid Margin="10,4,20,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="1.3*" /><ColumnDefinition Width="2.4*" /><ColumnDefinition Width="5.6*" /></Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource LatencyHead}" Text="{x:Static t:Txt.ColTime}" />
                <TextBlock Grid.Column="1" Style="{StaticResource LatencyHead}" Text="{x:Static t:Txt.ColEvent}" />
                <TextBlock Grid.Column="2" Style="{StaticResource LatencyHead}" Text="{x:Static t:Txt.ColDetails}" />
            </Grid>
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.StabilityNone}" Margin="10,6,0,0" Visibility="{Binding NoEvents, Converter={StaticResource BoolToVis}}" />
                    <ItemsControl ItemsSource="{Binding Events}" Focusable="False" />
                </StackPanel>
            </Border>

            <Grid Margin="2,4,0,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static t:Txt.StabilityDumps}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="{x:Static t:Txt.StabilityOpenDumps}" Command="{Binding OpenDumpsCommand}" />
            </Grid>
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Style="{StaticResource Secondary}" Text="{Binding DumpsNote}" Margin="10,6,0,0" Visibility="{Binding DumpsNote, Converter={StaticResource NotEmptyToVis}}" />
                    <ItemsControl ItemsSource="{Binding Dumps}" Focusable="False" />
                </StackPanel>
            </Border>

            <Grid Margin="2,4,0,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static t:Txt.StabilitySessions}" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding Sessions}" SelectedItem="{Binding SelectedSession, Mode=TwoWay}" MinWidth="320"
                          AutomationProperties.Name="{x:Static t:Txt.StabilitySessions}" Visibility="{Binding HasSessions, Converter={StaticResource BoolToVis}}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.StabilitySessionsNote}" TextWrapping="Wrap" Margin="10,6,20,4" />
                    <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.StabilityNoSessions}" Margin="10,2,0,0"
                               Visibility="{Binding NoSessions, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding SelectedSession.Session.Summary}" TextWrapping="Wrap" FontWeight="SemiBold" Margin="10,6,20,2" />
                    <ItemsControl ItemsSource="{Binding SessionSections}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Style="{StaticResource LatencyHead}" Text="{Binding Title}" Margin="10,0,0,2" />
                                    <ItemsControl ItemsSource="{Binding Lines}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="10,2,20,2">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="7*" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" Foreground="{StaticResource TextSecondaryBrush}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Warning}" Value="True"><Setter Property="Foreground" Value="{StaticResource WarningBrush}" /></DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:LatencyPageViewModel}">
        <StackPanel>
            <ItemsControl ItemsSource="{Binding Tabs}" Focusable="False" Margin="0,0,0,10">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{DynamicResource GpuTabButton}" Command="{Binding DataContext.SelectTabCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding Key}" AutomationProperties.Name="{Binding Label}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ===== Mouse (report rate test, like MouseTester) ===== -->
            <StackPanel Visibility="{Binding IsMouseTab, Converter={StaticResource BoolToVis}}">
                <StackPanel DataContext="{Binding Mouse}">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.MouseNote}" TextWrapping="Wrap" />
                            <WrapPanel Margin="0,12,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Content="{x:Static t:Txt.MouseCollect}" Command="{Binding CollectCommand}" ToolTip="{x:Static t:Txt.MouseCollectTip}" MinWidth="90" Margin="0,0,8,6" />
                                <Button Content="{Binding LogText}" Command="{Binding LogCommand}" ToolTip="{x:Static t:Txt.MouseLogTip}" MinWidth="90" Margin="0,0,8,6" />
                                <Button Content="{x:Static t:Txt.MouseCancel}" Command="{Binding CancelCommand}" Margin="0,0,8,6" />
                                <Border Width="1" Height="22" Background="{StaticResource BorderBrush}" Margin="4,0,12,6" />
                                <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.MouseDistance}" VerticalAlignment="Center" Margin="0,0,6,6" />
                                <TextBox Text="{Binding Distance, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="0,0,8,6" VerticalContentAlignment="Center"
                                         AutomationProperties.Name="{x:Static t:Txt.MouseDistance}" />
                                <Button Content="{x:Static t:Txt.MouseMeasure}" Command="{Binding MeasureCommand}" ToolTip="{x:Static t:Txt.MouseMeasureTip}" Margin="0,0,12,6" />
                                <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.MouseCpi}" VerticalAlignment="Center" Margin="0,0,6,6" />
                                <TextBlock Text="{Binding Cpi}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,6" />
                                <Border Width="1" Height="22" Background="{StaticResource BorderBrush}" Margin="4,0,12,6" />
                                <Button Content="{x:Static t:Txt.MouseSave}" Command="{Binding SaveCommand}" Margin="0,0,8,6" />
                                <Button Content="{x:Static t:Txt.MouseLoad}" Command="{Binding LoadCommand}" Margin="0,0,8,6" />
                            </WrapPanel>
                            <TextBlock Text="{Binding Status}" FontWeight="SemiBold" Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <ComboBox ItemsSource="{Binding Graphs}" SelectedItem="{Binding Graph}" DisplayMemberPath="Label" MinWidth="220" AutomationProperties.Name="{x:Static t:Txt.MouseGraphLabel}" />
                                <ComboBox ItemsSource="{Binding Styles}" SelectedItem="{Binding Style}" DisplayMemberPath="Label" MinWidth="110" Margin="8,0,0,0" AutomationProperties.Name="{x:Static t:Txt.MouseStyleLabel}" />
                                <CheckBox Content="{x:Static t:Txt.MouseHideOutliers}" IsChecked="{Binding HideOutliers}" IsEnabled="{Binding CanHideOutliers}"
                                          ToolTip="{x:Static t:Txt.MouseHideOutliersTip}" VerticalAlignment="Center" Margin="16,0,0,0" />
                                <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.MouseRangeStart}" VerticalAlignment="Center" Margin="16,0,6,0" />
                                <TextBox Text="{Binding RangeStart, UpdateSourceTrigger=LostFocus}" Width="64" VerticalContentAlignment="Center" AutomationProperties.Name="{x:Static t:Txt.MouseRangeStart}" />
                                <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.MouseRangeEnd}" VerticalAlignment="Center" Margin="8,0,6,0" />
                                <TextBox Text="{Binding RangeEnd, UpdateSourceTrigger=LostFocus}" Width="64" VerticalContentAlignment="Center" AutomationProperties.Name="{x:Static t:Txt.MouseRangeEnd}" />
                            </StackPanel>
                            <v:DataPlot Series="{Binding Series}" StyleKind="{Binding PlotStyle}" XTitle="{Binding XTitle}" YTitle="{Binding YTitle}" YMin="{Binding YMin}" YMax="{Binding YMax}" Height="340" />
                            <TextBlock Style="{StaticResource Secondary}" Text="{Binding RangeNote}" Margin="0,6,0,0" Visibility="{Binding RangeNote, Converter={StaticResource NotEmptyToVis}}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="{x:Static t:Txt.MouseStats}" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding Stats}" Grid.IsSharedSizeScope="True" Focusable="False">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" VerticalAlignment="Top" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- ===== Frames (PresentMon capture, saved captures, comparison): FramesTemplates.xaml ===== -->
            <ContentControl Content="{Binding Frames}" Focusable="False" Visibility="{Binding IsFramesTab, Converter={StaticResource BoolToVis}}" />

            <!-- ===== Ping (round trip, jitter and loss) ===== -->
            <StackPanel Visibility="{Binding IsPingTab, Converter={StaticResource BoolToVis}}">
                <StackPanel DataContext="{Binding Ping}">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.PingNote}" TextWrapping="Wrap" />
                            <WrapPanel Margin="0,12,0,0">
                                <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.PingHostLabel}" VerticalAlignment="Center" Margin="0,0,6,6" />
                                <TextBox Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" Tag="1.1.1.1" MinWidth="160" Margin="0,0,6,6" VerticalAlignment="Center"
                                         AutomationProperties.Name="{x:Static t:Txt.PingHostLabel}" IsEnabled="{Binding IsIdle}" />
                                <ComboBox ItemsSource="{Binding Hosts}" SelectedItem="{Binding PickedHost}" DisplayMemberPath="Label" MinWidth="190" Margin="0,0,16,6"
                                          AutomationProperties.Name="Suggested hosts" IsEnabled="{Binding IsIdle}" />
                                <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.PingIntervalLabel}" VerticalAlignment="Center" Margin="0,0,6,6" />
                                <ComboBox ItemsSource="{Binding Intervals}" SelectedItem="{Binding Interval}" DisplayMemberPath="Label" MinWidth="80" Margin="0,0,16,6"
                                          AutomationProperties.Name="{x:Static t:Txt.PingIntervalLabel}" IsEnabled="{Binding IsIdle}" />
                                <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.PingDurationLabel}" VerticalAlignment="Center" Margin="0,0,6,6" />
                                <ComboBox ItemsSource="{Binding Durations}" SelectedItem="{Binding Duration}" DisplayMemberPath="Label" MinWidth="80" Margin="0,0,16,6"
                                          AutomationProperties.Name="{x:Static t:Txt.PingDurationLabel}" IsEnabled="{Binding IsIdle}" />
                                <Button Style="{StaticResource PrimaryButton}" Content="{Binding ToggleText}" Command="{Binding ToggleCommand}" MinWidth="90" Margin="0,0,0,6" />
                            </WrapPanel>
                            <TextBlock Text="{Binding HostError}" Foreground="{StaticResource ErrorBrush}" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding HostError, Converter={StaticResource NotEmptyToVis}}" />
                            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="{Binding Status, Converter={StaticResource NotEmptyToVis}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsError}" Value="True"><Setter Property="Foreground" Value="{StaticResource ErrorBrush}" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <v:DataPlot Series="{Binding Series}" Marks="{Binding Marks}" StyleKind="Lines" XTitle="{x:Static t:Txt.PingGraphX}" YTitle="{x:Static t:Txt.PingGraphY}" Height="280" />
                    </Border>
                    <Border Style="{StaticResource Card}" Visibility="{Binding HasStats, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="{x:Static t:Txt.PingStats}" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding Stats}" Grid.IsSharedSizeScope="True" Focusable="False" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- ===== Timer (Sleep(1) precision) ===== -->
            <StackPanel Visibility="{Binding IsTimerTab, Converter={StaticResource BoolToVis}}">
                <StackPanel DataContext="{Binding Timer}">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.TimerNote}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Resolution}" FontWeight="SemiBold" Margin="0,8,0,0" />
                            <WrapPanel Margin="0,12,0,0">
                                <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.TimerRequestLabel}" VerticalAlignment="Center" Margin="0,0,6,6" />
                                <ComboBox ItemsSource="{Binding Requests}" SelectedItem="{Binding Request}" DisplayMemberPath="Label" MinWidth="200" Margin="0,0,16,6"
                                          AutomationProperties.Name="{x:Static t:Txt.TimerRequestLabel}" />
                                <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.TimerCountLabel}" VerticalAlignment="Center" Margin="0,0,6,6" />
                                <ComboBox ItemsSource="{Binding Counts}" SelectedItem="{Binding Count}" DisplayMemberPath="Label" MinWidth="150" Margin="0,0,16,6"
                                          AutomationProperties.Name="{x:Static t:Txt.TimerCountLabel}" />
                                <Button Style="{StaticResource PrimaryButton}" Content="{x:Static t:Txt.TimerRun}" Command="{Binding RunCommand}" MinWidth="90" Margin="0,0,0,6" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <v:DataPlot Series="{Binding Series}" StyleKind="Dots" XTitle="Call" YTitle="Sleep(1) (ms)" Height="260" />
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="{x:Static t:Txt.TimerRuns}" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding Runs}" Grid.IsSharedSizeScope="True" Focusable="False" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- ===== DPC / ISR (like LatencyMon) ===== -->
            <StackPanel Visibility="{Binding IsDpcTab, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Card}" Margin="0,0,0,10" Visibility="{Binding NeedsAdmin, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.LatencyNeedsAdmin}" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <Button Grid.Column="1" Content="{x:Static t:Txt.RestartAsAdmin}" VerticalAlignment="Center" Command="{Binding RestartAsAdminCommand}" />
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.LatencyNote}" />
                        <TextBlock Text="{Binding Elapsed}" FontWeight="SemiBold" Margin="0,8,0,0"
                                   Visibility="{Binding Elapsed, Converter={StaticResource NotEmptyToVis}}" />
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="{Binding ToggleText}" MinWidth="90" VerticalAlignment="Center"
                            Command="{Binding ToggleCommand}" />
                </Grid>
            </Border>

            <StackPanel Visibility="{Binding HasReport, Converter={StaticResource BoolToVis}}">
                <UniformGrid Columns="4" Margin="0,0,-8,10">
                    <Border Style="{StaticResource LatencyStat}" ToolTip="{x:Static t:Txt.LatencyTimerTip}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.LatencyTimer}" />
                            <TextBlock Text="{Binding TimerValue}" FontSize="20" FontWeight="SemiBold" Margin="0,2,0,0" />
                            <TextBlock Style="{StaticResource Secondary}" Text="{Binding TimerDetail}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource LatencyStat}" ToolTip="{x:Static t:Txt.LatencyDpcTip}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.LatencyDpc}" />
                            <TextBlock Text="{Binding DpcValue}" FontSize="20" FontWeight="SemiBold" Margin="0,2,0,0" />
                            <TextBlock Style="{StaticResource Secondary}" Text="{Binding DpcDetail}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource LatencyStat}" ToolTip="{x:Static t:Txt.LatencyIsrTip}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.LatencyIsr}" />
                            <TextBlock Text="{Binding IsrValue}" FontSize="20" FontWeight="SemiBold" Margin="0,2,0,0" />
                            <TextBlock Style="{StaticResource Secondary}" Text="{Binding IsrDetail}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource LatencyStat}" ToolTip="{x:Static t:Txt.LatencyFaultsTip}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.LatencyFaults}" />
                            <TextBlock Text="{Binding FaultsValue}" FontSize="20" FontWeight="SemiBold" Margin="0,2,0,0" />
                            <TextBlock Style="{StaticResource Secondary}" Text="{Binding FaultsDetail}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <TextBlock Text="{Binding Verdict}" TextWrapping="Wrap" Margin="2,0,0,10">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding VerdictIsWarning}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Style="{StaticResource Secondary}" Text="{Binding NoDriverNames}" Margin="2,0,0,10"
                           Visibility="{Binding NoDriverNames, Converter={StaticResource NotEmptyToVis}}" />

                <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static t:Txt.LatencyDrivers}" Margin="2,4,0,4" />
                <ContentPresenter Content="{x:Static t:Txt.ColDriver}" ContentTemplate="{StaticResource LatencyHeaderDrivers}" />
                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,14">
                    <ItemsControl ItemsSource="{Binding Drivers}" Focusable="False" />
                </Border>

                <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static t:Txt.LatencyCpus}" Margin="2,4,0,4" />
                <ContentPresenter Content="{x:Static t:Txt.ColProcessor}" ContentTemplate="{StaticResource LatencyHeader}" />
                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,14">
                    <ItemsControl ItemsSource="{Binding Cpus}" Focusable="False" />
                </Border>

                <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static t:Txt.LatencyProcesses}" Margin="2,4,0,4" />
                <Grid Margin="10,4,20,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.2*" />
                        <ColumnDefinition Width="5.8*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource LatencyHead}" Text="{x:Static t:Txt.ColProcess}" />
                    <TextBlock Grid.Column="1" Style="{StaticResource LatencyHead}" Text="{x:Static t:Txt.ColHardFaults}" />
                </Grid>
                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.LatencyNoFaults}" Margin="10,6,0,0"
                                   Visibility="{Binding NoFaults, Converter={StaticResource BoolToVis}}" />
                        <ItemsControl ItemsSource="{Binding Faults}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="10,3,20,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2.2*" />
                                            <ColumnDefinition Width="5.8*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource LatencyCell}" Text="{Binding Process}" ToolTip="{Binding Process}" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource LatencyCell}" Text="{Binding Count, StringFormat={}{0:N0}}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
            </StackPanel>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
