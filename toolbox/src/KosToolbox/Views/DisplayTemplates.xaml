<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:KosToolbox.ViewModels"
                    xmlns:v="clr-namespace:KosToolbox.Views"
                    xmlns:t="clr-namespace:KosToolbox.Core.Text;assembly=KosToolbox.Core">

    <!-- ===================== Display (GPU page tab) ===================== -->
    <Style x:Key="DisplayLabel" TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
    <Style x:Key="DisplayValue" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="DisplayCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Margin" Value="0,0,0,14" />
    </Style>
    <Style x:Key="DisplaySection" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,4,0,10" />
    </Style>
    <Style x:Key="DisplayHeader" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="DisplayRow" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="MinHeight" Value="48" />
    </Style>
    <Style x:Key="DisplayRowCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="Width" Value="280" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="DisplayMemberPath" Value="Label" />
        <Setter Property="SelectedValuePath" Value="Value" />
    </Style>
    <!-- Move up/down next to the list buttons. -->
    <Style x:Key="ArrowButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="11,0" />
    </Style>
    <!-- Two-column grid of checkboxes in the data block editors. -->
    <ItemsPanelTemplate x:Key="TwoColumns"><UniformGrid Columns="2" /></ItemsPanelTemplate>
    <DataTemplate x:Key="BitCheck"><CheckBox Content="{Binding Label}" IsChecked="{Binding IsOn}" Margin="0,0,12,8" /></DataTemplate>
    <Style x:Key="EditorSection" TargetType="Border">
        <Setter Property="Background" Value="#111111" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="12,8,12,10" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style x:Key="EditorSectionTitle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <!-- Button with icon and text (Add / Edit / Delete). -->
    <Style x:Key="IconTextButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"
                                   Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" />
                        <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Dark resolution list: the selected one gets a background and a blue stripe. -->
    <Style x:Key="TimingList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Bg" Background="Transparent" CornerRadius="4" Padding="12,7" Margin="0,1">
                                    <Grid>
                                        <Border x:Name="Bar" Width="3" CornerRadius="1.5" Background="#4DA3FF" HorizontalAlignment="Left" Margin="-12,1,0,1" Visibility="Collapsed" />
                                        <ContentPresenter />
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#141414" /></Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bg" Property="Background" Value="#1A1A1A" />
                                        <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate DataType="{x:Type vm:DisplayPageViewModel}">
        <StackPanel>
            <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.NoMonitors}" Margin="2,0,0,10"
                       Visibility="{Binding HasMonitors, Converter={StaticResource InverseBoolToVis}}" />
            <TextBlock Style="{StaticResource Secondary}" Text="{Binding LoadError}" Foreground="{StaticResource ErrorBrush}" Margin="2,0,0,10"
                       Visibility="{Binding LoadError, Converter={StaticResource NotEmptyToVis}}" />

            <!-- ===== EDID: pending until Save; the driver uses it after a restart ===== -->
            <Grid Visibility="{Binding HasEdid, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

                <!-- Monitor -->
                <Border Style="{StaticResource DisplayCard}">
                    <StackPanel>
                        <StackPanel Style="{StaticResource DisplayHeader}" Margin="0,0,0,12">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7F4;" FontSize="17" Margin="0,0,10,0" />
                            <TextBlock Style="{StaticResource CardTitle}" FontSize="15" Text="{Binding MonitorName}" VerticalAlignment="Center" />
                            <Border Background="#1E4E8C" CornerRadius="9" Padding="8,1" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Active" FontSize="11" Foreground="#CFE3FF" />
                            </Border>
                            <Border Background="#3A3220" CornerRadius="9" Padding="8,1" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="{Binding HasOverride, Converter={StaticResource BoolToVis}}"
                                    ToolTip="{Binding SourceText}">
                                <TextBlock Text="{x:Static t:Txt.OverridePill}" FontSize="11" Foreground="{StaticResource WarningBrush}" />
                            </Border>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource DisplayLabel}" Text="Product ID" />
                                <TextBlock Style="{StaticResource DisplayValue}" Text="{Binding ProductId}" />
                                <TextBlock Style="{StaticResource DisplayLabel}" Text="Extension Blocks" />
                                <TextBlock Style="{StaticResource DisplayValue}" Text="{Binding ExtensionBlocks}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource DisplayLabel}" Text="Native Resolution" />
                                <TextBlock Style="{StaticResource DisplayValue}" Text="{Binding NativeResolution}" />
                                <TextBlock Style="{StaticResource DisplayLabel}" Text="Device Name" />
                                <TextBlock Style="{StaticResource DisplayValue}" Text="{Binding DeviceName}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource DisplayLabel}" Text="Registry Key" />
                        <TextBlock Style="{StaticResource DisplayValue}" Text="{Binding RegistryKey}" Margin="0" />
                    </StackPanel>
                </Border>

                <!-- HDMI audio -->
                <Border Grid.Column="2" Style="{StaticResource DisplayCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <StackPanel Style="{StaticResource DisplayHeader}">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE767;" FontSize="16" Margin="0,0,10,0" />
                                <TextBlock Style="{StaticResource CardTitle}" FontSize="15" Text="{x:Static t:Txt.HdmiAudio}" VerticalAlignment="Center" />
                            </StackPanel>
                            <CheckBox Style="{StaticResource GpuOnOff}" HorizontalAlignment="Right" IsChecked="{Binding AudioEnabled}" IsEnabled="{Binding HasCta}" AutomationProperties.Name="{x:Static t:Txt.HdmiAudio}" />
                        </Grid>
                        <TextBlock Style="{StaticResource DisplayLabel}" Text="Optional bitstream formats" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding AudioFormats}" IsEnabled="{Binding HasCta}" Focusable="False">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><CheckBox Content="{Binding Label}" IsChecked="{Binding IsOn}" Margin="0,0,0,10" /></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Secondary}" FontSize="11.5" Text="{Binding AudioStatus}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Refresh rate range (VRR) -->
                <Border Grid.Row="1" Style="{StaticResource DisplayCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <StackPanel Style="{StaticResource DisplayHeader}">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE9E9;" FontSize="16" Margin="0,0,10,0" />
                                <TextBlock Style="{StaticResource CardTitle}" FontSize="15" Text="Refresh Rate Range (VRR / FreeSync)" VerticalAlignment="Center" />
                            </StackPanel>
                            <CheckBox Style="{StaticResource GpuOnOff}" HorizontalAlignment="Right" IsChecked="{Binding RangeEnabled}" AutomationProperties.Name="Refresh rate range" />
                        </Grid>
                        <Grid IsEnabled="{Binding RangeEnabled}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource DisplayLabel}" Text="Min (Hz)" />
                                <TextBox Text="{Binding MinHz, UpdateSourceTrigger=PropertyChanged}" v:Spin.Step="1" ToolTip="↑/↓ or mouse wheel" AutomationProperties.Name="Minimum refresh rate" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource DisplayLabel}" Text="Max (Hz)" />
                                <TextBox Text="{Binding MaxHz, UpdateSourceTrigger=PropertyChanged}" v:Spin.Step="1" ToolTip="↑/↓ or mouse wheel" AutomationProperties.Name="Maximum refresh rate" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource DisplayLabel}" Text="Max pixel clock (MHz)" Margin="0,10,0,2" />
                        <TextBox Text="{Binding MaxPixelClock, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding RangeEnabled}" v:Spin.Step="10" ToolTip="↑/↓ or mouse wheel" AutomationProperties.Name="Maximum pixel clock" />
                        <TextBlock Style="{StaticResource Secondary}" FontSize="11.5" Text="{Binding RangeNote}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Established resolutions (CRU's left column) -->
                <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource DisplayCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <StackPanel Style="{StaticResource DisplayHeader}">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8A9;" FontSize="16" Margin="0,0,10,0" />
                                <TextBlock Style="{StaticResource CardTitle}" FontSize="15" Text="Established Resolutions" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="All" Command="{Binding AllEstablishedCommand}" />
                                <Button Content="None" Command="{Binding NoEstablishedCommand}" Margin="6,0,0,0" />
                            </StackPanel>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Established}" Focusable="False">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,10,10">
                                        <TextBlock Style="{StaticResource DisplayLabel}" Text="{Binding Title}" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate><CheckBox Content="{Binding Label}" IsChecked="{Binding IsOn}" Margin="0,0,0,4" /></DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Secondary}" FontSize="11.5" TextWrapping="Wrap"
                                   Text="Old VESA modes the display says it supports. Unchecking hides them from Windows' resolution list." />
                    </StackPanel>
                </Border>

                <!-- Detailed resolutions (base block) -->
                <Border Grid.Row="2" Style="{StaticResource DisplayCard}">
                    <StackPanel>
                        <StackPanel Style="{StaticResource DisplayHeader}" Margin="0,0,0,8">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE7B3;" FontSize="16" Margin="0,0,10,0" />
                            <TextBlock Style="{StaticResource CardTitle}" FontSize="15" Text="{Binding DetailedSlotsText}" VerticalAlignment="Center" />
                        </StackPanel>
                        <ListBox Style="{StaticResource TimingList}" ItemsSource="{Binding Detailed}" SelectedItem="{Binding SelectedDetailed, Mode=TwoWay}" MinHeight="40" MaxHeight="190"
                                 AutomationProperties.Name="Detailed resolutions">
                            <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" /></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Style="{StaticResource IconTextButton}" Tag="&#xE710;" Content="Add" Command="{Binding AddDetailedCommand}" Margin="0,0,6,6" />
                            <Button Style="{StaticResource IconTextButton}" Tag="&#xE70F;" Content="Edit" Command="{Binding EditDetailedCommand}" Margin="0,0,6,6" />
                            <Button Style="{StaticResource IconTextButton}" Tag="&#xE74D;" Content="Delete" Command="{Binding DeleteDetailedCommand}" Margin="0,0,6,6" />
                            <Button Style="{StaticResource ArrowButton}" Content="&#xE70E;" Command="{Binding DetailedUpCommand}" ToolTip="Move up" Margin="0,0,6,6" />
                            <Button Style="{StaticResource ArrowButton}" Content="&#xE70D;" Command="{Binding DetailedDownCommand}" ToolTip="Move down" Margin="0,0,0,6" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Secondary}" FontSize="11.5" TextWrapping="Wrap"
                                   Text="The base block's four descriptors. The first is the preferred (native) resolution; use Preferred in a resolution's editor to change it." />
                    </StackPanel>
                </Border>

                <!-- Standard resolutions -->
                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource DisplayCard}">
                    <StackPanel>
                        <StackPanel Style="{StaticResource DisplayHeader}" Margin="0,0,0,8">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE8B3;" FontSize="16" Margin="0,0,10,0" />
                            <TextBlock Style="{StaticResource CardTitle}" FontSize="15" Text="{Binding StandardSlotsText}" VerticalAlignment="Center" />
                        </StackPanel>
                        <ListBox Style="{StaticResource TimingList}" ItemsSource="{Binding Standard}" SelectedItem="{Binding SelectedStandard, Mode=TwoWay}" MinHeight="40" MaxHeight="190"
                                 AutomationProperties.Name="Standard resolutions">
                            <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" /></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Style="{StaticResource IconTextButton}" Tag="&#xE710;" Content="Add" Command="{Binding AddStandardCommand}" Margin="0,0,6,6" />
                            <Button Style="{StaticResource IconTextButton}" Tag="&#xE70F;" Content="Edit" Command="{Binding EditStandardCommand}" Margin="0,0,6,6" />
                            <Button Style="{StaticResource IconTextButton}" Tag="&#xE74D;" Content="Delete" Command="{Binding DeleteStandardCommand}" Margin="0,0,6,6" />
                            <Button Content="Delete all" Command="{Binding ClearStandardCommand}" Margin="0,0,6,6" />
                            <Button Style="{StaticResource ArrowButton}" Content="&#xE70E;" Command="{Binding StandardUpCommand}" ToolTip="Move up" Margin="0,0,6,6" />
                            <Button Style="{StaticResource ArrowButton}" Content="&#xE70D;" Command="{Binding StandardDownCommand}" ToolTip="Move down" Margin="0,0,0,6" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Extension blocks -->
                <Border Grid.Row="3" Grid.ColumnSpan="3" Style="{StaticResource DisplayCard}">
                    <StackPanel>
                        <StackPanel Style="{StaticResource DisplayHeader}" Margin="0,0,0,8">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE71D;" FontSize="16" Margin="0,0,10,0" />
                            <TextBlock Style="{StaticResource CardTitle}" FontSize="15" Text="{Binding ExtensionSlotsText}" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Secondary}" Text="{Binding NoCtaText}" Foreground="{StaticResource WarningBrush}" Margin="0,0,0,6"
                                   Visibility="{Binding NoCtaText, Converter={StaticResource NotEmptyToVis}}" />
                        <ListBox Style="{StaticResource TimingList}" ItemsSource="{Binding Extensions}" SelectedItem="{Binding SelectedExtension, Mode=TwoWay}" MinHeight="40" MaxHeight="150"
                                 AutomationProperties.Name="Extension blocks">
                            <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" /></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Style="{StaticResource IconTextButton}" Tag="&#xE710;" Content="Add CTA-861" Command="{Binding AddExtensionCommand}" Margin="0,0,6,6" />
                            <Button Style="{StaticResource IconTextButton}" Tag="&#xE70F;" Content="Edit" Command="{Binding EditExtensionCommand}" Margin="0,0,6,6"
                                    ToolTip="Detailed resolutions, data blocks (TV resolutions, audio, speakers, HDMI, FreeSync, colorimetry, HDR...) and flags" />
                            <Button Style="{StaticResource IconTextButton}" Tag="&#xE74D;" Content="Delete" Command="{Binding DeleteExtensionCommand}" Margin="0,0,6,6" />
                            <Button Style="{StaticResource ArrowButton}" Content="&#xE70E;" Command="{Binding ExtensionUpCommand}" ToolTip="Move up" Margin="0,0,6,6" />
                            <Button Style="{StaticResource ArrowButton}" Content="&#xE70D;" Command="{Binding ExtensionDownCommand}" ToolTip="Move down" Margin="0,0,0,6" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== Windows: layout and settings of the selected monitor (apply immediately) ===== -->
            <StackPanel Visibility="{Binding HasWindowsDisplays, Converter={StaticResource BoolToVis}}">
                <TextBlock Style="{StaticResource DisplaySection}" Text="Display arrangement" />
                <Border Style="{StaticResource DisplayCard}" Padding="0" Height="300">
                    <Canvas v:ChartSize.Track="True" v:ChartSize.Size="{Binding ArrangeSize, Mode=OneWayToSource}" Background="Transparent" ClipToBounds="True">
                        <ItemsControl ItemsSource="{Binding Arrangement}" Focusable="False">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding Left}" /><Setter Property="Canvas.Top" Value="{Binding Top}" /></Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Thumb v:ChartDrag.Enabled="True" Width="{Binding Width}" Height="{Binding Height}" Cursor="Hand" ToolTip="Click to select; drag to move (with more than one display)">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="Box" Background="#1A1A1A" BorderBrush="#3A3A3A" BorderThickness="1.5" CornerRadius="6">
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <TextBlock Text="{Binding Number}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{StaticResource TextBrush}" />
                                                        <TextBlock Text="{Binding Name}" FontSize="11.5" HorizontalAlignment="Center" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextBrush}" />
                                                        <TextBlock Text="{Binding Mode}" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#8A8A8A" /></Trigger>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#FFFFFF" /><Setter TargetName="Box" Property="BorderThickness" Value="2" /></DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Canvas>
                </Border>

                <TextBlock Style="{StaticResource DisplaySection}" Text="Selected display" />
                <Border Style="{StaticResource DisplayRow}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7F4;" FontSize="17" Foreground="#4DA3FF" />
                        <TextBlock Grid.Column="1" Text="Display" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Content="Make this my main display" Command="{Binding MakePrimaryCommand}" Margin="0,0,8,0" Visibility="{Binding CanMakePrimary, Converter={StaticResource BoolToVis}}" />
                            <TextBox Width="280" Text="{Binding WinName, Mode=OneWay}" IsReadOnly="True" IsTabStop="False" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource DisplayRow}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE740;" FontSize="17" Foreground="#4DA3FF" />
                        <TextBlock Grid.Column="1" Text="Display scale" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="2" Style="{StaticResource DisplayRowCombo}" ItemsSource="{Binding Scales}" SelectedValue="{Binding SelectedScale}" IsEnabled="{Binding ScaleAvailable}" AutomationProperties.Name="Display scale" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource DisplayRow}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7B3;" FontSize="17" Foreground="#4DA3FF" />
                        <TextBlock Grid.Column="1" Text="Resolution" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="2" Style="{StaticResource DisplayRowCombo}" ItemsSource="{Binding Resolutions}" SelectedValue="{Binding SelectedResolution}" AutomationProperties.Name="Resolution" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource DisplayRow}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7AD;" FontSize="17" Foreground="#4DA3FF" />
                        <TextBlock Grid.Column="1" Text="Rotation" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="2" Style="{StaticResource DisplayRowCombo}" ItemsSource="{Binding Rotations}" SelectedValue="{Binding SelectedRotation}" AutomationProperties.Name="Rotation" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource DisplayRow}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE895;" FontSize="17" Foreground="#4DA3FF" />
                        <TextBlock Grid.Column="1" Text="Refresh rate" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Content="Max Refresh Rate" Command="{Binding MaxRefreshCommand}" Margin="0,0,8,0" />
                            <ComboBox Style="{StaticResource DisplayRowCombo}" Width="140" ItemsSource="{Binding RefreshChoices}" SelectedValue="{Binding SelectedRefresh}" AutomationProperties.Name="Refresh rate" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource DisplayRow}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE706;" FontSize="17" Foreground="#4DA3FF" />
                        <TextBlock Grid.Column="1" Text="HDR" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <CheckBox Grid.Column="2" Style="{StaticResource GpuOnOff}" IsChecked="{Binding Hdr}" IsEnabled="{Binding HdrSupported}" AutomationProperties.Name="HDR" />
                    </Grid>
                </Border>

                <TextBlock Style="{StaticResource DisplaySection}" Text="{x:Static t:Txt.DdcTitle}" ToolTip="{Binding DdcCapabilities}" />
                <Border Style="{StaticResource DisplayRow}" Visibility="{Binding DdcStatus, Converter={StaticResource NotEmptyToVis}}">
                    <TextBlock Style="{StaticResource Secondary}" Text="{Binding DdcStatus}" TextWrapping="Wrap" />
                </Border>
                <Border Style="{StaticResource DisplayRow}" Visibility="{Binding HasBrightness, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE706;" FontSize="17" Foreground="#4DA3FF" />
                        <TextBlock Grid.Column="1" Text="{x:Static t:Txt.DdcBrightness}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Slider Width="240" Minimum="0" Maximum="{Binding BrightnessMax}" Value="{Binding DdcBrightness, Mode=TwoWay}" IsSnapToTickEnabled="True" TickFrequency="1"
                                    VerticalAlignment="Center" AutomationProperties.Name="{x:Static t:Txt.DdcBrightness}" />
                            <TextBlock Text="{Binding DdcBrightness, StringFormat={}{0:0}}" Width="40" TextAlignment="Right" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource DisplayRow}" Visibility="{Binding HasContrast, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE793;" FontSize="17" Foreground="#4DA3FF" />
                        <TextBlock Grid.Column="1" Text="{x:Static t:Txt.DdcContrast}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Slider Width="240" Minimum="0" Maximum="{Binding ContrastMax}" Value="{Binding DdcContrast, Mode=TwoWay}" IsSnapToTickEnabled="True" TickFrequency="1"
                                    VerticalAlignment="Center" AutomationProperties.Name="{x:Static t:Txt.DdcContrast}" />
                            <TextBlock Text="{Binding DdcContrast, StringFormat={}{0:0}}" Width="40" TextAlignment="Right" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource DisplayRow}" Visibility="{Binding HasInputs, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7F4;" FontSize="17" Foreground="#4DA3FF" />
                        <TextBlock Grid.Column="1" Text="{x:Static t:Txt.DdcInput}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="2" Style="{StaticResource DisplayRowCombo}" ItemsSource="{Binding DdcInputs}" SelectedValue="{Binding DdcInput}"
                                  ToolTip="{x:Static t:Txt.DdcInputTip}" AutomationProperties.Name="{x:Static t:Txt.DdcInput}" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource DisplayRow}" Visibility="{Binding CanRestoreMonitor, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE777;" FontSize="17" Foreground="#4DA3FF" />
                        <TextBlock Grid.Column="1" Text="{x:Static t:Txt.DdcRestoreRow}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Content="{x:Static t:Txt.DdcRestore}" Command="{Binding DdcRestoreCommand}" ToolTip="{x:Static t:Txt.DdcRestoreTip}" />
                    </Grid>
                </Border>
            </StackPanel>
            <TextBlock Style="{StaticResource PageMessage}" />
        </StackPanel>
    </DataTemplate>

    <!-- ===================== EDID editors (EditorDialog) ===================== -->
    <DataTemplate DataType="{x:Type vm:StandardEditorViewModel}">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock Text="Resolution:" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Presets}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Preset}" Margin="0,3" AutomationProperties.Name="Resolution" />
            <TextBlock Grid.Row="1" Text="Width:" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding WidthText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsOther}" Margin="0,3" AutomationProperties.Name="Width" />
            <TextBlock Grid.Row="2" Text="Height:" VerticalAlignment="Center" />
            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding HeightText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsOther}" Margin="0,3" AutomationProperties.Name="Height" />
            <TextBlock Grid.Row="3" Text="Refresh rate:" VerticalAlignment="Center" />
            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding RateText, UpdateSourceTrigger=PropertyChanged}" v:Spin.Step="1" Margin="0,3" ToolTip="60–123 Hz" AutomationProperties.Name="Refresh rate" />
        </Grid>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:CtaEditorViewModel}">
        <StackPanel>
            <Grid Margin="0,0,0,10">
                <TextBlock Text="{Binding Header}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Style="{StaticResource Secondary}" Text="{Binding FreeText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
            <Border Style="{StaticResource EditorSection}">
                <WrapPanel>
                    <CheckBox Content="Underscan" IsChecked="{Binding Underscan}" Margin="0,0,18,0" ToolTip="The display underscans IT (PC) formats by default" />
                    <CheckBox Content="Basic audio" IsChecked="{Binding BasicAudio}" Margin="0,0,18,0" />
                    <CheckBox Content="YCbCr 4:4:4" IsChecked="{Binding YCbCr444}" Margin="0,0,18,0" />
                    <CheckBox Content="YCbCr 4:2:2" IsChecked="{Binding YCbCr422}" />
                </WrapPanel>
            </Border>
            <Border Style="{StaticResource EditorSection}">
                <StackPanel>
                    <TextBlock Style="{StaticResource EditorSectionTitle}" Text="Detailed resolutions" />
                    <ListBox Style="{StaticResource TimingList}" ItemsSource="{Binding Timings}" SelectedItem="{Binding SelectedTiming, Mode=TwoWay}" MinHeight="36" MaxHeight="150"
                             AutomationProperties.Name="Detailed resolutions">
                        <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Text}" /></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <WrapPanel Margin="0,8,0,0">
                        <Button Style="{StaticResource IconTextButton}" Tag="&#xE710;" Content="Add" Command="{Binding AddTimingCommand}" Margin="0,0,6,0" />
                        <Button Style="{StaticResource IconTextButton}" Tag="&#xE70F;" Content="Edit" Command="{Binding EditTimingCommand}" Margin="0,0,6,0" />
                        <Button Style="{StaticResource IconTextButton}" Tag="&#xE74D;" Content="Delete" Command="{Binding DeleteTimingCommand}" Margin="0,0,6,0" />
                        <Button Content="Delete all" Command="{Binding ClearTimingsCommand}" Margin="0,0,6,0" />
                        <Button Style="{StaticResource ArrowButton}" Content="&#xE70E;" Command="{Binding TimingUpCommand}" ToolTip="Move up" Margin="0,0,6,0" />
                        <Button Style="{StaticResource ArrowButton}" Content="&#xE70D;" Command="{Binding TimingDownCommand}" ToolTip="Move down" />
                    </WrapPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource EditorSection}" IsEnabled="{Binding SupportsDataBlocks}">
                <StackPanel>
                    <TextBlock Style="{StaticResource EditorSectionTitle}" Text="Data blocks" />
                    <ListBox Style="{StaticResource TimingList}" ItemsSource="{Binding Blocks}" SelectedItem="{Binding SelectedBlock, Mode=TwoWay}" MinHeight="36" MaxHeight="190"
                             AutomationProperties.Name="Data blocks">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="210" /><ColumnDefinition Width="80" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource Secondary}" Text="{Binding Size}" />
                                    <TextBlock Grid.Column="2" Style="{StaticResource Secondary}" Text="{Binding Summary}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <WrapPanel Margin="0,8,0,0">
                        <Button Style="{StaticResource IconTextButton}" Tag="&#xE710;" Content="Add" Command="{Binding AddBlockCommand}" Margin="0,0,6,0" />
                        <Button Style="{StaticResource IconTextButton}" Tag="&#xE70F;" Content="Edit" Command="{Binding EditBlockCommand}" Margin="0,0,6,0" />
                        <Button Style="{StaticResource IconTextButton}" Tag="&#xE74D;" Content="Delete" Command="{Binding DeleteBlockCommand}" Margin="0,0,6,0" />
                        <Button Content="Delete all" Command="{Binding ClearBlocksCommand}" Margin="0,0,6,0" />
                        <Button Style="{StaticResource ArrowButton}" Content="&#xE70E;" Command="{Binding BlockUpCommand}" ToolTip="Move up" Margin="0,0,6,0" />
                        <Button Style="{StaticResource ArrowButton}" Content="&#xE70D;" Command="{Binding BlockDownCommand}" ToolTip="Move down" />
                    </WrapPanel>
                </StackPanel>
            </Border>
            <TextBlock Text="{Binding Message}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap"
                       Visibility="{Binding Message, Converter={StaticResource NotEmptyToVis}}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:VideoBlockEditor}">
        <StackPanel>
            <TextBlock Style="{StaticResource Secondary}" Text="{Binding CountText}" Margin="0,0,0,8" />
            <Border Style="{StaticResource EditorSection}" Padding="4">
                <ListBox ItemsSource="{Binding Items}" Height="380" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" AutomationProperties.Name="TV resolutions">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter Margin="8,3" /></ControlTemplate></Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsOn}" />
                                <CheckBox Grid.Column="1" Content="Native" IsChecked="{Binding Native}" IsEnabled="{Binding CanBeNative}" ToolTip="Mark as a native format (VIC 1–64 only)" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:AudioBlockEditor}">
        <StackPanel>
            <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource BitCheck}" ItemsPanel="{StaticResource TwoColumns}" Focusable="False" />
            <TextBlock Style="{StaticResource Secondary}" FontSize="11.5" Text="{Binding Note}" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:SpeakerEditor}">
        <StackPanel>
            <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource BitCheck}" ItemsPanel="{StaticResource TwoColumns}" Focusable="False" />
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <Button Content="Stereo" Command="{Binding StereoCommand}" />
                <Button Content="5.1" Command="{Binding Surround51Command}" Margin="6,0,0,0" />
                <Button Content="7.1" Command="{Binding Surround71Command}" Margin="6,0,0,0" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ColorimetryEditor}">
        <StackPanel>
            <Border Style="{StaticResource EditorSection}">
                <StackPanel>
                    <TextBlock Style="{StaticResource EditorSectionTitle}" Text="Colorimetry" />
                    <ItemsControl ItemsSource="{Binding Items}" ItemTemplate="{StaticResource BitCheck}" ItemsPanel="{StaticResource TwoColumns}" Focusable="False" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource EditorSection}">
                <StackPanel>
                    <TextBlock Style="{StaticResource EditorSectionTitle}" Text="Metadata" />
                    <ItemsControl ItemsSource="{Binding Metadata}" ItemTemplate="{StaticResource BitCheck}" Focusable="False">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:HdrEditor}">
        <StackPanel>
            <Border Style="{StaticResource EditorSection}">
                <StackPanel>
                    <TextBlock Style="{StaticResource EditorSectionTitle}" Text="Transfer functions" />
                    <ItemsControl ItemsSource="{Binding Eotfs}" ItemTemplate="{StaticResource BitCheck}" ItemsPanel="{StaticResource TwoColumns}" Focusable="False" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource EditorSection}">
                <CheckBox Content="Static metadata type 1" IsChecked="{Binding Type1}" />
            </Border>
            <Border Style="{StaticResource EditorSection}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Grid.ColumnSpan="3" Style="{StaticResource EditorSectionTitle}" Text="Luminance (codes 1–255, blank = not given)" />
                    <TextBlock Grid.Row="1" Text="Max luminance:" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MaxText, UpdateSourceTrigger=PropertyChanged}" v:Spin.Step="1" Margin="0,3" AutomationProperties.Name="Max luminance" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource Secondary}" Text="{Binding MaxNits}" VerticalAlignment="Center" Margin="10,0,0,0" />
                    <TextBlock Grid.Row="2" Text="Max frame-avg:" VerticalAlignment="Center" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding AvgText, UpdateSourceTrigger=PropertyChanged}" v:Spin.Step="1" Margin="0,3" AutomationProperties.Name="Max frame-average luminance" />
                    <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource Secondary}" Text="{Binding AvgNits}" VerticalAlignment="Center" Margin="10,0,0,0" />
                    <TextBlock Grid.Row="3" Text="Min luminance:" VerticalAlignment="Center" />
                    <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding MinText, UpdateSourceTrigger=PropertyChanged}" v:Spin.Step="1" Margin="0,3" AutomationProperties.Name="Min luminance" />
                    <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource Secondary}" Text="{Binding MinNits}" VerticalAlignment="Center" Margin="10,0,0,0" />
                </Grid>
            </Border>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:VideoCapabilityEditor}">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock Text="TV resolutions (CE):" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding ScanModes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Ce}" Margin="0,3" />
            <TextBlock Grid.Row="1" Text="PC resolutions (IT):" VerticalAlignment="Center" />
            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding ScanModes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding It}" Margin="0,3" />
            <TextBlock Grid.Row="2" Text="Native resolution (PT):" VerticalAlignment="Center" />
            <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding NativeModes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Pt}" Margin="0,3" />
            <CheckBox Grid.Row="3" Grid.ColumnSpan="2" Content="Selectable RGB range (QY)" IsChecked="{Binding Qy}" Margin="0,10,0,6" />
            <CheckBox Grid.Row="4" Grid.ColumnSpan="2" Content="Selectable YCC range (QS)" IsChecked="{Binding Qs}" />
        </Grid>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:FreeSyncEditor}">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock Text="Minimum (Hz):" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding MinText, UpdateSourceTrigger=PropertyChanged}" v:Spin.Step="1" Margin="0,3" AutomationProperties.Name="Minimum refresh rate" />
            <TextBlock Grid.Row="1" Text="Maximum (Hz):" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding MaxText, UpdateSourceTrigger=PropertyChanged}" v:Spin.Step="1" Margin="0,3" AutomationProperties.Name="Maximum refresh rate" />
        </Grid>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:HdmiEditor}">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Text="Physical address:" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" ToolTip="Usually 1.0.0.0" AutomationProperties.Name="Physical address" />
                <TextBlock Grid.Row="1" Text="Max TMDS clock (MHz):" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding TmdsText, UpdateSourceTrigger=PropertyChanged}" v:Spin.Step="5" Margin="0,3"
                         ToolTip="Blank = not given (165 MHz). 340 for HDMI 1.4 at full speed." AutomationProperties.Name="Max TMDS clock" />
            </Grid>
            <Border Style="{StaticResource EditorSection}" Margin="0,10,0,0">
                <UniformGrid Columns="2">
                    <CheckBox Content="Deep color 30-bit" IsChecked="{Binding Dc30}" Margin="0,0,0,8" />
                    <CheckBox Content="Deep color 36-bit" IsChecked="{Binding Dc36}" Margin="0,0,0,8" />
                    <CheckBox Content="Deep color 48-bit" IsChecked="{Binding Dc48}" Margin="0,0,0,8" />
                    <CheckBox Content="Deep color YCbCr 4:4:4" IsChecked="{Binding Y444}" Margin="0,0,0,8" />
                    <CheckBox Content="Supports AI (ACP, ISRC)" IsChecked="{Binding Ai}" />
                </UniformGrid>
            </Border>
            <TextBlock Style="{StaticResource Secondary}" FontSize="11.5" TextWrapping="Wrap" Text="Latency, content types and 3D stay as the EDID has them." />
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:HdmiForumEditor}">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Text="Max TMDS rate (MHz):" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding TmdsText, UpdateSourceTrigger=PropertyChanged}" v:Spin.Step="5" Margin="0,3" ToolTip="600 for HDMI 2.0 at full speed; blank = 340" AutomationProperties.Name="Max TMDS rate" />
                <TextBlock Grid.Row="1" Text="VRR minimum (Hz):" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding VrrMinText, UpdateSourceTrigger=PropertyChanged}" v:Spin.Step="1" Margin="0,3" ToolTip="HDMI 2.1 VRR; blank = none" AutomationProperties.Name="VRR minimum" />
                <TextBlock Grid.Row="2" Text="VRR maximum (Hz):" VerticalAlignment="Center" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding VrrMaxText, UpdateSourceTrigger=PropertyChanged}" v:Spin.Step="1" Margin="0,3" ToolTip="HDMI 2.1 VRR; blank = the display's maximum" AutomationProperties.Name="VRR maximum" />
            </Grid>
            <Border Style="{StaticResource EditorSection}" Margin="0,10,0,0">
                <UniformGrid Columns="2">
                    <CheckBox Content="SCDC present" IsChecked="{Binding Scdc}" Margin="0,0,0,8" />
                    <CheckBox Content="Scrambling below 340 MHz" IsChecked="{Binding Scramble}" Margin="0,0,0,8" />
                    <CheckBox Content="Deep color 4:2:0 30-bit" IsChecked="{Binding Dc30}" Margin="0,0,0,8" />
                    <CheckBox Content="Deep color 4:2:0 36-bit" IsChecked="{Binding Dc36}" Margin="0,0,0,8" />
                    <CheckBox Content="Deep color 4:2:0 48-bit" IsChecked="{Binding Dc48}" />
                </UniformGrid>
            </Border>
            <TextBlock Style="{StaticResource Secondary}" FontSize="11.5" TextWrapping="Wrap" Text="FRL, DSC and the other HDMI 2.1 features stay as the EDID has them." />
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:HexBlockEditor}">
        <StackPanel>
            <TextBlock Style="{StaticResource Secondary}" Text="{Binding Hint}" TextWrapping="Wrap" Margin="0,0,0,8" />
            <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" TextWrapping="Wrap" AcceptsReturn="False" MinHeight="70"
                     VerticalContentAlignment="Top" AutomationProperties.Name="Data block bytes" />
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
