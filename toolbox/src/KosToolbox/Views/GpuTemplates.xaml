<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:KosToolbox.ViewModels"
                    xmlns:v="clr-namespace:KosToolbox.Views"
                    xmlns:t="clr-namespace:KosToolbox.Core.Text;assembly=KosToolbox.Core">

    <!-- ===================== GPU ===================== -->
    <!-- Dark slider (the theme didn't have one): thin track, filled part and round thumb; step of 1. -->
    <!-- GPU page tab: icon + text; the selected one is light with a blue stripe below. DataContext = GpuTab. -->
    <Style x:Key="GpuTabButton" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <!-- Spacing between tabs is outside the template: the (Tab) focus rectangle fits tightly around the tab. -->
        <Setter Property="Margin" Value="0,0,16,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <StackPanel Orientation="Horizontal" Margin="4,6,4,10">
                            <TextBlock Style="{StaticResource Icon}" Text="{Binding Icon}" FontSize="15" Margin="0,0,8,0" Foreground="{TemplateBinding Foreground}" />
                            <TextBlock Text="{Binding Label}" FontSize="14" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" />
                        </StackPanel>
                        <Border x:Name="Bar" Height="3" Width="18" CornerRadius="1.5" Background="#4DA3FF" VerticalAlignment="Bottom" HorizontalAlignment="Center" Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource TextBrush}" /></Trigger>
                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            <Setter TargetName="Bar" Property="Opacity" Value="1" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Disabled | Enabled (two-half CheckBox), as in the NVIDIA control panel. -->
    <Style x:Key="GpuOnOff" TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border Width="194" Height="32" CornerRadius="5" Background="{StaticResource ControlBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="2">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <Border x:Name="OffBg" CornerRadius="4" Background="#1C1C1C" />
                            <Border x:Name="OnBg" Grid.Column="1" CornerRadius="4" Background="Transparent" />
                            <TextBlock x:Name="OffText" Text="Disabled" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#4DA3FF" FontWeight="SemiBold" />
                            <TextBlock x:Name="OnText" Grid.Column="1" Text="Enabled" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="OffBg" Property="Background" Value="Transparent" />
                            <Setter TargetName="OnBg" Property="Background" Value="#1C1C1C" />
                            <Setter TargetName="OffText" Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                            <Setter TargetName="OffText" Property="FontWeight" Value="Normal" />
                            <Setter TargetName="OnText" Property="Foreground" Value="#4DA3FF" />
                            <Setter TargetName="OnText" Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Simple dark list (driver profiles): background on mouse over and on the selected item. -->
    <Style x:Key="DrsPlainList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Cursor" Value="Hand" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Bg" Background="Transparent" CornerRadius="4" Padding="12,7">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#222222" /></Trigger>
                                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bg" Property="Background" Value="#262626" /></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Top action bar: square buttons with icons. -->
    <Style x:Key="GpuToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="34" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="15" />
    </Style>
    <Style x:Key="GpuToolApply" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="34" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="15" />
    </Style>
    <!-- Bar toggle button (apply at logon): blue when on. -->
    <Style x:Key="GpuToolToggle" TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="34" />
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid>
                        <Border x:Name="Bg" CornerRadius="5" Background="{StaticResource ControlBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" />
                        <Border x:Name="Hover" Margin="1" CornerRadius="4" Background="{StaticResource HoverBrush}" Opacity="0" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Hover" Property="Opacity" Value="1" /></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#1E9BE0" />
                            <Setter TargetName="Bg" Property="BorderBrush" Value="#1E9BE0" />
                            <Setter TargetName="Hover" Property="Background" Value="#22FFFFFF" />
                            <Setter Property="Foreground" Value="#FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Fan curve: blue in Curve mode, gray (disabled) in Auto/Static. -->
    <Style x:Key="GpuCurveChart" TargetType="Border">
        <Setter Property="Background" Value="#06141C" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="5" />
        <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="#101010" /></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="GpuCurveFill" TargetType="Polygon">
        <Setter Property="Fill" Value="#2A1E9BE0" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Fill" Value="#14FFFFFF" /></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="GpuCurveLine" TargetType="Polyline">
        <Setter Property="Stroke" Value="#1E9BE0" />
        <Setter Property="StrokeThickness" Value="2.5" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Stroke" Value="#8C8C8C" /></Trigger></Style.Triggers>
    </Style>

    <!-- Switch (pill-shaped CheckBox), used on the V/F curve. -->
    <Style x:Key="GpuSwitch" TargetType="CheckBox">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="36" Height="20" VerticalAlignment="Center">
                            <Border x:Name="Track" CornerRadius="10" Background="{StaticResource ControlBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" />
                            <Ellipse x:Name="Knob" Width="14" Height="14" Margin="3,0" HorizontalAlignment="Left" Fill="{StaticResource TextSecondaryBrush}" />
                        </Grid>
                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="#1E9BE0" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="#1E9BE0" />
                            <Setter TargetName="Knob" Property="Fill" Value="#FFFFFF" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GpuSlider" TargetType="Slider">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="IsSnapToTickEnabled" Value="True" />
        <Setter Property="TickFrequency" Value="1" />
        <Setter Property="SmallChange" Value="1" />
        <Setter Property="LargeChange" Value="5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Height="24" Background="Transparent">
                        <Border Height="4" CornerRadius="2" Background="{StaticResource BorderStrongBrush}" VerticalAlignment="Center" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False" IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent">
                                                <Border Height="4" CornerRadius="2" Background="{StaticResource TextBrush}" VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False" IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="16" Height="16">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Fill="{StaticResource TextBrush}" Stroke="{StaticResource BgBrush}" StrokeThickness="2" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="GpuDeviceText">
        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
    </DataTemplate>

    <!-- Label above a field (same FieldLabel as the Devices page; repeated so this dictionary doesn't depend on load order). -->
    <Style x:Key="GpuFieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style x:Key="GpuError" TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="GpuHint" TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Card status (Main and Overclock tabs): fixed positions, even when the driver doesn't report a sensor. -->
    <DataTemplate x:Key="GpuStatusCard">
        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Readings}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="7" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,5,12,7" MinWidth="0">
                                <TextBlock Style="{StaticResource Secondary}" Text="{Binding Label}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}" />
                                <TextBlock Text="{Binding Value}" FontSize="15" FontWeight="SemiBold" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Value}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource GpuError}" Text="{Binding ReadError}" Visibility="{Binding ReadError, Converter={StaticResource NotEmptyToVis}}" />
            </StackPanel>
        </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:GpuPageViewModel}">
        <!-- DockPanel: on the Display tab (which scrolls on its own) the last child fills the window height; on the others the page scrolls. -->
        <DockPanel LastChildFill="True">
            <!-- Tabs on the left, action bar on the right (profiles, defaults, apply at logon, discard, undo, apply). Without an NVIDIA card, only Main and Driver. -->
            <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <ItemsControl ItemsSource="{Binding Tabs}" Focusable="False" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource GpuTabButton}" Command="{Binding DataContext.SelectTabCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Key}" AutomationProperties.Name="{Binding Label}"
                                    Visibility="{Binding IsAvailable, Converter={StaticResource BoolToVis}}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- Settings: own profiles (they don't touch the overclock); they apply immediately. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding IsSettingsTab, Converter={StaticResource BoolToVis}}">
                    <ComboBox ItemsSource="{Binding Settings.ProfileNames}" SelectedItem="{Binding Settings.SelectedProfile, Mode=TwoWay}" MinWidth="170" VerticalAlignment="Center"
                              ToolTip="Settings profile: choosing one applies it right away (overclock profiles are separate)" AutomationProperties.Name="Settings profile" />
                    <Button Style="{StaticResource GpuToolButton}" Content="&#xE710;" Command="{Binding Settings.NewProfileCommand}" Margin="6,0,0,0" ToolTip="New settings profile from the current display settings" AutomationProperties.Name="New settings profile" />
                    <Button Style="{StaticResource GpuToolButton}" Content="&#xE74E;" Command="{Binding Settings.SaveProfileCommand}" Margin="6,0,0,0" ToolTip="Save the current display settings to this profile" AutomationProperties.Name="Save settings profile" />
                    <Button Style="{StaticResource GpuToolButton}" Content="&#xE74D;" Command="{Binding Settings.DeleteProfileCommand}" Margin="6,0,0,0" ToolTip="Delete this settings profile" AutomationProperties.Name="Delete settings profile" />
                </StackPanel>
                <!-- DRS: driver profile search, restore all, undo pending and apply. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding IsDrsTab, Converter={StaticResource BoolToVis}}">
                    <Grid Width="280">
                        <TextBox x:Name="DrsProfileBox" Text="{Binding Drs.ProfileQuery, UpdateSourceTrigger=PropertyChanged}" Tag="Search profiles..." Padding="10,0,30,0" v:ClearOnFocus.Enabled="True"
                                 AutomationProperties.Name="Driver profile" ToolTip="Driver profile: type to search, pick one from the list" />
                        <Button Style="{StaticResource IconButton}" Content="&#xE70D;" FontSize="10" Width="26" Height="26" Margin="0,0,3,0" HorizontalAlignment="Right"
                                Command="{Binding Drs.OpenProfilesCommand}" ToolTip="Show all profiles" AutomationProperties.Name="Show all profiles" />
                        <Popup IsOpen="{Binding Drs.ProfilesOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=DrsProfileBox}" Placement="Bottom" StaysOpen="False" AllowsTransparency="True" VerticalOffset="4" v:Motion.PopOnOpen="True">
                            <Border Width="280" Background="#161616" BorderBrush="#2E2E2E" BorderThickness="1" CornerRadius="8" Padding="4">
                                <ListBox Style="{StaticResource DrsPlainList}" ItemsSource="{Binding Drs.FilteredProfiles}" SelectedItem="{Binding Drs.SelectedProfile, Mode=TwoWay}" MaxHeight="360"
                                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" AutomationProperties.Name="Driver profiles" />
                            </Border>
                        </Popup>
                    </Grid>
                    <Button Style="{StaticResource GpuToolButton}" Content="&#xE710;" Command="{Binding Drs.ProgramProfileCommand}" Margin="6,0,0,0"
                            ToolTip="Profile for a program: opens the driver profile that has its file, or makes a new one named after it" AutomationProperties.Name="Profile for a program" />
                    <Button Style="{StaticResource GpuToolButton}" Content="&#xE74D;" Command="{Binding Drs.DeleteProfileCommand}" Margin="6,0,0,0"
                            ToolTip="Delete this profile (only profiles made by the user; its programs use the global profile again)" AutomationProperties.Name="Delete profile" />
                    <Button Style="{StaticResource GpuToolButton}" Content="&#xE777;" Command="{Binding Drs.RestoreAllCommand}" Margin="6,0,0,0" ToolTip="Restore ALL driver settings to NVIDIA defaults" AutomationProperties.Name="Restore all driver settings" />
                    <Button Style="{StaticResource GpuToolButton}" Content="&#xE7A7;" Command="{Binding Drs.UndoCommand}" Margin="6,0,0,0" ToolTip="Undo pending changes" AutomationProperties.Name="Undo pending changes" />
                    <Button Style="{StaticResource GpuToolApply}" Content="&#xE73E;" Command="{Binding Drs.ApplyCommand}" Margin="6,0,0,0" ToolTip="Apply pending changes to the driver" AutomationProperties.Name="{x:Static t:Txt.Apply}" />
                </StackPanel>
                <!-- Display: EDID monitor, re-read, restart driver, back to the monitor's EDID, discard and save the override. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding IsDisplayTab, Converter={StaticResource BoolToVis}}">
                    <ComboBox ItemsSource="{Binding Display.MonitorItems}" DisplayMemberPath="Label" SelectedItem="{Binding Display.SelectedMonitor, Mode=TwoWay}" MinWidth="300" MaxWidth="420"
                              VerticalAlignment="Center" AutomationProperties.Name="{x:Static t:Txt.Monitor}" />
                    <Button Style="{StaticResource GpuToolButton}" Content="&#xE72C;" Command="{Binding Display.RescanCommand}" Margin="6,0,0,0" ToolTip="Rescan monitors (discards unsaved changes)" AutomationProperties.Name="Rescan monitors" />
                    <Button Style="{StaticResource GpuToolButton}" Content="&#xE895;" Command="{Binding Display.RestartCommand}" Margin="6,0,0,0"
                            ToolTip="Restart Driver - disable and re-enable the display adapters so saved overrides apply without a reboot. The screen will flicker for a few seconds." AutomationProperties.Name="{x:Static t:Txt.RestartDisplayDriver}" />
                    <Button Style="{StaticResource GpuToolButton}" Content="&#xE777;" Command="{Binding Display.RestoreCommand}" Margin="6,0,0,0" ToolTip="Restore monitor EDID - delete the saved override" AutomationProperties.Name="{x:Static t:Txt.RestoreMonitorEdid}" />
                    <Button Style="{StaticResource GpuToolButton}" Content="&#xE7A7;" Command="{Binding Display.DiscardCommand}" Margin="6,0,0,0" ToolTip="Discard unsaved changes" AutomationProperties.Name="{x:Static t:Txt.Discard}" />
                    <Button Command="{Binding Display.SaveCommand}" Content="&#xE74E;" Margin="6,0,0,0" ToolTip="Save - write the EDID override to the registry; a driver restart is needed to apply it" AutomationProperties.Name="{x:Static t:Txt.SaveOverride}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GpuToolButton}">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Display.HasPending}" Value="True">
                                        <Setter Property="Foreground" Value="#4DA3FF" />
                                        <Setter Property="BorderBrush" Value="#4DA3FF" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding ShowOcToolbar, Converter={StaticResource BoolToVis}}">
                                <ComboBox ItemsSource="{Binding ProfileNames}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}" MinWidth="170" VerticalAlignment="Center"
                                          ToolTip="Profile: choosing one loads its settings (press Apply to write them). The chosen profile is applied every time the toolbox opens." AutomationProperties.Name="Profile" />
                                <Button Style="{StaticResource GpuToolButton}" Content="&#xE710;" Command="{Binding NewProfileCommand}" Margin="6,0,0,0" ToolTip="New profile from the current settings" AutomationProperties.Name="New profile" />
                                <Button Style="{StaticResource GpuToolButton}" Content="&#xE74E;" Command="{Binding SaveProfileCommand}" Margin="6,0,0,0" ToolTip="Save the current settings to this profile" AutomationProperties.Name="Save profile" />
                                <Button Style="{StaticResource GpuToolButton}" Content="&#xE74D;" Command="{Binding DeleteProfileCommand}" Margin="6,0,0,0" ToolTip="Delete this profile" AutomationProperties.Name="Delete profile" />
                                <Border Width="1" Height="22" Background="{StaticResource BorderBrush}" Margin="10,0" />
                                <Button Style="{StaticResource GpuToolButton}" Content="&#xE777;" Command="{Binding ResetCommand}" ToolTip="{x:Static t:Txt.GpuResetDefaultsTooltip}" AutomationProperties.Name="{x:Static t:Txt.GpuResetDefaults}" />
                                <CheckBox Style="{StaticResource GpuToolToggle}" Content="&#xE7E8;" IsChecked="{Binding SignIn}" Margin="6,0,0,0" AutomationProperties.Name="{x:Static t:Txt.GpuSignIn}">
                                    <CheckBox.ToolTip>
                                        <StackPanel MaxWidth="360">
                                            <TextBlock Text="{x:Static t:Txt.GpuSignIn}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{x:Static t:Txt.GpuSignInNote}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </CheckBox.ToolTip>
                                </CheckBox>
                                <Button Style="{StaticResource GpuToolButton}" Content="&#xE72C;" Command="{Binding DiscardCommand}" Margin="6,0,0,0" ToolTip="Discard changes (back to what the card has now)" AutomationProperties.Name="{x:Static t:Txt.Discard}" />
                                <Button Style="{StaticResource GpuToolButton}" Content="&#xE7A7;" Command="{Binding UndoCommand}" Margin="6,0,0,0" ToolTip="Undo the last change (Ctrl+Z)" AutomationProperties.Name="Undo" />
                                <Button Style="{StaticResource GpuToolApply}" Content="&#xE73E;" Command="{Binding ApplyCommand}" Margin="6,0,0,0" ToolTip="{Binding PendingText}" AutomationProperties.Name="{x:Static t:Txt.Apply}" />
                            </StackPanel>
            </Grid>
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource PageMessage}" TextWrapping="Wrap" Margin="2,0,0,10" />

            <!-- No NVML, no NVIDIA card, or cards from other vendors (the Display tab works without NVIDIA). -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,10" Visibility="{Binding Notice, Converter={StaticResource NotEmptyToVis}}">
                <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" />
            </Border>

            <StackPanel DockPanel.Dock="Top" Visibility="{Binding HasDevice, Converter={StaticResource BoolToVis}}">
              <!-- ===== Main ===== -->
              <StackPanel Visibility="{Binding IsMainTab, Converter={StaticResource BoolToVis}}">
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource CardTitle}" Text="{Binding SelectedDevice.Name}" />
                            <TextBlock Style="{StaticResource Secondary}" Text="{Binding DeviceDetail}" Margin="0,3,0,0" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Devices}" ItemTemplate="{StaticResource GpuDeviceText}" SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                                  MinWidth="220" VerticalAlignment="Center" AutomationProperties.Name="{x:Static t:Txt.PageGpu}"
                                  Visibility="{Binding HasManyDevices, Converter={StaticResource BoolToVis}}" />
                    </Grid>
                </Border>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource GpuStatusCard}" Focusable="False" />
              </StackPanel>

              <!-- ===== Overclock ===== -->
              <StackPanel Visibility="{Binding IsOverclockTab, Converter={StaticResource BoolToVis}}">
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource GpuStatusCard}" Focusable="False" />
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{x:Static t:Txt.GpuTuningTitle}" Margin="0,0,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="250" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" MinWidth="250" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Style="{StaticResource GpuFieldLabel}" Text="{x:Static t:Txt.GpuCoreOffset}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="86" /></Grid.ColumnDefinitions>
                                        <Slider Style="{StaticResource GpuSlider}" Minimum="{Binding CoreMinimum}" Maximum="{Binding CoreMaximum}" Value="{Binding CoreSlider, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CoreEnabled}" AutomationProperties.Name="{x:Static t:Txt.GpuCoreOffset}" />
                                        <TextBox Grid.Column="2" Text="{Binding CoreText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CoreEnabled}" AutomationProperties.Name="{x:Static t:Txt.GpuCoreOffset}" />
                                    </Grid>
                                    <TextBlock Style="{StaticResource GpuHint}" Text="{Binding CoreHint}" />
                                    <TextBlock Style="{StaticResource GpuError}" Text="{Binding CoreError}" Visibility="{Binding CoreError, Converter={StaticResource NotEmptyToVis}}" />
                                    <TextBlock Style="{StaticResource GpuHint}" Text="{Binding CoreProblem}" Visibility="{Binding CoreProblem, Converter={StaticResource NotEmptyToVis}}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Style="{StaticResource GpuFieldLabel}" Text="{x:Static t:Txt.GpuMemOffset}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="86" /></Grid.ColumnDefinitions>
                                        <Slider Style="{StaticResource GpuSlider}" Minimum="{Binding MemMinimum}" Maximum="{Binding MemMaximum}" Value="{Binding MemSlider, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding MemEnabled}" AutomationProperties.Name="{x:Static t:Txt.GpuMemOffset}" />
                                        <TextBox Grid.Column="2" Text="{Binding MemText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding MemEnabled}" AutomationProperties.Name="{x:Static t:Txt.GpuMemOffset}" />
                                    </Grid>
                                    <TextBlock Style="{StaticResource GpuHint}" Text="{Binding MemHint}" />
                                    <TextBlock Style="{StaticResource GpuError}" Text="{Binding MemError}" Visibility="{Binding MemError, Converter={StaticResource NotEmptyToVis}}" />
                                    <TextBlock Style="{StaticResource GpuHint}" Text="{Binding MemProblem}" Visibility="{Binding MemProblem, Converter={StaticResource NotEmptyToVis}}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Style="{StaticResource GpuFieldLabel}" Text="{x:Static t:Txt.GpuMinClock}" />
                                    <TextBox Text="{Binding MinClockText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding MinClockEnabled}" Width="86" HorizontalAlignment="Left" AutomationProperties.Name="{x:Static t:Txt.GpuMinClock}" />
                                    <TextBlock Style="{StaticResource GpuHint}" Text="{Binding MinClockHint}" />
                                    <TextBlock Style="{StaticResource GpuError}" Text="{Binding MinClockError}" Visibility="{Binding MinClockError, Converter={StaticResource NotEmptyToVis}}" />
                                    <TextBlock Style="{StaticResource GpuHint}" Text="{Binding MinClockProblem}" Visibility="{Binding MinClockProblem, Converter={StaticResource NotEmptyToVis}}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Style="{StaticResource GpuFieldLabel}" Text="{x:Static t:Txt.GpuThermalLimit}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="86" /></Grid.ColumnDefinitions>
                                        <Slider Style="{StaticResource GpuSlider}" Minimum="{Binding ThermalMinimum}" Maximum="{Binding ThermalMaximum}" Value="{Binding ThermalSlider, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding ThermalEnabled}" AutomationProperties.Name="{x:Static t:Txt.GpuThermalLimit}" />
                                        <TextBox Grid.Column="2" Text="{Binding ThermalText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding ThermalEnabled}" AutomationProperties.Name="{x:Static t:Txt.GpuThermalLimit}" />
                                    </Grid>
                                    <TextBlock Style="{StaticResource GpuHint}" Text="{Binding ThermalHint}" />
                                    <TextBlock Style="{StaticResource GpuError}" Text="{Binding ThermalError}" Visibility="{Binding ThermalError, Converter={StaticResource NotEmptyToVis}}" />
                                    <TextBlock Style="{StaticResource GpuHint}" Text="{Binding ThermalProblem}" Visibility="{Binding ThermalProblem, Converter={StaticResource NotEmptyToVis}}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,14">
                                    <CheckBox Style="{StaticResource GpuSwitch}" Content="{x:Static t:Txt.GpuThermalSlowdown}" IsChecked="{Binding ThermalSlowdownOn}" IsEnabled="{Binding SlowdownEnabled}" HorizontalAlignment="Left" AutomationProperties.Name="{x:Static t:Txt.GpuThermalSlowdown}" />
                                    <TextBlock Style="{StaticResource GpuHint}" Text="{x:Static t:Txt.GpuThermalSlowdownWarning}" Foreground="{StaticResource WarningBrush}" />
                                    <TextBlock Style="{StaticResource GpuHint}" Text="{Binding SlowdownProblem}" Visibility="{Binding SlowdownProblem, Converter={StaticResource NotEmptyToVis}}" />
                                </StackPanel>
                                <StackPanel Margin="0,0,0,14">
                                    <TextBlock Style="{StaticResource GpuFieldLabel}" Text="{x:Static t:Txt.GpuPowerLimit}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="86" /></Grid.ColumnDefinitions>
                                        <Slider Style="{StaticResource GpuSlider}" Minimum="{Binding PowerMinimum}" Maximum="{Binding PowerMaximum}" Value="{Binding PowerSlider, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding PowerEnabled}" AutomationProperties.Name="{x:Static t:Txt.GpuPowerLimit}" />
                                        <TextBox Grid.Column="2" Text="{Binding PowerText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding PowerEnabled}" AutomationProperties.Name="{x:Static t:Txt.GpuPowerLimit}" />
                                    </Grid>
                                    <TextBlock Style="{StaticResource GpuHint}" Text="{Binding PowerHint}" />
                                    <TextBlock Style="{StaticResource GpuError}" Text="{Binding PowerError}" Visibility="{Binding PowerError, Converter={StaticResource NotEmptyToVis}}" />
                                    <TextBlock Style="{StaticResource GpuHint}" Text="{Binding PowerProblem}" Visibility="{Binding PowerProblem, Converter={StaticResource NotEmptyToVis}}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource GpuHint}" Text="{x:Static t:Txt.GpuThermalNote}" />
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Style="{StaticResource GpuFieldLabel}" Text="{x:Static t:Txt.GpuFan}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <ItemsControl Style="{StaticResource Segmented}" ItemsSource="{Binding FanModes}" Tag="{Binding SelectFanModeCommand}" AutomationProperties.Name="{x:Static t:Txt.GpuFan}" />
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="86" /></Grid.ColumnDefinitions>
                                    <Slider Style="{StaticResource GpuSlider}" Minimum="{Binding FanMinimum}" Maximum="{Binding FanMaximum}" Value="{Binding FanSlider, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding FanPercentEnabled}" AutomationProperties.Name="{x:Static t:Txt.GpuFanFixed}" />
                                    <TextBox Grid.Column="2" Text="{Binding FanText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding FanPercentEnabled}" AutomationProperties.Name="{x:Static t:Txt.GpuFanFixed}" />
                                </Grid>
                                <TextBlock Style="{StaticResource GpuHint}" Text="{Binding FanHint}" />
                                <TextBlock Style="{StaticResource GpuError}" Text="{Binding FanError}" Visibility="{Binding FanError, Converter={StaticResource NotEmptyToVis}}" />
                                <TextBlock Style="{StaticResource GpuHint}" Text="{Binding FanProblem}" Visibility="{Binding FanProblem, Converter={StaticResource NotEmptyToVis}}" />

                                <!-- Always visible; outside Curve mode it is disabled and gray (GpuCurve* styles). -->
                                <StackPanel Margin="0,16,0,0" IsEnabled="{Binding FanCurveSelected}" Visibility="{Binding FanEnabled, Converter={StaticResource BoolToVis}}">
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource CardTitle}" Text="{x:Static t:Txt.FanCurveTitle}" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="+" Command="{Binding AddPointCommand}" Width="32" Height="30" Padding="0" FontSize="16" ToolTip="{x:Static t:Txt.AddPoint}" AutomationProperties.Name="{x:Static t:Txt.AddPoint}" />
                                            <Button Content="−" Command="{Binding RemovePointCommand}" Width="32" Height="30" Padding="0" FontSize="16" Margin="6,0,0,0" ToolTip="{x:Static t:Txt.Remove}" AutomationProperties.Name="{x:Static t:Txt.Remove}" />
                                        </StackPanel>
                                    </Grid>
                                    <Border Style="{StaticResource GpuCurveChart}">
                                        <!-- Chart area in real pixels; the margins hold the axis labels and half a dot at the edges. -->
                                        <Grid Height="250" Margin="46,14,18,28">
                                            <Canvas v:ChartSize.Track="True" v:ChartSize.Size="{Binding FanPlotSize, Mode=OneWayToSource}" Background="Transparent">
                                                <ItemsControl ItemsSource="{Binding FanYTicks}" Focusable="False">
                                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Top" Value="{Binding Pos}" /></Style></ItemsControl.ItemContainerStyle>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Canvas>
                                                                <Line X1="0" X2="{Binding DataContext.FanPlotWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Stroke="#22FFFFFF" />
                                                                <TextBlock Canvas.Left="-44" Canvas.Top="-8" Width="36" TextAlignment="Right" Text="{Binding Label}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                                            </Canvas>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <ItemsControl ItemsSource="{Binding FanXTicks}" Focusable="False">
                                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding Pos}" /></Style></ItemsControl.ItemContainerStyle>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Canvas>
                                                                <Line Y1="0" Y2="{Binding DataContext.FanPlotHeight, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Stroke="#22FFFFFF" />
                                                                <TextBlock Canvas.Top="{Binding DataContext.FanPlotHeight, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Margin="-24,6,0,0" Width="48" TextAlignment="Center" Text="{Binding Label}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                                            </Canvas>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Polygon Points="{Binding CurveFill}" Style="{StaticResource GpuCurveFill}" />
                                                <Line X1="{Binding TemperatureX}" X2="{Binding TemperatureX}" Y1="0" Y2="{Binding FanPlotHeight}" Stroke="#E05555" StrokeThickness="1.5" StrokeDashArray="4 3" Visibility="{Binding CurveRunning, Converter={StaticResource BoolToVis}}" />
                                                <Polyline Points="{Binding CurvePreview}" Style="{StaticResource GpuCurveLine}" />
                                                <ItemsControl ItemsSource="{Binding CurvePoints}" Focusable="False">
                                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemContainerStyle>
                                                        <Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding PlotLeft}" /><Setter Property="Canvas.Top" Value="{Binding PlotTop}" /></Style>
                                                    </ItemsControl.ItemContainerStyle>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Thumb v:ChartDrag.Enabled="True" Cursor="SizeAll" ToolTip="{Binding Label}">
                                                                <Thumb.Template>
                                                                    <ControlTemplate TargetType="Thumb">
                                                                        <Ellipse x:Name="Dot" Width="14" Height="14" Fill="#06141C" Stroke="#1E9BE0" StrokeThickness="2.5" />
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Dot" Property="Fill" Value="#1E9BE0" /></Trigger>
                                                                            <Trigger Property="IsDragging" Value="True"><Setter TargetName="Dot" Property="Fill" Value="#FFFFFF" /></Trigger>
                                                                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Dot" Property="Stroke" Value="#8C8C8C" /><Setter TargetName="Dot" Property="Fill" Value="#161616" /></Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Thumb.Template>
                                                            </Thumb>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Canvas>
                                        </Grid>
                                    </Border>
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="62" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,20,0,0">
                                            <TextBlock Style="{StaticResource Secondary}" Text="Speed %" Height="34" Padding="0,8,0,0" />
                                            <TextBlock Style="{StaticResource Secondary}" Text="Temp °C" Height="34" Padding="0,8,0,0" Margin="0,4,0,0" />
                                        </StackPanel>
                                        <!-- Background: the 8 empty columns (P1–P8). On top: the points that exist, covering the first columns. -->
                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding CurveSlots}" Focusable="False" IsTabStop="False">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" Columns="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,0,6,0">
                                                        <TextBlock Style="{StaticResource Secondary}" Text="{Binding}" FontSize="11" HorizontalAlignment="Center" Height="20" />
                                                        <Border Height="34" CornerRadius="5" Background="{StaticResource ControlBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Opacity="0.45" />
                                                        <Border Height="34" CornerRadius="5" Background="{StaticResource ControlBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Opacity="0.45" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding CurvePoints}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" Columns="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,20,6,0">
                                                        <TextBox Text="{Binding Percent, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" AutomationProperties.Name="{x:Static t:Txt.FanCurvePercent}" />
                                                        <TextBox Text="{Binding Temp, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center" Margin="0,4,0,0" AutomationProperties.Name="{x:Static t:Txt.FanCurveTemp}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <TextBlock Style="{StaticResource Secondary}" Text="Hysteresis °C" VerticalAlignment="Center" />
                                        <TextBox Text="{Binding Hysteresis, UpdateSourceTrigger=PropertyChanged}" Width="60" Margin="8,0,0,0" AutomationProperties.Name="{x:Static t:Txt.FanCurveHysteresis}" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource GpuError}" Text="{Binding CurveError}" Visibility="{Binding CurveError, Converter={StaticResource NotEmptyToVis}}" />
                                    <TextBlock Style="{StaticResource GpuHint}" Text="{Binding CurveStatus}" Margin="0,8,0,0" />
                                    <TextBlock Style="{StaticResource GpuHint}" Text="{x:Static t:Txt.FanCurveNeedsAdmin}" Foreground="{StaticResource WarningBrush}" Visibility="{Binding CurveNeedsAdmin, Converter={StaticResource BoolToVis}}" />                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource GpuHint}" Text="{x:Static t:Txt.GpuTuningNote}" Foreground="{StaticResource WarningBrush}" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource CardTitle}" Text="{x:Static t:Txt.GpuVfCurve}" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource Secondary}" Text="{Binding VfSelectionLabel}" Margin="12,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox Style="{StaticResource GpuSwitch}" Content="Custom curve" IsChecked="{Binding VfActive}" IsEnabled="{Binding VfEnabled}" Margin="0,0,20,0" ToolTip="Off puts every point back to the driver's default curve (applied with Apply)" />
                                <TextBlock Style="{StaticResource Secondary}" Text="MHz" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox Text="{Binding VfTargetText, UpdateSourceTrigger=PropertyChanged}" Width="88" IsEnabled="{Binding VfActive}" ToolTip="Type a clock for the selected point and press Enter" AutomationProperties.Name="V/F point clock in MHz">
                                    <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding StageVfPointCommand}" /></TextBox.InputBindings>
                                </TextBox>
                                <TextBlock Style="{StaticResource Secondary}" Text="mV" VerticalAlignment="Center" Margin="12,0,6,0" />
                                <TextBox Text="{Binding VfSelectedVoltage, Mode=OneWay}" Width="86" IsReadOnly="True" IsTabStop="False" ToolTip="Voltage anchors are fixed by the driver" />
                                <Button Content="{Binding VfLockButtonText}" Command="{Binding VfCycleLockCommand}" MinWidth="110" Margin="16,0,0,0"
                                        ToolTip="Same as L on the chart: lock the selected point's voltage, then its clock, then unlock" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource GpuHint}" Text="{Binding VfProblem}" Visibility="{Binding VfProblem, Converter={StaticResource NotEmptyToVis}}" />
                        <StackPanel Visibility="{Binding VfEnabled, Converter={StaticResource BoolToVis}}">
                            <Border Background="#050505" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5">
                                <Grid Height="330" Margin="56,30,22,30">
                                    <TextBlock Text="Frequency (MHz)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="-50,-24,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-26,0,0" Padding="8,3" CornerRadius="4" Background="#1A1A1A" Panel.ZIndex="1"
                                            Visibility="{Binding HasVfSelection, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding VfSelectedTip}" FontSize="11" Foreground="{StaticResource TextBrush}" />
                                    </Border>
                                    <Canvas v:ChartSize.Track="True" v:ChartSize.Size="{Binding VfPlotSize, Mode=OneWayToSource}" Background="Transparent"
                                            v:ChartRange.Enabled="True" Focusable="True" FocusVisualStyle="{x:Null}" AutomationProperties.Name="V/F curve">
                                        <Canvas.InputBindings>
                                            <KeyBinding Key="L" Command="{Binding VfCycleLockCommand}" />
                                            <KeyBinding Key="Up" Command="{Binding VfNudgeCommand}" CommandParameter="1" />
                                            <KeyBinding Key="Down" Command="{Binding VfNudgeCommand}" CommandParameter="-1" />
                                            <KeyBinding Key="Up" Modifiers="Shift" Command="{Binding VfNudgeCommand}" CommandParameter="15" />
                                            <KeyBinding Key="Down" Modifiers="Shift" Command="{Binding VfNudgeCommand}" CommandParameter="-15" />
                                            <KeyBinding Key="A" Modifiers="Control" Command="{Binding VfSelectAllCommand}" />
                                            <KeyBinding Key="Escape" Command="{Binding VfClearSelectionCommand}" />
                                        </Canvas.InputBindings>
                                        <!-- Selection band (more than one point), a blue area. -->
                                        <Rectangle Canvas.Left="{Binding VfSelectionLeft}" Width="{Binding VfSelectionWidth}" Height="{Binding VfPlotHeight}" Fill="#2E3D4BFF" IsHitTestVisible="False"
                                                   Visibility="{Binding VfSelectionVisible, Converter={StaticResource BoolToVis}}" />
                                        <ItemsControl ItemsSource="{Binding VfYTicks}" Focusable="False">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Top" Value="{Binding Pos}" /></Style></ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Canvas>
                                                        <Line X1="0" X2="{Binding DataContext.VfPlotWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Stroke="#1EFFFFFF" />
                                                        <TextBlock Canvas.Left="-52" Canvas.Top="-8" Width="44" TextAlignment="Right" Text="{Binding Label}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                                    </Canvas>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <ItemsControl ItemsSource="{Binding VfXTicks}" Focusable="False">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding Pos}" /></Style></ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Canvas>
                                                        <Line Y1="0" Y2="{Binding DataContext.VfPlotHeight, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Stroke="#1EFFFFFF" />
                                                        <TextBlock Canvas.Top="{Binding DataContext.VfPlotHeight, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Margin="-24,8,0,0" Width="48" TextAlignment="Center" Text="{Binding Label}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                                    </Canvas>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <!-- Voltage lock: vertical line; clock lock: horizontal line with arrows at the ends. -->
                                        <Line X1="{Binding VfLockX}" X2="{Binding VfLockX}" Y1="0" Y2="{Binding VfPlotHeight}" Stroke="{StaticResource WarningBrush}" StrokeThickness="1.2" StrokeDashArray="4 3"
                                              IsHitTestVisible="False" Visibility="{Binding VfLockVisible, Converter={StaticResource BoolToVis}}" />
                                        <Canvas Canvas.Top="{Binding VfClockLockY}" IsHitTestVisible="False" Visibility="{Binding VfClockLockVisible, Converter={StaticResource BoolToVis}}">
                                            <Line X1="0" X2="{Binding VfPlotWidth}" Stroke="{StaticResource WarningBrush}" StrokeThickness="1.2" StrokeDashArray="2 2" />
                                            <Polygon Points="-6,-4 4,0 -6,4" Fill="{StaticResource WarningBrush}" />
                                            <Polygon Canvas.Left="{Binding VfPlotWidth}" Points="6,-4 -4,0 6,4" Fill="{StaticResource WarningBrush}" />
                                        </Canvas>
                                        <!-- Where the card is now: a line at the current voltage, like the temperature line on the fan curve; the dot (at the current clock) goes on top of the points. -->
                                        <Line X1="{Binding VfLiveX}" X2="{Binding VfLiveX}" Y1="0" Y2="{Binding VfPlotHeight}" Stroke="#E05555" StrokeThickness="1.5" StrokeDashArray="4 3"
                                              IsHitTestVisible="False" Visibility="{Binding VfLiveVisible, Converter={StaticResource BoolToVis}}" />
                                        <Polyline Points="{Binding VfStockPreview}" Stroke="#55FFFFFF" StrokeThickness="1" StrokeLineJoin="Round" IsHitTestVisible="False" />
                                        <Polyline Points="{Binding VfPreview}" Stroke="#8C8C8C" StrokeThickness="1.5" StrokeLineJoin="Round" IsHitTestVisible="False" />
                                        <Line X1="{Binding VfSelectedX}" X2="{Binding VfSelectedX}" Y1="0" Y2="{Binding VfPlotHeight}" Stroke="#1E9BE0" StrokeThickness="1" StrokeDashArray="4 3" IsHitTestVisible="False" Visibility="{Binding HasVfSelection, Converter={StaticResource BoolToVis}}" />
                                        <ItemsControl ItemsSource="{Binding VfPoints}" Focusable="False">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Canvas.Left" Value="{Binding PlotLeft}" /><Setter Property="Canvas.Top" Value="{Binding PlotTop}" /></Style></ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Thumb v:ChartDrag.Enabled="True" Cursor="SizeNS" ToolTip="{Binding Tip}" AutomationProperties.Name="{Binding Voltage}">
                                                        <Thumb.Template>
                                                            <ControlTemplate TargetType="Thumb">
                                                                <Rectangle x:Name="Dot" Width="8" Height="8" Fill="#8C8C8C" />
                                                                <ControlTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding Pending}" Value="True"><Setter TargetName="Dot" Property="Fill" Value="#1E9BE0" /></DataTrigger>
                                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Dot" Property="Fill" Value="#FFFFFF" /></Trigger>
                                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="Dot" Property="Fill" Value="#E8F4FF" /></DataTrigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Thumb.Template>
                                                    </Thumb>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <!-- Selected point: on top, without capturing the mouse (dragging still works on the square below). -->
                                        <Canvas Canvas.Left="{Binding VfSelectedX}" Canvas.Top="{Binding VfSelectedY}" IsHitTestVisible="False" Visibility="{Binding HasVfSelection, Converter={StaticResource BoolToVis}}">
                                            <Ellipse Canvas.Left="-6" Canvas.Top="-6" Width="12" Height="12" Fill="#1E9BE0" Stroke="#CFEFFF" StrokeThickness="1.5" />
                                        </Canvas>
                                        <Canvas Canvas.Left="{Binding VfLiveX}" Canvas.Top="{Binding VfLiveY}" IsHitTestVisible="False" Visibility="{Binding VfLiveVisible, Converter={StaticResource BoolToVis}}">
                                            <Ellipse Canvas.Left="-5" Canvas.Top="-5" Width="10" Height="10" Fill="#E05555" Stroke="#FFD6D6" StrokeThickness="1.5" />
                                        </Canvas>
                                    </Canvas>
                                </Grid>
                            </Border>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource GpuHint}" Text="Drag a square up or down, or type the clock in MHz (Enter). Ctrl+click adds or removes points, Shift+click or Shift+drag on the chart selects a range, Ctrl+A selects all; the selection moves together. ↑/↓ move 1 MHz (Shift: 15 MHz). Points to the right that would end up lower follow the moved point (flat curve)." />
                                    <TextBlock Style="{StaticResource GpuHint}" Text="L: lock the selected point's voltage, L again: lock its clock, L a third time: unlock. Blue = changed, not applied yet; the faint line is the driver's stock curve." />
                                    <TextBlock Style="{StaticResource GpuHint}" Text="{Binding VfRange}" />
                                    <TextBlock Style="{StaticResource GpuHint}" Text="{Binding VfLockStatus}" />
                                    <TextBlock Style="{StaticResource GpuHint}" Text="{Binding VfLiveText}" Visibility="{Binding VfLiveVisible, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Reset selected points" Command="{Binding ResetVfPointCommand}" VerticalAlignment="Top" Margin="12,0,0,0" />
                            </Grid>
                            <TextBlock Style="{StaticResource GpuHint}" Text="{Binding VfLockProblem}" Visibility="{Binding VfLockProblem, Converter={StaticResource NotEmptyToVis}}" />
                            <TextBlock Style="{StaticResource GpuError}" Text="{Binding VfError}" Visibility="{Binding VfError, Converter={StaticResource NotEmptyToVis}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{x:Static t:Txt.GpuGamemodeTitle}" Margin="0,0,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="250" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" MinWidth="250" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource GpuFieldLabel}" Text="{x:Static t:Txt.GpuGamemodeOn}" />
                                <ComboBox ItemsSource="{Binding GamemodeOnChoices}" SelectedItem="{Binding GamemodeOn, Mode=TwoWay}" AutomationProperties.Name="{x:Static t:Txt.GpuGamemodeOn}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource GpuFieldLabel}" Text="{x:Static t:Txt.GpuGamemodeOff}" />
                                <ComboBox ItemsSource="{Binding GamemodeOffChoices}" SelectedItem="{Binding GamemodeOff, Mode=TwoWay}" AutomationProperties.Name="{x:Static t:Txt.GpuGamemodeOff}" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource GpuError}" Text="{Binding GamemodeStatus}" Visibility="{Binding GamemodeStatus, Converter={StaticResource NotEmptyToVis}}" />
                        <TextBlock Style="{StaticResource GpuHint}" Text="{x:Static t:Txt.GpuGamemodeNote}" Margin="0,10,0,0" />
                        <TextBlock Style="{StaticResource GpuHint}" Text="{x:Static t:Txt.GpuGamemodeNeedsAdmin}" Foreground="{StaticResource WarningBrush}" Visibility="{Binding CurveNeedsAdmin, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Border>
              </StackPanel>
            </StackPanel>

            <!-- ===== Settings (NVIDIA panel), Display (EDID), DRS (driver profiles) and NVIDIA tool Tweaks (on Main, below the status): own templates ===== -->
            <!-- Last child: on the DRS tab (which scrolls on its own) it fills the window height. Without an NVIDIA card, only the warning above
                 and, with an AMD card, the tweaks (the AMD Radeon section). -->
            <Grid>
                <Grid Visibility="{Binding IsNvidia, Converter={StaticResource BoolToVis}}">
                    <ContentControl Content="{Binding Settings}" Focusable="False" VerticalAlignment="Top" Visibility="{Binding IsSettingsTab, Converter={StaticResource BoolToVis}}" />
                    <ContentControl Content="{Binding Display}" Focusable="False" Visibility="{Binding IsDisplayTab, Converter={StaticResource BoolToVis}}" />
                    <ContentControl Content="{Binding Drs}" Focusable="False" Visibility="{Binding IsDrsTab, Converter={StaticResource BoolToVis}}" />
                </Grid>
                <ContentControl Content="{Binding Tweaks}" Focusable="False" VerticalAlignment="Top" Visibility="{Binding ShowMainTweaks, Converter={StaticResource BoolToVis}}" />
                <ContentControl Content="{Binding Driver}" Focusable="False" VerticalAlignment="Top" Visibility="{Binding IsDriverTab, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </DockPanel>
    </DataTemplate>

    <!-- ===================== GPU › DRS (driver profiles) ===================== -->
    <!-- Setting value button: opens the editor (popup) right below. -->
    <Style x:Key="DrsValueButton" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Box" Height="32" CornerRadius="5" Background="{StaticResource ControlBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12,0,10,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="10" Margin="8,0,0,0" Foreground="{StaticResource TextSecondaryBrush}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="{StaticResource HoverBrush}" /></Trigger>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#4DA3FF" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Editor value list item: ✓ on the current one, name and the value in hex. -->
    <Style x:Key="DrsOptionButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="4" Padding="8,6">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#222222" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate DataType="{x:Type vm:DriverSettingsViewModel}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <ComboBox Width="170" ItemsSource="{Binding Filters}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding Filter}" VerticalAlignment="Center" AutomationProperties.Name="Filter" />
                <TextBlock Grid.Column="1" Style="{StaticResource Secondary}" Text="{Binding ProfilePrograms}" ToolTip="{Binding ProfilePrograms}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="12,0" />
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBox Width="280" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=150}" Tag="Search settings..." VerticalAlignment="Center" AutomationProperties.Name="Search settings" />
                    <Button Style="{StaticResource GpuToolButton}" Content="&#xE72C;" Command="{Binding ReloadCommand}" Margin="6,0,0,0" ToolTip="Reload values from the driver" AutomationProperties.Name="Reload" />
                    <Button Style="{StaticResource GpuToolButton}" Content="&#xE896;" Command="{Binding ImportCommand}" Margin="6,0,0,0" ToolTip="Import settings from a .nip (NVIDIA Profile Inspector) file" AutomationProperties.Name="Import" />
                    <Button Style="{StaticResource GpuToolButton}" Content="&#xE898;" Command="{Binding ExportCommand}" Margin="6,0,0,0" ToolTip="Export this profile's modified + pending settings to a .nip file" AutomationProperties.Name="Export" />
                    <Button Style="{StaticResource GpuToolButton}" Content="&#xE8A7;" Command="{Binding OpenInspectorCommand}" Margin="6,0,0,0" ToolTip="Open NVIDIA Profile Inspector" AutomationProperties.Name="Open NVIDIA Profile Inspector" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="0,10,0,0">
                <ListBox ItemsSource="{Binding View}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel" AutomationProperties.Name="Driver settings">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Secondary}" FontWeight="SemiBold" Margin="22,16,0,6" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bg" Background="Transparent" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,8,12,8">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#101010" /></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ToolTip="{Binding Tooltip}" ToolTipService.InitialShowDelay="900">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="250" /></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Description}" Style="{StaticResource Secondary}" FontSize="11.5" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                </StackPanel>
                                <!-- Dot: green = changed by you; gray = NVIDIA's value in this profile; yellow = pending. -->
                                <Ellipse Grid.Column="1" Width="8" Height="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPredefined}" Value="True"><Setter Property="Visibility" Value="Visible" /><Setter Property="Fill" Value="#7A7A7A" /><Setter Property="ToolTip" Value="NVIDIA's value for this profile" /></DataTrigger>
                                                <DataTrigger Binding="{Binding IsModified}" Value="True"><Setter Property="Visibility" Value="Visible" /><Setter Property="Fill" Value="#5CC98A" /><Setter Property="ToolTip" Value="Changed by you" /></DataTrigger>
                                                <DataTrigger Binding="{Binding IsPending}" Value="True"><Setter Property="Visibility" Value="Visible" /><Setter Property="Fill" Value="{StaticResource WarningBrush}" /><Setter Property="ToolTip" Value="Pending (press Apply)" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <Grid Grid.Column="2">
                                    <ToggleButton x:Name="ValueButton" Style="{StaticResource DrsValueButton}" IsChecked="{Binding IsEditing}" IsEnabled="{Binding CanEdit}"
                                                  AutomationProperties.Name="{Binding Name}">
                                        <TextBlock Text="{Binding ValueText}" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsInherited}" Value="True"><Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </ToggleButton>
                                    <Popup IsOpen="{Binding IsEditing, Mode=TwoWay}" PlacementTarget="{Binding ElementName=ValueButton}" Placement="Bottom" HorizontalOffset="-90" VerticalOffset="4"
                                           StaysOpen="False" AllowsTransparency="True" v:Motion.PopOnOpen="True">
                                        <Border Width="340" Background="#161616" BorderBrush="#2E2E2E" BorderThickness="1" CornerRadius="8" Padding="10">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                    <TextBox Text="{Binding CustomValue, UpdateSourceTrigger=PropertyChanged}" Tag="Custom Value" FontFamily="Consolas" AutomationProperties.Name="Custom value"
                                                             ToolTip="Decimal (240) or hexadecimal (0xF0); Enter applies">
                                                        <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding CustomCommand}" /></TextBox.InputBindings>
                                                    </TextBox>
                                                    <CheckBox Grid.Column="1" Content="Bitmask" IsChecked="{Binding Bitmask}" IsEnabled="{Binding CanBitmask}" Margin="10,0,0,0" VerticalAlignment="Center" />
                                                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE7A7;" FontSize="12" Width="28" Height="28" Margin="6,0,0,0"
                                                            Command="{Binding ResetCommand}" ToolTip="Back to the driver default for this profile" AutomationProperties.Name="Driver default" />
                                                </Grid>
                                                <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                    <Grid>
                                                        <ItemsControl ItemsSource="{Binding Options}" Focusable="False" Visibility="{Binding Bitmask, Converter={StaticResource InverseBoolToVis}}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Button Style="{StaticResource DrsOptionButton}" CommandParameter="{Binding}"
                                                                            Command="{Binding DataContext.ChooseCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE73E;" FontSize="11" Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}" />
                                                                            <TextBlock Grid.Column="1" Text="{Binding Label}" TextWrapping="Wrap" />
                                                                            <TextBlock Grid.Column="2" Text="{Binding Hex}" Style="{StaticResource Secondary}" FontFamily="Consolas" FontSize="11.5" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                                        </Grid>
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <ItemsControl ItemsSource="{Binding Bits}" Focusable="False" Visibility="{Binding Bitmask, Converter={StaticResource BoolToVis}}">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Grid Margin="8,3">
                                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                                        <CheckBox Content="{Binding Label}" IsChecked="{Binding IsOn}" />
                                                                        <TextBlock Grid.Column="1" Text="{Binding Hex}" Style="{StaticResource Secondary}" FontFamily="Consolas" FontSize="11.5" VerticalAlignment="Center" />
                                                                    </Grid>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Grid>
                                                </ScrollViewer>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="4,8,0,0">
                <TextBlock Text="{Binding LoadedText}" Style="{StaticResource Secondary}" />
                <TextBlock Style="{StaticResource PageMessage}" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <!-- ===================== GPU › Settings ===================== -->
    <!-- Settings tab row: label on the left, control on the right, thin line below. -->
    <Style x:Key="NvRow" TargetType="Grid">
        <Setter Property="MinHeight" Value="52" />
    </Style>
    <Style x:Key="NvLabel" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="NvLine" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{StaticResource BorderBrush}" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Grid.ColumnSpan" Value="2" />
    </Style>
    <Style x:Key="NvCombo" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="Width" Value="190" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="DisplayMemberPath" Value="Label" />
        <Setter Property="SelectedValuePath" Value="Value" />
    </Style>

    <DataTemplate DataType="{x:Type vm:GpuSettingsViewModel}">
        <StackPanel>
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

                    <!-- Left column: video output -->
                    <StackPanel>
                        <Grid Style="{StaticResource NvRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource NvLabel}" Text="Display Adapter" />
                            <ComboBox Grid.Column="1" Width="190" VerticalAlignment="Center" ItemsSource="{Binding Targets}" SelectedItem="{Binding SelectedTarget, Mode=TwoWay}"
                                      Visibility="{Binding HasManyTargets, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Display" />
                            <TextBox Grid.Column="1" Width="190" VerticalAlignment="Center" Text="{Binding TargetName, Mode=OneWay}" IsReadOnly="True" IsTabStop="False"
                                     Visibility="{Binding HasManyTargets, Converter={StaticResource InverseBoolToVis}}" />
                            <Border Style="{StaticResource NvLine}" />
                        </Grid>
                        <Grid Style="{StaticResource NvRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource NvLabel}" Text="Color Format" />
                            <ComboBox Grid.Column="1" Style="{StaticResource NvCombo}" ItemsSource="{Binding Formats}" SelectedValue="{Binding Format}" IsEnabled="{Binding ColorAvailable}" AutomationProperties.Name="Color format" />
                            <Border Style="{StaticResource NvLine}" />
                        </Grid>
                        <Grid Style="{StaticResource NvRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource NvLabel}" Text="Dynamic Range" />
                            <ComboBox Grid.Column="1" Style="{StaticResource NvCombo}" ItemsSource="{Binding Ranges}" SelectedValue="{Binding Range}" IsEnabled="{Binding ColorAvailable}" AutomationProperties.Name="Dynamic range" />
                            <Border Style="{StaticResource NvLine}" />
                        </Grid>
                        <Grid Style="{StaticResource NvRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource NvLabel}" Text="Color Depth" />
                            <ComboBox Grid.Column="1" Style="{StaticResource NvCombo}" ItemsSource="{Binding Depths}" SelectedValue="{Binding Depth}" IsEnabled="{Binding ColorAvailable}" AutomationProperties.Name="Color depth" />
                            <Border Style="{StaticResource NvLine}" />
                        </Grid>
                        <Grid Style="{StaticResource NvRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource NvLabel}" Text="Scaling Mode" />
                            <ComboBox Grid.Column="1" Style="{StaticResource NvCombo}" ItemsSource="{Binding ScaleModes}" SelectedValue="{Binding ScaleMode}" IsEnabled="{Binding ScaleModeEnabled}"
                                      ToolTip="How a resolution below the display's own is shown: Full-screen stretches it (4:3 stretched). Integer scaling needs Perform Scaling On: GPU."
                                      AutomationProperties.Name="Scaling mode" />
                            <Border Style="{StaticResource NvLine}" />
                        </Grid>
                        <Grid Style="{StaticResource NvRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource NvLabel}" Text="Perform Scaling On" />
                            <ComboBox Grid.Column="1" Style="{StaticResource NvCombo}" ItemsSource="{Binding ScaleTargets}" SelectedValue="{Binding ScaleOn}" AutomationProperties.Name="Perform scaling on" />
                            <Border Style="{StaticResource NvLine}" />
                        </Grid>
                        <Grid Style="{StaticResource NvRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource NvLabel}" Text="Override Scaling Set by Games and Programs" />
                            <CheckBox Grid.Column="1" Style="{StaticResource GpuOnOff}" IsChecked="{Binding ScalingOverride}" IsEnabled="{Binding OverrideAvailable}"
                                      ToolTip="Games and programs can't change the scaling chosen above. Changing it restarts the NVIDIA driver: the screen goes black for a few seconds."
                                      AutomationProperties.Name="Override the scaling mode set by games and programs" />
                            <Border Style="{StaticResource NvLine}" />
                        </Grid>
                        <Grid Style="{StaticResource NvRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource NvLabel}" Text="GPU Performance Counters for All Users" />
                            <CheckBox Grid.Column="1" Style="{StaticResource GpuOnOff}" IsChecked="{Binding CountersForAllUsers}" AutomationProperties.Name="GPU performance counters for all users" />
                        </Grid>
                    </StackPanel>

                    <!-- Right column: desktop color -->
                    <StackPanel Grid.Column="2">
                        <Grid Style="{StaticResource NvRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource NvLabel}" Text="HDR10" />
                            <CheckBox Grid.Column="1" Style="{StaticResource GpuOnOff}" IsChecked="{Binding Hdr}" IsEnabled="{Binding HdrSupported}" AutomationProperties.Name="HDR10" />
                            <Border Style="{StaticResource NvLine}" />
                        </Grid>
                        <Grid Style="{StaticResource NvRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource NvLabel}" Text="Color channel" />
                            <ComboBox Grid.Column="1" Style="{StaticResource NvCombo}" ItemsSource="{Binding Channels}" SelectedValue="{Binding Channel}" IsEnabled="{Binding Adjustable}" AutomationProperties.Name="Color channel" />
                            <Border Style="{StaticResource NvLine}" />
                        </Grid>
                        <Grid Style="{StaticResource NvRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /><ColumnDefinition Width="12" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource NvLabel}" Text="Brightness" />
                            <Slider Grid.Column="1" Style="{StaticResource GpuSlider}" Minimum="0" Maximum="100" Value="{Binding Brightness}" IsEnabled="{Binding Adjustable}" VerticalAlignment="Center" AutomationProperties.Name="Brightness" />
                            <TextBox Grid.Column="3" Text="{Binding Brightness, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding Adjustable}" VerticalAlignment="Center" />
                            <Border Style="{StaticResource NvLine}" Grid.ColumnSpan="4" />
                        </Grid>
                        <Grid Style="{StaticResource NvRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /><ColumnDefinition Width="12" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource NvLabel}" Text="Contrast" />
                            <Slider Grid.Column="1" Style="{StaticResource GpuSlider}" Minimum="0" Maximum="100" Value="{Binding Contrast}" IsEnabled="{Binding Adjustable}" VerticalAlignment="Center" AutomationProperties.Name="Contrast" />
                            <TextBox Grid.Column="3" Text="{Binding Contrast, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding Adjustable}" VerticalAlignment="Center" />
                            <Border Style="{StaticResource NvLine}" Grid.ColumnSpan="4" />
                        </Grid>
                        <Grid Style="{StaticResource NvRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /><ColumnDefinition Width="12" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource NvLabel}" Text="Gamma" />
                            <Slider Grid.Column="1" Style="{StaticResource GpuSlider}" Minimum="30" Maximum="280" Value="{Binding Gamma}" IsEnabled="{Binding Adjustable}" VerticalAlignment="Center" AutomationProperties.Name="Gamma" />
                            <TextBox Grid.Column="3" Text="{Binding GammaText, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding Adjustable}" VerticalAlignment="Center" />
                            <Border Style="{StaticResource NvLine}" Grid.ColumnSpan="4" />
                        </Grid>
                        <Grid Style="{StaticResource NvRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /><ColumnDefinition Width="12" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource NvLabel}" Text="Digital Vibrance" />
                            <Slider Grid.Column="1" Style="{StaticResource GpuSlider}" Minimum="0" Maximum="100" Value="{Binding Vibrance}" IsEnabled="{Binding VibranceAvailable}" VerticalAlignment="Center" AutomationProperties.Name="Digital vibrance" />
                            <TextBox Grid.Column="3" Text="{Binding Vibrance, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding VibranceAvailable}" VerticalAlignment="Center" />
                            <Border Style="{StaticResource NvLine}" Grid.ColumnSpan="4" />
                        </Grid>
                        <Grid Style="{StaticResource NvRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /><ColumnDefinition Width="12" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource NvLabel}" Text="Hue" />
                            <Slider Grid.Column="1" Style="{StaticResource GpuSlider}" Minimum="0" Maximum="359" Value="{Binding Hue}" IsEnabled="{Binding HueAvailable}" VerticalAlignment="Center" AutomationProperties.Name="Hue" />
                            <TextBox Grid.Column="3" Text="{Binding Hue, UpdateSourceTrigger=LostFocus}" IsEnabled="{Binding HueAvailable}" VerticalAlignment="Center" />
                            <Border Style="{StaticResource NvLine}" Grid.ColumnSpan="4" />
                        </Grid>
                        <Grid Style="{StaticResource NvRow}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource NvLabel}" Text="Override to Reference Mode" />
                            <CheckBox Grid.Column="1" Style="{StaticResource GpuOnOff}" IsChecked="{Binding ReferenceMode}"
                                      ToolTip="Shows the desktop without any of the color adjustments above (they are kept and come back when you turn this off)" AutomationProperties.Name="Override to reference mode" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
            <TextBlock Style="{StaticResource PageMessage}" TextWrapping="Wrap" Margin="2,10,0,0" />
            <TextBlock Style="{StaticResource GpuHint}" Margin="2,6,0,0"
                       Text="Changes apply right away. Color format, range, depth, scaling and HDR are kept by the driver/Windows; brightness, contrast, gamma, vibrance and hue set here are re-applied when the toolbox opens." />
        </StackPanel>
    </DataTemplate>

    <!-- ===================== GPU › Driver ===================== -->
    <DataTemplate x:Key="CheckItemBox" DataType="{x:Type vm:CheckItem}">
        <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding IsEnabled}" ToolTip="{Binding ToolTip}" ToolTipService.ShowOnDisabled="True"
                  AutomationProperties.Name="{Binding Name}" VerticalAlignment="Top" Margin="0,0,18,6">
            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
        </CheckBox>
    </DataTemplate>

    <!-- Fixed columns: names of any length line up -->
    <ItemsPanelTemplate x:Key="CheckItemGrid">
        <UniformGrid Columns="3" />
    </ItemsPanelTemplate>

    <DataTemplate DataType="{x:Type vm:GpuDriverViewModel}">
        <StackPanel>
            <!-- Installed driver: remove (pnputil /uninstall /force), install from an extracted folder, official download pages -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                <StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <ComboBox ItemsSource="{Binding DisplayVendors}" ItemTemplate="{StaticResource OptionText}" SelectedItem="{Binding SelectedVendor, Mode=TwoWay}"
                                      MinWidth="110" AutomationProperties.Name="{x:Static t:Txt.ColProvider}"
                                      Visibility="{Binding HasDisplayDriver, Converter={StaticResource BoolToVis}}" />
                            <Button Content="{x:Static t:Txt.RemoveDisplayDriver}" Margin="8,0,0,0" Command="{Binding RemoveDisplayCommand}" />
                            <Button Content="{x:Static t:Txt.InstallFromFolder}" Margin="8,0,0,0" Command="{Binding InstallFromFolderCommand}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource CardTitle}" Text="{x:Static t:Txt.DisplayDriverTitle}" />
                            <TextBlock Style="{StaticResource Secondary}" Text="{Binding DisplayDriverText}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <CheckBox Content="{x:Static t:Txt.AlsoRemoveAudio}" IsChecked="{Binding AlsoRemoveAudio}" Margin="0,8,0,0"
                              Visibility="{Binding HasDisplayDriver, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.DisplayDownloadNote}" TextWrapping="Wrap" Margin="0,8,0,6" />
                    <ItemsControl ItemsSource="{Binding DownloadLinks}" Focusable="False">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource LinkButton}" Content="{Binding Label}" Margin="0,0,16,0" CommandParameter="{Binding Key}"
                                        Command="{Binding DataContext.OpenUrlCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- NVIDIA driver: list from NVIDIA, download, components, install (elevated, silent setup.exe) -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,10" Visibility="{Binding IsNvidia, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{x:Static t:Txt.NvidiaDriverTitle}" />
                    <WrapPanel Margin="0,10,0,0">
                        <ComboBox ItemsSource="{Binding DriverTypes}" ItemTemplate="{StaticResource OptionText}" SelectedItem="{Binding SelectedDriverType, Mode=TwoWay}"
                                  MinWidth="120" Margin="0,0,8,6" AutomationProperties.Name="{x:Static t:Txt.NvidiaDriverTitle}" />
                        <Button Content="{x:Static t:Txt.FindDrivers}" Command="{Binding FindCommand}" Margin="0,0,8,6" />
                        <Button Content="{x:Static t:Txt.FindAllDrivers}" Command="{Binding FindAllCommand}" ToolTip="{x:Static t:Txt.FindAllDriversTip}" Margin="0,0,8,6" />
                        <ComboBox ItemsSource="{Binding Releases}" ItemTemplate="{StaticResource OptionText}" SelectedItem="{Binding SelectedRelease, Mode=TwoWay}"
                                  MinWidth="260" Margin="0,0,8,6" AutomationProperties.Name="{x:Static t:Txt.NvidiaDriverTitle}"
                                  Visibility="{Binding HasReleases, Converter={StaticResource BoolToVis}}" />
                        <Button Content="{x:Static t:Txt.DownloadDriver}" Command="{Binding DownloadCommand}" Margin="0,0,8,6"
                                Visibility="{Binding HasReleases, Converter={StaticResource BoolToVis}}" />
                        <Button Content="{x:Static t:Txt.UseDownloadedFile}" Command="{Binding UseFileCommand}" Margin="0,0,8,6" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Secondary}" Text="{Binding LookupNote}" TextWrapping="Wrap" Margin="0,2,0,0"
                               Visibility="{Binding LookupNote, Converter={StaticResource NotEmptyToVis}}" />
                    <TextBlock Style="{StaticResource Secondary}" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,2,0,0"
                               Visibility="{Binding Status, Converter={StaticResource NotEmptyToVis}}" />
                    <StackPanel Margin="0,10,0,0" Visibility="{Binding HasPackage, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding PackageText}" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static t:Txt.NvidiaComponentsTitle}" Margin="0,12,0,2" />
                        <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.NvidiaComponentsNote}" Margin="0,0,0,8" />
                        <ItemsControl ItemsSource="{Binding Components}" ItemTemplate="{StaticResource CheckItemBox}" ItemsPanel="{StaticResource CheckItemGrid}" Focusable="False" />
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static t:Txt.NvidiaAfterInstallTitle}" Margin="0,10,0,8" />
                        <CheckBox Content="{x:Static t:Txt.CleanInstall}" IsChecked="{Binding CleanInstall}" Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding PostInstallTweaks}" ItemTemplate="{StaticResource CheckItemBox}" ItemsPanel="{StaticResource CheckItemGrid}" Focusable="False" />
                        <DockPanel Margin="0,8,0,0">
                            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="{x:Static t:Txt.InstallDriver}" Command="{Binding InstallCommand}" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.NvidiaInstallNote}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0" />
                        </DockPanel>
                        <StackPanel Margin="0,10,0,0" Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVis}}">
                            <ProgressBar Maximum="100" Value="{Binding InstallPercent, Mode=OneWay}" IsIndeterminate="{Binding InstallIndeterminate}" />
                            <TextBlock Style="{StaticResource Secondary}" Text="{Binding InstallStep}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- The Windows › System › Updates item itself (same view model): Windows Update can replace a driver installed here. -->
            <ContentControl Content="{Binding WindowsUpdateDrivers}" Focusable="False" Margin="0,0,0,10" />

            <!-- Display Driver Uninstaller, through its command line; now or in Safe Mode (RunOnce + safeboot) -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <ComboBox DockPanel.Dock="Right" ItemsSource="{Binding DduVendors}" ItemTemplate="{StaticResource OptionText}" SelectedItem="{Binding SelectedDduVendor, Mode=TwoWay}"
                                  MinWidth="110" VerticalAlignment="Top" AutomationProperties.Name="{x:Static t:Txt.DduVendor}"
                                  Visibility="{Binding DduAvailable, Converter={StaticResource BoolToVis}}" />
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Style="{StaticResource CardTitle}" Text="{x:Static t:Txt.DduTitle}" />
                            <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.DduNote}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Secondary}" Text="{Binding DduMissing}" TextWrapping="Wrap" Foreground="{StaticResource WarningBrush}" Margin="0,8,0,0"
                               Visibility="{Binding DduMissing, Converter={StaticResource NotEmptyToVis}}" />
                    <StackPanel Visibility="{Binding DduAvailable, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static t:Txt.DduOptionsTitle}" Margin="0,12,0,8" />
                        <ItemsControl ItemsSource="{Binding DduOptions}" ItemTemplate="{StaticResource CheckItemBox}" ItemsPanel="{StaticResource CheckItemGrid}" Focusable="False" />
                        <DockPanel Margin="0,8,0,0">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="{x:Static t:Txt.DduRunNow}" Command="{Binding DduNowCommand}" />
                                <Button Style="{StaticResource PrimaryButton}" Content="{x:Static t:Txt.DduRunSafeMode}" Command="{Binding DduSafeModeCommand}" Margin="8,0,0,0" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.DduSafeModeNote}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0" />
                        </DockPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
