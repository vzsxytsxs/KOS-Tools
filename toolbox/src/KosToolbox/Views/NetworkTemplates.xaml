<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:KosToolbox.ViewModels"
                    xmlns:v="clr-namespace:KosToolbox.Views"
                    xmlns:t="clr-namespace:KosToolbox.Core.Text;assembly=KosToolbox.Core">

    <!-- ===================== Network ===================== -->
    <Style x:Key="NicLabel" TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
    <Style x:Key="NicValue" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="NicKeyword" TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Margin" Value="0,1,0,0" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <!-- "★ recommended value": clicking selects the recommended one; dimmed when it is already in effect. -->
    <Style x:Key="NicRecommended" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="#4DA3FF" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <TextBlock x:Name="t" Text="{TemplateBinding Content}" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="t" Property="TextDecorations" Value="Underline" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="t" Property="Foreground" Value="{StaticResource TextSecondaryBrush}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Clickable section header (expands/collapses). -->
    <Style x:Key="NicSectionHeader" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="Transparent" Padding="16,12" CornerRadius="6,6,0,0">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#101010" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="NicSection" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style x:Key="NicChevron" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
        <Setter Property="Text" Value="&#xE70D;" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
    </Style>
    <v:ChevronAngle x:Key="ChevronAngle" />
    <!-- The theme sets MinWidth 190 on every ComboBox: here the box takes the column width (otherwise it gets clipped). -->
    <Style x:Key="NicEditor" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Width" Value="170" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Advanced adapter property: name (⚠ if the driver doesn't list it), keyword, ★ recommended and the value. -->
    <DataTemplate DataType="{x:Type vm:NetPropertyViewModel}">
        <Grid Margin="0,4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="170" /></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource WarningBrush}" Margin="0,0,6,0" VerticalAlignment="Center" ToolTip="Pending (press Apply)"
                             Visibility="{Binding IsModified, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="11" Foreground="{StaticResource WarningBrush}" Margin="6,0,0,0"
                               ToolTip="{Binding UnlistedTip}" Visibility="{Binding IsUnlisted, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <TextBlock Style="{StaticResource NicKeyword}" Text="{Binding Keyword}" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource NicRecommended}" Content="{Binding RecommendedLabel}" Command="{Binding UseRecommendedCommand}"
                    ToolTip="KOS recommended value — click to use it" Visibility="{Binding HasRecommended, Converter={StaticResource BoolToVis}}" />
            <Grid Grid.Column="2">
                <ComboBox Style="{StaticResource NicEditor}" ItemsSource="{Binding Options}" ItemTemplate="{StaticResource OptionText}" SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                          AutomationProperties.Name="{Binding Name}" Visibility="{Binding IsEnum, Converter={StaticResource BoolToVis}}" />
                <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Tag="Enter value..." VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}"
                         ToolTip="{Binding Hint}" Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}" />
                <TextBlock Style="{StaticResource Icon}" Text="&#xE783;" FontSize="12" Foreground="{StaticResource ErrorBrush}" HorizontalAlignment="Right" Margin="0,0,8,0"
                           ToolTip="{Binding Error}" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </Grid>
    </DataTemplate>

    <!-- Global TCP/UDP parameter. -->
    <DataTemplate DataType="{x:Type vm:NetGlobalViewModel}">
        <Grid Margin="0,4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="170" /></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource WarningBrush}" Margin="0,0,6,0" VerticalAlignment="Center" ToolTip="Pending (press Apply)"
                             Visibility="{Binding IsModified, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Style="{StaticResource NicKeyword}" Text="{Binding Key}" />
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource NicRecommended}" Content="{Binding RecommendedLabel}" Command="{Binding UseRecommendedCommand}"
                    ToolTip="KOS recommended value — click to use it" Visibility="{Binding HasRecommended, Converter={StaticResource BoolToVis}}" />
            <Grid Grid.Column="2">
                <ComboBox Style="{StaticResource NicEditor}" ItemsSource="{Binding Options}" ItemTemplate="{StaticResource OptionText}" SelectedItem="{Binding SelectedOption, Mode=TwoWay}"
                          AutomationProperties.Name="{Binding Name}" Visibility="{Binding IsEnum, Converter={StaticResource BoolToVis}}" />
                <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}"
                         Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}" />
                <TextBlock Style="{StaticResource Icon}" Text="&#xE783;" FontSize="12" Foreground="{StaticResource ErrorBrush}" HorizontalAlignment="Right" Margin="0,0,8,0"
                           ToolTip="{Binding Error}" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </Grid>
    </DataTemplate>

    <!-- Adapter binding. -->
    <DataTemplate DataType="{x:Type vm:NetBindingViewModel}">
        <Grid Margin="0,5">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" Fill="{StaticResource WarningBrush}" Margin="0,0,6,0" VerticalAlignment="Center" ToolTip="Pending (press Apply)"
                             Visibility="{Binding IsModified, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Style="{StaticResource NicKeyword}" Text="{Binding ComponentId}" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{Binding RecommendedLabel}" Foreground="#4DA3FF" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,10,0"
                       Visibility="{Binding HasRecommended, Converter={StaticResource BoolToVis}}" />
            <CheckBox Grid.Column="2" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}" />
        </Grid>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:NetworkPageViewModel}">
        <StackPanel>
            <!-- One tab per adapter; on the right: virtual, restart adapter, recommended, undo, restore originals, apply. -->
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <ItemsControl ItemsSource="{Binding Tabs}" Focusable="False" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource GpuTabButton}" Command="{Binding DataContext.SelectTabCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding Key}" AutomationProperties.Name="{Binding Label}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox Style="{StaticResource GpuToolToggle}" Content="&#xE8F1;" IsChecked="{Binding ShowVirtual}" ToolTip="{x:Static t:Txt.ShowVirtualAdapters}"
                              AutomationProperties.Name="{x:Static t:Txt.ShowVirtualAdapters}" />
                    <CheckBox Style="{StaticResource GpuToolToggle}" Content="&#xE7BA;" IsChecked="{Binding ShowUnlisted}" Margin="6,0,0,0" AutomationProperties.Name="{x:Static t:Txt.ShowUnlistedSettings}"
                              ToolTip="Show settings this driver doesn't list (⚠): known keywords that aren't in its list or in the registry. With this on, Recommended adds them too." />
                    <Border Width="1" Height="22" Background="{StaticResource BorderBrush}" Margin="10,0" />
                    <Button Style="{StaticResource GpuToolButton}" Content="&#xE895;" Command="{Binding RestartCommand}" ToolTip="Restart the adapter (the connection drops for a few seconds)"
                            AutomationProperties.Name="{x:Static t:Txt.RestartAdapter}" />
                    <Button Style="{StaticResource GpuToolButton}" Content="&#xE945;" Command="{Binding RecommendedCommand}" Margin="6,0,0,0"
                            ToolTip="Mark every KOS recommended value (they stay pending until Apply). Keywords this driver doesn't have are added only when the ⚠ button (show settings this driver doesn't list) is on." AutomationProperties.Name="Recommended values" />
                    <Button Style="{StaticResource GpuToolButton}" Content="&#xE7A7;" Command="{Binding DiscardCommand}" Margin="6,0,0,0" ToolTip="Discard pending changes" AutomationProperties.Name="{x:Static t:Txt.Discard}" />
                    <Button Style="{StaticResource GpuToolButton}" Content="&#xE777;" Command="{Binding RestoreCommand}" Margin="6,0,0,0" ToolTip="{x:Static t:Txt.RestoreOriginalTooltip}"
                            AutomationProperties.Name="{x:Static t:Txt.RestoreOriginal}" />
                    <Button Style="{StaticResource GpuToolApply}" Content="&#xE73E;" Command="{Binding ApplyCommand}" Margin="6,0,0,0" ToolTip="{Binding PendingText}" AutomationProperties.Name="{x:Static t:Txt.Apply}" />
                </StackPanel>
            </Grid>
            <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.NoAdapters}" Margin="2,0,0,10" Visibility="{Binding HasAdapters, Converter={StaticResource InverseBoolToVis}}" />
            <TextBlock Style="{StaticResource Secondary}" Text="{Binding LoadError}" Foreground="{StaticResource ErrorBrush}" Margin="2,0,0,10"
                       Visibility="{Binding LoadError, Converter={StaticResource NotEmptyToVis}}" />

            <StackPanel Visibility="{Binding HasAdapters, Converter={StaticResource BoolToVis}}">
                <!-- Adapter and driver -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Style="{StaticResource CardTitle}" FontSize="16" Text="{Binding AdapterName}" VerticalAlignment="Center" />
                            <Border Background="#1E4E8C" CornerRadius="4" Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="NDIS DRIVER" FontSize="10.5" FontWeight="SemiBold" Foreground="#CFE3FF" />
                            </Border>
                        </StackPanel>
                        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,0,0,12" />
                        <UniformGrid Columns="6">
                            <StackPanel Margin="0,0,12,0" ToolTip="{Binding DriverProvider}">
                                <TextBlock Style="{StaticResource NicLabel}" Text="Manufacturer" />
                                <TextBlock Style="{StaticResource NicValue}" Text="{Binding Manufacturer}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Style="{StaticResource NicLabel}" Text="Status" />
                                <TextBlock Style="{StaticResource NicValue}" Text="{Binding AdapterStatus}" Foreground="#4DA3FF" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Style="{StaticResource NicLabel}" Text="Hardware ID" />
                                <TextBlock Style="{StaticResource NicValue}" Text="{Binding HardwareId}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Style="{StaticResource NicLabel}" Text="Driver Version" />
                                <TextBlock Style="{StaticResource NicValue}" Text="{Binding DriverVersion}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Style="{StaticResource NicLabel}" Text="Driver File" />
                                <TextBlock Style="{StaticResource NicValue}" Text="{Binding DriverFile}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource NicLabel}" Text="Registry Key" />
                                <TextBlock Style="{StaticResource NicValue}" Text="{Binding RegistryKey}" FontFamily="Consolas" />
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- Advanced properties -->
                <Border Style="{StaticResource NicSection}">
                    <StackPanel>
                        <Button Style="{StaticResource NicSectionHeader}" Command="{Binding ToggleCommand}" CommandParameter="advanced">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE713;" FontSize="16" Margin="0,0,10,0" />
                                    <TextBlock Text="Advanced Adapter Properties" FontSize="15" FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource NicChevron}" v:Motion.Angle="{Binding AdvancedOpen, Converter={StaticResource ChevronAngle}}" />
                            </Grid>
                        </Button>
                        <StackPanel Margin="18,4,18,14" Visibility="Collapsed" Opacity="0" v:Motion.RevealWhen="{Binding AdvancedOpen}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="36" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <ItemsControl ItemsSource="{Binding AdvancedLeft}" Focusable="False" />
                                <ItemsControl Grid.Column="2" ItemsSource="{Binding AdvancedRight}" Focusable="False" />
                            </Grid>
                            <TextBlock Style="{StaticResource Secondary}" FontSize="11.5" Text="{Binding UnlistedNote}" Margin="0,10,0,0" TextWrapping="Wrap"
                                       Visibility="{Binding UnlistedNote, Converter={StaticResource NotEmptyToVis}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Interrupt moderation -->
                <Border Style="{StaticResource NicSection}" Visibility="{Binding HasInterrupt, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Button Style="{StaticResource NicSectionHeader}" Command="{Binding ToggleCommand}" CommandParameter="interrupt">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE950;" FontSize="16" Margin="0,0,10,0" />
                                    <TextBlock Text="Interrupt Moderation" FontSize="15" FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource NicChevron}" v:Motion.Angle="{Binding InterruptOpen, Converter={StaticResource ChevronAngle}}" />
                            </Grid>
                        </Button>
                        <StackPanel Margin="18,4,18,14" Visibility="Collapsed" Opacity="0" v:Motion.RevealWhen="{Binding InterruptOpen}">
                            <Border Background="#141414" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE7BA;" FontSize="13" Margin="0,1,10,0" VerticalAlignment="Top" />
                                    <TextBlock Grid.Column="1" Text="{Binding InterruptNote}" TextWrapping="Wrap" MaxWidth="760" HorizontalAlignment="Left" Style="{StaticResource Secondary}" />
                                </Grid>
                            </Border>
                            <ItemsControl ItemsSource="{Binding InterruptRows}" Focusable="False" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- RSS -->
                <Border Style="{StaticResource NicSection}" Visibility="{Binding HasRss, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Button Style="{StaticResource NicSectionHeader}" Command="{Binding ToggleCommand}" CommandParameter="rss">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE9F5;" FontSize="16" Margin="0,0,10,0" />
                                    <TextBlock Text="Receive Side Scaling" FontSize="15" FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource NicChevron}" v:Motion.Angle="{Binding RssOpen, Converter={StaticResource ChevronAngle}}" />
                            </Grid>
                        </Button>
                        <ItemsControl Margin="18,4,18,14" ItemsSource="{Binding RssRows}" Focusable="False" Visibility="Collapsed" Opacity="0" v:Motion.RevealWhen="{Binding RssOpen}" />
                    </StackPanel>
                </Border>

                <!-- Global TCP / UDP / offload -->
                <Border Style="{StaticResource NicSection}">
                    <StackPanel>
                        <Button Style="{StaticResource NicSectionHeader}" Command="{Binding ToggleCommand}" CommandParameter="globals">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE774;" FontSize="16" Margin="0,0,10,0" />
                                    <TextBlock Text="TCP &amp; UDP Global Parameters" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Secondary}" Text="system-wide (every adapter)" FontSize="11.5" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource NicChevron}" v:Motion.Angle="{Binding GlobalsOpen, Converter={StaticResource ChevronAngle}}" />
                            </Grid>
                        </Button>
                        <TextBlock Style="{StaticResource Secondary}" Text="Loading…" Margin="18,0,18,14" Visibility="{Binding SlowLoading, Converter={StaticResource BoolToVis}}" />
                        <Grid Margin="18,4,18,14" Visibility="Collapsed" Opacity="0" v:Motion.RevealWhen="{Binding GlobalsOpen}">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="36" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <ItemsControl ItemsSource="{Binding GlobalsLeft}" Focusable="False" />
                            <ItemsControl Grid.Column="2" ItemsSource="{Binding GlobalsRight}" Focusable="False" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- DNS: applies right away (not a pending change). -->
                <Border Style="{StaticResource NicSection}" Visibility="{Binding HasDns, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Button Style="{StaticResource NicSectionHeader}" Command="{Binding ToggleCommand}" CommandParameter="dns">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE774;" FontSize="16" Margin="0,0,10,0" />
                                    <TextBlock Text="DNS" FontSize="15" FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource NicChevron}" v:Motion.Angle="{Binding DnsOpen, Converter={StaticResource ChevronAngle}}" />
                            </Grid>
                        </Button>
                        <StackPanel Margin="18,4,18,14" Visibility="Collapsed" Opacity="0" v:Motion.RevealWhen="{Binding DnsOpen}">
                            <StackPanel Orientation="Horizontal">
                                <ItemsControl Style="{StaticResource Segmented}" ItemsSource="{Binding DnsChoices}" Tag="{Binding SelectDnsCommand}" VerticalAlignment="Center"
                                              AutomationProperties.Name="DNS servers" ToolTip="DNS servers of this adapter, IPv4 and IPv6. Choosing one applies it right away." />
                                <CheckBox Content="Encrypt (DNS over HTTPS)" IsChecked="{Binding DnsEncrypted, Mode=OneWay}" Command="{Binding ToggleDnsEncryptionCommand}" Margin="16,0,0,0" VerticalAlignment="Center"
                                          ToolTip="Queries go to the provider over HTTPS with the address Windows already knows for it, with no fallback to plain DNS. Not available with the servers DHCP gives." ToolTipService.ShowOnDisabled="True" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Secondary}" Text="{Binding DnsStatus}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Bindings -->
                <Border Style="{StaticResource NicSection}" Visibility="{Binding HasBindings, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Button Style="{StaticResource NicSectionHeader}" Command="{Binding ToggleCommand}" CommandParameter="bindings">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8FD;" FontSize="16" Margin="0,0,10,0" />
                                    <TextBlock Text="Adapter Bindings" FontSize="15" FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource NicChevron}" v:Motion.Angle="{Binding BindingsOpen, Converter={StaticResource ChevronAngle}}" />
                            </Grid>
                        </Button>
                        <TextBlock Style="{StaticResource Secondary}" Text="Loading…" Margin="18,0,18,14" Visibility="{Binding SlowLoading, Converter={StaticResource BoolToVis}}" />
                        <Grid Margin="18,4,18,14" Visibility="Collapsed" Opacity="0" v:Motion.RevealWhen="{Binding BindingsOpen}">
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="36" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <ItemsControl ItemsSource="{Binding BindingsLeft}" Focusable="False" />
                            <ItemsControl Grid.Column="2" ItemsSource="{Binding BindingsRight}" Focusable="False" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
            <TextBlock Style="{StaticResource PageMessage}" />
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
