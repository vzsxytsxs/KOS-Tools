<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:KosToolbox.ViewModels"
                    xmlns:v="clr-namespace:KosToolbox.Views"
                    xmlns:t="clr-namespace:KosToolbox.Core.Text;assembly=KosToolbox.Core">

    <!-- ===================== Peripherals ===================== -->
    <!-- A device of the list: icon by its guessed kind, name, VID:PID (after Bluetooth when it is connected that way). -->
    <DataTemplate x:Key="PeripheralRow">
        <Button Style="{StaticResource HomeRow}" Height="52" AutomationProperties.Name="{Binding Name}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="18" Width="22" Margin="0,0,14,0" ToolTip="{Binding KindText}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="name" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                    <TextBlock Text="{Binding Sub}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </Button>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="name" Property="FontWeight" Value="SemiBold" /></DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <Style x:Key="HidHeader" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0,0,16,6" />
    </Style>
    <Style x:Key="HidCell" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,5,16,5" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <!-- Segmented choices that share the column's width (stages, rates, effects), so they fit the narrow controls column. -->
    <Style x:Key="PeriSegmentButton" TargetType="Button" BasedOn="{StaticResource SegmentButton}">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="6,5" />
    </Style>
    <Style x:Key="PeriSegmented" TargetType="ItemsControl" BasedOn="{StaticResource Segmented}">
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Button Style="{StaticResource PeriSegmentButton}" Content="{Binding Label}" AutomationProperties.Name="{Binding Label}"
                            Command="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Key}" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PeriLabel" TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style x:Key="PeriField" TargetType="StackPanel">
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <!-- Color presets: each fills a color box through the command in Tag (CommandParameter: "#RRGGBB"). -->
    <Style x:Key="PeriSwatches" TargetType="ItemsControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></Setter.Value></Setter>
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Button Command="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"
                            AutomationProperties.Name="{Binding}" ToolTip="{Binding}" Cursor="Hand" Margin="0,0,8,6" FocusVisualStyle="{StaticResource FocusVisual}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Ellipse x:Name="dot" Width="22" Height="22" Fill="{Binding}" Stroke="{StaticResource BorderStrongBrush}" StrokeThickness="1" />
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="dot" Property="Stroke" Value="{StaticResource TextBrush}" /><Setter TargetName="dot" Property="StrokeThickness" Value="2" /></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Device pictures ===================== -->
    <!-- One picture per kind (mice: a rendered mouse; the dock, headset, keyboard and controller are drawn here); the light (LedBrush: the color and brightness the controls show,
         null while off) glows where the device has it. Dark plastic on the dark stage whatever the theme. -->
    <LinearGradientBrush x:Key="ArtBody" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#141414" Offset="0" /><GradientStop Color="#2B2B2B" Offset="0.42" /><GradientStop Color="#232323" Offset="0.6" /><GradientStop Color="#101010" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ArtStage" Color="#111111" /> <!-- the mouse picture's own background -->
    <SolidColorBrush x:Key="ArtEdge" Color="#3C3C3C" />
    <SolidColorBrush x:Key="ArtDark" Color="#0A0A0A" />
    <DropShadowEffect x:Key="ArtShadow" BlurRadius="34" ShadowDepth="10" Direction="270" Opacity="0.75" Color="#000000" />
    <BlurEffect x:Key="ArtGlow" Radius="22" />

    <!-- The light: a dark lens, the glow behind and the lit lens on top; Data is the lens shape. -->
    <Style x:Key="ArtLens" TargetType="Path">
        <Setter Property="Fill" Value="{StaticResource ArtDark}" />
        <Setter Property="Stroke" Value="#262626" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Visibility" Value="{Binding HasLight, Converter={StaticResource BoolToVis}}" />
    </Style>
    <Style x:Key="ArtLit" TargetType="Path">
        <Setter Property="Fill" Value="{Binding LedBrush}" />
        <Setter Property="StrokeThickness" Value="0" />
    </Style>
    <!-- The glow: the lens drawn wider (a thick stroke in the light's color) and blurred, centered on the lens itself. -->
    <Style x:Key="ArtGlowPath" TargetType="Path" BasedOn="{StaticResource ArtLit}">
        <Setter Property="Stroke" Value="{Binding LedBrush}" />
        <Setter Property="StrokeThickness" Value="18" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="Effect" Value="{StaticResource ArtGlow}" />
    </Style>

    <!-- Mice: a rendered mouse (Assets/mouse.png, its own light painted out) with the light drawn over the palm, where the logo sits. -->
    <DataTemplate x:Key="ArtMouse">
        <Canvas Width="300" Height="550" ClipToBounds="True">
            <Image Source="pack://application:,,,/KosToolbox;component/Assets/mouse.png" Width="480" Height="640" Canvas.Left="-90" Canvas.Top="-40" RenderOptions.BitmapScalingMode="HighQuality" />
            <Path Style="{StaticResource ArtLens}" Fill="#101010" Stroke="#1C1C1C" Data="M149,380 A13.5,13.5 0 1 1 148.9,380 Z" />
            <Path Style="{StaticResource ArtGlowPath}" StrokeThickness="26" Data="M149,380 A13.5,13.5 0 1 1 148.9,380 Z" />
            <Path Style="{StaticResource ArtLit}" Data="M149,380 A13.5,13.5 0 1 1 148.9,380 Z" />
        </Canvas>
    </DataTemplate>

    <!-- Charging dock: a round base with the light ring and the charging contacts in the middle. -->
    <DataTemplate x:Key="ArtDock">
        <Canvas Width="260" Height="270">
            <Rectangle Canvas.Left="120" Canvas.Top="240" Width="20" Height="30" RadiusX="4" RadiusY="4" Fill="#161616" Stroke="{StaticResource ArtEdge}" />
            <Ellipse Canvas.Left="10" Canvas.Top="10" Width="240" Height="240" Stroke="{StaticResource ArtEdge}" StrokeThickness="1.2" Effect="{StaticResource ArtShadow}">
                <Ellipse.Fill>
                    <RadialGradientBrush Center="0.4,0.3" GradientOrigin="0.4,0.3" RadiusX="0.7" RadiusY="0.7">
                        <GradientStop Color="#2C2C2C" Offset="0" /><GradientStop Color="#121212" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Path Style="{StaticResource ArtLens}" Fill="{x:Null}" Stroke="{StaticResource ArtDark}" StrokeThickness="9" Data="M130,26 A104,104 0 1 1 129.9,26 Z" />
            <Path Style="{StaticResource ArtLit}" Fill="{x:Null}" Stroke="{Binding LedBrush}" StrokeThickness="14" Effect="{StaticResource ArtGlow}" Data="M130,26 A104,104 0 1 1 129.9,26 Z" />
            <Path Style="{StaticResource ArtLit}" Fill="{x:Null}" Stroke="{Binding LedBrush}" StrokeThickness="5" Data="M130,26 A104,104 0 1 1 129.9,26 Z" />
            <Ellipse Canvas.Left="38" Canvas.Top="38" Width="184" Height="184" Stroke="#2A2A2A">
                <Ellipse.Fill>
                    <RadialGradientBrush><GradientStop Color="#1C1C1C" Offset="0" /><GradientStop Color="#0E0E0E" Offset="1" /></RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Canvas.Left="114" Canvas.Top="114" Width="32" Height="32" Fill="{StaticResource ArtDark}" Stroke="{StaticResource ArtEdge}" />
            <Ellipse Canvas.Left="122" Canvas.Top="127" Width="6" Height="6" Fill="#8A7A4A" />
            <Ellipse Canvas.Left="132" Canvas.Top="127" Width="6" Height="6" Fill="#8A7A4A" />
        </Canvas>
    </DataTemplate>

    <!-- Headset, from the front: the band, two cups (lit where the device has a light) and the mic. -->
    <DataTemplate x:Key="ArtHeadset">
        <Canvas Width="240" Height="250">
            <Path Stroke="#303030" StrokeThickness="18" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M50,136 C50,34 190,34 190,136" Effect="{StaticResource ArtShadow}" />
            <Path Stroke="#1A1A1A" StrokeThickness="12" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M50,136 C50,34 190,34 190,136" />
            <Path Fill="{x:Null}" Stroke="#141414" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M34,212 C38,244 82,246 106,232" />
            <Ellipse Canvas.Left="100" Canvas.Top="226" Width="13" Height="13" Fill="#1E1E1E" Stroke="{StaticResource ArtEdge}" />
            <Rectangle Canvas.Left="20" Canvas.Top="128" Width="56" Height="92" RadiusX="26" RadiusY="26" Fill="{StaticResource ArtBody}" Stroke="{StaticResource ArtEdge}" Effect="{StaticResource ArtShadow}" />
            <Rectangle Canvas.Left="164" Canvas.Top="128" Width="56" Height="92" RadiusX="26" RadiusY="26" Fill="{StaticResource ArtBody}" Stroke="{StaticResource ArtEdge}" Effect="{StaticResource ArtShadow}" />
            <Rectangle Canvas.Left="70" Canvas.Top="138" Width="14" Height="72" RadiusX="7" RadiusY="7" Fill="#101010" />
            <Rectangle Canvas.Left="156" Canvas.Top="138" Width="14" Height="72" RadiusX="7" RadiusY="7" Fill="#101010" />
            <Path Style="{StaticResource ArtLens}" Data="M48,162 A12,12 0 1 1 47.9,162 Z M192,162 A12,12 0 1 1 191.9,162 Z" />
            <Path Style="{StaticResource ArtGlowPath}" Data="M48,162 A12,12 0 1 1 47.9,162 Z M192,162 A12,12 0 1 1 191.9,162 Z" />
            <Path Style="{StaticResource ArtLit}" Data="M48,162 A12,12 0 1 1 47.9,162 Z M192,162 A12,12 0 1 1 191.9,162 Z" />
        </Canvas>
    </DataTemplate>

    <!-- Keyboard, from above: the case, a tiled key field and an underglow where the device has a light. -->
    <DataTemplate x:Key="ArtKeyboard">
        <Canvas Width="340" Height="150">
            <Rectangle Style="{x:Null}" Canvas.Left="14" Canvas.Top="122" Width="312" Height="14" RadiusX="7" RadiusY="7" Fill="{Binding LedBrush}" Effect="{StaticResource ArtGlow}" />
            <Rectangle Canvas.Left="4" Canvas.Top="10" Width="332" Height="122" RadiusX="10" RadiusY="10" Stroke="{StaticResource ArtEdge}" Effect="{StaticResource ArtShadow}">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#262626" Offset="0" /><GradientStop Color="#121212" Offset="1" /></LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle Canvas.Left="16" Canvas.Top="22" Width="308" Height="98">
                <Rectangle.Fill>
                    <DrawingBrush TileMode="Tile" Viewport="0,0,19.25,19.6" ViewportUnits="Absolute" Viewbox="0,0,19.25,19.6" ViewboxUnits="Absolute">
                        <DrawingBrush.Drawing>
                            <GeometryDrawing Brush="#1C1C1C">
                                <GeometryDrawing.Pen><Pen Brush="#333333" Thickness="0.8" /></GeometryDrawing.Pen>
                                <GeometryDrawing.Geometry><RectangleGeometry Rect="1.2,1.2,16.8,17.2" RadiusX="2.5" RadiusY="2.5" /></GeometryDrawing.Geometry>
                            </GeometryDrawing>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Canvas>
    </DataTemplate>

    <!-- Controller, from the front: the grips, d-pad, four face buttons, two sticks and the light bar. -->
    <DataTemplate x:Key="ArtController">
        <Canvas Width="260" Height="190">
            <Path Fill="{StaticResource ArtBody}" Stroke="{StaticResource ArtEdge}" StrokeThickness="1.2" Effect="{StaticResource ArtShadow}"
                  Data="M70,30 C90,24 110,32 130,32 C150,32 170,24 190,30 C222,40 246,92 252,132 C256,162 236,176 218,162 C204,150 194,128 176,124 L84,124 C66,128 56,150 42,162 C24,176 4,162 8,132 C14,92 38,40 70,30 Z" />
            <Path Fill="#101010" Stroke="#333333" Data="M64,70 h12 v-12 h12 v12 h12 v12 h-12 v12 h-12 v-12 h-12 Z" />
            <Ellipse Canvas.Left="179" Canvas.Top="55" Width="14" Height="14" Fill="#101010" Stroke="#3A3A3A" />
            <Ellipse Canvas.Left="165" Canvas.Top="69" Width="14" Height="14" Fill="#101010" Stroke="#3A3A3A" />
            <Ellipse Canvas.Left="193" Canvas.Top="69" Width="14" Height="14" Fill="#101010" Stroke="#3A3A3A" />
            <Ellipse Canvas.Left="179" Canvas.Top="83" Width="14" Height="14" Fill="#101010" Stroke="#3A3A3A" />
            <Ellipse Canvas.Left="88" Canvas.Top="94" Width="32" Height="32" Fill="{StaticResource ArtDark}" Stroke="{StaticResource ArtEdge}" />
            <Ellipse Canvas.Left="95" Canvas.Top="101" Width="18" Height="18" Fill="#1E1E1E" />
            <Ellipse Canvas.Left="140" Canvas.Top="94" Width="32" Height="32" Fill="{StaticResource ArtDark}" Stroke="{StaticResource ArtEdge}" />
            <Ellipse Canvas.Left="147" Canvas.Top="101" Width="18" Height="18" Fill="#1E1E1E" />
            <Path Style="{StaticResource ArtLens}" Data="M112,36 h36 a3,3 0 0 1 0,6 h-36 a3,3 0 0 1 0,-6 Z" />
            <Path Style="{StaticResource ArtGlowPath}" Data="M112,36 h36 a3,3 0 0 1 0,6 h-36 a3,3 0 0 1 0,-6 Z" />
            <Path Style="{StaticResource ArtLit}" Data="M112,36 h36 a3,3 0 0 1 0,6 h-36 a3,3 0 0 1 0,-6 Z" />
        </Canvas>
    </DataTemplate>

    <DataTemplate x:Key="ArtOther">
        <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="96" Foreground="{StaticResource TextSecondaryBrush}" Margin="40" />
    </DataTemplate>

    <!-- The picture beside the controls: the drawing for the device's family, its battery and what its light shows. -->
    <DataTemplate x:Key="PeripheralPicture">
        <Border Background="{StaticResource ArtStage}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="20,24,20,18">
            <StackPanel>
                <Viewbox Height="{Binding Tag, RelativeSource={RelativeSource AncestorType=ContentControl}, FallbackValue=330}" Stretch="Uniform">
                    <ContentControl Content="{Binding}" Focusable="False" Margin="8">
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="ContentTemplate" Value="{StaticResource ArtOther}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Art}" Value="Mouse"><Setter Property="ContentTemplate" Value="{StaticResource ArtMouse}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding Art}" Value="Dock"><Setter Property="ContentTemplate" Value="{StaticResource ArtDock}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding Art}" Value="Headset"><Setter Property="ContentTemplate" Value="{StaticResource ArtHeadset}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding Art}" Value="Keyboard"><Setter Property="ContentTemplate" Value="{StaticResource ArtKeyboard}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding Art}" Value="Controller"><Setter Property="ContentTemplate" Value="{StaticResource ArtController}" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </Viewbox>
                <TextBlock Text="{Binding BatteryText}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0"
                           Visibility="{Binding HasBattery, Converter={StaticResource BoolToVis}}" />
                <TextBlock Style="{StaticResource Secondary}" Text="{Binding LedText}" HorizontalAlignment="Center" Margin="0,4,0,0"
                           Visibility="{Binding HasLight, Converter={StaticResource BoolToVis}}" />
                <TextBlock Style="{StaticResource Secondary}" FontSize="11.5" Text="{x:Static t:Txt.PeripheralLivePreview}" HorizontalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" Margin="0,2,0,0" Visibility="{Binding CanLighting, Converter={StaticResource BoolToVis}}" />
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- The selected device's controls (the picture sits beside them, outside the scroll): name, status, Performance, Lighting,
         Gamemode profile, Power, Info and the HID collections. A slider only moves its box and the picture; Apply writes once and reads back. -->
    <DataTemplate DataType="{x:Type vm:PeripheralRowViewModel}">
        <StackPanel>
            <TextBlock Style="{StaticResource Secondary}" FontSize="12" Text="{Binding KindText}" />
            <WrapPanel Margin="0,4,0,8">
                <TextBlock Text="{Binding Name}" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap" />
                <Border Style="{StaticResource Pill}" Margin="0,2,0,0">
                    <TextBlock Text="{Binding StatusText}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
                </Border>
            </WrapPanel>
            <Grid Margin="0,0,8,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Secondary}" Text="{Binding Note}" Margin="0,0,16,0" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="{x:Static t:Txt.CopyDeviceReport}" Command="{Binding CopyReportCommand}" VerticalAlignment="Center" />
            </Grid>
            <TextBlock Style="{StaticResource Secondary}" Text="{Binding VendorNote}" Foreground="{StaticResource WarningBrush}" Margin="0,0,0,10"
                       Visibility="{Binding VendorNote, Converter={StaticResource NotEmptyToVis}}" />
            <TextBlock Style="{StaticResource Secondary}" Text="{Binding Error}" Foreground="{StaticResource ErrorBrush}" Margin="0,0,0,10"
                       Visibility="{Binding Error, Converter={StaticResource NotEmptyToVis}}" />
            <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.PeripheralReading}" Margin="0,0,0,10"
                       Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

            <!-- Performance: DPI, stages, polling rate. A control shows only when the driver read its value; Apply only when it can write it. -->
            <Border Style="{StaticResource Card}" Margin="0,0,8,8" Visibility="{Binding HasPerformance, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{x:Static t:Txt.PeripheralPerformance}" Margin="0,0,0,12" />
                    <StackPanel Style="{StaticResource PeriField}" Visibility="{Binding Dpi, Converter={StaticResource NotEmptyToVis}}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource PeriLabel}" Text="{Binding DpiRange}" />
                            <TextBlock Style="{StaticResource PeriLabel}" Text="{x:Static t:Txt.PeripheralDpi}" />
                        </DockPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="76" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Slider Style="{StaticResource GpuSlider}" Minimum="{Binding DpiLogMin}" Maximum="{Binding DpiLogMax}" IsSnapToTickEnabled="False" SmallChange="0.02"
                                    LargeChange="0.1" Value="{Binding DpiSlider, Mode=TwoWay}" IsEnabled="{Binding CanDpi}" AutomationProperties.Name="{x:Static t:Txt.PeripheralDpi}" />
                            <TextBox Grid.Column="2" Text="{Binding DpiText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanDpi}" AutomationProperties.Name="{x:Static t:Txt.PeripheralDpi}" />
                            <Button Grid.Column="3" Content="{x:Static t:Txt.Apply}" Command="{Binding ApplyDpiCommand}" Margin="8,0,0,0" Visibility="{Binding CanDpi, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </StackPanel>
                    <StackPanel Style="{StaticResource PeriField}" Visibility="{Binding HasStages, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource PeriLabel}" Text="{x:Static t:Txt.PeripheralDpiStages}" />
                        <ItemsControl Style="{StaticResource PeriSegmented}" ItemsSource="{Binding Stages}" Tag="{Binding StageCommand}" IsEnabled="{Binding CanStage}"
                                      AutomationProperties.Name="{x:Static t:Txt.PeripheralDpiStages}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource PeriField}" Visibility="{Binding HasProfile, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource PeriLabel}" Text="{x:Static t:Txt.PeripheralProfile}" />
                        <ItemsControl Style="{StaticResource PeriSegmented}" ItemsSource="{Binding Profiles}" Tag="{Binding ProfileCommand}" IsEnabled="{Binding CanProfile}"
                                      AutomationProperties.Name="{x:Static t:Txt.PeripheralProfile}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource PeriField}" Margin="0" Visibility="{Binding HasPolling, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource PeriLabel}" Text="{x:Static t:Txt.PeripheralPolling}" />
                        <ItemsControl Style="{StaticResource PeriSegmented}" ItemsSource="{Binding Rates}" Tag="{Binding PollingCommand}" IsEnabled="{Binding CanPolling}"
                                      AutomationProperties.Name="{x:Static t:Txt.PeripheralPolling}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="{Binding RateColumns}" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                    <Grid Margin="0,12,0,0" Visibility="{Binding OnboardMode, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.PeripheralOnboardNote}" Margin="0,0,16,0" />
                        <Button Grid.Column="1" Content="{x:Static t:Txt.PeripheralUseHostMode}" Command="{Binding HostModeCommand}" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Lighting: brightness, effect and color, each written stored and live and read back (only effects the device reports back). -->
            <Border Style="{StaticResource Card}" Margin="0,0,8,8" Visibility="{Binding HasLightingCard, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{x:Static t:Txt.PeripheralLighting}" Margin="0,0,0,12" />
                    <StackPanel Style="{StaticResource PeriField}" Visibility="{Binding HasBrightness, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource PeriLabel}" Text="{x:Static t:Txt.PeripheralBrightness}" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="76" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Slider Style="{StaticResource GpuSlider}" Minimum="0" Maximum="100" Value="{Binding BrightnessSlider, Mode=TwoWay}" IsEnabled="{Binding CanBrightness}"
                                    AutomationProperties.Name="{x:Static t:Txt.PeripheralBrightness}" />
                            <TextBox Grid.Column="2" Text="{Binding BrightnessText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanBrightness}" AutomationProperties.Name="{x:Static t:Txt.PeripheralBrightness}" />
                            <Button Grid.Column="3" Content="{x:Static t:Txt.Apply}" Command="{Binding ApplyBrightnessCommand}" Margin="8,0,0,0" Visibility="{Binding CanBrightness, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                    </StackPanel>
                    <StackPanel Style="{StaticResource PeriField}" Visibility="{Binding HasLighting, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource PeriLabel}" Text="{x:Static t:Txt.PeripheralEffect}" />
                        <ItemsControl Style="{StaticResource PeriSegmented}" ItemsSource="{Binding Effects}" Tag="{Binding EffectCommand}" IsEnabled="{Binding CanLighting}"
                                      AutomationProperties.Name="{x:Static t:Txt.PeripheralEffect}" />
                    </StackPanel>
                    <StackPanel Style="{StaticResource PeriField}" Visibility="{Binding HasLighting, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource PeriLabel}" Text="{x:Static t:Txt.PeripheralColor}" />
                        <ItemsControl Style="{StaticResource PeriSwatches}" ItemsSource="{Binding Swatches}" Tag="{Binding SwatchCommand}" Margin="0,0,0,2" IsEnabled="{Binding CanLighting}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBox Text="{Binding ColorText, UpdateSourceTrigger=PropertyChanged}" Width="96" IsEnabled="{Binding CanLighting}" AutomationProperties.Name="{x:Static t:Txt.PeripheralColor}" />
                            <Button Content="{x:Static t:Txt.Apply}" Command="{Binding ApplyColorCommand}" Margin="8,0,0,0" Visibility="{Binding CanLighting, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </StackPanel>
                    <!-- Dock only: KOS Governor sets the ring's live color from the mouse battery. -->
                    <StackPanel Visibility="{Binding IsDock, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="{x:Static t:Txt.PeripheralTurnOn}" Command="{Binding DockBatteryOnCommand}" />
                                <Button Content="{x:Static t:Txt.PeripheralTurnOff}" Command="{Binding DockBatteryOffCommand}" Margin="8,0,0,0" />
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{x:Static t:Txt.PeripheralDockBattery}" TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource Secondary}" Text="{Binding DockBatteryText}" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Style="{StaticResource GpuHint}" Text="{x:Static t:Txt.PeripheralDockBatteryNote}" Margin="0,8,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Switches (magnetic keyboards): one travel for every key of the active profile, stored in the keyboard; one Apply writes it all and reads it back. -->
            <Border Style="{StaticResource Card}" Margin="0,0,8,8" Visibility="{Binding HasSwitches, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{x:Static t:Txt.PeripheralSwitches}" />
                    <TextBlock Style="{StaticResource GpuHint}" Text="{x:Static t:Txt.PeripheralSwitchesNote}" Margin="0,2,0,4" />
                    <!-- The keyboard: click keys to choose them (the editor below then shows and sets those keys only); the live travel fills a key from the bottom. -->
                    <StackPanel Visibility="{Binding HasKeyCaps, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
                        <Viewbox Stretch="Uniform" HorizontalAlignment="Left">
                            <ItemsControl ItemsSource="{Binding KeyCaps}" Focusable="False" Width="640" Height="240" IsEnabled="{Binding CanSwitches}"
                                          AutomationProperties.Name="{x:Static t:Txt.PeripheralSwitches}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Width="{Binding Width}" Height="{Binding Height}" Cursor="Hand" FocusVisualStyle="{StaticResource FocusVisual}"
                                                Command="{Binding DataContext.KeyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding Slot}"
                                                AutomationProperties.Name="{Binding Label}" ToolTip="{Binding Actuation}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Grid>
                                                        <Border x:Name="cap" CornerRadius="4" Background="{StaticResource ControlBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" />
                                                        <Border CornerRadius="4" Background="{StaticResource SelectionBrush}" VerticalAlignment="Bottom" Height="{Binding LiveHeight}" />
                                                        <Ellipse Width="6" Height="6" Fill="{Binding PaintBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0" />
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Label}" FontSize="14" HorizontalAlignment="Center" Foreground="{StaticResource TextBrush}" />
                                                            <TextBlock Text="{Binding Actuation}" FontSize="12" HorizontalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                                        </StackPanel>
                                                        <Border CornerRadius="4" Background="{StaticResource TextBrush}" Opacity="0" v:Motion.ShowWhen="{Binding IsSelected}">
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Label}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{StaticResource OnLightBrush}" />
                                                                <TextBlock Text="{Binding Actuation}" FontSize="12" HorizontalAlignment="Center" Foreground="{StaticResource OnLightBrush}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="cap" Property="BorderBrush" Value="{StaticResource TextBrush}" /></Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Viewbox>
                        <DockPanel Margin="0,8,0,0">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="{x:Static t:Txt.PeripheralKeysSelectAll}" Command="{Binding SelectAllKeysCommand}" />
                                <Button Content="{x:Static t:Txt.PeripheralKeysClear}" Command="{Binding ClearKeysCommand}" Margin="8,0,0,0" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource GpuHint}" Text="{Binding KeysChosenText}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0" />
                        </DockPanel>
                    </StackPanel>
                    <TextBlock Style="{StaticResource GpuHint}" Text="{Binding SwitchesMixedText}" Foreground="{StaticResource WarningBrush}" Margin="0,4,0,4"
                               Visibility="{Binding SwitchesMixed, Converter={StaticResource BoolToVis}}" />
                    <StackPanel Style="{StaticResource PeriField}" Margin="0,8,0,12">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource PeriLabel}" Text="{Binding SwitchesRange}" />
                            <TextBlock Style="{StaticResource PeriLabel}" Text="{x:Static t:Txt.PeripheralActuation}" />
                        </DockPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="76" /></Grid.ColumnDefinitions>
                            <Slider Style="{StaticResource GpuSlider}" Minimum="0.1" Maximum="3.3" SmallChange="0.05" LargeChange="0.1" Value="{Binding ActuationSlider, Mode=TwoWay}"
                                    IsEnabled="{Binding CanSwitches}" AutomationProperties.Name="{x:Static t:Txt.PeripheralActuation}" />
                            <TextBox Grid.Column="2" Text="{Binding ActuationText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSwitches}" AutomationProperties.Name="{x:Static t:Txt.PeripheralActuation}" />
                        </Grid>
                    </StackPanel>
                    <CheckBox Style="{StaticResource GpuSwitch}" Content="{x:Static t:Txt.PeripheralRapidTrigger}" IsChecked="{Binding RapidTrigger}" IsEnabled="{Binding CanSwitches}"
                              HorizontalAlignment="Left" Margin="0,0,0,12" />
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel IsEnabled="{Binding RapidTrigger}">
                            <TextBlock Style="{StaticResource PeriLabel}" Text="{x:Static t:Txt.PeripheralRtPress}" />
                            <TextBox Text="{Binding RtPressText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSwitches}" AutomationProperties.Name="{x:Static t:Txt.PeripheralRtPress}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" IsEnabled="{Binding RapidTrigger}">
                            <TextBlock Style="{StaticResource PeriLabel}" Text="{x:Static t:Txt.PeripheralRtRelease}" />
                            <TextBox Text="{Binding RtReleaseText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSwitches}" AutomationProperties.Name="{x:Static t:Txt.PeripheralRtRelease}" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Style="{StaticResource PeriLabel}" Text="{x:Static t:Txt.PeripheralDeadZone}" />
                            <TextBox Text="{Binding DeadZoneText, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSwitches}" AutomationProperties.Name="{x:Static t:Txt.PeripheralDeadZone}" />
                        </StackPanel>
                    </Grid>
                    <Button Content="{x:Static t:Txt.Apply}" Command="{Binding ApplySwitchesCommand}" HorizontalAlignment="Left" Visibility="{Binding CanSwitches, Converter={StaticResource BoolToVis}}" />
                    <!-- Key mode: one chosen key (two for snap tap); written to the active profile and read back. -->
                    <StackPanel Margin="0,16,0,0" Visibility="{Binding HasKeyCaps, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource PeriLabel}" Text="{x:Static t:Txt.PeripheralKeyMode}" />
                        <TextBlock Style="{StaticResource GpuHint}" Text="{Binding KeyModeHint}" Margin="0,0,0,6" TextWrapping="Wrap"
                                   Visibility="{Binding KeyModeHint, Converter={StaticResource NotEmptyToVis}}" />
                        <StackPanel Visibility="{Binding CanKeyMode, Converter={StaticResource BoolToVis}}">
                            <ItemsControl Style="{StaticResource PeriSegmented}" ItemsSource="{Binding ModeKinds}" Tag="{Binding ModeKindCommand}" AutomationProperties.Name="{x:Static t:Txt.PeripheralKeyMode}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource GpuHint}" Text="{Binding ModeNote}" Margin="0,6,0,0" TextWrapping="Wrap" Visibility="{Binding ModeNote, Converter={StaticResource NotEmptyToVis}}" />
                            <CheckBox Style="{StaticResource GpuSwitch}" Content="{x:Static t:Txt.PeripheralModeRepeat}" IsChecked="{Binding ModeRepeat}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                      Visibility="{Binding ModeIsToggle, Converter={StaticResource BoolToVis}}" />
                            <Grid Margin="0,8,0,0" Visibility="{Binding ModeIsModTap, Converter={StaticResource BoolToVis}}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource PeriLabel}" Text="{x:Static t:Txt.PeripheralModeTapKey}" />
                                    <ComboBox ItemsSource="{Binding Source={x:Static vm:PeripheralRowViewModel.Usages}}" SelectedItem="{Binding TapKey}" AutomationProperties.Name="{x:Static t:Txt.PeripheralModeTapKey}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource PeriLabel}" Text="{x:Static t:Txt.PeripheralModeHoldKey}" />
                                    <ComboBox ItemsSource="{Binding Source={x:Static vm:PeripheralRowViewModel.Usages}}" SelectedItem="{Binding HoldKey}" AutomationProperties.Name="{x:Static t:Txt.PeripheralModeHoldKey}" />
                                </StackPanel>
                                <StackPanel Grid.Column="4">
                                    <TextBlock Style="{StaticResource PeriLabel}" Text="{x:Static t:Txt.PeripheralModeHoldMs}" />
                                    <TextBox Text="{Binding HoldMsText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static t:Txt.PeripheralModeHoldMs}" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Margin="0,8,0,0" Visibility="{Binding ModeIsDks, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Style="{StaticResource PeriLabel}" Text="{x:Static t:Txt.PeripheralModeFirstPoint}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBox Text="{Binding DksPointText, UpdateSourceTrigger=PropertyChanged}" Width="76" AutomationProperties.Name="{x:Static t:Txt.PeripheralModeFirstPoint}" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding DksRows}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <ComboBox ItemsSource="{Binding Source={x:Static vm:PeripheralRowViewModel.Usages}}" SelectedItem="{Binding Key}" Margin="0,0,6,0" />
                                                <ComboBox Grid.Column="1" ItemsSource="{Binding CellChoices}" SelectedIndex="{Binding Cell0}" Margin="0,0,4,0" />
                                                <ComboBox Grid.Column="2" ItemsSource="{Binding CellChoices}" SelectedIndex="{Binding Cell1}" Margin="0,0,4,0" />
                                                <ComboBox Grid.Column="3" ItemsSource="{Binding CellChoices}" SelectedIndex="{Binding Cell2}" Margin="0,0,4,0" />
                                                <ComboBox Grid.Column="4" ItemsSource="{Binding CellChoices}" SelectedIndex="{Binding Cell3}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <Button Content="{x:Static t:Txt.Apply}" Command="{Binding ApplyModeCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <!-- Remap: the chosen key's base and Fn-layer key; Restore default puts back the catalog's factory key. -->
                    <StackPanel Margin="0,16,0,0" Visibility="{Binding CanRemap, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource PeriLabel}" Text="{x:Static t:Txt.PeripheralRemap}" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource GpuHint}" Text="{Binding RemapKeyLabel}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding Source={x:Static vm:PeripheralRowViewModel.Usages}}" SelectedItem="{Binding RemapKey}" AutomationProperties.Name="{x:Static t:Txt.PeripheralRemapKey}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource GpuHint}" Text="{Binding RemapFnLabel}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding Source={x:Static vm:PeripheralRowViewModel.Usages}}" SelectedItem="{Binding RemapFn}" AutomationProperties.Name="{x:Static t:Txt.PeripheralRemapFn}" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="{x:Static t:Txt.Apply}" Command="{Binding ApplyRemapCommand}" />
                            <Button Content="{x:Static t:Txt.PeripheralRemapDefault}" Command="{Binding RemapDefaultCommand}" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                    <!-- Per-key colors: painted on this page (the keyboard can't report them) and sent whole; the toast says it isn't confirmed. -->
                    <StackPanel Margin="0,16,0,0" Visibility="{Binding HasPicture, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource PeriLabel}" Text="{x:Static t:Txt.PeripheralPicture}" />
                        <TextBlock Style="{StaticResource GpuHint}" Text="{x:Static t:Txt.PeripheralPictureNote}" Margin="0,0,0,6" TextWrapping="Wrap" />
                        <WrapPanel>
                            <TextBox Text="{Binding PaintText, UpdateSourceTrigger=PropertyChanged}" Width="96" Margin="0,0,8,6" AutomationProperties.Name="{x:Static t:Txt.PeripheralColor}" />
                            <Button Content="{x:Static t:Txt.PeripheralPicturePaint}" Command="{Binding PaintCommand}" Margin="0,0,8,6" />
                            <Button Content="{x:Static t:Txt.PeripheralPictureFill}" Command="{Binding FillCommand}" Margin="0,0,8,6" />
                            <Button Content="{x:Static t:Txt.PeripheralPictureSend}" Command="{Binding SendPictureCommand}" Margin="0,0,0,6" />
                        </WrapPanel>
                    </StackPanel>
                    <!-- Macros: one of the 50 slots, read, edited as text, saved and read back; bound to the chosen key through the keymap. -->
                    <StackPanel Margin="0,16,0,0" Visibility="{Binding HasMacros, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource PeriLabel}" Text="{x:Static t:Txt.PeripheralMacros}" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="64" /></Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource GpuHint}" Text="{x:Static t:Txt.PeripheralMacroSlot}" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding MacroSlots}" SelectedItem="{Binding MacroSlot}" AutomationProperties.Name="{x:Static t:Txt.PeripheralMacroSlot}" />
                            <Button Grid.Column="2" Content="{x:Static t:Txt.PeripheralMacroLoad}" Command="{Binding MacroLoadCommand}" Margin="8,0,0,0" />
                            <TextBlock Grid.Column="3" Style="{StaticResource GpuHint}" Text="{x:Static t:Txt.PeripheralMacroRepeat}" VerticalAlignment="Center" Margin="12,0,6,0" />
                            <TextBox Grid.Column="4" Text="{Binding MacroRepeat, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static t:Txt.PeripheralMacroRepeat}" />
                        </Grid>
                        <TextBlock Style="{StaticResource GpuHint}" Text="{x:Static t:Txt.PeripheralMacroSteps}" Margin="0,8,0,4" TextWrapping="Wrap" />
                        <TextBox Text="{Binding MacroSteps, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="72" MaxHeight="160"
                                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" AutomationProperties.Name="{x:Static t:Txt.PeripheralMacros}" />
                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="{x:Static t:Txt.PeripheralMacroSave}" Command="{Binding MacroSaveCommand}" Margin="0,0,8,6" />
                            <Button Content="{x:Static t:Txt.PeripheralMacroClear}" Command="{Binding MacroClearCommand}" Margin="0,0,8,6" />
                            <ComboBox ItemsSource="{Binding MacroModes}" SelectedIndex="{Binding MacroMode}" Width="120" Margin="0,0,8,6" />
                            <Button Content="{x:Static t:Txt.PeripheralMacroBind}" Command="{Binding MacroBindCommand}" IsEnabled="{Binding CanRemap}" Margin="0,0,0,6" />
                        </WrapPanel>
                    </StackPanel>
                    <StackPanel Margin="0,16,0,0" Visibility="{Binding CanTravel, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{Binding TravelButtonText}" Command="{Binding TravelCommand}" />
                            <TextBlock Text="{x:Static t:Txt.PeripheralTravel}" VerticalAlignment="Center" />
                        </DockPanel>
                        <StackPanel Visibility="{Binding TravelOn, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
                            <TextBlock Style="{StaticResource GpuHint}" Text="{Binding TravelText}" Margin="0,0,0,6" />
                            <ProgressBar Minimum="0" Maximum="4" Value="{Binding TravelMm, Mode=OneWay}" Height="6" AutomationProperties.Name="{x:Static t:Txt.PeripheralTravel}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Gamemode profile: KOS Governor writes these when gamemode turns on (live on mice and the dock, stored on a keyboard that
                 keeps every setting) and puts back what was there. -->
            <Border Style="{StaticResource Card}" Margin="0,0,8,8" Visibility="{Binding CanGamemode, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{x:Static t:Txt.PeripheralGamemode}" />
                    <TextBlock Style="{StaticResource GpuHint}" Text="{x:Static t:Txt.PeripheralGamemodeNote}" Margin="0,2,0,12" />
                    <TextBlock Style="{StaticResource GpuHint}" Text="{x:Static t:Txt.PeripheralGamemodeStoredNote}" Foreground="{StaticResource WarningBrush}" Margin="0,-6,0,12"
                               Visibility="{Binding GmStoredOnly, Converter={StaticResource BoolToVis}}" />
                    <StackPanel Style="{StaticResource PeriField}" Visibility="{Binding CanGmDpi, Converter={StaticResource BoolToVis}}">
                        <CheckBox Style="{StaticResource GpuSwitch}" Content="{x:Static t:Txt.PeripheralGamemodeSetDpi}" IsChecked="{Binding GmDpiOn}" HorizontalAlignment="Left" Margin="0,0,0,6" />
                        <Grid IsEnabled="{Binding GmDpiOn}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="76" /></Grid.ColumnDefinitions>
                            <Slider Style="{StaticResource GpuSlider}" Minimum="{Binding DpiLogMin}" Maximum="{Binding DpiLogMax}" IsSnapToTickEnabled="False" SmallChange="0.02"
                                    LargeChange="0.1" Value="{Binding GmDpiSlider, Mode=TwoWay}" AutomationProperties.Name="{x:Static t:Txt.PeripheralGamemodeSetDpi}" />
                            <TextBox Grid.Column="2" Text="{Binding GmDpiText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static t:Txt.PeripheralGamemodeSetDpi}" />
                        </Grid>
                    </StackPanel>
                    <StackPanel Style="{StaticResource PeriField}" Visibility="{Binding CanGmPolling, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource PeriLabel}" Text="{x:Static t:Txt.PeripheralPolling}" />
                        <ItemsControl Style="{StaticResource PeriSegmented}" ItemsSource="{Binding GmRates}" Tag="{Binding GmPollingCommand}" AutomationProperties.Name="{x:Static t:Txt.PeripheralPolling}" />
                    </StackPanel>
                    <!-- The light (not the dock's ring): kept, off, or an effect and color. -->
                    <StackPanel Style="{StaticResource PeriField}" Visibility="{Binding CanGmLightChoice, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource PeriLabel}" Text="{x:Static t:Txt.PeripheralGamemodeLight}" />
                        <ItemsControl Style="{StaticResource PeriSegmented}" ItemsSource="{Binding GmLights}" Tag="{Binding GmLightCommand}" AutomationProperties.Name="{x:Static t:Txt.PeripheralGamemodeLight}" />
                        <StackPanel Margin="0,8,0,0" Visibility="{Binding GmHasColor, Converter={StaticResource BoolToVis}}">
                            <ItemsControl Style="{StaticResource PeriSwatches}" ItemsSource="{Binding Swatches}" Tag="{Binding GmSwatchCommand}" />
                            <TextBox Text="{Binding GmColorText, UpdateSourceTrigger=PropertyChanged}" Width="96" HorizontalAlignment="Left" AutomationProperties.Name="{x:Static t:Txt.PeripheralColor}" />
                        </StackPanel>
                    </StackPanel>
                    <!-- Magnetic keyboards: rapid trigger on (one step for press and release) or off on every key; each key's actuation kept. -->
                    <StackPanel Style="{StaticResource PeriField}" Visibility="{Binding CanGmRt, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource PeriLabel}" Text="{x:Static t:Txt.PeripheralGamemodeRt}" />
                        <ItemsControl Style="{StaticResource PeriSegmented}" ItemsSource="{Binding GmRts}" Tag="{Binding GmRtCommand}" AutomationProperties.Name="{x:Static t:Txt.PeripheralGamemodeRt}" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0" Visibility="{Binding GmRtOn, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{x:Static t:Txt.PeripheralGamemodeRtStep}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBox Text="{Binding GmRtText, UpdateSourceTrigger=PropertyChanged}" Width="76" AutomationProperties.Name="{x:Static t:Txt.PeripheralGamemodeRtStep}" />
                        </StackPanel>
                    </StackPanel>
                    <!-- The dock's ring: kept, off, or the mouse battery shown on it or not during gamemode. -->
                    <StackPanel Style="{StaticResource PeriField}" Visibility="{Binding CanGmRing, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource PeriLabel}" Text="{x:Static t:Txt.PeripheralGamemodeRing}" />
                        <ItemsControl Style="{StaticResource PeriSegmented}" ItemsSource="{Binding GmRings}" Tag="{Binding GmRingCommand}" AutomationProperties.Name="{x:Static t:Txt.PeripheralGamemodeRing}" />
                        <TextBlock Style="{StaticResource GpuHint}" Text="{x:Static t:Txt.PeripheralGamemodeRingNote}" />
                    </StackPanel>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="{x:Static t:Txt.PeripheralUseInGamemode}" Command="{Binding GamemodeCommand}" />
                            <Button Content="{x:Static t:Txt.PeripheralGamemodeClear}" Command="{Binding GamemodeClearCommand}" Margin="8,0,0,0"
                                    Visibility="{Binding HasGamemode, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Style="{StaticResource PeriLabel}" Margin="0" Text="{x:Static t:Txt.PeripheralGamemodeSavedLabel}" />
                            <TextBlock Text="{Binding GamemodeText}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- Power: battery, sleep timer, low-battery threshold. -->
            <Border Style="{StaticResource Card}" Margin="0,0,8,8" Visibility="{Binding HasPower, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource CardTitle}" Text="{x:Static t:Txt.PeripheralPower}" Margin="0,0,0,10" />
                    <DockPanel Margin="0,0,0,10" Visibility="{Binding HasBattery, Converter={StaticResource BoolToVis}}">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding BatteryText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Static t:Txt.PeripheralBatteryLabel}" VerticalAlignment="Center" />
                    </DockPanel>
                    <DockPanel Margin="0,0,0,10" Visibility="{Binding HasSleep, Converter={StaticResource BoolToVis}}">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBox Text="{Binding SleepText, UpdateSourceTrigger=PropertyChanged}" Width="60" IsEnabled="{Binding CanSleep}" AutomationProperties.Name="{x:Static t:Txt.PeripheralSleep}" />
                            <Button Content="{x:Static t:Txt.Apply}" Command="{Binding ApplySleepCommand}" Margin="8,0,0,0" Visibility="{Binding CanSleep, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <TextBlock Text="{x:Static t:Txt.PeripheralSleep}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>
                    <DockPanel Visibility="{Binding HasLow, Converter={StaticResource BoolToVis}}">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBox Text="{Binding LowText, UpdateSourceTrigger=PropertyChanged}" Width="60" IsEnabled="{Binding CanLow}" AutomationProperties.Name="{x:Static t:Txt.PeripheralLowBattery}" />
                            <Button Content="{x:Static t:Txt.Apply}" Command="{Binding ApplyLowCommand}" Margin="8,0,0,0" Visibility="{Binding CanLow, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <TextBlock Text="{x:Static t:Txt.PeripheralLowBattery}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>
                </StackPanel>
            </Border>
            <ContentControl Content="{Binding Info}" Focusable="False" />
            <Border Style="{StaticResource Card}" Margin="0,0,8,8">
                <StackPanel Grid.IsSharedSizeScope="True">
                    <TextBlock Style="{StaticResource CardTitle}" Text="{x:Static t:Txt.PeripheralCollections}" Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="HidLocation" /><ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="HidInput" /><ColumnDefinition Width="Auto" SharedSizeGroup="HidOutput" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="HidFeature" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource HidHeader}" Text="{x:Static t:Txt.HidInterfaceHeader}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource HidHeader}" Text="{x:Static t:Txt.HidUsageHeader}" />
                        <TextBlock Grid.Column="2" Style="{StaticResource HidHeader}" Text="{x:Static t:Txt.HidInputHeader}" TextAlignment="Right" />
                        <TextBlock Grid.Column="3" Style="{StaticResource HidHeader}" Text="{x:Static t:Txt.HidOutputHeader}" TextAlignment="Right" />
                        <TextBlock Grid.Column="4" Style="{StaticResource HidHeader}" Text="{x:Static t:Txt.HidFeatureHeader}" TextAlignment="Right" Margin="0,0,0,6" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Collections}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="HidLocation" /><ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="HidInput" /><ColumnDefinition Width="Auto" SharedSizeGroup="HidOutput" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="HidFeature" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource HidCell}" Text="{Binding Location}" />
                                        <WrapPanel Grid.Column="1" Margin="0,5,16,5">
                                            <TextBlock Text="{Binding Usage}" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding UsageName}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                        </WrapPanel>
                                        <TextBlock Grid.Column="2" Style="{StaticResource HidCell}" Text="{Binding Input}" TextAlignment="Right" />
                                        <TextBlock Grid.Column="3" Style="{StaticResource HidCell}" Text="{Binding Output}" TextAlignment="Right" />
                                        <TextBlock Grid.Column="4" Style="{StaticResource HidCell}" Text="{Binding Feature}" TextAlignment="Right" Margin="0,5" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Secondary}" FontSize="11.5" Text="{x:Static t:Txt.HidLengthsNote}" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </DataTemplate>

    <!-- Peripherals: the device list (280 px), the selected device's controls (scrolling on their own) and its picture, which stays in
         place while the controls scroll. Narrower than 940 px (the window near its minimum width) the picture goes above the controls, smaller. -->
    <v:WidthAtLeast x:Key="PeriWide" />
    <DataTemplate DataType="{x:Type vm:PeripheralsPageViewModel}">
        <Grid x:Name="page">
            <Grid.ColumnDefinitions><ColumnDefinition Width="280" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel Margin="0,4,0,12">
                        <TextBlock Style="{StaticResource HomeHeader}" Text="{x:Static t:Txt.PeripheralsSupportedHeader}"
                                   Visibility="{Binding HasSupported, Converter={StaticResource BoolToVis}}" />
                        <ItemsControl ItemsSource="{Binding Supported}" ItemTemplate="{StaticResource PeripheralRow}" Focusable="False" />
                        <TextBlock Style="{StaticResource HomeHeader}" Text="{x:Static t:Txt.PeripheralsNotSupportedHeader}"
                                   Visibility="{Binding HasUnsupported, Converter={StaticResource BoolToVis}}" />
                        <ItemsControl ItemsSource="{Binding Unsupported}" ItemTemplate="{StaticResource PeripheralRow}" Focusable="False" />
                        <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.PeripheralsNone}" Margin="16,12"
                                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Style="{StaticResource Secondary}" Text="{Binding LoadError}" Foreground="{StaticResource ErrorBrush}" Margin="16,12"
                                   Visibility="{Binding LoadError, Converter={StaticResource NotEmptyToVis}}" />
                        <!-- Lighting sync: one effect and color on the checked devices, now (each read back) or in their gamemode profiles. -->
                        <Border Margin="16,16,16,0" Padding="0,14,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                                Visibility="{Binding HasSync, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="{x:Static t:Txt.PeripheralSync}" />
                                <TextBlock Style="{StaticResource GpuHint}" Text="{x:Static t:Txt.PeripheralSyncNote}" Margin="0,2,0,10" />
                                <ItemsControl ItemsSource="{Binding SyncRows}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding IsSynced}" Margin="0,0,0,6" /></DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <ItemsControl Style="{StaticResource PeriSegmented}" ItemsSource="{Binding SyncEffects}" Tag="{Binding SyncEffectCommand}" Margin="0,6,0,10"
                                              AutomationProperties.Name="{x:Static t:Txt.PeripheralEffect}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                </ItemsControl>
                                <StackPanel Visibility="{Binding SyncHasColor, Converter={StaticResource BoolToVis}}" Margin="0,0,0,10">
                                    <ItemsControl Style="{StaticResource PeriSwatches}" ItemsSource="{Binding Swatches}" Tag="{Binding SyncSwatchCommand}" />
                                    <TextBox Text="{Binding SyncColorText, UpdateSourceTrigger=PropertyChanged}" Width="96" HorizontalAlignment="Left" AutomationProperties.Name="{x:Static t:Txt.PeripheralColor}" />
                                </StackPanel>
                                <WrapPanel>
                                    <Button Content="{x:Static t:Txt.PeripheralSyncApply}" Command="{Binding SyncApplyCommand}" Margin="0,0,8,6" />
                                    <Button Content="{x:Static t:Txt.PeripheralSyncGamemode}" Command="{Binding SyncGamemodeCommand}" Margin="0,0,0,6" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Margin="24,0,0,0">
                <StackPanel Margin="0,0,4,0">
                    <Grid Visibility="{Binding ActualWidth, ElementName=page, Converter={StaticResource PeriWide}, ConverterParameter=!940}">
                        <ContentControl Content="{Binding Selected}" ContentTemplate="{StaticResource PeripheralPicture}" Tag="200" Focusable="False" Margin="0,0,0,12"
                                        Visibility="{Binding Selected, Converter={StaticResource NotEmptyToVis}}" />
                    </Grid>
                    <ContentControl Content="{Binding Selected}" Focusable="False" v:Motion.Transition="{Binding Selected}" />
                </StackPanel>
            </ScrollViewer>
            <Grid Grid.Column="2" Visibility="{Binding ActualWidth, ElementName=page, Converter={StaticResource PeriWide}, ConverterParameter=940}">
                <ContentControl Content="{Binding Selected}" ContentTemplate="{StaticResource PeripheralPicture}" Tag="330" Focusable="False" Width="250" Margin="12,0,0,0"
                                VerticalAlignment="Top" Visibility="{Binding Selected, Converter={StaticResource NotEmptyToVis}}" />
            </Grid>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
