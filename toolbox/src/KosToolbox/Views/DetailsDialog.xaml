<Window x:Class="KosToolbox.Views.DetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:t="clr-namespace:KosToolbox.Core.Text;assembly=KosToolbox.Core"
        Width="780" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" UseLayoutRounding="True"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13">
    <StackPanel x:Name="Root">
        <ScrollViewer MaxHeight="640" VerticalScrollBarVisibility="Auto" Focusable="False">
            <StackPanel Margin="24,20,24,16">
                <TextBlock x:Name="Heading" Style="{StaticResource CardTitle}" FontSize="16" />
                <TextBlock x:Name="Summary" Style="{StaticResource Secondary}" Margin="0,6,0,0" />
                <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                    <Grid x:Name="Facts">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </Border>
                <StackPanel x:Name="ReadingsSection">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static t:Txt.DetailReadings}" Margin="0,16,0,6" />
                    <Border Style="{StaticResource Card}" Padding="0" Margin="0">
                        <Grid x:Name="Readings" />
                    </Border>
                    <TextBlock Style="{StaticResource Secondary}" FontSize="12" Margin="0,8,0,0" Text="{x:Static t:Txt.DetailHowDetermined}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,14">
            <Button Style="{StaticResource PrimaryButton}" Content="{x:Static t:Txt.Ok}" MinWidth="96" HorizontalAlignment="Right"
                    IsDefault="True" IsCancel="True" />
        </Border>
    </StackPanel>
</Window>
