<Window x:Class="KosToolbox.Views.AppWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:KosToolbox.Views"
        xmlns:vm="clr-namespace:KosToolbox.ViewModels"
        xmlns:t="clr-namespace:KosToolbox.Core.Text;assembly=KosToolbox.Core"
        Title="{Binding Title}"
        Width="1120" Height="760" MinWidth="860" MinHeight="500" WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True">
    <!-- A KOS app that is one page (KOS Firewall, KOS Equalizer): the toolbox's header, toasts and content, without the sidebar. -->
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </Window.InputBindings>
    <Grid>
        <ItemsControl Panel.ZIndex="10" ItemsSource="{x:Static vm:Toasts.Items}" Focusable="False" ItemTemplate="{StaticResource Toast}"
                      HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,26" />

        <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="28,20,28,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Style="{StaticResource Secondary}" Text="{Binding Current.Subtitle}" Margin="0,2,0,0" />
                </StackPanel>
                <!-- The app's master switch (KOS Firewall on/off, KOS Equalizer on/off for every device). -->
                <Button Grid.Column="1" Style="{StaticResource MasterSwitch}" Command="{Binding Current.MasterCommand}" VerticalAlignment="Center" Margin="16,0,10,0"
                        ToolTip="{Binding Current.MasterTooltip}" AutomationProperties.Name="{Binding Current.MasterText}"
                        Visibility="{Binding Current.MasterCommand, Converter={StaticResource NotEmptyToVis}}" />
                <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="{Binding Current.HeaderGlyph}" VerticalAlignment="Center" Margin="0,0,4,0"
                        Command="{Binding Current.HeaderCommand}" ToolTip="{Binding Current.HeaderTooltip}" AutomationProperties.Name="{Binding Current.HeaderTooltip}"
                        Visibility="{Binding Current.HeaderCommand, Converter={StaticResource NotEmptyToVis}}" />
                <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE72C;" VerticalAlignment="Center"
                        Command="{Binding RefreshCommand}" ToolTip="{x:Static t:Txt.RefreshTooltip}" AutomationProperties.Name="{x:Static t:Txt.Refresh}" />
            </Grid>

            <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Current.ScrollsItself}" Value="True">
                                <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>
                <ContentControl Content="{Binding Current}" Focusable="False" Margin="28,0,28,24" />
            </ScrollViewer>
        </DockPanel>
    </Grid>
</Window>
