<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:KosToolbox.ViewModels"
                    xmlns:t="clr-namespace:KosToolbox.Core.Text;assembly=KosToolbox.Core">

    <!-- ===================== Firewall ===================== -->
    <Style x:Key="FwWarning" TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
        <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="FwLabel" TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <!-- Multi-line text (the hosts file): fills its area, scrolls both ways, monospace. -->
    <Style x:Key="FwCodeEditor" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="AcceptsTab" Value="True" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource TextBrush}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A rule of the config (Apps and Rules tabs): on/off, name and what it matches, direction, Allow/Block, remove. -->
    <DataTemplate DataType="{x:Type vm:FirewallRuleRow}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="40" />
            </Grid.ColumnDefinitions>
            <CheckBox IsChecked="{Binding Enabled, Mode=OneWay}" Command="{Binding ToggleEnabledCommand}" VerticalAlignment="Center" Margin="0,0,12,0"
                      ToolTip="{x:Static t:Txt.FwEnabledTip}" AutomationProperties.Name="{x:Static t:Txt.FwEnabledTip}" />
            <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                <TextBlock Style="{StaticResource Secondary}" FontSize="12" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" />
                <TextBlock Style="{StaticResource FwWarning}" FontSize="12" Text="{Binding Problem}" Visibility="{Binding Problem, Converter={StaticResource NotEmptyToVis}}" />
            </StackPanel>
            <TextBlock Grid.Column="2" Style="{StaticResource Secondary}" Text="{Binding Direction}" VerticalAlignment="Center" />
            <ItemsControl Grid.Column="3" Style="{StaticResource Segmented}" ItemsSource="{Binding Actions}" Tag="{Binding SetActionCommand}" VerticalAlignment="Center"
                          AutomationProperties.Name="{Binding Name}" />
            <Button Grid.Column="4" Style="{StaticResource IconButton}" Content="&#xE74D;" FontSize="13" Width="30" Height="28" HorizontalAlignment="Right"
                    Command="{Binding RemoveCommand}" ToolTip="{x:Static t:Txt.FwRemove}" AutomationProperties.Name="{x:Static t:Txt.FwRemove}" />
        </Grid>
    </DataTemplate>

    <!-- A service or Store app: none / allow / block. -->
    <DataTemplate DataType="{x:Type vm:FirewallTargetRow}">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                <TextBlock Style="{StaticResource Secondary}" FontSize="12" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <ItemsControl Grid.Column="1" Style="{StaticResource Segmented}" ItemsSource="{Binding Choices}" Tag="{Binding ChooseCommand}" VerticalAlignment="Center"
                          AutomationProperties.Name="{Binding Name}" />
        </Grid>
    </DataTemplate>

    <!-- A connection KOS Firewall dropped: when, which program, where to, and Allow / Block for programs on a drive. -->
    <DataTemplate DataType="{x:Type vm:FirewallEventRow}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource Secondary}" Text="{Binding Time}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Program}" TextTrimming="CharacterEllipsis" />
                <TextBlock Style="{StaticResource Secondary}" FontSize="12" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"
                           Visibility="{Binding Detail, Converter={StaticResource NotEmptyToVis}}" />
            </StackPanel>
            <TextBlock Grid.Column="2" Text="{Binding Remote}" FontFamily="Consolas" TextTrimming="CharacterEllipsis" ToolTip="{Binding Remote}" Margin="0,0,12,0" VerticalAlignment="Center" />
            <TextBlock Grid.Column="3" Style="{StaticResource Secondary}" Text="{Binding Protocol}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="4" Style="{StaticResource Secondary}" Text="{Binding Direction}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding HasPath, Converter={StaticResource BoolToVis}}">
                <Button Content="{x:Static t:Txt.FwAllow}" MinWidth="72" Command="{Binding AllowCommand}" />
                <Button Content="{x:Static t:Txt.FwBlock}" MinWidth="72" Margin="8,0,0,0" Command="{Binding BlockCommand}" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:FirewallPageViewModel}">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

            <Border Style="{StaticResource Card}" Margin="0,0,0,10" Visibility="{Binding NeedsAdmin, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.FwNeedsAdmin}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <Button Grid.Column="1" Content="{x:Static t:Txt.RestartAsAdmin}" VerticalAlignment="Center" Command="{Binding RestartAsAdminCommand}" />
                </Grid>
            </Border>

            <!-- KOS Firewall and its status (read back after every change), Windows Firewall per profile, what's in the way. -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,10" Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <StackPanel Orientation="Horizontal">
                                <CheckBox Style="{StaticResource GpuSwitch}" IsChecked="{Binding KosOn, Mode=OneWay}" Command="{Binding ToggleKosCommand}"
                                          AutomationProperties.Name="{x:Static t:Txt.FwKosSwitch}">
                                    <TextBlock Style="{StaticResource CardTitle}" Text="{x:Static t:Txt.FwKosSwitch}" />
                                </CheckBox>
                                <TextBlock Text="{Binding Status}" Margin="16,0,0,0" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StatusWarning}" Value="True"><Setter Property="Foreground" Value="{StaticResource WarningBrush}" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <CheckBox Style="{StaticResource GpuSwitch}" Content="{x:Static t:Txt.FwPopupsSwitch}" IsChecked="{Binding Popups, Mode=OneWay}" Command="{Binding TogglePopupsCommand}"
                                      ToolTip="{x:Static t:Txt.FwPopupsTip}" HorizontalAlignment="Left" Margin="0,12,0,0" AutomationProperties.Name="{x:Static t:Txt.FwPopupsSwitch}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Top">
                            <TextBlock Style="{StaticResource Secondary}" Text="{Binding WindowsState}" HorizontalAlignment="Right" />
                            <Button Content="{x:Static t:Txt.FwWindowsOn}" Command="{Binding WindowsOnCommand}" ToolTip="{x:Static t:Txt.FwWindowsOnTip}" HorizontalAlignment="Right" Margin="0,8,0,0" />
                        </StackPanel>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Notes}" Focusable="False" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><TextBlock Style="{StaticResource FwWarning}" Text="{Binding}" Margin="0,2,0,0" /></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Secondary}" FontSize="12" Text="{x:Static t:Txt.FwNote}" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <ItemsControl Grid.Row="2" ItemsSource="{Binding Tabs}" Focusable="False" Margin="0,0,0,10" Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource GpuTabButton}" Command="{Binding DataContext.SelectTabCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                CommandParameter="{Binding Key}" AutomationProperties.Name="{Binding Label}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Grid.Row="3" Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}">
                <!-- Apps: program rules by path. -->
                <DockPanel Visibility="{Binding IsAppsTab, Converter={StaticResource BoolToVis}}">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="{x:Static t:Txt.FwAddProgram}" Command="{Binding AddProgramCommand}" VerticalAlignment="Center" />
                        <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.FwAppsHint}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Secondary}" Text="{x:Static t:Txt.FwAppsEmpty}" Margin="0,4,0,8"
                               Visibility="{Binding NoAppRows, Converter={StaticResource BoolToVis}}" />
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                        <ListBox Style="{StaticResource DataList}" ItemsSource="{Binding AppRows}" AutomationProperties.Name="{x:Static t:Txt.FwTabApps}" />
                    </Border>
                </DockPanel>

                <!-- Services: each one's outbound rule, by service SID. -->
                <DockPanel Visibility="{Binding IsServicesTab, Converter={StaticResource BoolToVis}}">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <ContentPresenter DockPanel.Dock="Right" Content="{Binding}" ContentTemplate="{StaticResource PageSearch}" VerticalAlignment="Center" />
                        <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.FwServicesHint}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Secondary}" Text="{Binding ListNote}" Margin="0,4,0,8" Visibility="{Binding ListNote, Converter={StaticResource NotEmptyToVis}}" />
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                        <ListBox Style="{StaticResource DataList}" ItemsSource="{Binding ServicesView}" AutomationProperties.Name="{x:Static t:Txt.FwTabServices}" />
                    </Border>
                </DockPanel>

                <!-- Store apps: each one's outbound rule, by package SID. -->
                <DockPanel Visibility="{Binding IsStoreTab, Converter={StaticResource BoolToVis}}">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <ContentPresenter DockPanel.Dock="Right" Content="{Binding}" ContentTemplate="{StaticResource PageSearch}" VerticalAlignment="Center" />
                        <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.FwStoreHint}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Secondary}" Text="{Binding ListNote}" Margin="0,4,0,8" Visibility="{Binding ListNote, Converter={StaticResource NotEmptyToVis}}" />
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                        <ListBox Style="{StaticResource DataList}" ItemsSource="{Binding StoreView}" AutomationProperties.Name="{x:Static t:Txt.FwTabStore}" />
                    </Border>
                </DockPanel>

                <!-- Rules: a custom rule's form (checked as it's typed), presets, and the custom rules. -->
                <ScrollViewer Visibility="{Binding IsRulesTab, Converter={StaticResource BoolToVis}}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="{x:Static t:Txt.FwNewRule}" Margin="0,0,0,10" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Style="{StaticResource FwLabel}" Text="{x:Static t:Txt.FwRuleName}" />
                                        <TextBox Text="{Binding RuleName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static t:Txt.FwRuleName}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="0,0,0,10">
                                        <TextBlock Style="{StaticResource FwLabel}" Text="{x:Static t:Txt.FwRuleProgram}" />
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="{x:Static t:Txt.FwBrowse}" Command="{Binding BrowseRuleProgramCommand}" Margin="8,0,0,0" />
                                            <TextBox Text="{Binding RuleProgram, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static t:Txt.FwRuleProgram}" />
                                        </DockPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Margin="0,0,0,10">
                                        <TextBlock Style="{StaticResource FwLabel}" Text="{x:Static t:Txt.FwRuleDirection}" />
                                        <ComboBox ItemsSource="{Binding Directions}" ItemTemplate="{StaticResource OptionText}" SelectedItem="{Binding RuleDirection, Mode=TwoWay}"
                                                  AutomationProperties.Name="{x:Static t:Txt.FwRuleDirection}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,10">
                                        <TextBlock Style="{StaticResource FwLabel}" Text="{x:Static t:Txt.FwRuleProtocol}" />
                                        <ComboBox ItemsSource="{Binding Protocols}" ItemTemplate="{StaticResource OptionText}" SelectedItem="{Binding RuleProtocol, Mode=TwoWay}"
                                                  AutomationProperties.Name="{x:Static t:Txt.FwRuleProtocol}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Margin="0,0,0,10">
                                        <TextBlock Style="{StaticResource FwLabel}" Text="{x:Static t:Txt.FwRuleRemotePorts}" />
                                        <TextBox Text="{Binding RuleRemotePorts, UpdateSourceTrigger=PropertyChanged}" Tag="{x:Static t:Txt.FwPortsExample}" AutomationProperties.Name="{x:Static t:Txt.FwRuleRemotePorts}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,10">
                                        <TextBlock Style="{StaticResource FwLabel}" Text="{x:Static t:Txt.FwRuleLocalPorts}" />
                                        <TextBox Text="{Binding RuleLocalPorts, UpdateSourceTrigger=PropertyChanged}" Tag="{x:Static t:Txt.FwPortsExample}" AutomationProperties.Name="{x:Static t:Txt.FwRuleLocalPorts}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="3">
                                        <TextBlock Style="{StaticResource FwLabel}" Text="{x:Static t:Txt.FwRuleAddresses}" />
                                        <TextBox Text="{Binding RuleAddresses, UpdateSourceTrigger=PropertyChanged}" Tag="{x:Static t:Txt.FwAddressesExample}" AutomationProperties.Name="{x:Static t:Txt.FwRuleAddresses}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="3" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                                        <ItemsControl Style="{StaticResource Segmented}" ItemsSource="{Binding RuleActions}" Tag="{Binding SetRuleActionCommand}" VerticalAlignment="Center"
                                                      AutomationProperties.Name="{x:Static t:Txt.FwNewRule}" />
                                        <Button Style="{StaticResource PrimaryButton}" Content="{x:Static t:Txt.FwAddRule}" Command="{Binding AddRuleCommand}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Style="{StaticResource FwWarning}" Text="{Binding RuleProblem}" Margin="0,10,0,0" Visibility="{Binding RuleProblem, Converter={StaticResource NotEmptyToVis}}" />
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.FwPresets}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <Button Content="{x:Static t:Txt.FwPresetNtp}" Command="{Binding PresetCommand}" CommandParameter="ntp" ToolTip="{x:Static t:Txt.FwPresetNtpTip}" />
                                    <Button Content="{x:Static t:Txt.FwPresetWindowsUpdate}" Command="{Binding PresetCommand}" CommandParameter="windows-update" ToolTip="{x:Static t:Txt.FwPresetWindowsUpdateTip}" Margin="8,0,0,0" />
                                    <Button Content="{x:Static t:Txt.FwPresetDiscovery}" Command="{Binding PresetCommand}" CommandParameter="discovery" ToolTip="{x:Static t:Txt.FwPresetDiscoveryTip}" Margin="8,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static t:Txt.FwCustomRules}" Margin="4,4,0,6" />
                        <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.FwCustomEmpty}" Margin="4,0,0,0" Visibility="{Binding NoCustomRows, Converter={StaticResource BoolToVis}}" />
                        <ItemsControl ItemsSource="{Binding CustomRows}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,6">
                                        <ContentPresenter Content="{Binding}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Log: KOS Firewall's recent drops, newest first. -->
                <DockPanel Visibility="{Binding IsLogTab, Converter={StaticResource BoolToVis}}">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Content="{x:Static t:Txt.FwRefreshLog}" Command="{Binding RefreshLogCommand}" VerticalAlignment="Center" />
                        <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.FwLogHint}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Secondary}" Text="{Binding LogNote}" TextWrapping="Wrap" Margin="0,4,0,8" Visibility="{Binding LogNote, Converter={StaticResource NotEmptyToVis}}" />
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                        <ListBox Style="{StaticResource DataList}" ItemsSource="{Binding Events}" AutomationProperties.Name="{x:Static t:Txt.FwTabLog}" />
                    </Border>
                </DockPanel>

                <!-- Hosts: the file as text, checked as it's typed; Save keeps a backup and reads the file back. -->
                <DockPanel Visibility="{Binding IsHostsTab, Converter={StaticResource BoolToVis}}">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.FwHostsUnsaved}" VerticalAlignment="Center" Margin="0,0,12,0"
                                       Visibility="{Binding HostsDirty, Converter={StaticResource BoolToVis}}" />
                            <Button Content="{x:Static t:Txt.FwReload}" Command="{Binding ReloadHostsCommand}" />
                            <Button Style="{StaticResource PrimaryButton}" Content="{x:Static t:Txt.FwSave}" Command="{Binding SaveHostsCommand}" Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Secondary}" Text="{Binding HostsHint}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
                    </DockPanel>
                    <ScrollViewer DockPanel.Dock="Bottom" MaxHeight="100" VerticalScrollBarVisibility="Auto" Focusable="False" Margin="0,8,0,0"
                                  Visibility="{Binding HostsValid, Converter={StaticResource InverseBoolToVis}}">
                        <ItemsControl ItemsSource="{Binding HostsProblems}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate><TextBlock Style="{StaticResource FwWarning}" Text="{Binding}" /></DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBox Style="{StaticResource FwCodeEditor}" Text="{Binding HostsText, UpdateSourceTrigger=PropertyChanged, Delay=300}" AutomationProperties.Name="{x:Static t:Txt.FwTabHosts}" />
                </DockPanel>
            </Grid>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
