<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:KosToolbox.ViewModels"
                    xmlns:v="clr-namespace:KosToolbox.Views"
                    xmlns:t="clr-namespace:KosToolbox.Core.Text;assembly=KosToolbox.Core">

    <!-- ===================== Install and Debloat ===================== -->
    <DataTemplate DataType="{x:Type vm:SetupAppViewModel}">
        <Border Style="{StaticResource Card}" Width="340" Margin="0,0,8,8" Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" Margin="0,0,10,0" AutomationProperties.Name="{Binding Name}"
                          IsEnabled="{Binding CanSelect}" />
                <Image Grid.Column="1" Source="{Binding Icon}" Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="{Binding Description}">
                    <TextBlock Style="{StaticResource CardTitle}" FontSize="13.5" Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    <TextBlock FontSize="12" Text="{Binding Status}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,2,0,0" ToolTip="{Binding Status}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <Button Grid.Column="3" Content="{Binding ActionText}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}"
                        Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=2}}" CommandParameter="{Binding}" />
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:SetupCategoryViewModel}">
        <StackPanel Margin="0,0,0,10">
            <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Title}" Margin="0,0,0,8" />
            <ItemsControl ItemsSource="{Binding Apps}" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:DownloadViewModel}">
        <Border Style="{StaticResource Card}" Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Source="{Binding App.Icon}" Width="32" Height="32" Margin="0,2,14,0" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Secondary}" FontSize="12" Text="{Binding Detail}" Margin="12,0,0,0" VerticalAlignment="Bottom" />
                        <TextBlock Style="{StaticResource CardTitle}" FontSize="13.5" Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </DockPanel>
                    <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Margin="0,8,0,6" />
                    <TextBlock FontSize="12" Text="{Binding State}" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Style="{StaticResource Secondary}" FontSize="12" Text="{Binding SignerText}" Margin="0,2,0,0"
                               Visibility="{Binding SignerText, Converter={StaticResource NotEmptyToVis}}" />
                    <TextBlock Style="{StaticResource Secondary}" FontSize="11.5" Text="{Binding Target}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                               ToolTip="{Binding Target}" Visibility="{Binding Target, Converter={StaticResource NotEmptyToVis}}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{x:Static t:Txt.Cancel}" Margin="6,0,0,0" CommandParameter="{Binding}"
                            Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}" />
                    <Button Content="{Binding RunText}" Margin="6,0,0,0" CommandParameter="{Binding}"
                            Command="{Binding DataContext.RunCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            Visibility="{Binding CanRun, Converter={StaticResource BoolToVis}}" />
                    <Button Content="{x:Static t:Txt.SetupRetry}" Margin="6,0,0,0" CommandParameter="{Binding}"
                            Command="{Binding DataContext.RetryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            Visibility="{Binding CanRetry, Converter={StaticResource BoolToVis}}" />
                    <Button Content="{x:Static t:Txt.SetupRemove}" Margin="6,0,0,0" CommandParameter="{Binding}"
                            Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVis}}" />
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- One debloat function: the box runs it, and only the name shows; what it does is in the tooltip. -->
    <ItemsPanelTemplate x:Key="DebloatRows"><WrapPanel /></ItemsPanelTemplate>
    <DataTemplate DataType="{x:Type vm:DebloatOptionViewModel}">
        <Border Style="{StaticResource Card}" Width="340" Margin="0,0,8,8" Padding="12,10" ToolTip="{Binding Description}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox IsChecked="{Binding IsChecked}" IsEnabled="{Binding CanClick}" VerticalAlignment="Center" Margin="0,0,10,0" AutomationProperties.Name="{Binding Name}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource CardTitle}" FontSize="13.5" Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource OperationMessage}" />
                </StackPanel>
                <TextBlock Grid.Column="2" Style="{StaticResource Icon}" Text="&#xEA18;" FontSize="12" Margin="8,0,0,0" Foreground="{StaticResource TextSecondaryBrush}"
                           ToolTip="{x:Static t:Txt.NeedsAdminTooltip}" AutomationProperties.Name="{x:Static t:Txt.NeedsAdminTooltip}"
                           Visibility="{Binding ShowAdminBadge, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </Border>
    </DataTemplate>

    <!-- OBS profile form. -->
    <DataTemplate DataType="{x:Type vm:ObsProfileViewModel}">
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="{x:Static t:Txt.ObsProfileTitle}" Margin="0,0,0,2" />
                <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.ObsProfileInfo}" TextWrapping="Wrap" />
                <TextBlock Style="{StaticResource Secondary}" Text="{Binding ActiveText}" Margin="0,3,0,10" />
                <WrapPanel>
                    <StackPanel Margin="0,0,12,6">
                        <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.ObsResolution}" Margin="0,0,0,4" />
                        <ComboBox MinWidth="110" ItemsSource="{Binding Resolutions}" SelectedItem="{Binding Resolution}" AutomationProperties.Name="{x:Static t:Txt.ObsResolution}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,6">
                        <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.ObsFps}" Margin="0,0,0,4" />
                        <ComboBox MinWidth="110" ItemsSource="{Binding FpsOptions}" SelectedItem="{Binding Fps}" AutomationProperties.Name="{x:Static t:Txt.ObsFps}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,6" Visibility="{Binding IsCustomFps, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.ObsCustomFps}" Margin="0,0,0,4" />
                        <TextBox Width="80" Text="{Binding CustomFps, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{x:Static t:Txt.ObsCustomFps}" />
                    </StackPanel>
                    <StackPanel Margin="0,0,12,6">
                        <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.ObsEncoderLabel}" Margin="0,0,0,4" />
                        <ComboBox MinWidth="170" ItemsSource="{Binding Encoders}" SelectedItem="{Binding Encoder}" AutomationProperties.Name="{x:Static t:Txt.ObsEncoderLabel}" />
                    </StackPanel>
                    <Button Style="{StaticResource PrimaryButton}" Content="{x:Static t:Txt.ObsCreateProfile}" VerticalAlignment="Bottom" Margin="0,0,0,6" Command="{Binding CreateCommand}" />
                </WrapPanel>
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource OperationMessage}" />
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- An installed app: header that expands to its functions. -->
    <DataTemplate DataType="{x:Type vm:DebloatAppViewModel}">
        <StackPanel Margin="0,0,0,8">
            <ToggleButton Cursor="Hand" IsChecked="{Binding IsExpanded, Mode=TwoWay}" FocusVisualStyle="{StaticResource FocusVisual}" AutomationProperties.Name="{Binding Header}">
                <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent" Padding="2,6,2,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="chev" Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="10" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                                <Image Source="{Binding Icon}" Width="20" Height="20" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock Style="{StaticResource SectionTitle}" Text="{Binding Header}" VerticalAlignment="Center" Margin="0" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="chev" Property="v:Motion.Angle" Value="-90" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </ToggleButton.Template>
            </ToggleButton>
            <StackPanel Visibility="Collapsed" Opacity="0" v:Motion.RevealWhen="{Binding IsExpanded}">
                <ContentPresenter Content="{Binding ObsProfile}" Visibility="{Binding ObsProfile, Converter={StaticResource NotEmptyToVis}}" />
                <StackPanel Visibility="{Binding HasPresets, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static t:Txt.DebloatPresets}" Margin="2,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Presets}" ItemsPanel="{StaticResource DebloatRows}" Focusable="False" Margin="0,0,0,6" />
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static t:Txt.DebloatFunctions}" Margin="2,0,0,8" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Functions}" ItemsPanel="{StaticResource DebloatRows}" Focusable="False" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:DebloatPageViewModel}">
        <StackPanel>
            <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.DebloatIntro}" TextWrapping="Wrap" Margin="0,0,0,10" />
            <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.DebloatNoApps}" TextWrapping="Wrap"
                       Visibility="{Binding HasDebloatApps, Converter={StaticResource InverseBoolToVis}}" />
            <ItemsControl ItemsSource="{Binding DebloatApps}" Focusable="False" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:SetupPageViewModel}">
        <StackPanel>
            <ItemsControl Style="{StaticResource Segmented}" ItemsSource="{Binding Tabs}" Tag="{Binding SelectTabCommand}" HorizontalAlignment="Left"
                          Margin="0,0,0,12" AutomationProperties.Name="{x:Static t:Txt.Tabs}" />

            <StackPanel Visibility="{Binding ShowApps, Converter={StaticResource BoolToVis}}" v:Motion.Transition="{Binding ShowApps}">
                <DockPanel LastChildFill="False" Margin="0,0,0,12">
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource PageSearch}" VerticalAlignment="Center" />
                    <Button Style="{StaticResource PrimaryButton}" Content="{x:Static t:Txt.SetupInstallSelected}" Margin="8,0,0,0" Command="{Binding InstallSelectedCommand}" />
                    <Button Content="{x:Static t:Txt.SetupClearSelection}" Margin="8,0,0,0" Command="{Binding ClearSelectionCommand}" />
                    <TextBlock Style="{StaticResource Secondary}" Text="{Binding SelectedText}" Margin="10,0,0,0" VerticalAlignment="Center" />
                </DockPanel>
                <ItemsControl ItemsSource="{Binding Categories}" Focusable="False" />
            </StackPanel>

            <!-- Updates: catalog programs with a newer version -->
            <StackPanel Visibility="{Binding ShowUpdates, Converter={StaticResource BoolToVis}}" v:Motion.Transition="{Binding ShowUpdates}">
                <StackPanel DataContext="{Binding Updates}">
                    <TextBlock Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="Programs from the Apps tab with a newer version: Chocolatey's own list for the ones it installed, and the developer's newest release for the downloaded ones. Updating goes through the same downloads and signature check as installing." />
                    <DockPanel LastChildFill="False" Margin="0,0,0,10">
                        <Button Style="{StaticResource PrimaryButton}" Content="Update selected" Command="{Binding UpdateCommand}" />
                        <Button Content="Check again" Margin="8,0,0,0" Command="{Binding CheckCommand}" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Secondary}" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,0,0,10" Visibility="{Binding Status, Converter={StaticResource NotEmptyToVis}}" />
                    <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Width="340" Margin="0,0,8,8" Padding="12,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" Margin="0,0,10,0" AutomationProperties.Name="{Binding Name}" />
                                        <Image Grid.Column="1" Source="{Binding Icon}" Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" ToolTip="{Binding Source}">
                                            <TextBlock Style="{StaticResource CardTitle}" FontSize="13.5" Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            <TextBlock FontSize="12" Text="{Binding Versions}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,2,0,0" />
                                            <TextBlock Style="{StaticResource Secondary}" FontSize="12" Text="{Binding Source}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>

            <!-- Microsoft Store: install a Store app's packages without the Store app -->
            <StackPanel Visibility="{Binding ShowStore, Converter={StaticResource BoolToVis}}" v:Motion.Transition="{Binding ShowStore}">
                <StackPanel DataContext="{Binding Store}">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Secondary}" TextWrapping="Wrap"
                                       Text="Installs a free Microsoft Store app without the Store app, a Microsoft account or Windows Update: its packages come from the Store's own delivery service, are checked against the hash it lists and installed for this user. Type the app's name, or paste its Store link (apps.microsoft.com) or its id." />
                            <TextBlock Style="{StaticResource Secondary}" Text="{Binding ServicesNote}" Foreground="{StaticResource WarningBrush}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Visibility="{Binding ServicesNote, Converter={StaticResource NotEmptyToVis}}" />
                            <DockPanel Margin="0,12,0,0">
                                <Button DockPanel.Dock="Right" Content="{x:Static t:Txt.Cancel}" Command="{Binding CancelCommand}" Margin="6,0,0,0"
                                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Find" Command="{Binding FindCommand}" Margin="6,0,0,0" MinWidth="80" />
                                <TextBox Text="{Binding Link, UpdateSourceTrigger=PropertyChanged}" Tag="https://apps.microsoft.com/detail/9WZDNCRFHVN5" VerticalContentAlignment="Center"
                                         AutomationProperties.Name="App name, Store link or product id" />
                            </DockPanel>
                            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding Status, Converter={StaticResource NotEmptyToVis}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsError}" Value="True"><Setter Property="Foreground" Value="{StaticResource ErrorBrush}" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ProgressBar Value="{Binding Percent, Mode=OneWay}" Maximum="100" Margin="0,8,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,0,0,10" Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding Results}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,3,0,3">
                                        <Button DockPanel.Dock="Right" Content="Select" Margin="12,0,0,0" VerticalAlignment="Center"
                                                Command="{Binding DataContext.PickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Style="{StaticResource Secondary}" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Publisher, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding ProductId, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <Border Style="{StaticResource Card}" Visibility="{Binding HasProduct, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Install" Command="{Binding InstallCommand}" MinWidth="90" />
                                <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Packages}" Focusable="False" Margin="0,8,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3,0,3">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                                            <TextBlock Grid.Column="1" Style="{StaticResource Secondary}" Text="{Binding Detail}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>

            <StackPanel Visibility="{Binding ShowDownloads, Converter={StaticResource BoolToVis}}" v:Motion.Transition="{Binding ShowDownloads}">
                <DockPanel LastChildFill="False" Margin="0,0,0,8">
                    <Button Content="{x:Static t:Txt.OpenFolder}" Command="{Binding OpenFolderCommand}" />
                    <Button Content="{x:Static t:Txt.SetupClearFinished}" Margin="8,0,0,0" Command="{Binding ClearFinishedCommand}" />
                    <TextBlock Style="{StaticResource Secondary}" Text="{Binding ActiveText}" Margin="10,0,0,0" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Style="{StaticResource Secondary}" Text="{Binding FolderText}" Margin="0,0,0,2" />
                <TextBlock Style="{StaticResource Secondary}" Text="{Binding Aria2Text}" Margin="0,0,0,10" />
                <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.SetupNoDownloads}" Margin="0,6,0,0"
                           Visibility="{Binding HasDownloads, Converter={StaticResource InverseBoolToVis}}" />
                <ItemsControl ItemsSource="{Binding Downloads}" Focusable="False" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
