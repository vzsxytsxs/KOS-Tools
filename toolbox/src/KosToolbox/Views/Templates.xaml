<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:KosToolbox.ViewModels"
                    xmlns:v="clr-namespace:KosToolbox.Views"
                    xmlns:si="clr-namespace:KosToolbox.Core.SystemInfo;assembly=KosToolbox.Core"
                    xmlns:t="clr-namespace:KosToolbox.Core.Text;assembly=KosToolbox.Core">

    <v:InverseBoolToVisibility x:Key="InverseBoolToVis" />
    <v:InverseBool x:Key="InvertBool" />
    <v:NotEmptyToVisibility x:Key="NotEmptyToVis" />
    <v:AnyVisibleConverter x:Key="AnyVisible" />

    <!-- Text of an OptionItem in lists (the ComboBox never shows the class name). -->
    <DataTemplate x:Key="OptionText">
        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
    </DataTemplate>

    <!-- Operation message row (progress, result or error) with "Cancel" while it is queued. -->
    <DataTemplate x:Key="OperationMessage">
        <DockPanel Margin="0,6,0,0" Visibility="{Binding HasMessage, Converter={StaticResource BoolToVis}}">
            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="{x:Static t:Txt.Cancel}" FontSize="12" Margin="10,0,0,0"
                    Command="{Binding CancelCommand}" Visibility="{Binding IsQueued, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="{Binding Message}" FontSize="12" TextWrapping="Wrap" v:Motion.Transition="{Binding Message}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DockPanel>
    </DataTemplate>

    <!-- Warning when the log can't be written (in English, without changing the destination), with the permissions fix. -->
    <DataTemplate x:Key="LogProblem">
        <Border Style="{StaticResource Card}" BorderBrush="{StaticResource WarningBrush}" Visibility="{Binding HasProblem, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource CardTitle}" Text="{x:Static t:Txt.LogProblemTitle}" />
                    <TextBlock Style="{StaticResource Secondary}" Text="{Binding Problem}" Foreground="{StaticResource WarningBrush}" Margin="0,3,0,0" />
                    <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.LogProblemDetail}" Margin="0,3,0,0" />
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource OperationMessage}" />
                </StackPanel>
                <Button Grid.Column="1" Content="{x:Static t:Txt.FixPermissions}" VerticalAlignment="Center" Command="{Binding FixCommand}"
                        Visibility="{Binding CanFix, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </Border>
    </DataTemplate>

    <!-- ===== Tweak card ===== -->
    <DataTemplate DataType="{x:Type vm:TweakViewModel}">
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                    <WrapPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Name}" Margin="0,0,10,2" VerticalAlignment="Center" />
                        <Border Visibility="{Binding StatusText, Converter={StaticResource NotEmptyToVis}}" ToolTip="{Binding PartialTooltip}">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Pill}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsProblem}" Value="True">
                                            <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding StatusText}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
                        </Border>
                        <Border Style="{StaticResource Pill}" BorderBrush="{StaticResource WarningBrush}"
                                Visibility="{Binding RebootPending, Converter={StaticResource BoolToVis}}" ToolTip="{x:Static t:Txt.RestartPendingTooltip}">
                            <TextBlock Text="{x:Static t:Txt.RestartRequired}" FontSize="11.5" Foreground="{StaticResource WarningBrush}" />
                        </Border>
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7E8;" FontSize="12" Margin="0,0,8,0" Foreground="{StaticResource TextSecondaryBrush}"
                                   ToolTip="{x:Static t:Txt.NeedsRestartTooltip}" AutomationProperties.Name="{x:Static t:Txt.NeedsRestartTooltip}"
                                   Visibility="{Binding RequiresReboot, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Style="{StaticResource Icon}" Text="&#xEA18;" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                   ToolTip="{x:Static t:Txt.NeedsAdminTooltip}" AutomationProperties.Name="{x:Static t:Txt.NeedsAdminTooltip}"
                                   Visibility="{Binding ShowAdminBadge, Converter={StaticResource BoolToVis}}" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Secondary}" Text="{Binding Description}" Margin="0,3,0,0" />
                    <TextBlock Style="{StaticResource Secondary}" Text="{Binding StatusDetail}" Foreground="{StaticResource WarningBrush}" Margin="0,4,0,0"
                               Visibility="{Binding ShowDetailLine, Converter={StaticResource BoolToVis}}" />
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource OperationMessage}" />
                    <Button Style="{StaticResource LinkButton}" Content="{x:Static t:Txt.RestartExplorerNow}" FontSize="12" HorizontalAlignment="Left" Margin="0,6,0,0"
                            Command="{Binding RestartExplorerCommand}" Visibility="{Binding ShowRestartExplorer, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ItemsControl Style="{StaticResource Segmented}" ItemsSource="{Binding Options}" Tag="{Binding SelectCommand}" IsEnabled="{Binding CanChange}"
                                  AutomationProperties.Name="{Binding Name}"
                                  Visibility="{Binding IsChoice, Converter={StaticResource InverseBoolToVis}}" />
                    <ComboBox ItemsSource="{Binding Options}" ItemTemplate="{StaticResource OptionText}" SelectedItem="{Binding PendingOption, Mode=TwoWay}"
                              Tag="{Binding StatusText}" IsEnabled="{Binding CanChange}" AutomationProperties.Name="{Binding Name}"
                              Visibility="{Binding IsChoice, Converter={StaticResource BoolToVis}}" />
                    <Button Style="{StaticResource PrimaryButton}" Content="{x:Static t:Txt.Apply}" Margin="8,0,0,0" Command="{Binding ApplyPendingCommand}"
                            Visibility="{Binding PendingDiffers, Converter={StaticResource BoolToVis}}" />
                    <Button Style="{StaticResource IconButton}" Content="&#xE712;" Margin="6,0,0,0" v:MenuButton.OpenOnClick="True"
                            ToolTip="{x:Static t:Txt.MoreOptionsTooltip}" AutomationProperties.Name="{x:Static t:Txt.MoreOptions}">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{x:Static t:Txt.RestorePreviousMenu}" Command="{Binding RestorePreviousCommand}" />
                                <MenuItem Header="{x:Static t:Txt.RestoreOriginalMenu}" Command="{Binding RestoreOriginalCommand}" />
                                <MenuItem Header="{Binding KosDefaultLabel}" Command="{Binding KosDefaultCommand}" />
                                <MenuItem Header="{Binding WindowsDefaultLabel}" Command="{Binding WindowsDefaultCommand}" />
                                <MenuItem Header="{x:Static t:Txt.DetailsMenu}" Command="{Binding DetailsCommand}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- ===== Action card ===== -->
    <DataTemplate DataType="{x:Type vm:ActionViewModel}">
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                    <WrapPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Name}" Margin="0,0,10,2" VerticalAlignment="Center" />
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7E8;" FontSize="12" Margin="0,0,8,0" Foreground="{StaticResource TextSecondaryBrush}"
                                   ToolTip="{x:Static t:Txt.NeedsRestartAfterTooltip}" AutomationProperties.Name="{x:Static t:Txt.NeedsRestartAfterTooltip}"
                                   Visibility="{Binding RequiresReboot, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Style="{StaticResource Icon}" Text="&#xEA18;" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                   ToolTip="{x:Static t:Txt.NeedsAdminTooltip}" AutomationProperties.Name="{x:Static t:Txt.NeedsAdminTooltip}"
                                   Visibility="{Binding ShowAdminBadge, Converter={StaticResource BoolToVis}}" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Secondary}" Text="{Binding Description}" Margin="0,3,0,0" />
                    <TextBlock Style="{StaticResource Secondary}" Text="{Binding Problem}" Foreground="{StaticResource WarningBrush}" Margin="0,4,0,0"
                               Visibility="{Binding HasProblem, Converter={StaticResource BoolToVis}}" />
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource OperationMessage}" />
                </StackPanel>
                <Button Grid.Column="1" Content="{Binding ButtonText}" MinWidth="104" VerticalAlignment="Center" Command="{Binding RunCommand}"
                        AutomationProperties.Name="{Binding Name}" />
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:GroupViewModel}">
        <Expander Style="{StaticResource GroupExpander}" Header="{Binding Title}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
            <ItemsControl ItemsSource="{Binding Items}" Focusable="False" />
        </Expander>
    </DataTemplate>

    <!-- ===== Catalog page (tabs + groups) ===== -->
    <DataTemplate DataType="{x:Type vm:CatalogPageViewModel}">
        <StackPanel>
            <DockPanel Margin="0,0,0,12" LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="{x:Static t:Txt.ApplyKosDefaults}" VerticalAlignment="Top" Margin="12,0,0,0"
                        Command="{Binding ApplyKosDefaultsCommand}" Visibility="{Binding HasKosDefaults, Converter={StaticResource BoolToVis}}"
                        ToolTip="{x:Static t:Txt.ApplyKosDefaultsTooltip}" />
                <ListBox Style="{StaticResource TabList}" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                         AutomationProperties.Name="{x:Static t:Txt.Tabs}" Visibility="{Binding HasTabs, Converter={StaticResource BoolToVis}}" />
            </DockPanel>
            <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.NoSearchResults}"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
            <ItemsControl ItemsSource="{Binding SelectedTab.Groups}" Focusable="False" v:Motion.Transition="{Binding SelectedTab}" />
        </StackPanel>
    </DataTemplate>

    <!-- ===== Home ===== -->
    <DataTemplate DataType="{x:Type si:InfoRow}">
        <Grid Margin="0,3,16,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="InfoLabel" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,24,0" />
            <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
        </Grid>
    </DataTemplate>

    <!-- ===== Home: the hardware and the system's state in a list, the selected row in the inspector beside it ===== -->
    <DataTemplate DataType="{x:Type vm:CoreTile}">
        <Border Margin="0,0,6,6" Padding="8,6" CornerRadius="5" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Parked}" Value="True"><Setter Property="Opacity" Value="0.55" /></DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="Parked" FontSize="10.5" Foreground="{StaticResource WarningBrush}" Visibility="{Binding Parked, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding Detail, StringFormat='  ·  {0}'}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Opacity="0.75"
                               Visibility="{Binding Detail, Converter={StaticResource NotEmptyToVis}}" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <v:Sparkline Values="{Binding History}" Maximum="100" Height="34" ShowGrid="False" Margin="0,4,0,4" />
                <TextBlock Text="{Binding Text}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- A row of Home's list (hardware or system): marked like the sidebar's pages when selected. -->
    <Style x:Key="HomeRow" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
        <Setter Property="Command" Value="{Binding DataContext.SelectCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
        <Setter Property="CommandParameter" Value="{Binding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border Background="{StaticResource ControlBrush}" Opacity="0" v:Motion.ShowWhen="{TemplateBinding IsMouseOver}" />
                        <Border Background="{StaticResource HoverBrush}" Opacity="0" v:Motion.ShowWhen="{Binding IsSelected}" />
                        <Border Width="3" HorizontalAlignment="Left" Background="{StaticResource TextBrush}" Opacity="0" v:Motion.ShowWhen="{Binding IsSelected}" />
                        <ContentPresenter Margin="16,0" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="HomeHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="Margin" Value="16,12,16,4" />
    </Style>

    <!-- Hardware row: name and second line, a small graph of the last minute, and the main figure. -->
    <DataTemplate x:Key="HomeHardwareRow">
        <Button Style="{StaticResource HomeRow}" Height="52" AutomationProperties.Name="{Binding Title}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="64" /><ColumnDefinition Width="Auto" MinWidth="62" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock x:Name="name" Text="{Binding Title}" />
                    <TextBlock Text="{Binding Line}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Line}" />
                </StackPanel>
                <v:Sparkline Grid.Column="1" Values="{Binding History}" Maximum="{Binding Max}" Height="24" ShowGrid="False" Framed="False" />
                <TextBlock Grid.Column="2" Text="{Binding Short}" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0"
                           Typography.NumeralAlignment="Tabular" />
            </Grid>
        </Button>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="name" Property="FontWeight" Value="SemiBold" /></DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- System row: a status dot (warning and error brushes only for those), name and second line. -->
    <DataTemplate x:Key="HomeSystemRowTemplate">
        <Button Style="{StaticResource HomeRow}" Height="48" AutomationProperties.Name="{Binding Name}" Visibility="{Binding IsVisible, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Ellipse x:Name="dot" Width="7" Height="7" Fill="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="name" Text="{Binding Name}" />
                    <TextBlock Text="{Binding Sub}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Sub}" />
                </StackPanel>
                <TextBlock Grid.Column="2" Style="{StaticResource Icon}" Text="&#xE76C;" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="12,0,0,0" />
            </Grid>
        </Button>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="name" Property="FontWeight" Value="SemiBold" /></DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="{x:Static vm:HomeLevel.Normal}"><Setter TargetName="dot" Property="Fill" Value="{StaticResource TextBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="{x:Static vm:HomeLevel.Warning}"><Setter TargetName="dot" Property="Fill" Value="{StaticResource WarningBrush}" /></DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="{x:Static vm:HomeLevel.Error}"><Setter TargetName="dot" Property="Fill" Value="{StaticResource ErrorBrush}" /></DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- ===== Home inspector: hardware details ===== -->
    <ItemsPanelTemplate x:Key="SectionsStack"><StackPanel /></ItemsPanelTemplate>
    <ItemsPanelTemplate x:Key="SectionsTwoColumns"><UniformGrid Columns="2" VerticalAlignment="Top" /></ItemsPanelTemplate>

    <DataTemplate DataType="{x:Type vm:InfoSection}">
        <Border Style="{StaticResource Card}" Margin="0,0,8,8">
            <StackPanel>
                <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Title}" Margin="0,0,0,8" />
                <!-- One column: a stack, so a value that wraps doesn't make every row as tall as it. -->
                <ItemsControl ItemsSource="{Binding Rows}" Grid.IsSharedSizeScope="True" Focusable="False">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><UniformGrid Columns="{Binding Columns}" VerticalAlignment="Top" /></ItemsPanelTemplate></Setter.Value></Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Columns}" Value="1"><Setter Property="ItemsPanel" Value="{StaticResource SectionsStack}" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                </ItemsControl>
                <TextBox Style="{StaticResource ReadOnlyText}" Text="{Binding Mono, Mode=OneWay}" FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap"
                         Margin="0,12,0,0" Foreground="{StaticResource TextSecondaryBrush}" Visibility="{Binding Mono, Converter={StaticResource NotEmptyToVis}}" />
            </StackPanel>
        </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:CoresSection}">
        <ItemsControl ItemsSource="{Binding Cores}" Focusable="False" Margin="0,0,2,8">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        </ItemsControl>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:ActionSection}">
        <Border Style="{StaticResource Card}" Margin="0,0,8,8">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Title}" />
                    <TextBlock Style="{StaticResource Secondary}" Text="{Binding Text}" Margin="0,3,0,0" />
                    <TextBlock x:Name="status" Style="{StaticResource Secondary}" Text="{Binding Status}" Foreground="{StaticResource TextBrush}" Margin="0,8,0,0"
                               Visibility="{Binding Status, Converter={StaticResource NotEmptyToVis}}" />
                </StackPanel>
                <Button Grid.Column="1" Content="{Binding Button}" Command="{Binding Command}" VerticalAlignment="Center" MinWidth="96" />
            </Grid>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsError}" Value="True"><Setter TargetName="status" Property="Foreground" Value="{StaticResource WarningBrush}" /></DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Timings laid out in columns by group, name on the left and the value in a box. -->
    <DataTemplate DataType="{x:Type vm:TimingsSection}">
        <StackPanel Margin="0,0,0,8">
            <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Title}" Margin="0,0,0,10" />
                                <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,0,0,7">
                                                <Border x:Name="box" DockPanel.Dock="Right" MinWidth="66" Padding="8,4" CornerRadius="4" VerticalAlignment="Center"
                                                        Background="{StaticResource ControlBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                                                        ToolTip="Read live from the memory controller (CPU-Z)">
                                                    <TextBlock x:Name="value" Text="{Binding Value}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                                </Border>
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding Code}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Name}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding FromSpd}" Value="True">
                                                    <Setter TargetName="box" Property="Background" Value="Transparent" />
                                                    <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                                    <Setter TargetName="box" Property="ToolTip" Value="Calculated from the SPD for the current speed" />
                                                    <Setter TargetName="value" Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                    <Setter TargetName="value" Property="FontWeight" Value="Normal" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Style="{StaticResource Secondary}" FontSize="12" Margin="0,8,0,0"
                       Text="Filled boxes: read live from the memory controller. Outlined: calculated from the SPD and the JEDEC rules for the current speed, which is what the BIOS uses on Auto; a value set by hand in the BIOS isn't seen there." />
        </StackPanel>
    </DataTemplate>


    <!-- A component's tabs and sections, under the inspector's graph and figures. -->
    <DataTemplate DataType="{x:Type vm:HardwareDetail}">
        <StackPanel>
            <ListBox Style="{StaticResource TabList}" ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                     Margin="0,0,0,10" AutomationProperties.Name="{x:Static t:Txt.Tabs}" Visibility="{Binding HasTabs, Converter={StaticResource BoolToVis}}" />
            <TextBlock Style="{StaticResource Secondary}" Text="{Binding SelectedTab.Note}" Margin="0,0,0,10"
                       Visibility="{Binding SelectedTab.Note, Converter={StaticResource NotEmptyToVis}}" />
            <ContentControl Content="{Binding SelectedTab.Header}" Focusable="False" />
            <ItemsControl ItemsSource="{Binding SelectedTab.Sections}" Focusable="False">
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Setter Property="ItemsPanel" Value="{StaticResource SectionsStack}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTab.Columns}" Value="2"><Setter Property="ItemsPanel" Value="{StaticResource SectionsTwoColumns}" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
            </ItemsControl>
        </StackPanel>
    </DataTemplate>

    <!-- The selected hardware row: title and chips, the last minute's graph, its figures in one line, then its details (none for network). -->
    <DataTemplate DataType="{x:Type vm:HardwareInspector}">
        <StackPanel>
            <TextBlock Style="{StaticResource Secondary}" FontSize="12" Text="{x:Static t:Txt.HomeHardwareCrumb}" />
            <WrapPanel Margin="0,4,0,14">
                <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" Margin="0,0,10,0" VerticalAlignment="Center" />
                <ItemsControl ItemsSource="{Binding Chips}" Focusable="False" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="7,1" Margin="0,2,8,2">
                                <TextBlock Text="{Binding}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </WrapPanel>
            <Border Background="{StaticResource ControlBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,12,14,8">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding Card.MaxText}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                        <TextBlock Text="{Binding Card.Graph}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                    </DockPanel>
                    <v:Sparkline Values="{Binding Card.History}" Maximum="{Binding Card.Max}" Height="150" Framed="False" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            <ItemsControl ItemsSource="{Binding Card.Details}" Focusable="False" Margin="0,14,0,16">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="{Binding Label}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Value}" FontSize="16" FontWeight="SemiBold" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Value}"
                                       Typography.NumeralAlignment="Tabular" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ContentControl Content="{Binding Detail}" Focusable="False" />
        </StackPanel>
    </DataTemplate>

    <!-- ===== Home inspector: system sections (the DataContext is HomeViewModel) ===== -->
    <!-- KOS state: only after a Windows update put KOS items back (read-only check on Home). -->
    <DataTemplate x:Key="HomeKosSection">
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource CardTitle}" Text="{Binding KosNotice}" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.KosHomeNote}" Margin="0,3,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="{x:Static t:Txt.KosHomeReview}" VerticalAlignment="Center" Command="{Binding OpenKosStateCommand}" />
            </Grid>
        </Border>
    </DataTemplate>

    <!-- KOS post-install: only with warnings or errors; each with what it means. -->
    <DataTemplate x:Key="HomePostSetupSection">
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource CardTitle}" Text="{Binding PostSetup.StatusText}" />
                        <TextBlock Style="{StaticResource Secondary}" Text="{Binding PostSetup.Counts}" Margin="0,3,0,0" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="{x:Static t:Txt.OpenPostSetupLogs}" VerticalAlignment="Center" Command="{Binding OpenPostSetupCommand}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding PostSetup.Issues}" Margin="0,10,0,0" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,0,6">
                                <DockPanel>
                                    <Border x:Name="pill" DockPanel.Dock="Left" Style="{StaticResource Pill}" BorderBrush="{StaticResource WarningBrush}" VerticalAlignment="Top" Margin="0,1,12,0" MinWidth="64">
                                        <TextBlock x:Name="kind" Text="Warning" FontSize="11.5" Foreground="{StaticResource WarningBrush}" HorizontalAlignment="Center" />
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Detail}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Style="{StaticResource Secondary}" Text="{Binding Explanation}" Margin="0,2,0,0" />
                                        <TextBlock Style="{StaticResource Secondary}" Text="{Binding Meta}" FontSize="11.5" Opacity="0.75" Margin="0,3,0,0" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsError}" Value="True">
                                    <Setter TargetName="kind" Property="Text" Value="Error" />
                                    <Setter TargetName="kind" Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                    <Setter TargetName="pill" Property="BorderBrush" Value="{StaticResource ErrorBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- What takes effect after a restart (the toolbox's changes and Windows' own reasons). -->
    <DataTemplate x:Key="HomePendingSection">
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource CardTitle}" Text="{x:Static t:Txt.RestartRequired}" />
                    <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.NothingPendingRestart}" Margin="0,3,0,0"
                               Visibility="{Binding HasPending, Converter={StaticResource InverseBoolToVis}}" />
                    <ItemsControl ItemsSource="{Binding Pending}" Margin="0,4,0,0" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource Secondary}" Text="{Binding StringFormat='• {0}'}" Margin="0,1" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <Button Grid.Column="1" Content="{x:Static t:Txt.RestartNow}" VerticalAlignment="Center" Command="{Binding RestartCommand}"
                        Visibility="{Binding HasPending, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </Border>
    </DataTemplate>

    <!-- State of system settings and hardware checks, read when Home opens. -->
    <DataTemplate x:Key="HomeStatusSection">
        <Border Style="{StaticResource Card}">
            <ItemsControl ItemsSource="{Binding SystemStatus}" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="3*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                            <TextBlock Grid.Column="1" Text="{Binding Value}" FontWeight="SemiBold" TextAlignment="Right" TextWrapping="Wrap" Margin="12,0,0,0" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="HomeLogsSection">
        <ContentControl Content="{Binding Logs}" ContentTemplate="{StaticResource LogProblem}" Focusable="False" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:HomeSystemRow}">
        <StackPanel>
            <TextBlock Style="{StaticResource Secondary}" FontSize="12" Text="{x:Static t:Txt.HomeSystemCrumb}" />
            <TextBlock Text="{Binding Name}" FontSize="24" FontWeight="SemiBold" Margin="0,4,0,14" />
            <ContentControl Content="{Binding Home}" Focusable="False">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Key}" Value="kos"><Setter Property="ContentTemplate" Value="{StaticResource HomeKosSection}" /></DataTrigger>
                            <DataTrigger Binding="{Binding Key}" Value="post"><Setter Property="ContentTemplate" Value="{StaticResource HomePostSetupSection}" /></DataTrigger>
                            <DataTrigger Binding="{Binding Key}" Value="pending"><Setter Property="ContentTemplate" Value="{StaticResource HomePendingSection}" /></DataTrigger>
                            <DataTrigger Binding="{Binding Key}" Value="status"><Setter Property="ContentTemplate" Value="{StaticResource HomeStatusSection}" /></DataTrigger>
                            <DataTrigger Binding="{Binding Key}" Value="logs"><Setter Property="ContentTemplate" Value="{StaticResource HomeLogsSection}" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </StackPanel>
    </DataTemplate>

    <!-- Home: the list (360 px) and the inspector, each scrolling on its own; MainWindow gives Home the full height. -->
    <DataTemplate DataType="{x:Type vm:HomeViewModel}">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="360" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,1,0,0" CornerRadius="10,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel Margin="0,4,0,12">
                        <TextBlock Style="{StaticResource HomeHeader}" Text="{x:Static t:Txt.HomeHardwareHeader}" />
                        <ItemsControl ItemsSource="{Binding Hardware}" ItemTemplate="{StaticResource HomeHardwareRow}" Focusable="False" />
                        <ItemsControl ItemsSource="{Binding Resources}" ItemTemplate="{StaticResource HomeHardwareRow}" Focusable="False" />
                        <TextBlock Style="{StaticResource HomeHeader}" Text="{x:Static t:Txt.HomeSystemHeader}" />
                        <ItemsControl ItemsSource="{Binding SystemRows}" ItemTemplate="{StaticResource HomeSystemRowTemplate}" Focusable="False" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Border Grid.Column="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,1,0,0">
                <ScrollViewer x:Name="InspectorScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <ContentControl Content="{Binding Inspector}" Focusable="False" Margin="28,20,28,24" v:Motion.Transition="{Binding Inspector}" />
                </ScrollViewer>
            </Border>
        </Grid>
    </DataTemplate>

    <!-- ===== Settings ===== -->
    <DataTemplate DataType="{x:Type vm:PreferenceViewModel}">
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource CardTitle}" Text="{Binding Name}" />
                    <TextBlock Style="{StaticResource Secondary}" Text="{Binding Description}" Margin="0,3,0,0" />
                </StackPanel>
                <ItemsControl Grid.Column="1" Style="{StaticResource Segmented}" ItemsSource="{Binding Options}" Tag="{Binding SelectCommand}"
                              VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}" />
            </Grid>
        </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
        <StackPanel>
            <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static t:Txt.SectionPreferences}" Margin="2,0,0,8" />
            <ItemsControl ItemsSource="{Binding Preferences}" Focusable="False" />

            <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static t:Txt.SectionData}" Margin="2,12,0,8" />
            <ContentControl Content="{Binding Logs}" ContentTemplate="{StaticResource LogProblem}" Focusable="False" />
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource CardTitle}" Text="{x:Static t:Txt.LogsTitle}" />
                        <TextBlock Style="{StaticResource Secondary}" Margin="0,3,0,0" Text="{Binding Logs.Directory, StringFormat={x:Static t:Txt.LogsDetailFormat}}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="{x:Static t:Txt.OpenLogsFolder}" VerticalAlignment="Center" Command="{Binding Logs.OpenCommand}" />
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource CardTitle}" Text="{x:Static t:Txt.SavedStatesTitle}" />
                        <TextBlock Style="{StaticResource Secondary}" Margin="0,3,0,0" Text="{Binding DataText}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="{x:Static t:Txt.OpenFolder}" VerticalAlignment="Center" Command="{Binding OpenDataCommand}" />
                </Grid>
            </Border>
            <Border Style="{StaticResource Card}" Visibility="{Binding CanRestartAsAdmin, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource CardTitle}" Text="{x:Static t:Txt.RunAsAdminTitle}" />
                        <TextBlock Style="{StaticResource Secondary}" Margin="0,3,0,0" Text="{x:Static t:Txt.RunAsAdminDetail}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="{x:Static t:Txt.RestartAsAdmin}" VerticalAlignment="Center" Command="{Binding RestartAsAdminCommand}" />
                </Grid>
            </Border>

            <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static t:Txt.SectionHistory}" Margin="2,12,0,8" />
            <Border Style="{StaticResource Card}" Padding="20,14">
                <StackPanel>
                    <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.HistoryDetail}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.HistoryEmpty}" Margin="0,4,0,0"
                               Visibility="{Binding HistoryIsEmpty, Converter={StaticResource BoolToVis}}" />
                    <ItemsControl ItemsSource="{Binding History}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4" ToolTip="{Binding Values}" ToolTipService.ShowDuration="30000">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Secondary}" Text="{Binding Time}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource Secondary}" Text="{Binding Change}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Style="{StaticResource Secondary}" Text="{Binding Note}" Foreground="{StaticResource WarningBrush}"
                                                   Visibility="{Binding Note, Converter={StaticResource NotEmptyToVis}}" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="{x:Static t:Txt.HistoryUndo}" VerticalAlignment="Center" Command="{Binding UndoCommand}"
                                            Visibility="{Binding CanUndo, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Secondary}" Text="{Binding HistoryMore}" Margin="0,6,0,0"
                               Visibility="{Binding HistoryMore, Converter={StaticResource NotEmptyToVis}}" />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static t:Txt.SectionAbout}" Margin="2,12,0,8" />
            <Border Style="{StaticResource Card}" Padding="20,16">
                <StackPanel>
                    <Image Source="/Assets/kos-logo.png" Height="26" HorizontalAlignment="Left" Margin="0,0,0,12"
                           RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="KOS" />
                    <TextBlock Text="{Binding Version}" />
                    <ItemsControl ItemsSource="{Binding KosInfo}" Grid.IsSharedSizeScope="True" Focusable="False" Margin="0,8,0,0" />
                    <TextBlock Style="{StaticResource Secondary}" Text="{Binding ScriptsText}" Margin="0,8,0,0" />
                    <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.HomeLocationWarning}" Foreground="{StaticResource WarningBrush}" Margin="0,6,0,0"
                               Visibility="{Binding ShowLocationWarning, Converter={StaticResource BoolToVis}}" />
                    <Border Height="8" />
                    <Button Style="{StaticResource LinkButton}" Content="github.com/vzsxytsxs" HorizontalAlignment="Left"
                            Command="{Binding OpenGitHubCommand}" AutomationProperties.Name="{x:Static t:Txt.OpenGitHub}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
