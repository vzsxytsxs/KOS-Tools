<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:KosToolbox.ViewModels"
                    xmlns:t="clr-namespace:KosToolbox.Core.Text;assembly=KosToolbox.Core">

    <!-- ===================== Drivers ===================== -->
    <DataTemplate DataType="{x:Type vm:DriverRowViewModel}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="2.4*" />
                <ColumnDefinition Width="1.6*" />
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="1.2*" />
                <ColumnDefinition Width="0.9*" />
                <ColumnDefinition Width="0.8*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" AutomationProperties.Name="{Binding Name}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Published}" />
                <Border Style="{StaticResource Pill}" Margin="8,0,0,0" Visibility="{Binding IsOld, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{x:Static t:Txt.OldVersionPill}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                </Border>
            </StackPanel>
            <TextBlock Grid.Column="2" Text="{Binding Provider}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
            <TextBlock Grid.Column="3" Text="{Binding Class}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
            <TextBlock Grid.Column="4" Text="{Binding Version}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
            <TextBlock Grid.Column="5" Text="{Binding Date}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
            <TextBlock Grid.Column="6" Text="{Binding Size}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
            <TextBlock Grid.Column="7" Text="{Binding UsedBy}" ToolTip="{Binding Devices}" VerticalAlignment="Center" />
        </Grid>
    </DataTemplate>

    <DataTemplate DataType="{x:Type vm:DriversPageViewModel}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,8">
                <!-- The display driver (install, remove, NVIDIA driver, DDU) lives on GPU › Driver. -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{x:Static t:Txt.OpenGpuDriver}" Command="{Binding OpenGpuDriverCommand}" VerticalAlignment="Center" Margin="16,0,0,0" />
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="{x:Static t:Txt.DisplayDriverTitle}" />
                            <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.DisplayDriverMoved}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.DriversNote}" />
                <TextBlock Style="{StaticResource Secondary}" Text="{Binding LoadError}" Foreground="{StaticResource ErrorBrush}" Margin="0,4,0,0"
                           Visibility="{Binding LoadError, Converter={StaticResource NotEmptyToVis}}" />
            </StackPanel>
            <DockPanel Grid.Row="1" LastChildFill="False" Margin="0,0,0,8">
                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource PageSearch}" VerticalAlignment="Center" />
                <Button Content="{x:Static t:Txt.CheckOldVersions}" Margin="8,0,0,0" Command="{Binding CheckOldCommand}" />
                <Button Content="{x:Static t:Txt.CheckOlderWide}" Margin="8,0,0,0" Command="{Binding CheckOlderWideCommand}" />
                <Button Content="{x:Static t:Txt.UncheckAll}" Margin="8,0,0,0" Command="{Binding UncheckAllCommand}" />
                <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.Reading}" Margin="10,0,0,0" VerticalAlignment="Center"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Secondary}" Text="{Binding CountText}" VerticalAlignment="Center" />
            </DockPanel>
            <Grid Grid.Row="2" Margin="10,4,20,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="32" />
                    <ColumnDefinition Width="2.4*" />
                    <ColumnDefinition Width="1.6*" />
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="0.9*" />
                    <ColumnDefinition Width="0.8*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Style="{StaticResource SectionTitle}" FontSize="12" Text="{x:Static t:Txt.ColName}" />
                <TextBlock Grid.Column="2" Style="{StaticResource SectionTitle}" FontSize="12" Text="{x:Static t:Txt.ColProvider}" />
                <TextBlock Grid.Column="3" Style="{StaticResource SectionTitle}" FontSize="12" Text="{x:Static t:Txt.ColClassName}" />
                <TextBlock Grid.Column="4" Style="{StaticResource SectionTitle}" FontSize="12" Text="{x:Static t:Txt.ColVersion}" />
                <TextBlock Grid.Column="5" Style="{StaticResource SectionTitle}" FontSize="12" Text="{x:Static t:Txt.ColDate}" />
                <TextBlock Grid.Column="6" Style="{StaticResource SectionTitle}" FontSize="12" Text="{x:Static t:Txt.ColSize}" />
                <TextBlock Grid.Column="7" Style="{StaticResource SectionTitle}" FontSize="12" Text="{x:Static t:Txt.ColUsedBy}" />
            </Grid>
            <Border Grid.Row="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <ListBox Style="{StaticResource DataList}" ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                             SelectionMode="Single" AutomationProperties.Name="{x:Static t:Txt.PageDrivers}" />
                    <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.NoDrivers}" Margin="10,12,0,0"
                               Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Border>
            <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <CheckBox Content="{x:Static t:Txt.UninstallFromDevices}" IsChecked="{Binding UninstallFromDevices}" />
                        <CheckBox Content="{x:Static t:Txt.ForceDelete}" IsChecked="{Binding ForceDelete}" Margin="0,6,0,0" />
                        <TextBlock Style="{StaticResource PageMessage}" Margin="0,6,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="{x:Static t:Txt.ExportSelected}" Command="{Binding ExportCommand}" />
                        <Button Style="{StaticResource PrimaryButton}" Content="{x:Static t:Txt.DeleteChecked}" Margin="8,0,0,0" Command="{Binding DeleteCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
