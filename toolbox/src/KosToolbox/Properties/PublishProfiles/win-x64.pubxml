<?xml version="1.0" encoding="utf-8"?>
<!-- Framework-dependent single file: uses the .NET 8 Desktop Runtime installed in Windows (the KOS installer installs it when
     it's missing), so the .exe holds only the app. Nothing is extracted to %TEMP% (the app runs as administrator). -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Startup: no compression (compressed, every assembly is unpacked into the process's private memory at each start: ~0.25 s
         and ~65 MB more) and ReadyToRun (precompiled code, little JIT at startup: ~0.2 s less). -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>none</DebugType>
    <PublishDir>..\..\publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
