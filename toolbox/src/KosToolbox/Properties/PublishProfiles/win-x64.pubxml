<?xml version="1.0" encoding="utf-8"?>
<!-- Self-contained (doesn't need .NET installed). The WPF native DLLs sit next to the .exe instead of being extracted
     to %TEMP% (the user's folder), since the toolbox reopens itself as administrator. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <PublishDir>..\..\publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
