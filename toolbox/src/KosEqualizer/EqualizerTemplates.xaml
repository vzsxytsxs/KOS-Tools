<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:KosEqualizerApp"
                    xmlns:v="clr-namespace:KosToolbox.Views;assembly=KosToolbox"
                    xmlns:t="clr-namespace:KosToolbox.Core.Text;assembly=KosToolbox.Core">

    <!-- ===================== KOS Equalizer ===================== -->
    <!-- Uses Theme.xaml, Templates.xaml, GpuTemplates.xaml and AudioTemplates.xaml (AudioCard, AudioDeviceRow, AudioDeviceHeader/Cards). -->
    <Style x:Key="EqWarning" TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
        <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
        <Setter Property="Margin" Value="0,8,0,0" />
    </Style>
    <Style x:Key="EqLabel" TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <!-- A graphic band's slider: vertical, value up, 0.5 dB steps; a mark at 0 dB. -->
    <Style x:Key="EqVerticalSlider" TargetType="Slider">
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
        <Setter Property="Orientation" Value="Vertical" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="IsSnapToTickEnabled" Value="True" />
        <Setter Property="TickFrequency" Value="0.5" />
        <Setter Property="SmallChange" Value="0.5" />
        <Setter Property="LargeChange" Value="3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Width="20" Background="Transparent">
                        <Border Width="4" CornerRadius="2" Background="{StaticResource BorderStrongBrush}" HorizontalAlignment="Center" />
                        <Border Width="12" Height="1" Background="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        <Track x:Name="PART_Track" Orientation="Vertical">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False" IsTabStop="False">
                                    <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False" IsTabStop="False">
                                    <RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="14" Height="14">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse Fill="{StaticResource TextBrush}" Stroke="{StaticResource BgBrush}" StrokeThickness="2" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Pasted text: several lines, monospace, scrolls both ways. -->
    <Style x:Key="EqCodeEditor" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource TextBrush}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A parametric band: on/off, type, frequency, gain (none for pass, notch and band-pass), Q, remove. -->
    <DataTemplate DataType="{x:Type vm:EqBandRow}">
        <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="44" /><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="38" />
            </Grid.ColumnDefinitions>
            <CheckBox IsChecked="{Binding Enabled}" VerticalAlignment="Center" ToolTip="{x:Static t:Txt.EqBandOn}" AutomationProperties.Name="{x:Static t:Txt.EqBandOn}" />
            <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:EqBandRow.Types}" ItemTemplate="{StaticResource OptionText}" SelectedItem="{Binding Type, Mode=TwoWay}"
                      MinWidth="0" Margin="0,0,8,0" AutomationProperties.Name="{x:Static t:Txt.EqType}" />
            <TextBox Grid.Column="2" Text="{Binding Frequency, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" AutomationProperties.Name="{x:Static t:Txt.EqFrequencyHeader}" />
            <TextBox Grid.Column="3" Text="{Binding Gain, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding HasGain, Converter={StaticResource BoolToVis}}" Margin="0,0,8,0"
                     AutomationProperties.Name="{x:Static t:Txt.EqGainHeader}" />
            <TextBox Grid.Column="4" Text="{Binding Q, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Q" />
            <Button Grid.Column="5" Style="{StaticResource IconButton}" Content="&#xE74D;" FontSize="13" Width="30" Height="28" HorizontalAlignment="Right"
                    Command="{Binding RemoveCommand}" ToolTip="{x:Static t:Txt.EqRemoveBand}" AutomationProperties.Name="{x:Static t:Txt.EqRemoveBand}" />
        </Grid>
    </DataTemplate>

    <!-- A graphic band: its gain, the slider (limits before the value: EqGraphicRow.Range), its frequency. -->
    <DataTemplate DataType="{x:Type vm:EqGraphicRow}">
        <StackPanel ToolTip="{Binding Tooltip}">
            <TextBlock Text="{Binding GainText}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
            <Slider Style="{StaticResource EqVerticalSlider}" Minimum="-15" Maximum="15" Value="{Binding Gain, Mode=TwoWay}" Height="150" Margin="0,4"
                    HorizontalAlignment="Center" AutomationProperties.Name="{Binding Label}" />
            <TextBlock Text="{Binding Label}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" />
        </StackPanel>
    </DataTemplate>

    <!-- The selected device: KOS Equalizer's state and switch, profiles, the editor, import/export, then its Windows audio settings. -->
    <DataTemplate DataType="{x:Type vm:EqDeviceViewModel}">
        <StackPanel>
            <!-- In a Border: a ContentPresenter's own bindings would read its content (null when not connected), not this device. -->
            <Border Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}">
                <ContentPresenter Content="{Binding Settings}" ContentTemplate="{StaticResource AudioDeviceHeader}" />
            </Border>
            <StackPanel Margin="0,0,0,10" Visibility="{Binding IsConnected, Converter={StaticResource InverseBoolToVis}}">
                <TextBlock Style="{StaticResource Secondary}" FontSize="12" Text="{Binding FlowText}" />
                <WrapPanel Margin="0,4,0,0">
                    <TextBlock Text="{Binding Name}" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" TextWrapping="Wrap" />
                    <Border Style="{StaticResource AudioBadge}" BorderBrush="{StaticResource WarningBrush}">
                        <TextBlock Text="{x:Static t:Txt.EqNotConnected}" FontSize="11.5" Foreground="{StaticResource WarningBrush}" />
                    </Border>
                </WrapPanel>
            </StackPanel>

            <!-- 1. KOS Equalizer on this device: read from the system, again after each click. -->
            <Border Style="{StaticResource AudioCard}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource CardTitle}" Text="{x:Static t:Txt.EqCardTitle}" />
                            <TextBlock Text="{Binding StateText}" Margin="0,2,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Secondary}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StateWarning}" Value="True"><Setter Property="Foreground" Value="{StaticResource WarningBrush}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding IsOn}" Value="True"><Setter Property="Foreground" Value="{StaticResource TextBrush}" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <Button Grid.Column="1" Content="{Binding ToggleText}" Command="{Binding ToggleCommand}" MinWidth="104" VerticalAlignment="Center"
                                Visibility="{Binding HasToggle, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="{Binding ToggleText}" />
                    </Grid>
                    <TextBlock Style="{StaticResource EqWarning}" Text="{Binding Detail}" Visibility="{Binding Detail, Converter={StaticResource NotEmptyToVis}}" />
                    <TextBlock Style="{StaticResource EqWarning}" Text="{x:Static t:Txt.EqOtherNote}" Visibility="{Binding ShowOtherNote, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Style="{StaticResource EqWarning}" Text="{x:Static t:Txt.EqReplacedNote}" Visibility="{Binding ShowReplacedNote, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Style="{StaticResource EqWarning}" Text="{x:Static t:Txt.EqNotConnectedNote}" Visibility="{Binding IsConnected, Converter={StaticResource InverseBoolToVis}}" />
                    <TextBlock Style="{StaticResource Secondary}" Text="{Binding EffectText}" Margin="0,8,0,0" Visibility="{Binding EffectText, Converter={StaticResource NotEmptyToVis}}" />
                    <TextBlock Style="{StaticResource Secondary}" Text="{Binding BusyText}" Margin="0,8,0,0" Visibility="{Binding BusyText, Converter={StaticResource NotEmptyToVis}}" />
                    <TextBlock Style="{StaticResource GpuHint}" Text="{x:Static t:Txt.EqRestartNote}" Margin="0,8,0,0" Visibility="{Binding HasToggle, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>

            <StackPanel Visibility="{Binding IsConnected, Converter={StaticResource BoolToVis}}">
                <!-- 2. Profiles: the active one, the gamemode one, and their names. -->
                <Border Style="{StaticResource AudioCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{x:Static t:Txt.EqProfilesTitle}" Margin="0,0,0,10" />
                        <TextBlock Style="{StaticResource Secondary}" Text="{Binding ConfigError}" Foreground="{StaticResource ErrorBrush}" Margin="0,0,0,10"
                                   Visibility="{Binding ConfigError, Converter={StaticResource NotEmptyToVis}}" />
                        <Grid IsEnabled="{Binding IsEditable}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Style="{StaticResource EqLabel}" Text="{x:Static t:Txt.EqActiveLabel}" />
                                <ComboBox ItemsSource="{Binding ActiveItems}" ItemTemplate="{StaticResource OptionText}" SelectedItem="{Binding ActiveItem, Mode=TwoWay}"
                                          AutomationProperties.Name="{x:Static t:Txt.EqActiveLabel}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="0,0,0,10">
                                <TextBlock Style="{StaticResource EqLabel}" Text="{x:Static t:Txt.EqGamemodeLabel}" />
                                <ComboBox ItemsSource="{Binding GamemodeItems}" ItemTemplate="{StaticResource OptionText}" SelectedItem="{Binding GamemodeItem, Mode=TwoWay}"
                                          AutomationProperties.Name="{x:Static t:Txt.EqGamemodeLabel}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1">
                                <TextBlock Style="{StaticResource EqLabel}" Text="{x:Static t:Txt.EqNameLabel}" />
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="{x:Static t:Txt.EqRename}" Command="{Binding RenameCommand}" Margin="8,0,0,0" />
                                    <TextBox Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}" MaxLength="64" IsEnabled="{Binding HasProfile}"
                                             AutomationProperties.Name="{x:Static t:Txt.EqNameLabel}" />
                                </DockPanel>
                            </StackPanel>
                            <WrapPanel Grid.Row="1" Grid.Column="2" VerticalAlignment="Bottom">
                                <Button Content="{x:Static t:Txt.EqNew}" Command="{Binding NewCommand}" Margin="0,0,8,0" />
                                <Button Content="{x:Static t:Txt.EqDuplicate}" Command="{Binding DuplicateCommand}" Margin="0,0,8,0" />
                                <Button Content="{x:Static t:Txt.EqDelete}" Command="{Binding DeleteCommand}" />
                            </WrapPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource EqWarning}" Text="{Binding RenameProblem}" Visibility="{Binding RenameProblem, Converter={StaticResource NotEmptyToVis}}" />
                        <TextBlock Style="{StaticResource GpuHint}" Text="{x:Static t:Txt.EqGamemodeHint}" Margin="0,10,0,0" />
                        <TextBlock Style="{StaticResource GpuHint}" Text="{Binding GamemodeNote}" Visibility="{Binding GamemodeNote, Converter={StaticResource NotEmptyToVis}}" />
                        <TextBlock Style="{StaticResource GpuHint}" Text="{Binding OffHint}" Visibility="{Binding OffHint, Converter={StaticResource NotEmptyToVis}}" />
                    </StackPanel>
                </Border>

                <!-- 3. Editor: the active profile, applied live (saved and played once the edits rest); the response is drawn as it's edited. -->
                <Border Style="{StaticResource AudioCard}">
                    <StackPanel>
                        <DockPanel>
                            <ItemsControl DockPanel.Dock="Right" Style="{StaticResource Segmented}" ItemsSource="{Binding Modes}" Tag="{Binding SetModeCommand}"
                                          Visibility="{Binding HasProfile, Converter={StaticResource BoolToVis}}" IsEnabled="{Binding IsEditable}"
                                          AutomationProperties.Name="{x:Static t:Txt.EqEditorTitle}" />
                            <TextBlock Style="{StaticResource CardTitle}" Text="{x:Static t:Txt.EqEditorTitle}" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.EqFlatEditor}" Margin="0,8,0,0"
                                   Visibility="{Binding HasProfile, Converter={StaticResource InverseBoolToVis}}" />
                        <vm:EqGraph Points="{Binding Curve}" Height="180" Margin="0,12,0,0" AutomationProperties.Name="{x:Static t:Txt.EqResponse}" />
                        <TextBlock Style="{StaticResource EqWarning}" Text="{Binding Problem}" Visibility="{Binding Problem, Converter={StaticResource NotEmptyToVis}}" />
                        <StackPanel Visibility="{Binding HasProfile, Converter={StaticResource BoolToVis}}" IsEnabled="{Binding IsEditable}">
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="72" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Static t:Txt.EqPreamp}" VerticalAlignment="Center" Margin="0,0,16,0" />
                                <Slider Grid.Column="1" Style="{StaticResource GpuSlider}" Minimum="-30" Maximum="30" TickFrequency="0.5" SmallChange="0.5" LargeChange="3"
                                        Value="{Binding Preamp, Mode=TwoWay}" AutomationProperties.Name="{x:Static t:Txt.EqPreamp}" />
                                <TextBlock Grid.Column="2" Text="{Binding PreampText}" HorizontalAlignment="Right" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular" />
                                <Button Grid.Column="3" Content="{Binding SuggestedText}" Command="{Binding SuggestedCommand}" Margin="16,0,0,0" ToolTip="{x:Static t:Txt.EqSuggestedTip}" />
                            </Grid>

                            <!-- Parametric: one row per band (up to 64). -->
                            <StackPanel Margin="0,14,0,0" Visibility="{Binding IsParametric, Converter={StaticResource BoolToVis}}">
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" /><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="38" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource EqLabel}" Text="{x:Static t:Txt.EqBandOn}" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource EqLabel}" Text="{x:Static t:Txt.EqType}" />
                                    <TextBlock Grid.Column="2" Style="{StaticResource EqLabel}" Text="{x:Static t:Txt.EqFrequencyHeader}" />
                                    <TextBlock Grid.Column="3" Style="{StaticResource EqLabel}" Text="{x:Static t:Txt.EqGainHeader}" />
                                    <TextBlock Grid.Column="4" Style="{StaticResource EqLabel}" Text="Q" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Bands}" Focusable="False" />
                                <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.EqNoBands}" Margin="0,0,0,8"
                                           Visibility="{Binding NoBands, Converter={StaticResource BoolToVis}}" />
                                <Button Content="{x:Static t:Txt.EqAddBand}" Command="{Binding AddBandCommand}" HorizontalAlignment="Left" Margin="0,4,0,0" />
                            </StackPanel>

                            <!-- Graphic: 10, 15 or 31 sliders side by side. -->
                            <ItemsControl ItemsSource="{Binding Graphic}" Focusable="False" Margin="0,14,0,0" Visibility="{Binding IsGraphic, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 4. Import and export: Equalizer APO / AutoEQ text, from a file or pasted, becomes a new profile. -->
                <Border Style="{StaticResource AudioCard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="{x:Static t:Txt.EqImportTitle}" Margin="0,0,0,10" />
                        <WrapPanel>
                            <Button Content="{x:Static t:Txt.EqImportFile}" Command="{Binding ImportFileCommand}" Margin="0,0,8,0" />
                            <Button Content="{x:Static t:Txt.EqExport}" Command="{Binding ExportCommand}" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource GpuHint}" Text="{x:Static t:Txt.EqExportHint}" />
                        <TextBlock Style="{StaticResource EqLabel}" Text="{x:Static t:Txt.EqPasteLabel}" Margin="0,12,0,4" />
                        <TextBox Style="{StaticResource EqCodeEditor}" Text="{Binding PasteText, UpdateSourceTrigger=PropertyChanged}" Height="96" IsEnabled="{Binding IsEditable}"
                                 AutomationProperties.Name="{x:Static t:Txt.EqPasteLabel}" />
                        <Button Content="{x:Static t:Txt.EqImportPaste}" Command="{Binding ImportPasteCommand}" HorizontalAlignment="Right" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>

                <!-- 5. The device's Windows audio settings (the Audio page's cards). -->
                <TextBlock Style="{StaticResource SectionTitle}" Text="{x:Static t:Txt.EqDeviceSettings}" Margin="4,10,0,8" />
                <ContentPresenter Content="{Binding Settings}" ContentTemplate="{StaticResource AudioDeviceCards}" />
            </StackPanel>
        </StackPanel>
    </DataTemplate>

    <!-- KOS Equalizer: playback devices (280 px, scrolling on their own) and the selected one beside them (up to 760 px wide). -->
    <DataTemplate DataType="{x:Type vm:EqualizerPageViewModel}">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="280" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel Margin="0,4,0,12">
                        <TextBlock Style="{StaticResource HomeHeader}" Text="{x:Static t:Txt.AudioPlaybackHeader}" />
                        <ItemsControl ItemsSource="{Binding Devices}" ItemTemplate="{StaticResource AudioDeviceRow}" Focusable="False" />
                        <TextBlock Style="{StaticResource Secondary}" Text="{x:Static t:Txt.EqNone}" Margin="16,12" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Style="{StaticResource Secondary}" Text="{Binding ListError}" Foreground="{StaticResource ErrorBrush}" Margin="16,12"
                                   Visibility="{Binding ListError, Converter={StaticResource NotEmptyToVis}}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Margin="24,0,0,0"
                          vm:EqView.TopOn="{Binding Selected}">
                <Grid Margin="0,0,8,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" MaxWidth="760" /></Grid.ColumnDefinitions>
                    <ContentControl Content="{Binding Selected}" Focusable="False" v:Motion.Transition="{Binding Selected}" />
                </Grid>
            </ScrollViewer>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
