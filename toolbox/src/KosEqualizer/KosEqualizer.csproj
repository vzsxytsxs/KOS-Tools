<Project Sdk="Microsoft.NET.Sdk">
  <!-- KOS Equalizer: one page in the toolbox's window style (AppWindow), with the toolbox's theme and helpers. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <RootNamespace>KosEqualizerApp</RootNamespace>
    <AssemblyName>KosEqualizer</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\KosToolbox\Assets\kos.ico</ApplicationIcon>
    <Title>KOS Equalizer</Title>
    <Product>KOS Equalizer</Product>
    <StartupObject>KosEqualizerApp.Program</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\KosToolbox\KosToolbox.csproj" />
    <!-- The toolbox's templates use "/Assets/..." relative to the running app: the same files go in this one. -->
    <Resource Include="..\KosToolbox\Assets\*.png;..\KosToolbox\Assets\*.ico" Link="Assets\%(Filename)%(Extension)" />
    <!-- The audio effect (toolbox/apo, built by build.cmd) goes beside the exe, outside the single file: it's installed from there. -->
    <None Include="..\..\apo\bin\KosEqApo.dll" Condition="Exists('..\..\apo\bin\KosEqApo.dll')" Link="KosEqApo.dll"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
  <!-- Referencing the toolbox (an exe) brings its app host and runtimeconfig into the publish folder: they aren't part of this app. -->
  <Target Name="DropToolboxHost" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(RelativePath)' == 'KosToolbox.exe' Or '%(RelativePath)' == 'KosToolbox.runtimeconfig.json'" />
    </ItemGroup>
  </Target>
</Project>
