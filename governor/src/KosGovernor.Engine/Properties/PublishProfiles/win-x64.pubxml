<?xml version="1.0" encoding="utf-8"?>
<!-- Native AOT, to the repository's engine\publish folder (installed as KOS\engine, beside KOS\governor and KOS\toolbox). -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <DebugType>none</DebugType>
    <PublishDir>..\..\..\engine\publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
