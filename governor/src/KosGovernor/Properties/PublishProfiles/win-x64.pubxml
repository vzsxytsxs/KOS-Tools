<?xml version="1.0" encoding="utf-8"?>
<!-- Framework-dependent single file: uses the .NET 8 Desktop Runtime installed in Windows (the KOS installer installs it when
     it's missing), so the .exe holds only the app. Nothing is extracted to %TEMP% (the app runs as administrator). -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- No compression: compressed, the assemblies are unpacked into each process's private memory; without it they are
         mapped from the .exe. -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <!-- ReadyToRun: precompiled code, little JIT at startup (~1.55 s to ~1.2 s to the window). -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>none</DebugType>
    <PublishDir>..\..\publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
