<?xml version="1.0" encoding="utf-8"?>
<!-- Self-contained (doesn't need .NET installed). The WPF native DLLs sit next to the .exe instead of being extracted to
     %TEMP% (the user's folder), since the governor runs as administrator. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- No compression: compressed, the assemblies are unpacked into each process's private memory; without it they are
         mapped from the .exe. The .exe goes from ~71 to ~172 MB (zipped it's about the same size). -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <!-- ReadyToRun: precompiled code, little JIT at startup (~1.55 s to ~1.2 s to the window; the .exe ~240 MB). -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>none</DebugType>
    <PublishDir>..\..\publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
