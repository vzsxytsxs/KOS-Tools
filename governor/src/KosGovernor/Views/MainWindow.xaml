<Window x:Class="KosGovernor.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:KosGovernor.Views"
        Title="KOS Governor" Icon="/Assets/kos-governor.ico"
        Width="1440" Height="880" MinWidth="1180" MinHeight="640" WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="12" UseLayoutRounding="True">
    <Window.Resources>
        <v:VisibleIf x:Key="VisibleIf" />
        <DataTemplate x:Key="NameCell">
            <StackPanel Orientation="Horizontal">
                <Image Source="{Binding Icon}" Width="16" Height="16" Margin="2,0,6,0" RenderOptions.BitmapScalingMode="HighQuality"
                       Visibility="{Binding ShowIcon, Converter={StaticResource BoolToVis}}" />
                <TextBlock Text="{Binding DisplayName, Mode=OneWay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <ToggleButton Style="{StaticResource Expander}" IsChecked="{Binding IsExpanded}" VerticalAlignment="Center"
                              Visibility="{Binding HasServices, Converter={StaticResource BoolToVis}}" ToolTip="Show the services in this process" />
            </StackPanel>
        </DataTemplate>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <!-- Details panel: column titles (NOW, PRIORITY...), small labels and the value cards. -->
        <Style x:Key="PanelLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="PanelSub" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,2,0,4" />
        </Style>
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource ControlBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,8,8" />
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <DataTemplate x:Key="Option">
            <Button Style="{StaticResource OptionButton}" />
        </DataTemplate>
        <!-- Gamemode on the top strip: a pill with a switch (same look as the Switch style) and its state. -->
        <Style x:Key="GamemodePill" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Height="30">
                            <Border CornerRadius="15" Background="{StaticResource ControlBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" />
                            <Border CornerRadius="15" Margin="1" Background="{StaticResource HoverBrush}" Opacity="0" v:Motion.ShowWhen="{TemplateBinding IsMouseOver}" />
                            <StackPanel Orientation="Horizontal" Margin="8,0,12,0">
                                <Grid Width="34" Height="18" VerticalAlignment="Center">
                                    <Border x:Name="Track" CornerRadius="9" Background="{StaticResource ControlBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" />
                                    <Ellipse x:Name="Knob" Width="12" Height="12" Margin="3,0" HorizontalAlignment="Left" Fill="{StaticResource TextSecondaryBrush}" />
                                </Grid>
                                <TextBlock x:Name="Label" Text="Gamemode off" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding GamemodeOn}" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#1E9BE0" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="#1E9BE0" />
                                <Setter TargetName="Knob" Property="Fill" Value="#FFFFFF" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Label" Property="Text" Value="Gamemode on" />
                                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource TextBrush}" />
                                <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Gamemode section: the big on/off switch (DataContext: this window's view model), its cards and the rule table's column titles. -->
        <Style x:Key="GamemodeSwitch" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Height="40">
                            <Border x:Name="Frame" CornerRadius="20" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" />
                            <Border CornerRadius="20" Margin="1" Background="{StaticResource HoverBrush}" Opacity="0" v:Motion.ShowWhen="{TemplateBinding IsMouseOver}" />
                            <StackPanel Orientation="Horizontal" Margin="10,0,16,0">
                                <Grid Width="40" Height="22" VerticalAlignment="Center">
                                    <Border x:Name="Track" CornerRadius="11" Background="{StaticResource ControlBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" />
                                    <Ellipse x:Name="Knob" Width="14" Height="14" Margin="4,0" HorizontalAlignment="Left" Fill="{StaticResource TextSecondaryBrush}" />
                                </Grid>
                                <TextBlock x:Name="Label" Text="Gamemode off" Margin="12,0,0,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding Config.HotkeyText}" Margin="12,1,0,0" VerticalAlignment="Center" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding GamemodeOn}" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource TextBrush}" />
                                <Setter TargetName="Track" Property="Background" Value="#1E9BE0" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="#1E9BE0" />
                                <Setter TargetName="Knob" Property="Fill" Value="#FFFFFF" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Label" Property="Text" Value="Gamemode on" />
                                <Setter TargetName="Label" Property="Foreground" Value="{StaticResource TextBrush}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GmCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource RaisedBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,12" />
        </Style>
        <Style x:Key="GmColumn" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ===== Status bar ===== -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CpuText}" />
                    <TextBlock Text="{Binding CountsText}" Margin="22,0,0,0" />
                    <TextBlock Text="{Binding MemoryText}" Margin="22,0,0,0" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Message}" Margin="24,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Message}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Engine stopped: rules aren't applied" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center" Margin="0,0,14,0"
                               Visibility="{Binding EngineRunning, Converter={StaticResource VisibleIf}, ConverterParameter=false}" />
                    <TextBlock Text="KOS" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="196" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== Sidebar: the views, and the engine at the bottom ===== -->
            <DockPanel Margin="8,8,8,10">
                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource TextBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EngineRunning}" Value="False">
                                                <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock FontWeight="SemiBold" Margin="8,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Engine running" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EngineRunning}" Value="False">
                                                <Setter Property="Text" Value="Engine stopped" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Text="{Binding EngineNote}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
                <!-- Profile and gamemode, above the engine: no strip under the title bar. -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,8">
                    <Button x:Name="ProfileButton" Style="{StaticResource Small}" Click="OnProfileMenu" MinHeight="30" Padding="10,0"
                            ToolTip="Switch, add, rename or delete profiles">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="9" Margin="8,1,0,0" />
                            <TextBlock Text="Profile" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Config.ProfileName}" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Button>
                    <Button Style="{StaticResource GamemodePill}" Command="{Binding ToggleGamemodeCommand}" Margin="0,6,0,0"
                            AutomationProperties.Name="Gamemode" ToolTip="{Binding Config.HotkeyText}" ToolTipService.InitialShowDelay="300" />
                </StackPanel>
                <ListBox Style="{StaticResource NavList}" ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}" AutomationProperties.Name="Views" />
            </DockPanel>

            <Border Grid.Column="1" Margin="0,8,0,0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,1,0,0" CornerRadius="10,0,0,0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="16,12">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <!-- Gamemode draws its own title, with the on/off switch. -->
                                    <DataTrigger Binding="{Binding SelectedSection.Key}" Value="Gamemode">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedSection.Title}" FontSize="20" FontWeight="SemiBold" />
                            <TextBlock Text="Click a process to open its details below." Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="14,3,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ShowConfig}" Value="False" />
                                                    <Condition Binding="{Binding Panel.IsOpen}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <TextBox x:Name="Search" Width="280" HorizontalAlignment="Right" MinHeight="30" Tag="Search name, PID or service"
                                 Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                                 Visibility="{Binding ShowConfig, Converter={StaticResource VisibleIf}, ConverterParameter=false}" />
                    </Grid>

                    <Grid>
                        <!-- ===== Processes ===== -->
                        <DockPanel Visibility="{Binding ShowConfig, Converter={StaticResource VisibleIf}, ConverterParameter=false}">
                            <!-- Details of the selected processes, docked under the list; X or Esc closes it (unselects). -->
                            <Border DockPanel.Dock="Bottom" Height="322" DataContext="{Binding Panel}" Visibility="Collapsed" v:Motion.RevealWhen="{Binding IsOpen}"
                                    Background="{StaticResource BgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top" Margin="16,12,16,10">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Small}" Click="OnClosePanel" Margin="6,0,0,0" Width="28" MinHeight="28" Padding="0"
                                                ToolTip="Close (Esc)" AutomationProperties.Name="Close the details">
                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="11" />
                                        </Button>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Small}" Content="Open file location" Command="{Binding OpenLocationCommand}" Margin="6,0,0,0" />
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Small}" Content="{Binding ThreadsText}" Click="OnPanelThreads"
                                                Visibility="{Binding CanOpenThreads, Converter={StaticResource VisibleIf}}" />
                                        <Image Source="{Binding Icon}" Width="24" Height="24" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Subtitle}" ToolTip="{Binding Subtitle}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                                                   Margin="12,2,12,0" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <!-- Now: the row's own values (the sum with several selected) and the program's file. -->
                                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="16,12,8,12">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource PanelLabel}" Text="NOW" />
                                                    <UniformGrid Columns="2">
                                                        <Border Style="{StaticResource StatCard}">
                                                            <StackPanel><TextBlock Style="{StaticResource PanelSub}" Text="CPU" Margin="0" /><TextBlock Style="{StaticResource StatValue}" Text="{Binding CpuNow}" /></StackPanel>
                                                        </Border>
                                                        <Border Style="{StaticResource StatCard}">
                                                            <StackPanel><TextBlock Style="{StaticResource PanelSub}" Text="Memory" Margin="0" /><TextBlock Style="{StaticResource StatValue}" Text="{Binding MemoryNow}" /></StackPanel>
                                                        </Border>
                                                        <Border Style="{StaticResource StatCard}">
                                                            <StackPanel><TextBlock Style="{StaticResource PanelSub}" Text="GPU" Margin="0" /><TextBlock Style="{StaticResource StatValue}" Text="{Binding GpuNow}" /></StackPanel>
                                                        </Border>
                                                        <Border Style="{StaticResource StatCard}">
                                                            <StackPanel><TextBlock Style="{StaticResource PanelSub}" Text="Threads" Margin="0" /><TextBlock Style="{StaticResource StatValue}" Text="{Binding ThreadsNow}" /></StackPanel>
                                                        </Border>
                                                    </UniformGrid>
                                                    <TextBlock Text="{Binding PathText}" ToolTip="{Binding Path}" FontFamily="Cascadia Mono, Consolas" FontSize="11" Margin="0,2,8,0"
                                                               Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Border>
                                            <!-- Priority: applied now; the filled button is what the process reports. -->
                                            <Border Grid.Column="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="16,12,12,12">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource PanelLabel}" Text="PRIORITY" />
                                                    <TextBlock Style="{StaticResource PanelSub}" Text="CPU priority" />
                                                    <ItemsControl ItemsSource="{Binding CpuPriorities}" ItemTemplate="{StaticResource Option}" Focusable="False">
                                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                    </ItemsControl>
                                                    <TextBlock Style="{StaticResource PanelSub}" Text="I/O priority" />
                                                    <ItemsControl ItemsSource="{Binding IoPriorities}" ItemTemplate="{StaticResource Option}" Focusable="False">
                                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                    </ItemsControl>
                                                    <TextBlock Style="{StaticResource PanelSub}" Text="Memory priority" />
                                                    <ItemsControl ItemsSource="{Binding MemoryPriorities}" ItemTemplate="{StaticResource Option}" Focusable="False">
                                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="5" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                            <!-- Processors: affinity or CPU sets, one button per logical processor; the last one can't be turned off. -->
                                            <Border Grid.Column="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="16,12,12,12">
                                                <DockPanel>
                                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                                                        <ItemsControl DockPanel.Dock="Right" ItemsSource="{Binding Modes}" Focusable="False">
                                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate><Button Style="{StaticResource OptionButton}" Height="22" MinWidth="64" Margin="4,0,0,0" FontSize="12" /></DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                        <TextBlock Style="{StaticResource PanelLabel}" Text="PROCESSORS" VerticalAlignment="Center" Margin="0" />
                                                    </DockPanel>
                                                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding ProcessorsText}" ToolTip="{Binding ProcessorsText}" Foreground="{StaticResource TextSecondaryBrush}"
                                                               Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                                                        <ItemsControl ItemsSource="{Binding Cpus}" Focusable="False">
                                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate><Button Style="{StaticResource OptionButton}" Width="40" Height="28" FontSize="12" /></DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </DockPanel>
                                            </Border>
                                            <!-- Rule: keeps the panel's values for every start of the program (or only while gamemode is on). -->
                                            <DockPanel Grid.Column="3" Margin="16,12,16,12">
                                                <TextBlock DockPanel.Dock="Top" Style="{StaticResource PanelLabel}" Text="RULE" />
                                                <Button DockPanel.Dock="Bottom" Style="{StaticResource LinkButton}" Content="See it in Rules" Command="{Binding SeeRulesCommand}"
                                                        HorizontalAlignment="Left" Visibility="{Binding RuleOn, Converter={StaticResource VisibleIf}}" />
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding RuleOn, Mode=OneWay}" Command="{Binding ToggleRuleCommand}"
                                                                  VerticalAlignment="Top" AutomationProperties.Name="{Binding RuleLabel}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding RuleLabel}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="10,2,0,0" />
                                                    </Grid>
                                                    <Grid Margin="0,10,0,0" IsEnabled="{Binding CanGamemode}">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding GamemodeOnly, Mode=OneWay}" Command="{Binding ToggleGamemodeOnlyCommand}"
                                                                  VerticalAlignment="Top" AutomationProperties.Name="Only while gamemode is on" />
                                                        <TextBlock Grid.Column="1" Text="Only while gamemode is on" TextWrapping="Wrap" Margin="10,2,0,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                    <TextBlock Text="{Binding RuleNote}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="18" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Grid>
                                    </Border>
                                </DockPanel>
                            </Border>
                            <ListView x:Name="List" Style="{StaticResource GridList}" ItemsSource="{Binding View}" SelectionMode="Extended"
                                      BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                                      ContextMenuOpening="OnMenu" MouseDoubleClick="OnDoubleClick" SelectionChanged="OnSelectionChanged">
                                <ListView.ContextMenu>
                                    <ContextMenu />
                                </ListView.ContextMenu>
                            </ListView>
                        </DockPanel>

                        <!-- ===== Rules, Gamemode, CPU masks and Settings (ConfigViewModel's tabs) ===== -->
                        <DockPanel DataContext="{Binding Config}" Visibility="{Binding DataContext.ShowConfig, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                            <TextBlock DockPanel.Dock="Top" Text="{Binding LoadProblem}" Foreground="{StaticResource ErrorBrush}" Margin="12,0,12,8" TextWrapping="Wrap"
                                       Visibility="{Binding LoadProblem, Converter={StaticResource VisibleIf}, ConverterParameter=text}" />

                            <Grid>
                                <!-- Rules -->
                                <DockPanel Visibility="{Binding IsRules, Converter={StaticResource BoolToVis}}">
                                    <Grid DockPanel.Dock="Top" Margin="10,8">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource Small}" Content="+ Add Process Rule" Command="{Binding AddRuleCommand}" />
                                            <Button Style="{StaticResource Small}" Content="+ Add From Open Programs" Margin="6,0,0,0" Command="{Binding AddFromOpenCommand}" />
                                            <TextBlock Text="Rules apply every time the program starts (and right away when you save)." Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" Margin="14,0,0,0" />
                                        </StackPanel>
                                        <TextBox Width="220" HorizontalAlignment="Right" MinHeight="26" Tag="Search" Text="{Binding RuleSearch, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                    <TextBlock DockPanel.Dock="Top" Text="No rules yet. Add one here or right-click a process › Always." Foreground="{StaticResource TextSecondaryBrush}" Margin="22,10"
                                               Visibility="{Binding RuleRows, Converter={StaticResource VisibleIf}, ConverterParameter=empty}" />
                                    <ListBox Style="{StaticResource DataList}" ItemsSource="{Binding RuleRows}" ItemTemplate="{StaticResource RuleRowTemplate}" Margin="4,0" />
                                </DockPanel>

                                <!-- Masks -->
                                <DockPanel Visibility="{Binding IsMasks, Converter={StaticResource BoolToVis}}">
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,8">
                                        <Button Style="{StaticResource Small}" Content="+ Add Mask" Command="{Binding AddMaskCommand}" />
                                        <TextBlock Text="Named groups of processors to use in CPU Affinity and CPU Sets." Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" Margin="14,0,0,0" />
                                    </StackPanel>
                                    <ListBox Style="{StaticResource DataList}" ItemsSource="{Binding MaskRows}" Margin="4,0">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="220" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Cpus, StringFormat=Processors {0}}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                        <Button Style="{StaticResource Tiny}" Content="Edit" Command="{Binding EditCommand}" />
                                                        <Button Style="{StaticResource Tiny}" Content="Delete" Command="{Binding DeleteCommand}" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>

                                <!-- Gamemode: header with the on/off switch, three cards, then tabs (Windows actions, rules when it turns on, rules when it turns off). -->
                                <ScrollViewer Visibility="{Binding IsGamemode, Converter={StaticResource BoolToVis}}" VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="22,18,22,20">
                                        <!-- Header. GamemodeOn and the toggle live on the window's view model; GamemodeOn is polled, so the switch follows the real state. -->
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource GamemodeSwitch}" VerticalAlignment="Center"
                                                    DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" Command="{Binding ToggleGamemodeCommand}"
                                                    AutomationProperties.Name="Gamemode" AutomationProperties.HelpText="Turns gamemode on or off" />
                                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                <TextBlock Text="Gamemode" FontSize="24" FontWeight="SemiBold" />
                                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Off · turn it on here or with the hotkey." />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding AutoGamemode}" Value="True">
                                                                    <Setter Property="Text" Value="Off · turns on by itself when a game starts." />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding DataContext.GamemodeOn, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                    <Setter Property="Text" Value="On · stays on until you turn it off." />
                                                                </DataTrigger>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding DataContext.GamemodeOn, RelativeSource={RelativeSource AncestorType=Window}}" Value="True" />
                                                                        <Condition Binding="{Binding AutoGamemode}" Value="True" />
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Text" Value="On · turns off by itself after the last game closes, unless it was turned on by hand." />
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </DockPanel>

                                        <!-- Cards: turning on, timer resolution, games. -->
                                        <Grid Margin="0,16,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.1*" />
                                                <ColumnDefinition Width="0.9*" />
                                                <ColumnDefinition Width="1.3*" />
                                            </Grid.ColumnDefinitions>
                                            <!-- Automatic gamemode: turns on when a game from the list is open and turns off after the last one closes. -->
                                            <Border Style="{StaticResource GmCard}">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource PanelLabel}" Text="TURNING ON" />
                                                    <CheckBox Content="When a game starts" IsChecked="{Binding AutoGamemode}"
                                                              ToolTip="Turned on by hand stays on until you turn it off; turned off by hand while a game runs stays off until that game closes." />
                                                    <TextBlock Text="{Binding Value, ElementName=OffDelaySlider, StringFormat=Turn off {0} s after the last game closes}" Margin="0,10,0,4"
                                                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" IsEnabled="{Binding AutoGamemode}" />
                                                    <Slider x:Name="OffDelaySlider" Minimum="0" Maximum="120" TickFrequency="5" SmallChange="5" LargeChange="15" IsSnapToTickEnabled="True"
                                                            Value="{Binding AutoOffDelay, Delay=400}" IsEnabled="{Binding AutoGamemode}" AutomationProperties.Name="Seconds before turning off" />
                                                    <CheckBox IsChecked="{Binding AutoOpensPrograms}" Margin="0,10,0,0" IsEnabled="{Binding AutoGamemode}">
                                                        <TextBlock Text="Also open this profile's programs when it switches automatically" TextWrapping="Wrap" />
                                                    </CheckBox>
                                                    <Border BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,10,0,0">
                                                        <DockPanel>
                                                            <Button DockPanel.Dock="Right" Style="{StaticResource Small}" Content="Reset" Margin="6,0,0,0" Command="{Binding ResetHotkeyCommand}" />
                                                            <Button DockPanel.Dock="Right" Style="{StaticResource Small}" Content="Change" Command="{Binding ChangeHotkeyCommand}" />
                                                            <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0">
                                                                <Run Text="Hotkey" Foreground="{StaticResource TextSecondaryBrush}" />
                                                                <Run Text="{Binding HotkeyText, Mode=OneWay}" FontWeight="SemiBold" />
                                                            </TextBlock>
                                                        </DockPanel>
                                                    </Border>
                                                    <!-- KOS Engine's network killswitch: its own hotkey; KOS Firewall says whether it cuts the local network too. -->
                                                    <DockPanel Margin="0,8,0,0" ToolTip="Cuts the internet until pressed again (open connections too); KOS Engine closing brings it back. KOS Firewall's options say whether the local network is cut too.">
                                                        <Button DockPanel.Dock="Right" Style="{StaticResource Small}" Content="Reset" Margin="6,0,0,0" Command="{Binding ResetKillswitchHotkeyCommand}" />
                                                        <Button DockPanel.Dock="Right" Style="{StaticResource Small}" Content="Change" Command="{Binding ChangeKillswitchHotkeyCommand}" />
                                                        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0">
                                                            <Run Text="Killswitch" Foreground="{StaticResource TextSecondaryBrush}" />
                                                            <Run Text="{Binding KillswitchHotkeyText, Mode=OneWay}" FontWeight="SemiBold" />
                                                        </TextBlock>
                                                    </DockPanel>
                                                </StackPanel>
                                            </Border>

                                            <Border Grid.Column="1" Style="{StaticResource GmCard}" Margin="10,0,10,0">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource PanelLabel}" Text="TIMER RESOLUTION" />
                                                    <!-- The resolution, big; dimmed (disabled) while the mode is Off. -->
                                                    <ComboBox ItemsSource="{Binding TimerResolutionOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding TimerResolution}"
                                                              IsEnabled="{Binding TimerOn}" HorizontalAlignment="Left" MinWidth="150" MinHeight="40" FontSize="22" FontWeight="SemiBold"
                                                              AutomationProperties.Name="Timer resolution">
                                                        <ComboBox.ItemContainerStyle>
                                                            <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                                                                <Setter Property="FontSize" Value="12" />
                                                                <Setter Property="FontWeight" Value="Normal" />
                                                            </Style>
                                                        </ComboBox.ItemContainerStyle>
                                                    </ComboBox>
                                                    <ListBox Style="{StaticResource SegmentList}" ItemsSource="{Binding TimerModeOptions}" SelectedValuePath="Value" SelectedValue="{Binding TimerMode}"
                                                             Margin="0,10,0,0" AutomationProperties.Name="When"
                                                             ToolTip="The engine asks Windows for a finer system timer: only while gamemode is on, or all the time. Games also keep their own timer requests while minimized." />
                                                    <TextBlock Text="{Binding TimerNote}" Foreground="{StaticResource WarningBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,8,0,0"
                                                               Visibility="{Binding TimerNote, Converter={StaticResource VisibleIf}, ConverterParameter=text}" />
                                                </StackPanel>
                                            </Border>

                                            <Border Grid.Column="2" Style="{StaticResource GmCard}">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="Show list" Command="{Binding ShowGameListCommand}" FontSize="12"
                                                                ToolTip="Every game and every program that never counts, with search" />
                                                        <TextBlock Style="{StaticResource PanelLabel}" Text="GAMES" />
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding GameListText}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                                    <ItemsControl ItemsSource="{Binding GameRows}" Margin="0,6,0,0" Focusable="False">
                                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="13" Height="26" Padding="10,0,3,0" Margin="0,4,6,0">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                        <TextBlock Text="{Binding Kind}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" Margin="6,0,0,0" VerticalAlignment="Center" />
                                                                        <Button Command="{Binding RemoveCommand}" Width="20" Height="20" MinHeight="0" Padding="0" Margin="6,0,0,0" VerticalAlignment="Center"
                                                                                BorderThickness="0" ToolTip="Back to what the built-in list says" AutomationProperties.Name="{Binding Name, StringFormat=Remove {0}}">
                                                                            <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="8" Foreground="{StaticResource TextSecondaryBrush}" />
                                                                        </Button>
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <WrapPanel Margin="0,4,0,0">
                                                        <Button Style="{StaticResource DashedChip}" Content="+ Add game" Command="{Binding AddGameCommand}" Margin="0,4,6,0" />
                                                        <Button Style="{StaticResource Small}" Content="Windows settings" Command="{Binding ShowGameSettingsCommand}" Margin="0,4,0,0"
                                                                ToolTip="Network priority (DSCP 46), fullscreen optimizations and GPU choice per game" />
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Tabs, underlined; the rule tabs get their add buttons on the right. -->
                                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Margin="0,16,0,0">
                                            <DockPanel>
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                                            Visibility="{Binding ShowGamemodeActions, Converter={StaticResource VisibleIf}, ConverterParameter=false}">
                                                    <Button Style="{StaticResource Small}" Content="Start a program" Command="{Binding AddStartCommand}" />
                                                    <Button Style="{StaticResource Small}" Content="+ Add process rule" Margin="6,0,0,0" Command="{Binding AddGamemodeRuleCommand}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton Style="{StaticResource UnderlineTab}" Content="While it is on" IsChecked="{Binding ShowGamemodeActions}" GroupName="GamemodeTab" />
                                                    <RadioButton Style="{StaticResource UnderlineTab}" Content="When it turns on" IsChecked="{Binding IsEnableTab}" GroupName="GamemodeTab" />
                                                    <RadioButton Style="{StaticResource UnderlineTab}" Content="When it turns off" IsChecked="{Binding IsDisableTab}" GroupName="GamemodeTab" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>

                                        <!-- While it is on: Windows changes of the active profile. -->
                                        <StackPanel Visibility="{Binding ShowGamemodeActions, Converter={StaticResource BoolToVis}}" Margin="0,10,0,0">
                                            <TextBlock Text="Applied when gamemode turns on, by hand or automatically, and undone when it turns off, when the engine exits, or the next time it starts after a crash. Only what is still as gamemode left it is undone. Changes here count from the next time gamemode turns on."
                                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="24" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                                </Grid.RowDefinitions>
                                                <Grid.Resources>
                                                    <Style x:Key="ActionRow" TargetType="DockPanel">
                                                        <Setter Property="MinHeight" Value="50" />
                                                    </Style>
                                                    <Style x:Key="ActionLine" TargetType="Border">
                                                        <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
                                                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                                                    </Style>
                                                    <Style x:Key="ActionName" TargetType="TextBlock">
                                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                    </Style>
                                                    <Style x:Key="ActionDesc" TargetType="TextBlock">
                                                        <Setter Property="FontSize" Value="12" />
                                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                        <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                                    </Style>
                                                </Grid.Resources>

                                                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource ActionLine}">
                                                    <DockPanel Style="{StaticResource ActionRow}">
                                                        <ComboBox DockPanel.Dock="Right" Style="{StaticResource CompactCombo}" Width="170" ItemsSource="{Binding PowerPlanOptions}" DisplayMemberPath="Name"
                                                                  SelectedValuePath="Id" SelectedValue="{Binding SysPowerPlanId}" IsEnabled="{Binding SysPowerPlan}" AutomationProperties.Name="Power plan" />
                                                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding SysPowerPlan}">
                                                            <StackPanel>
                                                                <TextBlock Style="{StaticResource ActionName}" Text="Power plan" />
                                                                <TextBlock Style="{StaticResource ActionDesc}" Text="Switches to this plan, then back to the previous one." />
                                                            </StackPanel>
                                                        </CheckBox>
                                                    </DockPanel>
                                                </Border>
                                                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource ActionLine}">
                                                    <DockPanel Style="{StaticResource ActionRow}">
                                                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding SysStopUpdate}">
                                                            <StackPanel>
                                                                <TextBlock Style="{StaticResource ActionName}" Text="Stop Windows Update" />
                                                                <TextBlock Style="{StaticResource ActionDesc}" Text="Stops Windows Update, Update Orchestrator and Delivery Optimization (startup type unchanged); stopped again if Windows restarts them." />
                                                            </StackPanel>
                                                        </CheckBox>
                                                    </DockPanel>
                                                </Border>
                                                <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource ActionLine}">
                                                    <DockPanel Style="{StaticResource ActionRow}">
                                                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding SysStopSearch}">
                                                            <StackPanel>
                                                                <TextBlock Style="{StaticResource ActionName}" Text="Stop Windows Search indexing" />
                                                                <TextBlock Style="{StaticResource ActionDesc}" Text="Stops the indexer (WSearch); searching files still works, without the index." />
                                                            </StackPanel>
                                                        </CheckBox>
                                                    </DockPanel>
                                                </Border>
                                                <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource ActionLine}">
                                                    <DockPanel Style="{StaticResource ActionRow}">
                                                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding SysTransparency}">
                                                            <StackPanel>
                                                                <TextBlock Style="{StaticResource ActionName}" Text="Turn off transparency effects" />
                                                                <TextBlock Style="{StaticResource ActionDesc}" Text="Same as Personalization › Colors › Transparency effects." />
                                                            </StackPanel>
                                                        </CheckBox>
                                                    </DockPanel>
                                                </Border>
                                                <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource ActionLine}">
                                                    <DockPanel Style="{StaticResource ActionRow}">
                                                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding SysCStates}">
                                                            <StackPanel>
                                                                <TextBlock Style="{StaticResource ActionName}" Text="Disable processor idle states (C-states)" />
                                                                <TextBlock Style="{StaticResource ActionDesc}" Text="On the active power plan. Lower latency; higher power use and temperature, even when idle." />
                                                            </StackPanel>
                                                        </CheckBox>
                                                    </DockPanel>
                                                </Border>
                                                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource ActionLine}">
                                                    <DockPanel Style="{StaticResource ActionRow}">
                                                        <ComboBox DockPanel.Dock="Right" Style="{StaticResource CompactCombo}" Width="110" ItemsSource="{Binding CleanDelayOptions}" DisplayMemberPath="Label"
                                                                  SelectedValuePath="Value" SelectedValue="{Binding SysCleanDelay}" IsEnabled="{Binding SysCleanMemory}"
                                                                  ToolTip="Wait after gamemode turns on, so the clean doesn't run while the game is loading." AutomationProperties.Name="Wait after gamemode turns on" />
                                                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding SysCleanMemory}">
                                                            <StackPanel>
                                                                <TextBlock Style="{StaticResource ActionName}" Text="Clean memory when gamemode turns on" />
                                                                <TextBlock Style="{StaticResource ActionDesc}" Text="Once: trims the memory of open programs and purges the standby list. Left alone: Windows processes like Explorer, the games, what they opened, their launcher and anti-cheats." />
                                                            </StackPanel>
                                                        </CheckBox>
                                                    </DockPanel>
                                                </Border>
                                                <Border Grid.Row="3" Grid.Column="0" Style="{StaticResource ActionLine}">
                                                    <DockPanel Style="{StaticResource ActionRow}">
                                                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding SysBackgroundEfficiency}">
                                                            <StackPanel>
                                                                <TextBlock Style="{StaticResource ActionName}" Text="Efficiency mode for background programs" />
                                                                <TextBlock Style="{StaticResource ActionDesc}" Text="Programs behind the game run in efficiency mode (EcoQoS), back to automatic when gamemode turns off. Left alone: games, the program in front, Windows' own, voice and capture programs (Discord, OBS, Voicemeeter) and programs with a rule: add a rule to keep one out." />
                                                            </StackPanel>
                                                        </CheckBox>
                                                    </DockPanel>
                                                </Border>
                                                <Border Grid.Row="3" Grid.Column="2" Style="{StaticResource ActionLine}">
                                                    <DockPanel Style="{StaticResource ActionRow}">
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" IsEnabled="{Binding SysPurgeStandby}">
                                                            <ComboBox Style="{StaticResource CompactCombo}" Width="96" ItemsSource="{Binding MemoryMbOptions}" SelectedItem="{Binding SysPurgeStandbyMb}"
                                                                      ItemStringFormat="{}{0:N0} MB" ToolTip="Standby over" AutomationProperties.Name="Standby over" />
                                                            <ComboBox Style="{StaticResource CompactCombo}" Width="96" Margin="4,0,0,0" ItemsSource="{Binding MemoryMbOptions}" SelectedItem="{Binding SysPurgeFreeMb}"
                                                                      ItemStringFormat="{}{0:N0} MB" ToolTip="And free under" AutomationProperties.Name="Free under" />
                                                        </StackPanel>
                                                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding SysPurgeStandby}">
                                                            <StackPanel>
                                                                <TextBlock Style="{StaticResource ActionName}" Text="Purge the standby list during the game" />
                                                                <TextBlock Style="{StaticResource ActionDesc}" Text="When the file cache grows past the first size while free memory is under the second (at most once a minute). Running programs keep their memory." />
                                                            </StackPanel>
                                                        </CheckBox>
                                                    </DockPanel>
                                                </Border>
                                                <Border Grid.Row="4" Grid.Column="0" Style="{StaticResource ActionLine}">
                                                    <DockPanel Style="{StaticResource ActionRow}">
                                                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding SysRestrain}">
                                                            <StackPanel>
                                                                <TextBlock Style="{StaticResource ActionName}" Text="Lower busy background programs" />
                                                                <TextBlock Style="{StaticResource ActionDesc}" Text="A background program that keeps using more than 15 % of the CPU for 6 s drops to Below normal priority until it has been quiet for 15 s. The same programs are left alone as for efficiency mode." />
                                                            </StackPanel>
                                                        </CheckBox>
                                                    </DockPanel>
                                                </Border>
                                                <Border Grid.Row="4" Grid.Column="2" Style="{StaticResource ActionLine}">
                                                    <DockPanel Style="{StaticResource ActionRow}">
                                                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding SysKeepAwake}">
                                                            <StackPanel>
                                                                <TextBlock Style="{StaticResource ActionName}" Text="Keep the PC and the screen awake" />
                                                                <TextBlock Style="{StaticResource ActionDesc}" Text="For controller play and long loading screens, where nothing resets the idle timer." />
                                                            </StackPanel>
                                                        </CheckBox>
                                                    </DockPanel>
                                                </Border>
                                                <Border Grid.Row="5" Grid.Column="0" Style="{StaticResource ActionLine}">
                                                    <DockPanel Style="{StaticResource ActionRow}">
                                                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding SysDwmMmcss}">
                                                            <StackPanel>
                                                                <TextBlock Style="{StaticResource ActionName}" Text="Desktop compositor in MMCSS" />
                                                                <TextBlock Style="{StaticResource ActionDesc}" Text="DWM (the desktop compositor) runs in the multimedia scheduling class while gamemode is on, for steadier frame pacing in windowed and borderless games." />
                                                                <TextBlock Text="{Binding DwmMmcssProblem}" Style="{StaticResource ActionDesc}" Foreground="{StaticResource WarningBrush}"
                                                                           Visibility="{Binding DwmMmcssProblem, Converter={StaticResource VisibleIf}, ConverterParameter=text}" />
                                                            </StackPanel>
                                                        </CheckBox>
                                                    </DockPanel>
                                                </Border>
                                                <Border Grid.Row="5" Grid.Column="2" Style="{StaticResource ActionLine}">
                                                    <DockPanel Style="{StaticResource ActionRow}">
                                                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding SysWifi}">
                                                            <StackPanel>
                                                                <TextBlock Style="{StaticResource ActionName}" Text="Wi-Fi without background scans" />
                                                                <TextBlock Style="{StaticResource ActionDesc}" Text="Connected Wi-Fi adapters stop scanning for other networks (ping spikes) and use the driver's streaming mode. No effect on wired connections." />
                                                            </StackPanel>
                                                        </CheckBox>
                                                    </DockPanel>
                                                </Border>
                                                <Border Grid.Row="6" Grid.Column="0" Style="{StaticResource ActionLine}">
                                                    <DockPanel Style="{StaticResource ActionRow}">
                                                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding SysAudio}">
                                                            <StackPanel>
                                                                <TextBlock Style="{StaticResource ActionName}" Text="Low-latency audio" />
                                                                <TextBlock Style="{StaticResource ActionDesc}" Text="The default playback device runs at the driver's smallest buffer instead of 10 ms. Only if the driver supports it; can crackle under heavy CPU load." />
                                                            </StackPanel>
                                                        </CheckBox>
                                                    </DockPanel>
                                                </Border>
                                                <Border Grid.Row="6" Grid.Column="2" Style="{StaticResource ActionLine}">
                                                    <DockPanel Style="{StaticResource ActionRow}">
                                                        <ComboBox DockPanel.Dock="Right" Style="{StaticResource CompactCombo}" Width="170" ItemsSource="{Binding GameCoresOptions}" DisplayMemberPath="Label"
                                                                  SelectedValuePath="Spec" SelectedValue="{Binding SysGameCoresSpec}" IsEnabled="{Binding SysGameCores}" AutomationProperties.Name="Cores for games" />
                                                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding SysGameCores}">
                                                            <StackPanel>
                                                                <TextBlock Style="{StaticResource ActionName}" Text="Cores for games" />
                                                                <TextBlock Style="{StaticResource ActionDesc}" Text="Listed games without a rule of their own get these cores as CPU sets; back to all cores when gamemode turns off." />
                                                            </StackPanel>
                                                        </CheckBox>
                                                    </DockPanel>
                                                </Border>
                                                <!-- Thread director: the whole width, with its three options under it. -->
                                                <Border Grid.Row="7" Grid.ColumnSpan="3" Style="{StaticResource ActionLine}" Padding="0,8">
                                                    <StackPanel>
                                                        <DockPanel Style="{StaticResource ActionRow}" MinHeight="0">
                                                            <ComboBox DockPanel.Dock="Right" Style="{StaticResource CompactCombo}" Width="170" ItemsSource="{Binding HeavyThreadOptions}" SelectedItem="{Binding SysHeavyThreads}"
                                                                      ItemStringFormat="{}{0} busiest thread(s)" IsEnabled="{Binding SysDirector}" AutomationProperties.Name="Busiest threads" />
                                                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding SysDirector}">
                                                                <StackPanel>
                                                                    <TextBlock Style="{StaticResource ActionName}" Text="Thread director" />
                                                                    <TextBlock Style="{StaticResource ActionDesc}" Text="The game's busiest threads (by CPU cycles) get a core of their own that the rest of the game stays off; worker and pool threads, threads the game pinned and threads with a rule are left alone. Undone when the game closes." />
                                                                </StackPanel>
                                                            </CheckBox>
                                                        </DockPanel>
                                                        <WrapPanel Margin="46,6,0,0" IsEnabled="{Binding SysDirector}">
                                                            <CheckBox IsChecked="{Binding SysMoveBackground}" Margin="0,2,24,2" Content="Move other programs off the game's cores" />
                                                            <CheckBox IsChecked="{Binding SysNormalizePriorities}" Margin="0,2,24,2" Content="Lower other programs' Realtime priority and time-critical threads" />
                                                            <CheckBox IsChecked="{Binding SysAvoidInterrupts}" Margin="0,2,24,2" Content="Avoid the processors with the most interrupt work (short trace once a minute outside gamemode)" />
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </StackPanel>

                                        <!-- When it turns on / off: the phase's programs to open and its rules. -->
                                        <StackPanel Visibility="{Binding ShowGamemodeActions, Converter={StaticResource VisibleIf}, ConverterParameter=false}" Margin="0,10,0,0">
                                            <TextBlock Text="{Binding PhaseHint}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />
                                            <!-- Same columns as GamemodeRuleRowTemplate. -->
                                            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Height="28">
                                                <Grid VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="1.4*" />
                                                        <ColumnDefinition Width="110" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Program" Style="{StaticResource GmColumn}" Margin="12,0,0,0" />
                                                    <TextBlock Grid.Column="1" Text="What changes" Style="{StaticResource GmColumn}" />
                                                </Grid>
                                            </Border>
                                            <ItemsControl ItemsSource="{Binding GamemodeRows}" ItemTemplate="{StaticResource GamemodeRuleRowTemplate}" Focusable="False" />
                                            <TextBlock Text="Nothing yet: add a process rule or a program to start." Foreground="{StaticResource TextSecondaryBrush}" Margin="12,12,0,0"
                                                       Visibility="{Binding GamemodeRows, Converter={StaticResource VisibleIf}, ConverterParameter=empty}" />
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- RTSS: on-screen display and frame limit while gamemode is on (active profile). -->
                                <ScrollViewer Visibility="{Binding IsRtss, Converter={StaticResource BoolToVis}}" VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="14,12" MaxWidth="640" HorizontalAlignment="Left">
                                        <TextBlock Style="{StaticResource Secondary}" FontSize="11.5" TextWrapping="Wrap"
                                                   Text="RivaTuner Statistics Server, when it is installed: the governor never installs it. Everything here applies while gamemode is on (this profile), and only while RTSS is running. RTSS hooks into the game to draw and limit, which some anti-cheats refuse." />

                                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding SysRtssKeepRunning}" HorizontalAlignment="Left" Margin="0,16,0,0">
                                            <StackPanel>
                                                <TextBlock Text="Keep RTSS running" />
                                                <TextBlock Text="Starts RTSS in the tray when the engine starts, this setting is saved or gamemode turns on and it isn't running. RTSS has to be up before a game opens to draw on it, so without this, start it yourself first. Off by default: the governor otherwise never starts it."
                                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" TextWrapping="Wrap" MaxWidth="440" />
                                            </StackPanel>
                                        </CheckBox>

                                        <TextBlock Style="{StaticResource SectionLabel}" Text="On-screen display" Margin="0,20,0,10" />
                                        <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding SysRtssOsd}" HorizontalAlignment="Left">
                                            <StackPanel>
                                                <TextBlock Text="Show on RTSS's overlay" />
                                                <TextBlock Text="Updated every second in an OSD slot of the governor's own, freed when gamemode turns off. Needs RTSS running."
                                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" TextWrapping="Wrap" MaxWidth="440" />
                                            </StackPanel>
                                        </CheckBox>
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0" IsEnabled="{Binding SysRtssOsd}">
                                            <TextBlock Text="Layout" VerticalAlignment="Center" Width="110" />
                                            <ComboBox ItemsSource="{Binding OsdLayouts}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedOsdLayout}" Width="230" AutomationProperties.Name="RTSS overlay layout" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0" IsEnabled="{Binding SysRtssOsd}">
                                            <TextBlock Text="Label color" VerticalAlignment="Center" Width="110" />
                                            <ComboBox ItemsSource="{Binding OsdColors}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SysRtssOsdColor}" Width="230" AutomationProperties.Name="RTSS overlay label color" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Secondary}" FontSize="11.5" TextWrapping="Wrap" Margin="0,6,0,0"
                                                   Text="A layout sets which items show, whether they share one line and how it looks: Steam style is a big FPS number over small grey labels, Benchmark has sections and a bar for each CPU core. The check boxes below still adjust the items (the box reads empty when they no longer match a layout). The label color uses RTSS's own text colors." />
                                        <ItemsControl ItemsSource="{Binding RtssOsdOptions}" Margin="0,10,0,0" IsEnabled="{Binding SysRtssOsd}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><UniformGrid Columns="3" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate><CheckBox Content="{Binding Key}" IsChecked="{Binding IsVisible}" Margin="0,0,0,10" /></DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Style="{StaticResource Secondary}" FontSize="11.5" TextWrapping="Wrap"
                                                   Text="FPS, frame time and the frame time graph are RTSS's own measurements of the game. The GPU items need an NVIDIA card. Changes show within a few seconds." />

                                        <TextBlock Style="{StaticResource SectionLabel}" Text="Frame limit" Margin="0,22,0,10" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Limit" VerticalAlignment="Center" Width="110" />
                                            <TextBox Text="{Binding SysRtssFrameLimit}" Width="90" MinHeight="26" Tag="RTSS's own" AutomationProperties.Name="RTSS frame limit" />
                                            <TextBlock Text="FPS" VerticalAlignment="Center" Margin="8,0,0,0" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <TextBlock Text="Limiter mode" VerticalAlignment="Center" Width="110" />
                                            <ComboBox ItemsSource="{Binding LimiterModeOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SysRtssLimiterMode}"
                                                      Width="200" AutomationProperties.Name="RTSS limiter mode" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Secondary}" FontSize="11.5" TextWrapping="Wrap" Margin="0,8,0,0"
                                                   Text="10 to 1000 FPS, saved on Enter or when you leave the box; empty keeps RTSS's own limit. Async keeps the strictest limit and the lowest latency; front edge sync gives the evenest frame presentation (flat frame times) at some latency; back edge sync evens out frame starts and behaves close to async; NVIDIA Reflex uses the driver's limiter (NVIDIA, Direct3D 11/12; works with DLSS frame generation; RTSS falls back to async elsewhere)." />
                                        <TextBlock Style="{StaticResource SectionLabel}" Text="Frame limit per game" Margin="0,22,0,10" />
                                        <ItemsControl ItemsSource="{Binding RtssGameRows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                        <TextBlock Text="{Binding Exe}" VerticalAlignment="Center" Width="200" TextTrimming="CharacterEllipsis" />
                                                        <TextBox Text="{Binding Fps, UpdateSourceTrigger=LostFocus}" Width="70" MinHeight="26" AutomationProperties.Name="Frame limit of this game" />
                                                        <TextBlock Text="FPS" VerticalAlignment="Center" Margin="8,0,12,0" />
                                                        <Button Content="Remove" Command="{Binding RemoveCommand}" Padding="10,2" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBox Text="{Binding NewGameExe, UpdateSourceTrigger=PropertyChanged}" Width="200" MinHeight="26" Tag="game.exe" AutomationProperties.Name="Program name of the game" />
                                            <TextBox Text="{Binding NewGameFps, UpdateSourceTrigger=PropertyChanged}" Width="70" MinHeight="26" Margin="0,0,0,0" Tag="FPS" AutomationProperties.Name="Frame limit" />
                                            <Button Content="Add" Command="{Binding AddGameLimitCommand}" Padding="14,2" Margin="8,0,0,0" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Secondary}" FontSize="11.5" TextWrapping="Wrap" Margin="0,8,0,0"
                                                   Text="Each game gets its own limit in its own RTSS profile (a copy of the global one when it has none) while gamemode is on; the limit above stays for every other game. When gamemode turns off, the profile goes back as it was, or is removed if gamemode created it. Use the game's program name as Task Manager shows it." />
                                        <TextBlock Style="{StaticResource Secondary}" FontSize="11.5" TextWrapping="Wrap" Margin="0,6,0,0"
                                                   Text="Both go into RTSS's global profile when gamemode turns on (changes here count from the next time) and are put back when it turns off, only if still as set. A game's own RTSS profile with settings of its own wins over the global one." />
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- General -->
                                <ScrollViewer Visibility="{Binding IsGeneral, Converter={StaticResource BoolToVis}}" VerticalScrollBarVisibility="Auto">
                                    <Grid Margin="14,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="1.3*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SectionLabel}" Text="Process columns" />
                                            <ItemsControl ItemsSource="{Binding ProcessColumnOptions}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate><CheckBox Content="{Binding Key}" IsChecked="{Binding IsVisible}" Margin="0,0,0,10" /></DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Style="{StaticResource SectionLabel}" Text="Thread columns" />
                                            <ItemsControl ItemsSource="{Binding ThreadColumnOptions}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate><CheckBox Content="{Binding Key}" IsChecked="{Binding IsVisible}" Margin="0,0,0,10" /></DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" MaxWidth="420" HorizontalAlignment="Left">
                                            <TextBlock Style="{StaticResource SectionLabel}" Text="Refresh intervals" />
                                            <TextBlock Text="{Binding Value, ElementName=GuiSlider, StringFormat=Process list: {0} ms}" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <Slider x:Name="GuiSlider" Minimum="100" Maximum="2000" TickFrequency="100" SmallChange="100" LargeChange="500" Width="260" HorizontalAlignment="Left"
                                                    Value="{Binding GuiInterval, Delay=400}" Margin="0,2,0,10" />
                                            <TextBlock Text="{Binding Value, ElementName=EngineSlider, StringFormat=Engine (tray): {0} ms}" Foreground="{StaticResource TextSecondaryBrush}" />
                                            <Slider x:Name="EngineSlider" Minimum="500" Maximum="10000" TickFrequency="500" SmallChange="500" LargeChange="1000" Width="260" HorizontalAlignment="Left"
                                                    Value="{Binding EngineInterval, Delay=400}" Margin="0,2,0,4" />
                                            <TextBlock Text="How often the engine looks for new programs. Lower reacts faster and uses a little more CPU." Style="{StaticResource Secondary}" FontSize="11.5" />

                                            <TextBlock Style="{StaticResource SectionLabel}" Text="Engine" Margin="0,22,0,10" />
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock VerticalAlignment="Center" Margin="0,0,12,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Stopped: rules aren't applied." />
                                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DataContext.EngineRunning, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                    <Setter Property="Text" Value="Running in the tray." />
                                                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <Button Style="{StaticResource Small}" Content="Start" Command="{Binding StartEngineCommand}" />
                                                <Button Style="{StaticResource Small}" Content="Stop" Margin="6,0,0,0" Command="{Binding StopEngineCommand}" />
                                            </StackPanel>
                                            <CheckBox Content="Start with Windows (after sign-in)" Margin="0,14,0,0" IsChecked="{Binding StartWithWindows}"
                                                      IsEnabled="{Binding CanStartWithWindows}" />
                                            <TextBlock Text="{Binding SignInProblem}" Style="{StaticResource Secondary}" Foreground="{StaticResource WarningBrush}" Margin="26,6,0,0"
                                                       Visibility="{Binding SignInProblem, Converter={StaticResource VisibleIf}, ConverterParameter=text}" />
                                            <CheckBox Margin="0,10,0,0" IsChecked="{Binding SessionReport}">
                                                <TextBlock TextWrapping="Wrap" MaxWidth="390"
                                                           Text="Record a session report during gamemode (CPU, memory, GPU and what interfered; shown on the toolbox's Stability page)" />
                                            </CheckBox>
                                            <TextBlock Style="{StaticResource Secondary}" FontSize="11.5" Margin="0,14,0,0"
                                                       Text="Closing this window keeps the rules running; exit from the tray icon to stop them. The engine needs no window and uses little memory." />

                                            <TextBlock Style="{StaticResource SectionLabel}" Text="Profile file" Margin="0,22,0,10" />
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource Small}" Content="Import" Command="{Binding ImportCommand}" />
                                                <Button Style="{StaticResource Small}" Content="Export" Margin="6,0,0,0" Command="{Binding ExportCommand}" />
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource Secondary}" FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap"
                                                       Text="Export saves the active profile to a file; Import adds a profile from one." />
                                        </StackPanel>
                                    </Grid>
                                </ScrollViewer>
                            </Grid>
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
