<Window x:Class="KosGovernor.Views.CpuDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner">
    <Border x:Name="Root" Style="{StaticResource DialogFrame}" MinWidth="460">
        <StackPanel>
            <StackPanel Margin="24,20,24,18">
                <TextBlock x:Name="Heading" Style="{StaticResource CardTitle}" FontSize="17" />
                <Grid x:Name="NameRow" Margin="0,14,0,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Name:" />
                    <TextBox x:Name="NameBox" Grid.Column="1" TextChanged="OnChanged" />
                </Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,10">
                    <Button Style="{StaticResource Small}" Content="None" Click="OnNone" />
                    <Button Style="{StaticResource Small}" Content="All" Margin="6,0,0,0" Click="OnAll" />
                    <Button x:Name="PresetButton" Style="{StaticResource Small}" Margin="6,0,0,0" Click="OnPreset">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Preset" />
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE70D;" FontSize="9" Margin="8,1,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <!-- Cores grouped by type (hybrid) or CCD, one block per physical core: core number on top, logical processors (SMT/HT) below. -->
                <StackPanel x:Name="Cores" MaxWidth="560" />
                <TextBlock x:Name="Error" Style="{StaticResource Secondary}" Foreground="{StaticResource ErrorBrush}" Margin="0,10,0,0" Visibility="Collapsed" />
            </StackPanel>
            <Border Style="{StaticResource DialogFooter}">
                <UniformGrid Rows="1">
                    <Button x:Name="Ok" Style="{StaticResource PrimaryButton}" Content="Save" Margin="0,0,6,0" IsDefault="True" Click="OnOk" />
                    <Button Content="Cancel" Margin="6,0,0,0" IsCancel="True" />
                </UniformGrid>
            </Border>
        </StackPanel>
    </Border>
</Window>
